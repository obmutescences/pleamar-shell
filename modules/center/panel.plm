part CenterPanel {
    //  Centre Panel: 7 tabs (Overview, System, Tray, Media, Audio, Calendar, Actions).
    //  Zero bare global `time`: all clocks (`ct_clk`, `ct_sky_t`, `ct_vinyl_spd` -> `ct_time`)
    //  sleep completely when `center_open` is false or the relevant animated view is hidden.

    //  ── Conditional clocks (must precede `let` expressions that read them) ──
    prop ct_clk = 0
    spin ct_clk by if(center_open, 1, 0)

    prop ct_sky_t = 0
    spin ct_sky_t by if(center_open and center_tab == 0 and wx_ready and not motion.reduced, 1, 0)

    prop ct_vinyl_spd = 0 ~sp_calm
    follow ct_vinyl_spd = if(center_open and not motion.reduced and ((med.playing and (center_tab == 0 or center_tab == 3)) or (music_on and center_tab == 4)), 1, 0)
    prop ct_time = 0
    spin ct_time by ct_vinyl_spd

    //  ── Shaders & Dynamic Album Cover ───────────────────────────────────
    shader ct_water = file "../water/card.wgsl"
    shader ct_netfx = file "../water/netfx.wgsl"
    shader ct_hatch = file "../common/shaders/pencilhatch.wgsl"
    shader ct_fill = file "../common/shaders/fillstyle.wgsl"
    shader ct_sky = file "../common/shaders/sky.wgsl"
    shader ct_liquid = file "../common/shaders/liquid.wgsl"
    image ct_art_img = from ct_art_path, 256, 256

    //  ── Palette & Geometry Tokens ─────────────────────────────────────────
    let ct.card = rgb(pal_panel_r, pal_panel_g, pal_panel_b)
    let ct.primary = primary
    let ct.secondary = secondary
    let ct.track = mix(tint, ink, 0.09)
    let ct.line = mix(tint, ink, 0.16)
    let ct.card2 = mix(ct.card, ink, 0.035)
    let ct.off = aqua
    let ct.work = #f59e0b
    let ct.w = 1120
    let ct.h = 720
    let ct.x = 30
    let ct.y = 110
    let ct.px = (screen.width - ct.w) / 2
    let ct.wide = 1060
    let ct.tab_x = 300
    let ct.tab_w = 76
    let ct.tab_n = 7
    let ct_fr = floor(ct_clk * 6)

    //  ── Motion Props & Target Facts ───────────────────────────────────────
    prop ct_tab_ld = 0 ~sp_lead
    prop ct_tab_tl = 0 ~sp_trail
    follow ct_tab_ld = center_tab
    follow ct_tab_tl = center_tab

    prop ct_page = 1 ~quick
    prop ct_modal_p = 0 ~180ms
    follow ct_modal_p = center_power_confirm >= 0 or (audio_pick_open and center_tab == 4)
    prop ct_power_p = 0 ~180ms
    follow ct_power_p = center_power_confirm >= 0

    //  Calendar month swipe transition
    prop ct_cal_slide = 1 ~sp_calm

    //  Track change cover pop & burst event
    prop ct_track_pop = 1 ~sp_pop
    event ct_track_burst ->

    //  System tab manual smooth scroll
    fact ct_sys_sc_to = 0
    prop ct_sys_sc = 0 ~quick
    follow ct_sys_sc = ct_sys_sc_to

    //  Audio per-app mixer manual smooth scroll
    fact ct_app_sc_to = 0
    prop ct_app_sc = 0 ~quick
    follow ct_app_sc = ct_app_sc_to

    //  Overview alert expand toggle (`-1` none, `0..2` row expanded)
    fact ct_alert_exp = -1

    //  Tray pane slide-ins (clean flat glass, zero nested blur)
    prop ct_tray_m_p = 0 ~sp_calm
    follow ct_tray_m_p = tray_menu_open
    prop ct_tray_s_p = 0 ~sp_calm
    follow ct_tray_s_p = tray_submenu_open

    //  Quick controls knobs & radial fill washes
    prop ct_q_knob.0 = 0 ~quick
    follow ct_q_knob.0 = music_frame_on
    prop ct_q_knob.1 = 0 ~quick
    follow ct_q_knob.1 = glass_on
    prop ct_q_knob.2 = 0 ~quick
    follow ct_q_knob.2 = bt_on
    prop ct_q_knob.3 = 0 ~quick
    follow ct_q_knob.3 = wall_auto

    prop ct_q_fill.0 = 0 ~sp_calm
    follow ct_q_fill.0 = music_frame_on
    prop ct_q_fill.1 = 0 ~sp_calm
    follow ct_q_fill.1 = glass_on
    prop ct_q_fill.2 = 0 ~sp_calm
    follow ct_q_fill.2 = bt_on
    prop ct_q_fill.3 = 0 ~sp_calm
    follow ct_q_fill.3 = wall_auto

    //  1-second hold-to-confirm state for Log out (0), Restart (1), Shut down (2)
    fact pw_d0 = false
    fact pw_s0 = 0
    fact pw_b0 = -10
    fact pw_h0 = -10
    prop pw_hp0 = 0 ~sp_calm
    follow pw_hp0 = if(pw_d0, clamp((ct_clk - pw_s0) / 1.0, 0, 1), 0)
    event pw_shatter0 ->

    fact pw_d1 = false
    fact pw_s1 = 0
    fact pw_b1 = -10
    fact pw_h1 = -10
    prop pw_hp1 = 0 ~sp_calm
    follow pw_hp1 = if(pw_d1, clamp((ct_clk - pw_s1) / 1.0, 0, 1), 0)
    event pw_shatter1 ->

    fact pw_d2 = false
    fact pw_s2 = 0
    fact pw_b2 = -10
    fact pw_h2 = -10
    prop pw_hp2 = 0 ~sp_calm
    follow pw_hp2 = if(pw_d2, clamp((ct_clk - pw_s2) / 1.0, 0, 1), 0)
    event pw_shatter2 ->

    //  Interactive Audio dial drag baseline
    fact aud_drag_y = 0
    fact aud_drag_v = 0

    //  Smoothed weather sky uniforms (supports hover preview over 4-day rows)
    let wx_cur_kind = if(wx_hv == 0, wx_daily.0.kind, if(wx_hv == 1, wx_daily.1.kind, if(wx_hv == 2, wx_daily.2.kind, if(wx_hv == 3, wx_daily.3.kind, wx_kind))))
    prop sk_cl = 0.25 ~sp_calm
    prop sk_rn = 0 ~sp_calm
    prop sk_sn = 0 ~sp_calm
    prop sk_fg = 0 ~sp_calm
    prop sk_st = 0 ~sp_calm
    prop sk_dl = 1 ~sp_calm
    prop sk_sun = 0.5 ~sp_calm
    follow sk_cl = if(wx_cur_kind == 0, 0.08, if(wx_cur_kind == 1, 0.45, if(wx_cur_kind == 2, 0.85, if(wx_cur_kind == 3, 0.65, 0.92))))
    follow sk_rn = if(wx_cur_kind == 4, 0.85, if(wx_cur_kind == 6, 0.90, 0))
    follow sk_sn = if(wx_cur_kind == 5, 0.85, 0)
    follow sk_fg = if(wx_cur_kind == 3, 0.85, 0)
    follow sk_st = if(wx_cur_kind == 6, 0.90, 0)
    follow sk_dl = if(wx_hv >= 0, 1, wx_dl)
    follow sk_sun = if(wx_hv >= 0, 0.55, wx_sun)

    //  Reactive tab & state transitions
    on change center_tab {
        ct_page: 0 ~10ms
        ct_page: 1 ~240ms after 10ms
        ct_sys_sc_to = 0
        ct_app_sc_to = 0
        ct_alert_exp = -1
        center_cal_hover = -1
        pw_d0 = false
        pw_d1 = false
        pw_d2 = false
    }
    on change center_open while center_open {
        ct_page: 0 ~10ms
        ct_page: 1 ~240ms after 10ms
        ct_tab_ld: center_tab
        ct_tab_tl: center_tab
        ct_app_sc_to = 0
        center_cal_hover = -1
        pw_d0 = false
        pw_d1 = false
        pw_d2 = false
    }
    on change center_open while not center_open {
        ct_app_sc_to = 0
        center_cal_hover = -1
        pw_d0 = false
        pw_d1 = false
        pw_d2 = false
    }
    on change center_cal_tick {
        center_cal_hover = -1
        ct_cal_slide: 0 ~10ms
        ct_cal_slide: 1 ~240ms after 10ms
    }
    on change ct_track_tick while center_open and (center_tab == 0 or center_tab == 3) {
        ct_track_pop: 0.88 ~10ms
        ct_track_pop: 1 ~320ms after 10ms
        emit ct_track_burst
    }
    on change center_sys_jump while center_sys_jump >= 0 {
        ct_sys_sc_to = pick(clamp(center_sys_jump, 0, 4), 0, 250, 0, 420, 220)
        center_sys_jump = -1
    }

    //  ── Shared Components ───────────────────────────────────────────────

    //  Dual-edge pinched GPU slider matching Settings > Theme > `slider_fill`.
    component CtSlider(x0: number, y: number, w: number, lv: number, hot: number, accent: color) {
        prop p_ld = 0 ~sp_lead
        prop p_tl = 0 ~sp_trail
        follow p_ld = clamp(lv, 0, 1)
        follow p_tl = clamp(lv, 0, 1)
        let h = 8
        let p_lo = min(p_ld, p_tl)
        let p_hi = max(p_ld, p_tl)
        let kx_lo = clamp(x0 + h * 0.5 + (w - h) * p_lo, x0 + h * 0.5, x0 + w - h * 0.5)
        let kx_hi = clamp(x0 + h * 0.5 + (w - h) * p_hi, x0 + h * 0.5, x0 + w - h * 0.5)
        let m = clamp(abs(p_ld - p_tl) * 3.5, 0, 1)
        let hh = h * (1 - 0.16 * m)
        let fr = if(hot > 0.02, ct_fr, 0)
        let jt = 0.25 + 0.35 * hot

        box { from: x0, y - 6; size: w, 12; corner: 6; color: ct.track; opacity: 86% }
        box { from: x0, y - 6; size: w, 12; corner: 6; stroke: 1; color: ink; opacity: 12% + 14% * hot }

        shader ct_hatch {
            at: x0 - 6, y - h
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), 3.4, hh * 0.9, jt, fr, 1.15, 0
            colors: accent
            opacity: 62% + 22% * hot
            show: slider_fill == 0 and p_hi > 0.008
        }
        shader ct_hatch {
            at: x0 - 5.6, y - h + 0.3
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), 3.4, hh * 0.9, jt, fr, 0.85, 1
            colors: accent
            opacity: 26% + 12% * hot
            show: slider_fill == 0 and p_hi > 0.008
        }
        shader ct_fill {
            at: x0 - 6, y - h
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), hh * 1.4, hh * 0.7, slider_fill, fr, jt, 1
            colors: accent
            opacity: 66% + 22% * hot
            show: slider_fill > 0 and p_hi > 0.008
        }

        let tw = max(6, kx_hi - kx_lo + 5)
        let th = 18 - 3 * m
        box { at: (kx_lo + kx_hi) / 2, y + 1; size: tw + 2, th + 2; corner: (th + 2) / 2; color: #000000; opacity: 30% }
        box { at: (kx_lo + kx_hi) / 2, y; size: tw, th; corner: th / 2; color: mix(ink, accent, 0.45 + 0.55 * hot); opacity: 94% }
    }

    component CtGlowArc(x: number, y: number, radius: number, span: number, rotate: number, width: number, accent: color) {
        arc { at: x, y; radius: radius; span: span; width: width + 9; color: mix(accent, ct.secondary, 0.36); opacity: 9%; rotate: rotate }
        arc { at: x, y; radius: radius; span: span; width: width + 4; color: mix(accent, ct.secondary, 0.22); opacity: 18%; rotate: rotate }
        arc { at: x, y; radius: radius; span: span; width: width; color: accent; opacity: 95%; rotate: rotate }
    }

    component CtTrayRow(r: record, open: number, sel: number, activate: event, menu: event) {
        group {
            size: 268, 50
            let chosen = open > 0 and sel == r.index
            let cy = if(r.has_sub, 16, 24)
            box { from: 0, 2; size: 268, 46; corner: 12; color: if(chosen, ct.primary, ink); opacity: if(chosen, 14%, 3% + 5% * tray_hit.hover) }
            box { from: 0, 2; size: 268, 46; corner: 12; stroke: 1; color: if(chosen, ct.primary, ink); opacity: if(chosen, 36%, 4% + 10% * tray_hit.hover) }
            box { from: 0, 12; size: 3, 26; corner: 1.5; color: if(mod(r.index, 2) == 0, ct.primary, ct.secondary); show: chosen }
            box { from: 10, 12; size: 28, 28; corner: 8; color: if(mod(r.index, 2) == 0, ct.primary, ct.secondary); opacity: 12%; show: not r.has_icon }
            image r.icon { at: 12, 13; size: 24, 24; fit: contain; show: r.has_icon }
            text r.name { at: 48, cy; anchor: left center; size: 12; weight: 600; color: if(chosen, ct.primary, ink); width: 174; lines: 1; family: "Space Grotesk" }
            text r.sub { at: 48, 32; anchor: left center; size: 9.5; color: faint; width: 174; lines: 1; show: r.has_sub; family: "Space Grotesk" }
            text "›" { at: 244, 25; anchor: center; size: 17; weight: 700; color: if(chosen, ct.primary, ct.secondary); opacity: if(chosen, 92%, 48%); family: "Space Grotesk" }
            zone box tray_hit { from: 0, 2; size: 268, 46; corner: 12; cursor: pointer; label: r.name }
            on press tray_hit { emit ui_sound; emit activate(r.index) }
            on hover tray_hit for 140ms { emit menu(r.index) }
            on press right tray_hit { emit ui_sound; emit menu(r.index) }
        }
    }

    component CtTrayMenuRow(r: record, sel: number, hover_ev: event, click_ev: event) {
        group {
            size: 388, if(r.separator, 12, 32)
            let on = sel == r.index and r.enabled and not r.separator
            line { from: 10, 6; to: 378, 6; width: 1; color: ink; opacity: 12%; show: r.separator }
            box { from: 0, 1; size: 388, 30; corner: 8; color: if(on, ct.primary, ink); opacity: if(on, 13%, 4% * hit.hover); show: not r.separator and r.enabled }
            text "✓" { at: 12, 16; anchor: left center; size: 10.5; weight: 700; color: ct.primary; show: not r.separator and r.checked; family: "Space Grotesk" }
            text r.label { at: if(r.checked, 28, 12), 16; anchor: left center; size: 11.5; weight: if(on, 600, 500); color: if(r.enabled, ink, faint); opacity: if(r.enabled, 96%, 45%); width: 326; lines: 1; show: not r.separator; family: "Space Grotesk" }
            text "›" { at: 370, 16; anchor: center; size: 14; weight: 700; color: if(on, ct.primary, ct.secondary); show: not r.separator and r.sub; family: "Space Grotesk" }
            zone box hit { from: 0, 1; size: 388, 30; corner: 8; cursor: pointer; active: not r.separator and r.enabled; label: r.label }
            on enter hit { emit hover_ev(r.index) }
            on press hit { emit ui_sound; emit click_ev(r.index) }
        }
    }

    component CtTraySubmenuRow(r: record, click_ev: event) {
        group {
            size: 264, if(r.separator, 12, 32)
            line { from: 8, 6; to: 256, 6; width: 1; color: ink; opacity: 12%; show: r.separator }
            box { from: 0, 1; size: 264, 30; corner: 8; color: ct.secondary; opacity: 10% * hit.hover; show: not r.separator and r.enabled }
            text "✓" { at: 10, 16; anchor: left center; size: 10.5; weight: 700; color: ct.secondary; show: not r.separator and r.checked; family: "Space Grotesk" }
            text r.label { at: if(r.checked, 26, 10), 16; anchor: left center; size: 11.5; color: if(r.enabled, ink, faint); opacity: if(r.enabled, 96%, 45%); width: 224; lines: 1; show: not r.separator; family: "Space Grotesk" }
            zone box hit { from: 0, 1; size: 264, 30; corner: 8; cursor: pointer; active: not r.separator and r.enabled; label: r.label }
            on press hit { emit ui_sound; emit click_ev(r.index) }
        }
    }

    //  ── Panel Container + Backdrop ───────────────────────────────────────
    zone box ct_shield { from: 0, 0; size: 1120, 720; active: center_open; label: "Centre panel" }
    on press ct_shield { center_open = center_open }
    clip inset 0 box { from: 0, 0; size: 1120, 720; corner: 26 }
    PanelBackdrop(0, 0, 1120, 720, 26)

    //  ── Header: Clock + 60s Tick Bar + Dual-Edge Jelly Tab Bar ──────────
    group {
        row ct_clock {
            at: 36, 40
            anchor: left center
            gap: 0
            align: end
            text "{floor(tick.hour / 10)}" { size: 30; weight: 700; color: ct.primary; family: "Space Grotesk" }
            text "{mod(tick.hour, 10)}"   { size: 30; weight: 700; color: ct.primary; family: "Space Grotesk" }
            text ":"                      { size: 30; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text "{floor(tick.minute / 10)}" { size: 30; weight: 700; color: ct.primary; family: "Space Grotesk" }
            text "{mod(tick.minute, 10)}"   { size: 30; weight: 700; color: ct.primary; family: "Space Grotesk" }
            space 2
            text "{floor(tick.second / 10)}" { size: 12; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text "{mod(tick.second, 10)}"   { size: 12; weight: 700; color: ct.secondary; family: "Space Grotesk" }
        }

        //  60-second linear pulse track below clock
        box { from: 36, 59; size: 120, 2; corner: 1; color: ink; opacity: 10% }
        let sec_w = max(2, 120 * clamp(tick.second / 59, 0, 1))
        body {
            gradient: 36, 60 to max(42, 36 + sec_w), 60, ct.primary, ct.secondary
            opacity: 82%
            box { from: 36, 59; size: sec_w, 2; corner: 1 }
        }
        ellipse { at: 36 + sec_w, 60; radius: 2.3; color: ct.secondary; opacity: 92% }

        row {
            at: 36, 76
            anchor: left center
            gap: 6
            text ct_header_date { size: 15; weight: 600; color: ct.primary; family: "Noto Sans CJK SC" }
            text "·"            { size: 15; color: ct.secondary; opacity: 55%; family: "Noto Sans CJK SC" }
            text ct_weekday     { size: 15; weight: 500; color: ct.secondary; family: "Noto Sans CJK SC" }
        }

        //  Page counter + Close button
        text number(center_tab + 1, 0, "0") { at: 1014, 44; anchor: right center; size: 11; weight: 700; color: ct.secondary; family: "Space Grotesk" }
        text "/ 07" { at: 1020, 44; anchor: left center; size: 10; color: faint; opacity: 60%; family: "Space Grotesk" }
        ellipse { at: 1076, 44; radius: 15; color: ink; opacity: 6% + 12% * ct_close.hover }
        ellipse { at: 1076, 44; radius: 15; stroke: 1; color: ink; opacity: 14% + 26% * ct_close.hover }
        line { from: 1071, 39; to: 1081, 49; width: 1.6; color: ink }
        line { from: 1081, 39; to: 1071, 49; width: 1.6; color: ink }
        zone box ct_close { from: 1058, 26; size: 36, 36; corner: 18; cursor: pointer; label: "Close centre panel" }
        on press ct_close { emit ui_sound; emit center_close }

        //  Dual-edge stretching tab pill
        let tb_l = ct.tab_x + min(ct_tab_ld, ct_tab_tl) * ct.tab_w + 2
        let tb_r = ct.tab_x + (max(ct_tab_ld, ct_tab_tl) + 1) * ct.tab_w - 2
        let tb_w = max(ct.tab_w - 4, tb_r - tb_l)
        shader ct_hatch {
            at: ct.tab_x, 26
            size: ct.tab_n * ct.tab_w, 38
            values: (tb_l - ct.tab_x) + 4, (tb_r - ct.tab_x) - 4, 3.6, 32, 0.25, 0, 0.9, 0
            colors: mix(ct.primary, ct.secondary, 0.32)
            opacity: 22%
            show: slider_fill == 0
        }
        shader ct_fill {
            at: ct.tab_x, 26
            size: ct.tab_n * ct.tab_w, 38
            values: (tb_l - ct.tab_x) + 2, (tb_r - ct.tab_x) - 2, 34, 17, slider_fill, 0, 0.25, 1
            colors: mix(ct.primary, ct.secondary, 0.32)
            opacity: 28%
            show: slider_fill > 0
        }
        box { from: tb_l, 26; size: tb_w, 38; corner: 19; stroke: 1.5; color: ct.secondary; opacity: 88% }

        repeat t in 0..7 {
            text pick(t, "OVERVIEW", "SYSTEM", "TRAY", "MEDIA", "AUDIO", "CALENDAR", "ACTIONS") {
                at: ct.tab_x + t * ct.tab_w + ct.tab_w / 2, 46; anchor: center; size: 10.5; weight: 700
                color: if(center_tab == t, ct.primary, faint); family: "Space Grotesk"
            }
            text number(t + 1, 0, "") {
                at: ct.tab_x + t * ct.tab_w + ct.tab_w - 7, 29; anchor: right top; size: 8.5; weight: 700
                color: if(center_tab == t, ct.primary, ct.secondary); opacity: if(center_tab == t, 95%, 52%); family: "Space Grotesk"
            }
            zone box ct_tab_hit.$t { from: ct.tab_x + t * ct.tab_w, 26; size: ct.tab_w, 38; corner: 19; cursor: pointer; role: tab; selected: center_tab == t; label: pick(t, "Overview", "System", "Tray", "Media", "Audio", "Calendar", "Actions") }
            on press ct_tab_hit.$t { ripple ct_tab_hit.$t; emit ui_sound; tray_menu_open = false; audio_pick_open = false; center_power_confirm = -1; center_tab = t; center_sys_scroll = 0 }
        }
        line { from: 28, 94; to: 1092, 94; width: 1; color: ink; opacity: 10% }
    }

    //  ── Directional Page Viewport ────────────────────────────────────────
    group {
        opacity: ct_page
        move: center_tab_dir * 22 * (1 - ct_page) * if(motion.reduced, 0, 1), 0
        blur: 3 * ct_modal_p

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 0 · OVERVIEW
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 0

            //  Top Row: 4 clickable Water Tanks (jump directly to System section)
            repeat q in 0..4 {
                let qx = 36 + q * 262
                let lv = clamp(pick(q, sys_cpu, sys_mem, sys_gpu, if(sys_mounts.count > 0, sys_mounts.0.pct, 0)), 0, 1)
                let fluid = if(q == 1 or q == 3, ct.secondary, ct.primary)
                box { from: qx, 114; size: 248, 128; corner: 18; color: ct.card2; opacity: 64% }
                shader ct_water {
                    at: qx, 114; size: 248, 128; corner: 18
                    values: lv, q * 0.85, ct_ov_stat.$q.hover, if(motion.reduced, 0, 1)
                    colors: if(q == 1 or q == 3, ct.secondary, ct.primary), mix(fluid, ct.primary, 0.35)
                }
                box { from: qx, 114; size: 248, 128; corner: 18; stroke: 1; color: if(ct_ov_stat.$q.hover > 0.4, fluid, ink); opacity: 10% + 26% * ct_ov_stat.$q.hover }
                text pick(q, "CPU", "MEMORY", "GPU", "DISK") { at: qx + 18, 134; anchor: left center; size: 9.5; weight: 700; color: faint; family: "Space Grotesk" }
                text pick(q, "", "", "", sys_mounts.0.name) { at: qx + 230, 134; anchor: right center; size: 9.5; weight: 700; color: fluid; show: q == 3 and sys_mounts.count > 0; family: "Space Grotesk" }
                text "System ›" { at: qx + 230, 134; anchor: right center; size: 9.5; weight: 700; color: fluid; opacity: ct_ov_stat.$q.hover; show: q < 3 or sys_mounts.count < 1; family: "Space Grotesk" }
                text number(lv * 100, 0, "%") { at: qx + 18, 174; anchor: left center; size: 32; weight: 700; color: ink; family: "Space Grotesk" }
                text pick(q, sys_cpu_meta, sys_mem_used, sys_gpu_temp, sys_mounts.0.info) { at: qx + 18, 222; anchor: left center; size: 10.5; color: faint; width: 212; lines: 1; family: "Space Grotesk" }
                zone box ct_ov_stat.$q { from: qx, 114; size: 248, 128; corner: 18; cursor: pointer; label: pick(q, "Jump to CPU", "Jump to Memory", "Jump to GPU", "Jump to Disk") }
                on press ct_ov_stat.$q { ripple ct_ov_stat.$q; emit ui_sound; center_sys_jump = q; center_tab = 1 }
            }

            //  Left-Mid: Now Playing Card (spinning mini-vinyl + circular art + real 18-bar spec.s)
            box { from: 36, 258; size: 524, 240; corner: 20; color: ct.card2; opacity: 64% }
            box { from: 36, 258; size: 524, 240; corner: 20; stroke: 1; color: ink; opacity: 10% }
            text "NOW PLAYING" { at: 56, 280; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text med.player { at: 540, 280; anchor: right center; size: 10; color: faint; opacity: 80%; family: "Space Grotesk" }

            //  Spinning mini-vinyl at (114, 366), radius 48
            group {
                pivot: 114, 366
                scale: ct_track_pop
                group {
                    pivot: 114, 366
                    rotate: ct_time * 36 * 1deg
                    ellipse { at: 114, 366; radius: 48; color: deep }
                    ellipse { at: 114, 366; radius: 48; stroke: 1.5; color: if(med.playing, ct.primary, ink); opacity: if(med.playing, 60%, 16%) }
                    ellipse { at: 114, 366; radius: 39; stroke: 0.9; color: ct.secondary; opacity: if(med.playing, 28%, 12%) }
                    ellipse { at: 114, 366; radius: 31; stroke: 0.8; color: ink; opacity: 10% }
                    group {
                        show: ct_art_on
                        clip box { from: 86, 338; size: 56, 56; corner: 28 }
                        image ct_art_img { at: 86, 338; size: 56, 56; fit: cover }
                    }
                    ellipse { at: 114, 366; radius: 22; color: ct.secondary; opacity: 24%; show: not ct_art_on }
                    ellipse { at: 114, 366; radius: 6; color: ct.card }
                    ellipse { at: 114, 366; radius: 6; stroke: 1.4; color: ink; opacity: 50% }
                }
            }

            text med.title { at: 184, 332; anchor: left top; size: 19; weight: 700; color: ink; width: 350; lines: 2; line_height: 1.15; show: ct_has_track; family: "Space Grotesk" }
            text med.artist { at: 184, 384; anchor: left center; size: 13; color: faint; width: 350; lines: 1; show: ct_has_track; family: "Space Grotesk" }
            text "Nothing playing" { at: 184, 356; anchor: left center; size: 18; weight: 700; color: faint; show: not ct_has_track; family: "Space Grotesk" }

            //  18-band real Cava spectrum along bottom left of Now Playing
            repeat b in 0..18 {
                let sv = clamp(pick(b, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17), 0, 1)
                let bh = 4 + 42 * if(med.playing, sv, 0.05)
                box { from: 56 + b * 14, 480 - bh; size: 9, bh; corner: 4.5; color: mix(ct.primary, ct.secondary, b / 17); opacity: if(med.playing, 88%, 25%) }
            }

            //  Transport controls
            ellipse { at: 416, 464; radius: 17; color: ink; opacity: 6% + 12% * ct_med_prev.hover }
            ellipse { at: 416, 464; radius: 17; stroke: 1; color: ct.secondary; opacity: 38% * ct_med_prev.hover }
            path { at: 416, 464; color: ink; move 4, -5; line -5, 0; line 4, 5; close }
            line { from: 410, 459; to: 410, 469; width: 1.8; color: ink }
            zone box ct_med_prev { from: 398, 446; size: 36, 36; corner: 18; cursor: pointer; label: "Previous track" }
            on press ct_med_prev { ripple ct_med_prev; emit ui_sound; emit center_media(0) }

            ellipse { at: 468, 464; radius: 24.5; stroke: 1.5; color: ct.secondary; opacity: 14% + 52% * ct_med_play.hover }
            ellipse { at: 468, 464; radius: 22; color: ct.primary; opacity: 88% + 12% * ct_med_play.hover }
            group { show: not med.playing; path { at: 469, 464; color: ct.card; move -5, -7; line 7, 0; line -5, 7; close } }
            group { show: med.playing; box { from: 462, 456; size: 4, 16; corner: 2; color: ct.card }; box { from: 471, 456; size: 4, 16; corner: 2; color: ct.card } }
            zone box ct_med_play { from: 444, 440; size: 48, 48; corner: 24; cursor: pointer; label: "Play or pause" }
            on press ct_med_play { ripple ct_med_play; emit ui_sound; emit center_media(1) }

            ellipse { at: 520, 464; radius: 17; color: ink; opacity: 6% + 12% * ct_med_next.hover }
            ellipse { at: 520, 464; radius: 17; stroke: 1; color: ct.secondary; opacity: 38% * ct_med_next.hover }
            path { at: 520, 464; color: ink; move -4, -5; line 5, 0; line -4, 5; close }
            line { from: 526, 459; to: 526, 469; width: 1.8; color: ink }
            zone box ct_med_next { from: 502, 446; size: 36, 36; corner: 18; cursor: pointer; label: "Next track" }
            on press ct_med_next { ripple ct_med_next; emit ui_sound; emit center_media(2) }

            //  Left-Bottom: Recent Alerts with inline dismiss (`×`) + expand body + All link
            box { from: 36, 514; size: 524, 160; corner: 20; color: ct.card2; opacity: 64% }
            box { from: 36, 514; size: 524, 160; corner: 20; stroke: 1; color: ink; opacity: 10% }
            text "RECENT ALERTS" { at: 56, 534; anchor: left center; size: 9.5; weight: 700; color: ct.primary; family: "Space Grotesk" }
            box { from: 488, 522; size: 54, 22; corner: 11; color: ct.secondary; opacity: 12% + 14% * ct_ov_alerts.hover }
            text "All ›" { at: 515, 533; anchor: center; size: 10.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            zone box ct_ov_alerts { from: 488, 522; size: 54, 22; corner: 11; cursor: pointer; label: "Open Notification Center" }
            on press ct_ov_alerts { emit ui_sound; emit ipc_open_notifications }

            repeat a in 0..3 {
                let ay = 550 + a * 38
                group {
                    show: a < nt_history.count
                    let is_exp = ct_alert_exp == a
                    box { from: 52, ay; size: 492, 34; corner: 10; color: ink; opacity: if(is_exp, 8%, 3% + 4% * ct_ov_al_row.$a.hover) }
                    box { from: 56, ay + 6; size: 2.5, 22; corner: 1.25; color: if(nt_history.$a.urgent, alert, if(mod(a, 2) == 0, ct.primary, ct.secondary)); opacity: 84% }
                    text nt_history.$a.app   { at: 68, ay + 11; anchor: left center; size: 9; weight: 700; color: ct.secondary; width: 140; lines: 1; family: "Space Grotesk" }
                    text nt_history.$a.when  { at: 504, ay + 11; anchor: right center; size: 8.5; color: faint; opacity: 75%; family: "Space Grotesk" }
                    text nt_history.$a.title { at: 68, ay + 24; anchor: left center; size: 11; weight: 600; color: ink; width: 426; lines: 1; show: not is_exp; family: "Space Grotesk" }
                    text nt_history.$a.body  { at: 68, ay + 24; anchor: left center; size: 10.5; color: faint; width: 426; lines: 1; show: is_exp; family: "Space Grotesk" }
                    zone box ct_ov_al_row.$a { from: 52, ay; size: 458, 34; corner: 10; cursor: pointer; label: nt_history.$a.title }
                    on press ct_ov_al_row.$a { emit ui_sound; ct_alert_exp = if(ct_alert_exp == a, -1, a) }

                    //  Dismiss button `×`
                    ellipse { at: 528, ay + 17; radius: 10; color: ink; opacity: 6% + 16% * ct_ov_al_x.$a.hover }
                    line { from: 524, ay + 13; to: 532, ay + 21; width: 1.3; color: faint }
                    line { from: 532, ay + 13; to: 524, ay + 21; width: 1.3; color: faint }
                    zone box ct_ov_al_x.$a { from: 514, ay + 3; size: 28, 28; corner: 14; cursor: pointer; label: "Dismiss alert" }
                    on press ct_ov_al_x.$a { emit ui_sound; ct_alert_exp = -1; emit nt_history_dismiss(a) }
                }
            }
            text "No alerts. The water is quiet." { at: 56, 594; anchor: left center; size: 12; color: faint; show: nt_history.count < 1; family: "Space Grotesk" }

            //  Right-Top: Network Card (`ct_netfx` + 30-column mirrored vector RX/TX histogram + click jump)
            box { from: 576, 258; size: 508, 128; corner: 20; color: ct.card2; opacity: 64% }
            box { from: 576, 258; size: 508, 128; corner: 20; stroke: 1; color: if(ct_ov_net.hover > 0.4, ct.secondary, ink); opacity: 10% + 22% * ct_ov_net.hover }
            text "NETWORK" { at: 596, 280; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text pick(sys_net_up, "OFFLINE", sys_iface) { at: 1064, 276; anchor: right center; size: 9.5; weight: 700; color: if(sys_net_up, faint, alert); family: "Space Grotesk" }
            text sys_ip { at: 1064, 290; anchor: right center; size: 8.5; color: faint; opacity: 75%; width: 190; lines: 1; family: "Space Grotesk" }

            text "DOWN" { at: 596, 308; anchor: left center; size: 8.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sys_rx_txt   { at: 596, 328; anchor: left center; size: 17; weight: 700; color: ct.primary; width: 120; lines: 1; family: "Space Grotesk" }
            text sys_rx_total { at: 596, 348; anchor: left center; size: 8.5; color: faint; width: 120; lines: 1; family: "Space Grotesk" }
            text "UP"   { at: 734, 308; anchor: left center; size: 8.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sys_tx_txt   { at: 734, 328; anchor: left center; size: 17; weight: 700; color: ct.secondary; width: 112; lines: 1; family: "Space Grotesk" }
            text sys_tx_total { at: 734, 348; anchor: left center; size: 8.5; color: faint; width: 112; lines: 1; family: "Space Grotesk" }

            //  Mirrored 30-sample vector RX/TX well (`x = 858..1064`, mid `y = 336`)
            box { from: 856, 302; size: 210, 68; corner: 10; color: deep; opacity: 38% }
            shader ct_netfx { at: 856, 302; size: 210, 68; values: if(sys_net_up, 1, 0), if(motion.reduced, 0, 1); colors: ct.primary, ct.secondary }
            line { from: 862, 336; to: 1060, 336; width: 1; color: ink; opacity: 14% }
            group {
                show: sys_hist_count > 0
                repeat n in 0..30 {
                    let nx = 864 + n * 6.5
                    let rh = 2 + 24 * clamp(sys_hist30.$n.rx, 0, 1)
                    let th = 2 + 24 * clamp(sys_hist30.$n.tx, 0, 1)
                    box { from: nx, 335 - rh; size: 4.5, rh; corner: 2; color: ct.primary; opacity: 88% }
                    box { from: nx, 337; size: 4.5, th; corner: 2; color: ct.secondary; opacity: 78% }
                }
            }
            zone box ct_ov_net { from: 576, 258; size: 508, 128; corner: 20; cursor: pointer; label: "Open System Network" }
            on press ct_ov_net { ripple ct_ov_net; emit ui_sound; center_sys_jump = 4; center_tab = 1 }

            //  Right-Bottom: Live Sky Weather Card (sky.wgsl + 24h Bezier + 4-day interactive preview)
            box { from: 576, 400; size: 508, 274; corner: 20; color: ct.card2; opacity: 64% }
            group {
                clip box { from: 577, 401; size: 506, 272; corner: 19 }
                let sky_pack = clamp(wx_wind_n / 30, 0, 1) * wx_wdir
                shader ct_sky {
                    at: 577, 401; size: 506, 272
                    values: sk_cl, sk_rn, sk_sn, floor(clamp(sk_fg, 0, 1) * 999) + clamp(sk_st, 0, 0.999), ct_sky_t, sk_dl, floor(clamp(sk_sun, 0, 1) * 1000) + clamp(wx_moon, 0, 0.999), sky_pack
                    colors: ct.primary, ink
                    opacity: 90%
                    show: wx_ready
                }
            }
            box { from: 576, 400; size: 508, 274; corner: 20; stroke: 1; color: ink; opacity: 14% }

            //  City + Settings gear button
            ellipse { at: 602, 422; radius: 4; stroke: 1.6; color: ink; opacity: 88% }
            text if(wx_configured, wx_city, "Weather city not set") { at: 614, 422; anchor: left center; size: 12.5; weight: 700; color: ink; width: 210; lines: 1; family: "Space Grotesk" }
            box { from: 1038, 410; size: 28, 24; corner: 12; color: deep; opacity: 42% + 22% * ct_ov_weather.hover }
            ellipse { at: 1052, 422; radius: 4.5; stroke: 1.4; color: ink }
            zone box ct_ov_weather { from: 1036, 408; size: 32, 28; corner: 14; cursor: pointer; label: "Configure weather city" }
            on press ct_ov_weather { emit ui_sound; emit ipc_open_settings(9) }

            //  Not configured / not ready prompt
            group {
                show: not wx_ready
                text if(wx_configured, wx_status, "Click gear or open Settings > Weather to pick a city.") {
                    at: 830, 536; anchor: center; size: 12.5; color: faint; width: 420; lines: 2; align: center; family: "Space Grotesk"
                }
            }

            //  Weather live content (`wx_ready`)
            group {
                show: wx_ready
                zone box ct_wx_hr_z { from: 592, 536; size: 242, 74; corner: 12; label: "Scrub 24h forecast" }
                let dhr_k = if(ct_wx_hr_z.hover > 0.5, clamp(round((pointer.x - ct.px - 600) / 224 * 24), 0, 24), -1)

                //  Big temperature + condition (previews hovered 4-day card or 24h scrub point!)
                text wx_temp { at: 596, 464; anchor: left center; size: 42; weight: 700; color: ink; show: wx_hv < 0 and dhr_k < 0; family: "Space Grotesk" }
                text wx_daily[clamp(wx_hv, 0, 3)].hi { at: 596, 464; anchor: left center; size: 42; weight: 700; color: ink; show: wx_hv >= 0; family: "Space Grotesk" }
                text wx_hrs[clamp(dhr_k, 0, max(0, wx_hrs_count - 1))].deg { at: 596, 464; anchor: left center; size: 42; weight: 700; color: ct.primary; show: wx_hv < 0 and dhr_k >= 0 and wx_hrs_count >= 25; family: "Space Grotesk" }

                text wx_desc { at: 696, 452; anchor: left center; size: 13.5; weight: 700; color: ink; width: 150; lines: 1; show: wx_hv < 0 and dhr_k < 0; family: "Space Grotesk" }
                text wx_daily[clamp(wx_hv, 0, 3)].desc { at: 696, 452; anchor: left center; size: 13.5; weight: 700; color: ink; width: 150; lines: 1; show: wx_hv >= 0; family: "Space Grotesk" }
                text wx_hrs[clamp(dhr_k, 0, max(0, wx_hrs_count - 1))].label { at: 696, 452; anchor: left center; size: 13.5; weight: 700; color: ct.secondary; width: 150; lines: 1; show: wx_hv < 0 and dhr_k >= 0 and wx_hrs_count >= 25; family: "Space Grotesk" }

                text wx_feels .. " · " .. wx_humidity { at: 696, 472; anchor: left center; size: 11; color: ink; opacity: 82%; width: 154; lines: 1; show: wx_hv < 0; family: "Space Grotesk" }
                text wx_daily[clamp(wx_hv, 0, 3)].day { at: 696, 472; anchor: left center; size: 11; color: ct.secondary; width: 154; lines: 1; show: wx_hv >= 0; family: "Space Grotesk" }
                text wx_hi .. "  " .. wx_lo .. "  ·  " .. wx_wind { at: 596, 502; anchor: left center; size: 11; weight: 600; color: ink; opacity: 80%; width: 252; lines: 1; family: "Space Grotesk" }

                //  24h Midpoint Quadratic Bezier Temperature Curve (`x = 600..824`, `dx = 224/24`, baseline `y = 594`, amplitude `28`)
                group {
                    show: wx_hrs_count >= 25
                    let x0 = 600
                    let dx = 224 / 24
                    let sp = max(1, wx_hhi - wx_hlo)
                    let yb = 594
                    box { from: 592, 536; size: 242, 74; corner: 12; color: deep; opacity: 32% }
                    path {
                        at: 0, 0; color: ct.secondary; opacity: 20%
                        move x0, yb + 10
                        line x0, yb - 28 * (wx_hrs.0.t - wx_hlo) / sp
                        curve x0 + 1.5  * dx, yb - 14 * (wx_hrs.1.t  + wx_hrs.2.t  - 2 * wx_hlo) / sp via x0 + 1  * dx, yb - 28 * (wx_hrs.1.t  - wx_hlo) / sp
                        curve x0 + 2.5  * dx, yb - 14 * (wx_hrs.2.t  + wx_hrs.3.t  - 2 * wx_hlo) / sp via x0 + 2  * dx, yb - 28 * (wx_hrs.2.t  - wx_hlo) / sp
                        curve x0 + 3.5  * dx, yb - 14 * (wx_hrs.3.t  + wx_hrs.4.t  - 2 * wx_hlo) / sp via x0 + 3  * dx, yb - 28 * (wx_hrs.3.t  - wx_hlo) / sp
                        curve x0 + 4.5  * dx, yb - 14 * (wx_hrs.4.t  + wx_hrs.5.t  - 2 * wx_hlo) / sp via x0 + 4  * dx, yb - 28 * (wx_hrs.4.t  - wx_hlo) / sp
                        curve x0 + 5.5  * dx, yb - 14 * (wx_hrs.5.t  + wx_hrs.6.t  - 2 * wx_hlo) / sp via x0 + 5  * dx, yb - 28 * (wx_hrs.5.t  - wx_hlo) / sp
                        curve x0 + 6.5  * dx, yb - 14 * (wx_hrs.6.t  + wx_hrs.7.t  - 2 * wx_hlo) / sp via x0 + 6  * dx, yb - 28 * (wx_hrs.6.t  - wx_hlo) / sp
                        curve x0 + 7.5  * dx, yb - 14 * (wx_hrs.7.t  + wx_hrs.8.t  - 2 * wx_hlo) / sp via x0 + 7  * dx, yb - 28 * (wx_hrs.7.t  - wx_hlo) / sp
                        curve x0 + 8.5  * dx, yb - 14 * (wx_hrs.8.t  + wx_hrs.9.t  - 2 * wx_hlo) / sp via x0 + 8  * dx, yb - 28 * (wx_hrs.8.t  - wx_hlo) / sp
                        curve x0 + 9.5  * dx, yb - 14 * (wx_hrs.9.t  + wx_hrs.10.t - 2 * wx_hlo) / sp via x0 + 9  * dx, yb - 28 * (wx_hrs.9.t  - wx_hlo) / sp
                        curve x0 + 10.5 * dx, yb - 14 * (wx_hrs.10.t + wx_hrs.11.t - 2 * wx_hlo) / sp via x0 + 10 * dx, yb - 28 * (wx_hrs.10.t - wx_hlo) / sp
                        curve x0 + 11.5 * dx, yb - 14 * (wx_hrs.11.t + wx_hrs.12.t - 2 * wx_hlo) / sp via x0 + 11 * dx, yb - 28 * (wx_hrs.11.t - wx_hlo) / sp
                        curve x0 + 12.5 * dx, yb - 14 * (wx_hrs.12.t + wx_hrs.13.t - 2 * wx_hlo) / sp via x0 + 12 * dx, yb - 28 * (wx_hrs.12.t - wx_hlo) / sp
                        curve x0 + 13.5 * dx, yb - 14 * (wx_hrs.13.t + wx_hrs.14.t - 2 * wx_hlo) / sp via x0 + 13 * dx, yb - 28 * (wx_hrs.13.t - wx_hlo) / sp
                        curve x0 + 14.5 * dx, yb - 14 * (wx_hrs.14.t + wx_hrs.15.t - 2 * wx_hlo) / sp via x0 + 14 * dx, yb - 28 * (wx_hrs.14.t - wx_hlo) / sp
                        curve x0 + 15.5 * dx, yb - 14 * (wx_hrs.15.t + wx_hrs.16.t - 2 * wx_hlo) / sp via x0 + 15 * dx, yb - 28 * (wx_hrs.15.t - wx_hlo) / sp
                        curve x0 + 16.5 * dx, yb - 14 * (wx_hrs.16.t + wx_hrs.17.t - 2 * wx_hlo) / sp via x0 + 16 * dx, yb - 28 * (wx_hrs.16.t - wx_hlo) / sp
                        curve x0 + 17.5 * dx, yb - 14 * (wx_hrs.17.t + wx_hrs.18.t - 2 * wx_hlo) / sp via x0 + 17 * dx, yb - 28 * (wx_hrs.17.t - wx_hlo) / sp
                        curve x0 + 18.5 * dx, yb - 14 * (wx_hrs.18.t + wx_hrs.19.t - 2 * wx_hlo) / sp via x0 + 18 * dx, yb - 28 * (wx_hrs.18.t - wx_hlo) / sp
                        curve x0 + 19.5 * dx, yb - 14 * (wx_hrs.19.t + wx_hrs.20.t - 2 * wx_hlo) / sp via x0 + 19 * dx, yb - 28 * (wx_hrs.19.t - wx_hlo) / sp
                        curve x0 + 20.5 * dx, yb - 14 * (wx_hrs.20.t + wx_hrs.21.t - 2 * wx_hlo) / sp via x0 + 20 * dx, yb - 28 * (wx_hrs.20.t - wx_hlo) / sp
                        curve x0 + 21.5 * dx, yb - 14 * (wx_hrs.21.t + wx_hrs.22.t - 2 * wx_hlo) / sp via x0 + 21 * dx, yb - 28 * (wx_hrs.21.t - wx_hlo) / sp
                        curve x0 + 22.5 * dx, yb - 14 * (wx_hrs.22.t + wx_hrs.23.t - 2 * wx_hlo) / sp via x0 + 22 * dx, yb - 28 * (wx_hrs.22.t - wx_hlo) / sp
                        curve x0 + 23.5 * dx, yb - 14 * (wx_hrs.23.t + wx_hrs.24.t - 2 * wx_hlo) / sp via x0 + 23 * dx, yb - 28 * (wx_hrs.23.t - wx_hlo) / sp
                        line x0 + 24 * dx, yb - 28 * (wx_hrs.24.t - wx_hlo) / sp
                        line x0 + 24 * dx, yb + 10
                        close
                    }
                    path {
                        at: 0, 0; stroke: 2.0; color: ct.primary; opacity: 96%
                        move x0, yb - 28 * (wx_hrs.0.t - wx_hlo) / sp
                        curve x0 + 1.5  * dx, yb - 14 * (wx_hrs.1.t  + wx_hrs.2.t  - 2 * wx_hlo) / sp via x0 + 1  * dx, yb - 28 * (wx_hrs.1.t  - wx_hlo) / sp
                        curve x0 + 2.5  * dx, yb - 14 * (wx_hrs.2.t  + wx_hrs.3.t  - 2 * wx_hlo) / sp via x0 + 2  * dx, yb - 28 * (wx_hrs.2.t  - wx_hlo) / sp
                        curve x0 + 3.5  * dx, yb - 14 * (wx_hrs.3.t  + wx_hrs.4.t  - 2 * wx_hlo) / sp via x0 + 3  * dx, yb - 28 * (wx_hrs.3.t  - wx_hlo) / sp
                        curve x0 + 4.5  * dx, yb - 14 * (wx_hrs.4.t  + wx_hrs.5.t  - 2 * wx_hlo) / sp via x0 + 4  * dx, yb - 28 * (wx_hrs.4.t  - wx_hlo) / sp
                        curve x0 + 5.5  * dx, yb - 14 * (wx_hrs.5.t  + wx_hrs.6.t  - 2 * wx_hlo) / sp via x0 + 5  * dx, yb - 28 * (wx_hrs.5.t  - wx_hlo) / sp
                        curve x0 + 6.5  * dx, yb - 14 * (wx_hrs.6.t  + wx_hrs.7.t  - 2 * wx_hlo) / sp via x0 + 6  * dx, yb - 28 * (wx_hrs.6.t  - wx_hlo) / sp
                        curve x0 + 7.5  * dx, yb - 14 * (wx_hrs.7.t  + wx_hrs.8.t  - 2 * wx_hlo) / sp via x0 + 7  * dx, yb - 28 * (wx_hrs.7.t  - wx_hlo) / sp
                        curve x0 + 8.5  * dx, yb - 14 * (wx_hrs.8.t  + wx_hrs.9.t  - 2 * wx_hlo) / sp via x0 + 8  * dx, yb - 28 * (wx_hrs.8.t  - wx_hlo) / sp
                        curve x0 + 9.5  * dx, yb - 14 * (wx_hrs.9.t  + wx_hrs.10.t - 2 * wx_hlo) / sp via x0 + 9  * dx, yb - 28 * (wx_hrs.9.t  - wx_hlo) / sp
                        curve x0 + 10.5 * dx, yb - 14 * (wx_hrs.10.t + wx_hrs.11.t - 2 * wx_hlo) / sp via x0 + 10 * dx, yb - 28 * (wx_hrs.10.t - wx_hlo) / sp
                        curve x0 + 11.5 * dx, yb - 14 * (wx_hrs.11.t + wx_hrs.12.t - 2 * wx_hlo) / sp via x0 + 11 * dx, yb - 28 * (wx_hrs.11.t - wx_hlo) / sp
                        curve x0 + 12.5 * dx, yb - 14 * (wx_hrs.12.t + wx_hrs.13.t - 2 * wx_hlo) / sp via x0 + 12 * dx, yb - 28 * (wx_hrs.12.t - wx_hlo) / sp
                        curve x0 + 13.5 * dx, yb - 14 * (wx_hrs.13.t + wx_hrs.14.t - 2 * wx_hlo) / sp via x0 + 13 * dx, yb - 28 * (wx_hrs.13.t - wx_hlo) / sp
                        curve x0 + 14.5 * dx, yb - 14 * (wx_hrs.14.t + wx_hrs.15.t - 2 * wx_hlo) / sp via x0 + 14 * dx, yb - 28 * (wx_hrs.14.t - wx_hlo) / sp
                        curve x0 + 15.5 * dx, yb - 14 * (wx_hrs.15.t + wx_hrs.16.t - 2 * wx_hlo) / sp via x0 + 15 * dx, yb - 28 * (wx_hrs.15.t - wx_hlo) / sp
                        curve x0 + 16.5 * dx, yb - 14 * (wx_hrs.16.t + wx_hrs.17.t - 2 * wx_hlo) / sp via x0 + 16 * dx, yb - 28 * (wx_hrs.16.t - wx_hlo) / sp
                        curve x0 + 17.5 * dx, yb - 14 * (wx_hrs.17.t + wx_hrs.18.t - 2 * wx_hlo) / sp via x0 + 17 * dx, yb - 28 * (wx_hrs.17.t - wx_hlo) / sp
                        curve x0 + 18.5 * dx, yb - 14 * (wx_hrs.18.t + wx_hrs.19.t - 2 * wx_hlo) / sp via x0 + 18 * dx, yb - 28 * (wx_hrs.18.t - wx_hlo) / sp
                        curve x0 + 19.5 * dx, yb - 14 * (wx_hrs.19.t + wx_hrs.20.t - 2 * wx_hlo) / sp via x0 + 19 * dx, yb - 28 * (wx_hrs.19.t - wx_hlo) / sp
                        curve x0 + 20.5 * dx, yb - 14 * (wx_hrs.20.t + wx_hrs.21.t - 2 * wx_hlo) / sp via x0 + 20 * dx, yb - 28 * (wx_hrs.20.t - wx_hlo) / sp
                        curve x0 + 21.5 * dx, yb - 14 * (wx_hrs.21.t + wx_hrs.22.t - 2 * wx_hlo) / sp via x0 + 21 * dx, yb - 28 * (wx_hrs.21.t - wx_hlo) / sp
                        curve x0 + 22.5 * dx, yb - 14 * (wx_hrs.22.t + wx_hrs.23.t - 2 * wx_hlo) / sp via x0 + 22 * dx, yb - 28 * (wx_hrs.22.t - wx_hlo) / sp
                        curve x0 + 23.5 * dx, yb - 14 * (wx_hrs.23.t + wx_hrs.24.t - 2 * wx_hlo) / sp via x0 + 23 * dx, yb - 28 * (wx_hrs.23.t - wx_hlo) / sp
                        line x0 + 24 * dx, yb - 28 * (wx_hrs.24.t - wx_hlo) / sp
                    }

                    //  Interactive scrub marker along 24h curve
                    let sk_k = clamp(dhr_k, 0, 24)
                    let sk_y = yb - 28 * (wx_hrs[sk_k].t - wx_hlo) / sp
                    line { from: x0 + sk_k * dx, 540; to: x0 + sk_k * dx, 606; width: 1.2; color: ct.secondary; opacity: 62%; show: dhr_k >= 0 }
                    ellipse { at: x0 + sk_k * dx, sk_y; radius: 4; color: ct.primary; show: dhr_k >= 0 }

                    text "24h" { at: 600, 622; anchor: left center; size: 9.5; weight: 700; color: ink; opacity: 65%; family: "Space Grotesk" }
                    text "hover curve" { at: 826, 622; anchor: right center; size: 9.5; color: faint; opacity: 75%; show: dhr_k < 0; family: "Space Grotesk" }
                    text wx_hrs[sk_k].label .. " · " .. wx_hrs[sk_k].deg { at: 826, 622; anchor: right center; size: 10; weight: 700; color: ct.primary; show: dhr_k >= 0; family: "Space Grotesk" }
                }

                //  4-Day Forecast Card with Relative Temperature Range Bars & Sky Hover Preview
                let w_sp = max(1, wx_whi - wx_wlo)
                box { from: 850, 444; size: 222, 214; corner: 14; color: deep; opacity: 42% }
                box { from: 850, 444; size: 222, 214; corner: 14; stroke: 1; color: ink; opacity: 12% }
                repeat d in 0..4 {
                    let ry = 456 + d * 48
                    group {
                        show: d < wx_daily.count
                        let x_lo = 940 + 74 * clamp((wx_daily.$d.lo_n - wx_wlo) / w_sp, 0, 1)
                        let x_hi = 940 + 74 * clamp((wx_daily.$d.hi_n - wx_wlo) / w_sp, 0, 1)
                        box { from: 856, ry; size: 210, 42; corner: 10; color: ct.secondary; opacity: if(wx_hv == d, 18%, 0%) }
                        text wx_daily.$d.day { at: 866, ry + 21; anchor: left center; size: 11; weight: 700; color: ink; width: 44; lines: 1; family: "Space Grotesk" }
                        text wx_daily.$d.lo  { at: 936, ry + 21; anchor: right center; size: 10.5; color: ct.secondary; opacity: 88%; family: "Space Grotesk" }
                        box { from: 940, ry + 18.5; size: 74, 5; corner: 2.5; color: ink; opacity: 14% }
                        body { gradient: x_lo, ry + 21 to max(x_lo + 6, x_hi), ry + 21, ct.secondary, ct.primary; box { from: x_lo, ry + 18.5; size: max(6, x_hi - x_lo), 5; corner: 2.5 } }
                        text wx_daily.$d.hi  { at: 1058, ry + 21; anchor: right center; size: 11.5; weight: 700; color: ct.primary; family: "Space Grotesk" }
                        zone box ct_wx_d.$d { from: 856, ry; size: 210, 42; corner: 10; cursor: pointer; label: wx_daily.$d.day }
                        on enter ct_wx_d.$d { wx_hv = d }
                        on leave ct_wx_d.$d { wx_hv = -1 }
                    }
                }
                text wx_updated { at: 596, 654; anchor: left center; size: 9.5; color: ink; opacity: 62%; family: "Space Grotesk" }
            }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 1 · SYSTEM (manual scroll + jump + vector paths + sortable procs)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 1
            let sys.vh = 518
            let sys.ch = 1044
            let sys.max_s = max(1, sys.ch - sys.vh)
            let sys.sc = clamp(ct_sys_sc, 0, sys.max_s)
            let sys.off = floor(sys.sc + 0.5)
            let sys.cue = clamp((sys.max_s - sys.sc) / 36, 0, 1) * clamp(1 - sys.sc / 18, 0, 1)
            let sys.th = max(48, sys.vh * min(1, sys.vh / sys.ch))

            text "SYSTEM MONITOR" { at: 36, 118; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text sys_host { at: 36, 138; anchor: left center; size: 14; weight: 700; color: ink; family: "Space Grotesk" }
            text sys_cpu_name { at: 260, 138; anchor: left center; size: 11.5; color: faint; width: 520; lines: 1; family: "Space Grotesk"; selectable: true }
            text sys_uptime { at: 1084, 138; anchor: right center; size: 11; weight: 600; color: ct.primary; family: "Space Grotesk" }

            group {
                clip box { from: 36, 152; size: 1042, 518 }
                zone box ct_sys_wheel { from: 36, 152; size: 1042, 518 }
                on scroll ct_sys_wheel { ct_sys_sc_to = clamp(ct_sys_sc_to - wheel * 54, 0, sys.max_s) }

                group {
                    move: 0, -sys.off

                    //  ── LEFT COLUMN (x = 36, w = 508): CPU / MEMORY / TEMPS ──
                    //  CPU Card (`y = 156..414`)
                    box { from: 36, 156; size: 508, 258; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 36, 156; size: 508, 258; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "CPU" { at: 54, 178; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }
                    text sys_cpu_meta { at: 526, 178; anchor: right center; size: 10.5; color: faint; width: 320; lines: 1; align: right; family: "Space Grotesk" }
                    CtGlowArc(110, 240, 42, 360 * max(0.004, sys_cpu) * 1deg, 180 * sys_cpu * 1deg, 8, mix(ct.primary, alert, clamp((sys_cpu - 0.8) / 0.2, 0, 1)))
                    text sys_cpu_txt { at: 110, 236; anchor: center; size: 26; weight: 700; color: ink; family: "Space Grotesk" }
                    text sys_load    { at: 110, 294; anchor: center; size: 9.5; color: faint; family: "Space Grotesk" }
                    text sys_threads { at: 110, 310; anchor: center; size: 9; color: faint; opacity: 75%; family: "Space Grotesk" }

                    //  CPU Vector History Chart (`x = 172..524`, `y = 200..268`, baseline `y = 264`, h = `60`)
                    box { from: 168, 198; size: 360, 72; corner: 12; color: deep; opacity: 38% }
                    group {
                        show: sys_hist_count > 0
                        let cx0 = 174
                        let cdx = 348 / 29
                        let cyb = 264
                        let cpu_col = mix(ct.primary, alert, clamp((sys_cpu - 0.78) / 0.22, 0, 1))
                        path {
                            at: 0, 0; color: cpu_col; opacity: 18%
                            move cx0, cyb
                            line cx0, cyb - 60 * sys_hist30.0.cpu
                            line cx0 +  1 * cdx, cyb - 60 * sys_hist30.1.cpu
                            line cx0 +  2 * cdx, cyb - 60 * sys_hist30.2.cpu
                            line cx0 +  3 * cdx, cyb - 60 * sys_hist30.3.cpu
                            line cx0 +  4 * cdx, cyb - 60 * sys_hist30.4.cpu
                            line cx0 +  5 * cdx, cyb - 60 * sys_hist30.5.cpu
                            line cx0 +  6 * cdx, cyb - 60 * sys_hist30.6.cpu
                            line cx0 +  7 * cdx, cyb - 60 * sys_hist30.7.cpu
                            line cx0 +  8 * cdx, cyb - 60 * sys_hist30.8.cpu
                            line cx0 +  9 * cdx, cyb - 60 * sys_hist30.9.cpu
                            line cx0 + 10 * cdx, cyb - 60 * sys_hist30.10.cpu
                            line cx0 + 11 * cdx, cyb - 60 * sys_hist30.11.cpu
                            line cx0 + 12 * cdx, cyb - 60 * sys_hist30.12.cpu
                            line cx0 + 13 * cdx, cyb - 60 * sys_hist30.13.cpu
                            line cx0 + 14 * cdx, cyb - 60 * sys_hist30.14.cpu
                            line cx0 + 15 * cdx, cyb - 60 * sys_hist30.15.cpu
                            line cx0 + 16 * cdx, cyb - 60 * sys_hist30.16.cpu
                            line cx0 + 17 * cdx, cyb - 60 * sys_hist30.17.cpu
                            line cx0 + 18 * cdx, cyb - 60 * sys_hist30.18.cpu
                            line cx0 + 19 * cdx, cyb - 60 * sys_hist30.19.cpu
                            line cx0 + 20 * cdx, cyb - 60 * sys_hist30.20.cpu
                            line cx0 + 21 * cdx, cyb - 60 * sys_hist30.21.cpu
                            line cx0 + 22 * cdx, cyb - 60 * sys_hist30.22.cpu
                            line cx0 + 23 * cdx, cyb - 60 * sys_hist30.23.cpu
                            line cx0 + 24 * cdx, cyb - 60 * sys_hist30.24.cpu
                            line cx0 + 25 * cdx, cyb - 60 * sys_hist30.25.cpu
                            line cx0 + 26 * cdx, cyb - 60 * sys_hist30.26.cpu
                            line cx0 + 27 * cdx, cyb - 60 * sys_hist30.27.cpu
                            line cx0 + 28 * cdx, cyb - 60 * sys_hist30.28.cpu
                            line cx0 + 29 * cdx, cyb - 60 * sys_hist30.29.cpu
                            line cx0 + 29 * cdx, cyb
                            close
                        }
                        path {
                            at: 0, 0; stroke: 2; color: cpu_col; opacity: 94%
                            move cx0, cyb - 60 * sys_hist30.0.cpu
                            line cx0 +  1 * cdx, cyb - 60 * sys_hist30.1.cpu
                            line cx0 +  2 * cdx, cyb - 60 * sys_hist30.2.cpu
                            line cx0 +  3 * cdx, cyb - 60 * sys_hist30.3.cpu
                            line cx0 +  4 * cdx, cyb - 60 * sys_hist30.4.cpu
                            line cx0 +  5 * cdx, cyb - 60 * sys_hist30.5.cpu
                            line cx0 +  6 * cdx, cyb - 60 * sys_hist30.6.cpu
                            line cx0 +  7 * cdx, cyb - 60 * sys_hist30.7.cpu
                            line cx0 +  8 * cdx, cyb - 60 * sys_hist30.8.cpu
                            line cx0 +  9 * cdx, cyb - 60 * sys_hist30.9.cpu
                            line cx0 + 10 * cdx, cyb - 60 * sys_hist30.10.cpu
                            line cx0 + 11 * cdx, cyb - 60 * sys_hist30.11.cpu
                            line cx0 + 12 * cdx, cyb - 60 * sys_hist30.12.cpu
                            line cx0 + 13 * cdx, cyb - 60 * sys_hist30.13.cpu
                            line cx0 + 14 * cdx, cyb - 60 * sys_hist30.14.cpu
                            line cx0 + 15 * cdx, cyb - 60 * sys_hist30.15.cpu
                            line cx0 + 16 * cdx, cyb - 60 * sys_hist30.16.cpu
                            line cx0 + 17 * cdx, cyb - 60 * sys_hist30.17.cpu
                            line cx0 + 18 * cdx, cyb - 60 * sys_hist30.18.cpu
                            line cx0 + 19 * cdx, cyb - 60 * sys_hist30.19.cpu
                            line cx0 + 20 * cdx, cyb - 60 * sys_hist30.20.cpu
                            line cx0 + 21 * cdx, cyb - 60 * sys_hist30.21.cpu
                            line cx0 + 22 * cdx, cyb - 60 * sys_hist30.22.cpu
                            line cx0 + 23 * cdx, cyb - 60 * sys_hist30.23.cpu
                            line cx0 + 24 * cdx, cyb - 60 * sys_hist30.24.cpu
                            line cx0 + 25 * cdx, cyb - 60 * sys_hist30.25.cpu
                            line cx0 + 26 * cdx, cyb - 60 * sys_hist30.26.cpu
                            line cx0 + 27 * cdx, cyb - 60 * sys_hist30.27.cpu
                            line cx0 + 28 * cdx, cyb - 60 * sys_hist30.28.cpu
                            line cx0 + 29 * cdx, cyb - 60 * sys_hist30.29.cpu
                        }
                    }

                    //  Per-core vertical bar grid
                    let ct.core_3row = sys_cores.count > 16
                    let ct.core_rh = if(ct.core_3row, 28, 36)
                    let ct.core_bh = if(ct.core_3row, 22, 28)
                    let ct.core_y0 = if(ct.core_3row, 322, 332)
                    repeat c in 0..24 {
                        let cc = mod(c, 8)
                        let cr = floor(c / 8)
                        let cxx = 188 + cc * 44
                        let cyy = ct.core_y0 + cr * ct.core_rh
                        let ch = max(2, ct.core_bh * clamp(sys_cores.$c.pct, 0, 1))
                        box { from: cxx - 18, cyy - ct.core_bh / 2; size: 36, ct.core_bh; corner: 5; color: ink; opacity: 6%; show: c < sys_cores.count }
                        box { from: cxx - 18, cyy + ct.core_bh / 2 - ch; size: 36, ch; corner: 5; color: mix(ct.secondary, alert, clamp((sys_cores.$c.pct - 0.75) / 0.25, 0, 1)); opacity: 74%; show: c < sys_cores.count }
                        text number(sys_cores.$c.pct * 100, 0, "") { at: cxx, cyy; anchor: center; size: 8; weight: 600; color: ink; opacity: 90%; show: c < sys_cores.count; family: "Space Grotesk" }
                    }

                    //  Memory Card (`y = 428..648`)
                    box { from: 36, 428; size: 508, 220; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 36, 428; size: 508, 220; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "MEMORY" { at: 54, 450; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                    text sys_mem_total { at: 526, 450; anchor: right center; size: 11; color: faint; family: "Space Grotesk" }
                    CtGlowArc(110, 514, 38, 360 * max(0.004, sys_mem) * 1deg, 180 * max(0.004, sys_mem) * 1deg, 9, mix(ct.secondary, alert, clamp((sys_mem - 0.85) / 0.15, 0, 1)))
                    text sys_mem_pct { at: 110, 510; anchor: center; size: 24; weight: 700; color: ink; family: "Space Grotesk" }
                    text "Used"  { at: 174, 480; anchor: left center; size: 10; color: faint; family: "Space Grotesk" }
                    text sys_mem_used  { at: 320, 480; anchor: right center; size: 11.5; weight: 700; color: ink; family: "Space Grotesk" }
                    text "Cache" { at: 174, 504; anchor: left center; size: 10; color: faint; family: "Space Grotesk" }
                    text sys_mem_cache { at: 320, 504; anchor: right center; size: 11.5; weight: 700; color: ink; family: "Space Grotesk" }
                    text "Free"  { at: 344, 480; anchor: left center; size: 10; color: faint; family: "Space Grotesk" }
                    text sys_mem_free  { at: 526, 480; anchor: right center; size: 11.5; weight: 700; color: ink; family: "Space Grotesk" }
                    text "Swap"  { at: 344, 504; anchor: left center; size: 10; color: faint; family: "Space Grotesk" }
                    text sys_swap_txt  { at: 526, 504; anchor: right center; size: 11.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }

                    //  Memory Vector Area Chart (`x = 172..524`, `y = 534..628`, baseline `622`, h = `78`)
                    box { from: 168, 530; size: 360, 100; corner: 12; color: deep; opacity: 38% }
                    group {
                        show: sys_hist_count > 0
                        let mx0 = 174
                        let mdx = 348 / 29
                        let myb = 622
                        let mem_col = mix(ct.secondary, alert, clamp((sys_mem - 0.85) / 0.15, 0, 1))
                        path {
                            at: 0, 0; color: mem_col; opacity: 18%
                            move mx0, myb
                            line mx0, myb - 78 * sys_hist30.0.mem
                            line mx0 +  1 * mdx, myb - 78 * sys_hist30.1.mem
                            line mx0 +  2 * mdx, myb - 78 * sys_hist30.2.mem
                            line mx0 +  3 * mdx, myb - 78 * sys_hist30.3.mem
                            line mx0 +  4 * mdx, myb - 78 * sys_hist30.4.mem
                            line mx0 +  5 * mdx, myb - 78 * sys_hist30.5.mem
                            line mx0 +  6 * mdx, myb - 78 * sys_hist30.6.mem
                            line mx0 +  7 * mdx, myb - 78 * sys_hist30.7.mem
                            line mx0 +  8 * mdx, myb - 78 * sys_hist30.8.mem
                            line mx0 +  9 * mdx, myb - 78 * sys_hist30.9.mem
                            line mx0 + 10 * mdx, myb - 78 * sys_hist30.10.mem
                            line mx0 + 11 * mdx, myb - 78 * sys_hist30.11.mem
                            line mx0 + 12 * mdx, myb - 78 * sys_hist30.12.mem
                            line mx0 + 13 * mdx, myb - 78 * sys_hist30.13.mem
                            line mx0 + 14 * mdx, myb - 78 * sys_hist30.14.mem
                            line mx0 + 15 * mdx, myb - 78 * sys_hist30.15.mem
                            line mx0 + 16 * mdx, myb - 78 * sys_hist30.16.mem
                            line mx0 + 17 * mdx, myb - 78 * sys_hist30.17.mem
                            line mx0 + 18 * mdx, myb - 78 * sys_hist30.18.mem
                            line mx0 + 19 * mdx, myb - 78 * sys_hist30.19.mem
                            line mx0 + 20 * mdx, myb - 78 * sys_hist30.20.mem
                            line mx0 + 21 * mdx, myb - 78 * sys_hist30.21.mem
                            line mx0 + 22 * mdx, myb - 78 * sys_hist30.22.mem
                            line mx0 + 23 * mdx, myb - 78 * sys_hist30.23.mem
                            line mx0 + 24 * mdx, myb - 78 * sys_hist30.24.mem
                            line mx0 + 25 * mdx, myb - 78 * sys_hist30.25.mem
                            line mx0 + 26 * mdx, myb - 78 * sys_hist30.26.mem
                            line mx0 + 27 * mdx, myb - 78 * sys_hist30.27.mem
                            line mx0 + 28 * mdx, myb - 78 * sys_hist30.28.mem
                            line mx0 + 29 * mdx, myb - 78 * sys_hist30.29.mem
                            line mx0 + 29 * mdx, myb
                            close
                        }
                        path {
                            at: 0, 0; stroke: 2; color: mem_col; opacity: 94%
                            move mx0, myb - 78 * sys_hist30.0.mem
                            line mx0 +  1 * mdx, myb - 78 * sys_hist30.1.mem
                            line mx0 +  2 * mdx, myb - 78 * sys_hist30.2.mem
                            line mx0 +  3 * mdx, myb - 78 * sys_hist30.3.mem
                            line mx0 +  4 * mdx, myb - 78 * sys_hist30.4.mem
                            line mx0 +  5 * mdx, myb - 78 * sys_hist30.5.mem
                            line mx0 +  6 * mdx, myb - 78 * sys_hist30.6.mem
                            line mx0 +  7 * mdx, myb - 78 * sys_hist30.7.mem
                            line mx0 +  8 * mdx, myb - 78 * sys_hist30.8.mem
                            line mx0 +  9 * mdx, myb - 78 * sys_hist30.9.mem
                            line mx0 + 10 * mdx, myb - 78 * sys_hist30.10.mem
                            line mx0 + 11 * mdx, myb - 78 * sys_hist30.11.mem
                            line mx0 + 12 * mdx, myb - 78 * sys_hist30.12.mem
                            line mx0 + 13 * mdx, myb - 78 * sys_hist30.13.mem
                            line mx0 + 14 * mdx, myb - 78 * sys_hist30.14.mem
                            line mx0 + 15 * mdx, myb - 78 * sys_hist30.15.mem
                            line mx0 + 16 * mdx, myb - 78 * sys_hist30.16.mem
                            line mx0 + 17 * mdx, myb - 78 * sys_hist30.17.mem
                            line mx0 + 18 * mdx, myb - 78 * sys_hist30.18.mem
                            line mx0 + 19 * mdx, myb - 78 * sys_hist30.19.mem
                            line mx0 + 20 * mdx, myb - 78 * sys_hist30.20.mem
                            line mx0 + 21 * mdx, myb - 78 * sys_hist30.21.mem
                            line mx0 + 22 * mdx, myb - 78 * sys_hist30.22.mem
                            line mx0 + 23 * mdx, myb - 78 * sys_hist30.23.mem
                            line mx0 + 24 * mdx, myb - 78 * sys_hist30.24.mem
                            line mx0 + 25 * mdx, myb - 78 * sys_hist30.25.mem
                            line mx0 + 26 * mdx, myb - 78 * sys_hist30.26.mem
                            line mx0 + 27 * mdx, myb - 78 * sys_hist30.27.mem
                            line mx0 + 28 * mdx, myb - 78 * sys_hist30.28.mem
                            line mx0 + 29 * mdx, myb - 78 * sys_hist30.29.mem
                        }
                    }

                    //  Temps & Fans Card (`y = 662..940`)
                    box { from: 36, 662; size: 508, 280; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 36, 662; size: 508, 280; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "TEMPERATURES & FANS" { at: 54, 684; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }
                    repeat t in 0..8 {
                        let ty = 716 + t * 24
                        text sys_temps.$t.label { at: 54, ty; anchor: left center; size: 11; weight: 600; color: ink; width: 138; lines: 1; show: t < sys_temps.count; family: "Space Grotesk" }
                        box { from: 204, ty - 2.5; size: 260, 5; corner: 2.5; color: ink; opacity: 8%; show: t < sys_temps.count }
                        box { from: 204, ty - 2.5; size: max(5, 260 * sys_temps.$t.f), 5; corner: 2.5; color: mix(mix(ct.secondary, ct.primary, clamp(sys_temps.$t.f, 0, 1)), alert, clamp(sys_temps.$t.heat, 0, 1)); show: t < sys_temps.count }
                        text sys_temps.$t.txt { at: 526, ty; anchor: right center; size: 10; weight: 700; color: ink; show: t < sys_temps.count; family: "Space Grotesk" }
                    }
                    text "No temperature sensors." { at: 54, 730; anchor: left center; size: 11; color: faint; show: sys_temps.count < 1; family: "Space Grotesk" }
                    text sys_fans { at: 54, 922; anchor: left center; size: 9.5; color: faint; width: 472; lines: 1; family: "Space Grotesk" }

                    //  ── RIGHT COLUMN (x = 556, w = 520): GPU / NETWORK / STORAGE ──
                    //  GPU Card (`y = 156..398`)
                    box { from: 556, 156; size: 520, 242; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 556, 156; size: 520, 242; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "GPU" { at: 574, 178; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                    text sys_gpu_name { at: 1058, 178; anchor: right center; size: 10; color: faint; width: 320; lines: 1; family: "Space Grotesk"; selectable: true }
                    group {
                        show: sys_gpu_on
                        CtGlowArc(628, 244, 39, 360 * max(0.004, sys_gpu) * 1deg, 180 * sys_gpu * 1deg, 6.5, mix(ct.primary, alert, clamp((sys_gpu - 0.8) / 0.2, 0, 1)))
                        CtGlowArc(628, 244, 27, 360 * max(0.004, sys_vram) * 1deg, 180 * sys_vram * 1deg, 4.5, ct.secondary)
                        text sys_gpu_txt { at: 628, 240; anchor: center; size: 20; weight: 700; color: ink; family: "Space Grotesk" }
                    }
                    text "No GPU sensors found" { at: 628, 244; anchor: center; size: 11.5; color: faint; show: not sys_gpu_on; family: "Space Grotesk" }
                    text "VRAM"  { at: 706, 206; anchor: left center; size: 9.5; color: faint; family: "Space Grotesk" }
                    text sys_gpu_vram  { at: 1058, 206; anchor: right center; size: 11; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                    text "Power" { at: 706, 230; anchor: left center; size: 9.5; color: faint; family: "Space Grotesk" }
                    text sys_gpu_power { at: 1058, 230; anchor: right center; size: 11; weight: 600; color: ink; family: "Space Grotesk" }
                    text "Temp"  { at: 706, 256; anchor: left center; size: 9.5; color: faint; family: "Space Grotesk" }
                    text sys_gpu_temp  { at: 750, 256; anchor: left center; size: 11; weight: 700; color: ink; family: "Space Grotesk" }
                    text "Fan"   { at: 830, 256; anchor: left center; size: 9.5; color: faint; family: "Space Grotesk" }
                    text sys_gpu_fan   { at: 862, 256; anchor: left center; size: 11; weight: 700; color: ink; family: "Space Grotesk" }
                    text sys_gpu_clock { at: 1058, 256; anchor: right center; size: 10.5; weight: 700; color: ct.primary; family: "Space Grotesk" }

                    //  GPU Vector History Chart (`x = 702..1054`, `y = 280..378`, baseline `372`, h = `82`)
                    box { from: 698, 276; size: 360, 104; corner: 12; color: deep; opacity: 38% }
                    group {
                        show: sys_hist_count > 0
                        let gx0 = 704
                        let gdx = 348 / 29
                        let gyb = 372
                        let gpu_col = mix(ct.primary, alert, clamp((sys_gpu - 0.8) / 0.2, 0, 1))
                        path {
                            at: 0, 0; color: gpu_col; opacity: 18%
                            move gx0, gyb
                            line gx0, gyb - 82 * sys_hist30.0.gpu
                            line gx0 +  1 * gdx, gyb - 82 * sys_hist30.1.gpu
                            line gx0 +  2 * gdx, gyb - 82 * sys_hist30.2.gpu
                            line gx0 +  3 * gdx, gyb - 82 * sys_hist30.3.gpu
                            line gx0 +  4 * gdx, gyb - 82 * sys_hist30.4.gpu
                            line gx0 +  5 * gdx, gyb - 82 * sys_hist30.5.gpu
                            line gx0 +  6 * gdx, gyb - 82 * sys_hist30.6.gpu
                            line gx0 +  7 * gdx, gyb - 82 * sys_hist30.7.gpu
                            line gx0 +  8 * gdx, gyb - 82 * sys_hist30.8.gpu
                            line gx0 +  9 * gdx, gyb - 82 * sys_hist30.9.gpu
                            line gx0 + 10 * gdx, gyb - 82 * sys_hist30.10.gpu
                            line gx0 + 11 * gdx, gyb - 82 * sys_hist30.11.gpu
                            line gx0 + 12 * gdx, gyb - 82 * sys_hist30.12.gpu
                            line gx0 + 13 * gdx, gyb - 82 * sys_hist30.13.gpu
                            line gx0 + 14 * gdx, gyb - 82 * sys_hist30.14.gpu
                            line gx0 + 15 * gdx, gyb - 82 * sys_hist30.15.gpu
                            line gx0 + 16 * gdx, gyb - 82 * sys_hist30.16.gpu
                            line gx0 + 17 * gdx, gyb - 82 * sys_hist30.17.gpu
                            line gx0 + 18 * gdx, gyb - 82 * sys_hist30.18.gpu
                            line gx0 + 19 * gdx, gyb - 82 * sys_hist30.19.gpu
                            line gx0 + 20 * gdx, gyb - 82 * sys_hist30.20.gpu
                            line gx0 + 21 * gdx, gyb - 82 * sys_hist30.21.gpu
                            line gx0 + 22 * gdx, gyb - 82 * sys_hist30.22.gpu
                            line gx0 + 23 * gdx, gyb - 82 * sys_hist30.23.gpu
                            line gx0 + 24 * gdx, gyb - 82 * sys_hist30.24.gpu
                            line gx0 + 25 * gdx, gyb - 82 * sys_hist30.25.gpu
                            line gx0 + 26 * gdx, gyb - 82 * sys_hist30.26.gpu
                            line gx0 + 27 * gdx, gyb - 82 * sys_hist30.27.gpu
                            line gx0 + 28 * gdx, gyb - 82 * sys_hist30.28.gpu
                            line gx0 + 29 * gdx, gyb - 82 * sys_hist30.29.gpu
                            line gx0 + 29 * gdx, gyb
                            close
                        }
                        path {
                            at: 0, 0; stroke: 2; color: gpu_col; opacity: 94%
                            move gx0, gyb - 82 * sys_hist30.0.gpu
                            line gx0 +  1 * gdx, gyb - 82 * sys_hist30.1.gpu
                            line gx0 +  2 * gdx, gyb - 82 * sys_hist30.2.gpu
                            line gx0 +  3 * gdx, gyb - 82 * sys_hist30.3.gpu
                            line gx0 +  4 * gdx, gyb - 82 * sys_hist30.4.gpu
                            line gx0 +  5 * gdx, gyb - 82 * sys_hist30.5.gpu
                            line gx0 +  6 * gdx, gyb - 82 * sys_hist30.6.gpu
                            line gx0 +  7 * gdx, gyb - 82 * sys_hist30.7.gpu
                            line gx0 +  8 * gdx, gyb - 82 * sys_hist30.8.gpu
                            line gx0 +  9 * gdx, gyb - 82 * sys_hist30.9.gpu
                            line gx0 + 10 * gdx, gyb - 82 * sys_hist30.10.gpu
                            line gx0 + 11 * gdx, gyb - 82 * sys_hist30.11.gpu
                            line gx0 + 12 * gdx, gyb - 82 * sys_hist30.12.gpu
                            line gx0 + 13 * gdx, gyb - 82 * sys_hist30.13.gpu
                            line gx0 + 14 * gdx, gyb - 82 * sys_hist30.14.gpu
                            line gx0 + 15 * gdx, gyb - 82 * sys_hist30.15.gpu
                            line gx0 + 16 * gdx, gyb - 82 * sys_hist30.16.gpu
                            line gx0 + 17 * gdx, gyb - 82 * sys_hist30.17.gpu
                            line gx0 + 18 * gdx, gyb - 82 * sys_hist30.18.gpu
                            line gx0 + 19 * gdx, gyb - 82 * sys_hist30.19.gpu
                            line gx0 + 20 * gdx, gyb - 82 * sys_hist30.20.gpu
                            line gx0 + 21 * gdx, gyb - 82 * sys_hist30.21.gpu
                            line gx0 + 22 * gdx, gyb - 82 * sys_hist30.22.gpu
                            line gx0 + 23 * gdx, gyb - 82 * sys_hist30.23.gpu
                            line gx0 + 24 * gdx, gyb - 82 * sys_hist30.24.gpu
                            line gx0 + 25 * gdx, gyb - 82 * sys_hist30.25.gpu
                            line gx0 + 26 * gdx, gyb - 82 * sys_hist30.26.gpu
                            line gx0 + 27 * gdx, gyb - 82 * sys_hist30.27.gpu
                            line gx0 + 28 * gdx, gyb - 82 * sys_hist30.28.gpu
                            line gx0 + 29 * gdx, gyb - 82 * sys_hist30.29.gpu
                        }
                    }

                    //  Network Card (`y = 412..620`)
                    box { from: 556, 412; size: 520, 208; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 556, 412; size: 520, 208; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "NETWORK" { at: 574, 434; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }
                    text sys_iface { at: 1058, 434; anchor: right center; size: 10; color: faint; family: "Space Grotesk" }
                    text sys_ip    { at: 574, 456; anchor: left center; size: 10; color: faint; family: "Space Grotesk"; selectable: true }
                    text "RX  " .. sys_rx_txt   { at: 786, 454; anchor: left center; size: 13; weight: 700; color: ct.primary; family: "Space Grotesk" }
                    text "TX  " .. sys_tx_txt   { at: 936, 454; anchor: left center; size: 13; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                    text sys_rx_total { at: 786, 470; anchor: left center; size: 8.5; color: faint; family: "Space Grotesk" }
                    text sys_tx_total { at: 936, 470; anchor: left center; size: 8.5; color: faint; family: "Space Grotesk" }

                    //  Mirrored RX/TX Vector Bars + Baseline (`y = 546`)
                    box { from: 574, 488; size: 484, 114; corner: 12; color: deep; opacity: 38% }
                    line { from: 582, 545; to: 1050, 545; width: 1; color: ink; opacity: 14% }
                    group {
                        show: sys_hist_count > 0
                        repeat n in 0..30 {
                            let nx = 584 + n * 15.6
                            let rh = 2 + 44 * clamp(sys_hist30.$n.rx, 0, 1)
                            let th = 2 + 44 * clamp(sys_hist30.$n.tx, 0, 1)
                            box { from: nx, 544 - rh; size: 11, rh; corner: 3; color: ct.primary; opacity: 86% }
                            box { from: nx, 546;      size: 11, th; corner: 3; color: ct.secondary; opacity: 78% }
                        }
                    }

                    //  Disk & Storage Card (`y = 634..942`)
                    box { from: 556, 634; size: 520, 308; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 556, 634; size: 520, 308; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "STORAGE" { at: 574, 656; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                    text sys_dr_txt .. " read" { at: 1058, 656; anchor: right center; size: 9.5; color: faint; family: "Space Grotesk" }
                    repeat m in 0..4 {
                        let my = 690 + m * 36
                        group {
                            show: m < sys_mounts.count
                            let m_col = if(mod(m, 2) == 0, ct.primary, ct.secondary)
                            text sys_mounts.$m.name { at: 574, my; anchor: left center; size: 12; weight: 600; color: ink; width: 108; lines: 1; family: "Space Grotesk" }
                            box { from: 690, my - 3; size: 210, 6; corner: 3; color: ink; opacity: 8% }
                            box { from: 690, my - 3; size: max(6, 210 * sys_mounts.$m.pct), 6; corner: 3; color: mix(m_col, alert, clamp((sys_mounts.$m.pct - 0.8) / 0.2, 0, 1)) }
                            text sys_mounts.$m.info { at: 1058, my; anchor: right center; size: 10; color: faint; width: 148; lines: 1; align: right; family: "Space Grotesk" }
                        }
                    }
                    text "No mounted filesystems." { at: 574, 700; anchor: left center; size: 11; color: faint; show: sys_mounts.count < 1; family: "Space Grotesk" }
                    line { from: 574, 846; to: 1058, 846; width: 1; color: ink; opacity: 10% }
                    text "Write throughput" { at: 574, 882; anchor: left center; size: 11; color: faint; family: "Space Grotesk" }
                    text sys_dw_speed { at: 1058, 882; anchor: right center; size: 22; weight: 700; color: ct.secondary; family: "Space Grotesk" }

                    //  ── BUSIEST PROGRAMS (`y = 956..1180`, sortable CPU/MEM headers) ──
                    box { from: 36, 956; size: 1040, 224; corner: 18; color: ct.card2; opacity: 64% }
                    box { from: 36, 956; size: 1040, 224; corner: 18; stroke: 1; color: ink; opacity: 10% }
                    text "BUSIEST PROGRAMS" { at: 54, 980; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }

                    //  Clickable Sort Headers
                    box { from: 616, 968; size: 84, 24; corner: 12; color: ct.primary; opacity: if(sys_proc_sort == 0, 18%, 4% + 8% * ct_sort_cpu.hover) }
                    text if(sys_proc_sort == 0, "CPU ▾", "CPU") { at: 658, 980; anchor: center; size: 10; weight: 700; color: if(sys_proc_sort == 0, ct.primary, faint); family: "Space Grotesk" }
                    zone box ct_sort_cpu { from: 616, 968; size: 84, 24; corner: 12; cursor: pointer; active: 980 - sys.off > 152 and 980 - sys.off < 670; label: "Sort programs by CPU" }
                    on scroll ct_sort_cpu { ct_sys_sc_to = clamp(ct_sys_sc_to - wheel * 54, 0, sys.max_s) }
                    on press ct_sort_cpu { emit ui_sound; sys_proc_sort = 0 }

                    box { from: 966, 968; size: 92, 24; corner: 12; color: ct.secondary; opacity: if(sys_proc_sort == 1, 18%, 4% + 8% * ct_sort_mem.hover) }
                    text if(sys_proc_sort == 1, "MEMORY ▾", "MEMORY") { at: 1012, 980; anchor: center; size: 10; weight: 700; color: if(sys_proc_sort == 1, ct.secondary, faint); family: "Space Grotesk" }
                    zone box ct_sort_mem { from: 966, 968; size: 92, 24; corner: 12; cursor: pointer; active: 980 - sys.off > 152 and 980 - sys.off < 670; label: "Sort programs by Memory" }
                    on scroll ct_sort_mem { ct_sys_sc_to = clamp(ct_sys_sc_to - wheel * 54, 0, sys.max_s) }
                    on press ct_sort_mem { emit ui_sound; sys_proc_sort = 1 }

                    repeat p in 0..6 {
                        let py = 1006 + p * 26
                        group {
                            show: p < sys_procs.count
                            box { from: 54, py; size: 1004, 22; corner: 6; color: ink; opacity: 3.5% }
                            text sys_procs.$p.name { at: 66, py + 11; anchor: left center; size: 11.5; weight: 600; color: ink; width: 278; lines: 1; family: "Space Grotesk" }
                            box { from: 356, py + 8.5; size: 280, 5; corner: 2.5; color: ink; opacity: 8% }
                            box { from: 356, py + 8.5; size: 280 * clamp(sys_procs.$p.cpu, 0, 1), 5; corner: 2.5; color: mix(ct.primary, alert, clamp((sys_procs.$p.cpu - 0.75) / 0.25, 0, 1)); opacity: 84% }
                            text sys_procs.$p.cpu_txt { at: 700, py + 11; anchor: right center; size: 10; weight: 700; color: ink; family: "Space Grotesk" }
                            box { from: 726, py + 8.5; size: 260, 5; corner: 2.5; color: ink; opacity: 8% }
                            box { from: 726, py + 8.5; size: 260 * clamp(sys_procs.$p.mem, 0, 1), 5; corner: 2.5; color: ct.secondary; opacity: 64% }
                            text sys_procs.$p.mem_txt { at: 1052, py + 11; anchor: right center; size: 10; color: faint; family: "Space Grotesk" }
                        }
                    }
                    text "Waiting for programs…" { at: 54, 1020; anchor: left center; size: 11; color: faint; show: sys_procs.count < 1; family: "Space Grotesk" }
                }

                //  16-step bottom fade + bobbing More pill
                repeat f in 0..16 {
                    let fk = (f + 1) / 16
                    box { from: 36, 614 + f * 3.5; size: 1042, 4; color: deep; opacity: 52% * fk * fk * sys.cue }
                }
                let sys.cuey = 644 + 2 * sin(ct_clk * 240)
                box { at: 557, sys.cuey; size: 92, 26; corner: 13; color: deep; opacity: 84% * sys.cue }
                box { at: 557, sys.cuey; size: 92, 26; corner: 13; color: ct.secondary; opacity: (12% + 14% * sys_cue_hit.hover) * sys.cue }
                box { at: 557, sys.cuey; size: 92, 26; corner: 13; stroke: 1; color: ct.secondary; opacity: (38% + 36% * sys_cue_hit.hover) * sys.cue }
                path { at: 530, sys.cuey - 1; stroke: 1.5; color: ct.secondary; opacity: sys.cue; move -4, -2; line 0, 2; line 4, -2 }
                text "More" { at: 566, sys.cuey; anchor: center; size: 12.5; weight: 700; color: ink; opacity: sys.cue; family: "Space Grotesk" }
                zone box sys_cue_hit { at: 557, 644; size: 92, 28; corner: 14; cursor: pointer; active: sys.cue > 0.4; label: "Scroll down" }
                on press sys_cue_hit { emit ui_sound; ct_sys_sc_to = clamp(ct_sys_sc_to + 320, 0, sys.max_s) }
            }

            //  Draggable 14px System scrollbar
            box { from: 1087, 152; size: 4, 518; corner: 2; color: ink; opacity: 8% }
            box { from: 1087, 152 + (518 - sys.th) * clamp(sys.sc / sys.max_s, 0, 1); size: 4, sys.th; corner: 2; color: if(sys_bar_hit.hover > 0.4, ct.primary, ct.secondary); opacity: 45% + 45% * sys_bar_hit.hover }
            zone box sys_bar_hit { from: 1082, 152; size: 14, 518; cursor: pointer; label: "Scroll System monitor" }
            on press sys_bar_hit { ct_sys_sc_to = clamp((((pointer.y - notch_clock_h) - 152) - sys.th / 2) / max(1, 518 - sys.th) * sys.max_s, 0, sys.max_s) }
            on drag  sys_bar_hit { ct_sys_sc_to = clamp((((pointer.y - notch_clock_h) - 152) - sys.th / 2) / max(1, 518 - sys.th) * sys.max_s, 0, sys.max_s) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 2 · SYSTEM TRAY (clean flat cards, zero nested glass + slide-in)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 2
            text "SYSTEM TRAY" { at: 36, 120; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text "Hover or right-click an item for menu actions." { at: 36, 138; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }

            zone box ct_tray_shield { from: 36, 152; size: 1048, 500; active: tray_menu_open; label: "Close tray menu" }
            on press ct_tray_shield { emit center_tray_menu_close }

            //  Left Pane: Applications
            box { from: 36, 160; size: 300, 488; corner: 20; color: ct.card2; opacity: 66% }
            box { from: 36, 160; size: 300, 488; corner: 20; stroke: 1; color: ink; opacity: 12% }
            text "APPLICATIONS" { at: 56, 182; anchor: left center; size: 9.5; weight: 700; color: ct.primary; family: "Space Grotesk" }
            line { from: 56, 198; to: 316, 198; width: 1; color: ink; opacity: 10% }
            column ct_tray_list {
                at: 52, 210
                view: 268, 424
                step: 54
                gap: 4
                content: tray_items.count * 54
                for r in tray_items {
                    CtTrayRow(r, open: if(tray_menu_open, 1, 0), sel: tray_menu_row, activate: center_tray_activate, menu: center_tray_menu)
                }
            }
            text "No tray items" { at: 186, 330; anchor: center; size: 17; weight: 700; color: ink; show: tray_items.count < 1; family: "Space Grotesk" }
            text "Run an app that publishes a StatusNotifier item." { at: 186, 356; anchor: center; size: 10.5; color: faint; width: 232; lines: 2; align: center; show: tray_items.count < 1; family: "Space Grotesk" }

            //  Middle Pane: Actions (slides smoothly in when menu opens)
            group {
                move: 16 * (1 - ct_tray_m_p) * if(motion.reduced, 0, 1), 0
                box { from: 352, 160; size: 420, 488; corner: 20; color: ct.card2; opacity: 66% }
                box { from: 352, 160; size: 420, 488; corner: 20; stroke: 1; color: ink; opacity: 12% }
                text "ACTIONS" { at: 372, 182; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                text tray_items[tray_menu_row].name { at: 372, 200; anchor: left center; size: 12; weight: 600; color: ink; width: 328; lines: 1; show: tray_menu_open; family: "Space Grotesk" }
                text "Choose an app" { at: 372, 200; anchor: left center; size: 12; weight: 600; color: faint; width: 328; lines: 1; show: not tray_menu_open; family: "Space Grotesk" }
                line { from: 734, 174; to: 746, 186; width: 1.4; color: ink; opacity: 65%; show: tray_menu_open }
                line { from: 746, 174; to: 734, 186; width: 1.4; color: ink; opacity: 65%; show: tray_menu_open }
                zone box ct_tray_menu_close { from: 728, 168; size: 28, 28; corner: 14; cursor: pointer; label: "Close tray menu"; active: tray_menu_open }
                on press ct_tray_menu_close { emit center_tray_menu_close }

                column ct_tray_menu_list {
                    at: 368, 220
                    view: 388, 412
                    step: 34
                    gap: 2
                    content: tray_menu_count * 34
                    show: tray_menu_open
                    for r in tray_menu {
                        CtTrayMenuRow(r, sel: tray_menu_sel, hover_ev: center_tray_menu_hover, click_ev: center_tray_menu_click)
                    }
                }
                text "Hover an app to open its actions." { at: 562, 360; anchor: center; size: 11.5; color: faint; show: not tray_menu_open; family: "Space Grotesk" }
                text "This item has no actions." { at: 562, 360; anchor: center; size: 11.5; color: faint; show: tray_menu_open and tray_menu_count < 1; family: "Space Grotesk" }
            }

            //  Right Pane: Submenu (slides smoothly in when submenu opens)
            group {
                move: 16 * (1 - ct_tray_s_p) * if(motion.reduced, 0, 1), 0
                box { from: 788, 160; size: 296, 488; corner: 20; color: ct.card2; opacity: 66% }
                box { from: 788, 160; size: 296, 488; corner: 20; stroke: 1; color: ink; opacity: 12% }
                text "SUBMENU" { at: 808, 182; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
                column ct_tray_sub_list {
                    at: 804, 220
                    view: 264, 412
                    step: 34
                    gap: 2
                    content: tray_submenu_count * 34
                    show: tray_menu_open and tray_submenu_open
                    for r in tray_submenu {
                        CtTraySubmenuRow(r, click_ev: center_tray_submenu_click)
                    }
                }
                text "Hover an action marked ›." { at: 936, 360; anchor: center; size: 11; color: faint; show: not (tray_menu_open and tray_submenu_open); family: "Space Grotesk" }
            }

            line { from: 36, 660; to: 1084, 660; width: 1; color: ink; opacity: 10% }
            text "Hover an app to open its menu · Click an action to run it" { at: 36, 680; anchor: left center; size: 10; color: faint; family: "Space Grotesk" }
            text "Tray service · StatusNotifierItem" { at: 1064, 680; anchor: right center; size: 9; color: faint; opacity: 70%; family: "Space Grotesk" }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 3 · MEDIA (vinyl art + bass halo + 48 radial bars + seek + 24 EQ)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 3
            text "NOW PLAYING" { at: 36, 120; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text med.player { at: 1064, 120; anchor: right center; size: 10.5; color: faint; family: "Space Grotesk" }

            //  Bass-reactive ambient glow around turntable (`cx = 248, cy = 384`)
            let ct_bass = clamp((spec.s.0 + spec.s.1 + spec.s.2) / 3, 0, 1)
            let halo_r = 148 + 26 * if(med.playing, ct_bass, 0)
            ellipse { at: 248, 384; radius: halo_r; color: ct.secondary; opacity: if(med.playing, 7% + 18% * ct_bass, 3%) }
            ellipse { at: 248, 384; radius: 136; stroke: 1.5; color: ct.primary; opacity: if(med.playing, 18% + 28% * ct_bass, 9%) }

            //  48 symmetric radial spectrum bars surrounding vinyl (`spec.s.0..23`)
            repeat r in 0..48 {
                let si = if(r < 24, r, 47 - r)
                let rv = clamp(pick(si, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), 0, 1)
                let ra = r * 7.5 - 90
                let rlen = 6 + 34 * if(med.playing, rv, 0.08)
                line {
                    from: 248 + 144 * cos(ra), 384 + 144 * sin(ra)
                    to:   248 + (144 + rlen) * cos(ra), 384 + (144 + rlen) * sin(ra)
                    width: 3.2; color: mix(ct.primary, ct.secondary, si / 23); opacity: if(med.playing, 86%, 22%)
                }
            }

            //  Track-change particle burst + bouncy turntable + circular album art
            particles { at: 248, 384; area: 120, 120; count: 24; life: 0.45s .. 0.85s; speed: 60 .. 200; spread: 360deg
                gravity: 0, 120; drag: 1.4; size: 5, 2; colors: ct.primary, ct.secondary; opacity: 90%, 0%; shape: dot; burst: ct_track_burst }

            group {
                pivot: 248, 384
                scale: ct_track_pop
                group {
                    pivot: 248, 384
                    rotate: ct_time * 32 * 1deg
                    ellipse { at: 248, 384; radius: 130; color: deep }
                    ellipse { at: 248, 384; radius: 130; stroke: 1.5; color: if(med.playing, ct.primary, ink); opacity: if(med.playing, 48%, 16%) }
                    ellipse { at: 248, 384; radius: 112; stroke: 1; color: ink; opacity: 8% }
                    ellipse { at: 248, 384; radius: 94; stroke: 1; color: ink; opacity: 8% }
                    ellipse { at: 248, 384; radius: 76; stroke: 1; color: ink; opacity: 8% }
                    group {
                        show: ct_art_on
                        clip box { from: 184, 320; size: 128, 128; corner: 64 }
                        image ct_art_img { at: 184, 320; size: 128, 128; fit: cover }
                    }
                    ellipse { at: 248, 384; radius: 56; color: ct.secondary; opacity: 24%; show: not ct_art_on }
                    ellipse { at: 248, 384; radius: 10; color: ct.card }
                    ellipse { at: 248, 384; radius: 10; stroke: 1.6; color: ink; opacity: 55% }
                }
            }

            //  Right Side: Metadata, Seek Bar / LIVE Pulse, 24-Band Linear Spectrum, Transport
            text med.title  { at: 484, 178; anchor: left top; size: 28; weight: 700; color: ink; width: 576; lines: 2; line_height: 1.08; show: ct_has_track; family: "Space Grotesk" }
            text med.artist { at: 484, 256; anchor: left center; size: 15.5; color: faint; width: 576; lines: 1; show: ct_has_track; family: "Space Grotesk" }
            text med.player { at: 484, 282; anchor: left center; size: 10; weight: 700; color: ct.secondary; show: ct_has_track; family: "Space Grotesk" }
            text "Nothing playing" { at: 484, 224; anchor: left center; size: 26; weight: 700; color: faint; show: not ct_has_track; family: "Space Grotesk" }

            //  24-band real Cava linear equalizer (`x = 484..1060`)
            repeat b in 0..24 {
                let sv = clamp(pick(b, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), 0, 1)
                let bh = 6 + 96 * if(med.playing, sv, 0.05)
                box { from: 484 + b * 24, 412 - bh; size: 16, bh; corner: 6; color: mix(ct.primary, ct.secondary, b / 23); opacity: if(med.playing, 88%, 22%) }
            }

            //  Interactive Seek Slider (`ct_media_len_s > 0`) or pulsing LIVE indicator
            group {
                show: ct_has_track and ct_media_len_s > 0
                let seek_pct = clamp(ct_media_pos / max(1, ct_media_len_s), 0, 1)
                CtSlider(484, 452, 564, seek_pct, ct_med_seek.hover, ct.primary)
                zone box ct_med_seek { from: 478, 438; size: 576, 28; cursor: pointer; label: "Seek track position" }
                on press ct_med_seek { emit center_media_seek(clamp((pointer.x - ct.px - 484) / 564, 0, 1) * ct_media_len_s) }
                on drag  ct_med_seek { emit center_media_seek(clamp((pointer.x - ct.px - 484) / 564, 0, 1) * ct_media_len_s) }
                text ct_media_pos_txt { at: 484, 476; anchor: left center; size: 11; weight: 700; color: ct.primary; family: "Space Grotesk" }
                text ct_media_len     { at: 1048, 476; anchor: right center; size: 11; color: ct.secondary; opacity: 86%; family: "Space Grotesk" }
            }
            group {
                show: ct_has_track and ct_media_len_s <= 0
                let lp = if(motion.reduced, 1, 0.55 + 0.45 * sin(ct_clk * 240))
                box { from: 484, 442; size: 68, 22; corner: 11; color: alert; opacity: 18% }
                ellipse { at: 498, 453; radius: 3.5; color: alert; opacity: lp }
                text "LIVE" { at: 510, 453; anchor: left center; size: 10; weight: 700; color: alert; family: "Space Grotesk" }
            }

            //  Large Transport Buttons with ripple
            ellipse { at: 508, 548; radius: 22; color: ink; opacity: 6% + 12% * ct_media_prev.hover }
            ellipse { at: 508, 548; radius: 22; stroke: 1; color: ct.secondary; opacity: 42% * ct_media_prev.hover }
            path { at: 508, 548; color: ink; move 5, -6; line -6, 0; line 5, 6; close }
            line { from: 501, 542; to: 501, 554; width: 2; color: ink }
            zone box ct_media_prev { from: 484, 524; size: 48, 48; corner: 24; cursor: pointer; label: "Previous track" }
            on press ct_media_prev { ripple ct_media_prev; emit ui_sound; emit center_media(0) }

            ellipse { at: 572, 548; radius: 31; stroke: 1.5; color: ct.secondary; opacity: 16% + 52% * ct_media_play.hover }
            ellipse { at: 572, 548; radius: 28; color: ct.primary; opacity: 88% + 12% * ct_media_play.hover }
            group { show: not med.playing; path { at: 574, 548; color: ct.card; move -6, -8; line 8, 0; line -6, 8; close } }
            group { show: med.playing; box { from: 565, 540; size: 4.5, 16; corner: 2; color: ct.card }; box { from: 575, 540; size: 4.5, 16; corner: 2; color: ct.card } }
            zone box ct_media_play { from: 542, 518; size: 60, 60; corner: 30; cursor: pointer; label: "Play or pause" }
            on press ct_media_play { ripple ct_media_play; emit ui_sound; emit center_media(1) }

            ellipse { at: 636, 548; radius: 22; color: ink; opacity: 6% + 12% * ct_media_next.hover }
            ellipse { at: 636, 548; radius: 22; stroke: 1; color: ct.secondary; opacity: 42% * ct_media_next.hover }
            path { at: 636, 548; color: ink; move -5, -6; line 6, 0; line -5, 6; close }
            line { from: 643, 542; to: 643, 554; width: 2; color: ink }
            zone box ct_media_next { from: 612, 524; size: 48, 48; corner: 24; cursor: pointer; label: "Next track" }
            on press ct_media_next { ripple ct_media_next; emit ui_sound; emit center_media(2) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 4 · AUDIO (dial + per-app PipeWire mixer + mic + 24 EQ)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 4
            let app.can_scroll = audio_apps_count > 4
            let app.vh = 268
            let app.ch = max(app.vh, audio_apps_count * 64)
            let app.max_s = max(1, app.ch - app.vh)
            let app.sc = if(app.can_scroll, clamp(ct_app_sc, 0, app.max_s), 0)
            let app.off = if(app.can_scroll, floor(app.sc + 0.5), 0)
            let app.th = max(36, app.vh * min(1, app.vh / max(1, app.ch)))

            text "SOUND & OUTPUT" { at: 36, 120; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text pick(aud.muted, "Drag or scroll dial to adjust output volume.", "The default output is muted.") { at: 36, 140; anchor: left center; size: 12.5; color: faint; width: 404; lines: 1; family: "Space Grotesk" }

            //  ── Left Column (cx = 238): Master Volume Dial, Sink Picker, Mute, Mic ──
            ellipse { at: 238, 294; radius: 126; color: if(aud.muted, alert, ct.primary); opacity: 6% * ct_aud_dial.hover }
            ellipse { at: 238, 294; radius: 124; stroke: 1.2; color: if(aud.muted, alert, ct.secondary); opacity: 10% + 28% * ct_aud_dial.hover }
            ellipse { at: 238, 294; radius: 114; stroke: 10; color: ct.track; opacity: 90% }
            arc { at: 238, 294; radius: 114; span: 360 * clamp(aud.volume, 0.004, 1) * 1deg; width: 10; color: if(aud.muted, alert, ct.primary); opacity: 92%; rotate: 180 * clamp(aud.volume, 0.004, 1) * 1deg }
            repeat s in 0..36 {
                let sa = s * 10
                line { from: 238 + 99 * cos(sa), 294 + 99 * sin(sa); to: 238 + 107 * cos(sa), 294 + 107 * sin(sa); width: if(mod(s, 3) == 0, 1.5, 0.8); color: if(s / 36 <= aud.volume, ct.secondary, ink); opacity: if(s / 36 <= aud.volume, 72%, 14%) }
            }
            text number(aud.volume * 100, 0, "%") { at: 238, 282; anchor: center; size: 44; weight: 700; color: if(aud.muted, faint, ink); family: "Space Grotesk" }
            text pick(aud.muted, "VOLUME · DRAG/SCROLL", "MUTED") { at: 238, 320; anchor: center; size: 9.5; weight: 700; color: if(aud.muted, alert, faint); family: "Space Grotesk" }
            zone box ct_aud_dial { from: 114, 170; size: 248, 248; corner: 124; cursor: pointer; label: "Adjust volume dial" }
            on scroll ct_aud_dial { emit center_audio_set(clamp(aud.volume + wheel * 0.04, 0, 1)) }
            on press  ct_aud_dial { aud_drag_y = pointer.y; aud_drag_v = aud.volume }
            on drag   ct_aud_dial { emit center_audio_set(clamp(aud_drag_v + (aud_drag_y - pointer.y) / 180, 0, 1)) }

            //  Output Device Picker Pill (`y = 438..474`)
            box { from: 48, 438; size: 380, 36; corner: 18; color: ct.card2; opacity: 75% }
            box { from: 48, 438; size: 380, 36; corner: 18; stroke: 1; color: if(ct_audio_pick.hover > 0.3, ct.secondary, ink); opacity: 12% + 28% * ct_audio_pick.hover }
            text audio_out_name { at: 66, 456; anchor: left center; size: 12; weight: 600; color: ink; width: 324; lines: 1; family: "Space Grotesk" }
            text "▾" { at: 410, 456; anchor: center; size: 13; color: ct.secondary; family: "Space Grotesk" }
            zone box ct_audio_pick { from: 48, 438; size: 380, 36; corner: 18; cursor: pointer; label: "Choose output device" }
            on press ct_audio_pick { emit ui_sound; audio_pick_open = true }

            //  Mute Output Pill (`y = 486..524`)
            box { from: 48, 486; size: 380, 38; corner: 19; color: if(aud.muted, alert, ct.primary); opacity: if(aud.muted, 24%, 14%) + 10% * ct_aud_mute.hover }
            box { from: 48, 486; size: 380, 38; corner: 19; stroke: 1; color: if(aud.muted, alert, ct.primary); opacity: 32% }
            text pick(aud.muted, "Mute output", "Unmute output") { at: 238, 505; anchor: center; size: 12; weight: 700; color: if(aud.muted, alert, ct.primary); family: "Space Grotesk" }
            zone box ct_aud_mute { from: 48, 486; size: 380, 38; corner: 19; cursor: pointer; label: "Toggle output mute" }
            on press ct_aud_mute { ripple ct_aud_mute; emit ui_sound; emit center_audio_mute }

            //  Compact Microphone Card (`y = 540..662`)
            box { from: 36, 540; size: 404, 122; corner: 18; color: ct.card2; opacity: 64% }
            box { from: 36, 540; size: 404, 122; corner: 18; stroke: 1; color: ink; opacity: 10% }
            text "MICROPHONE" { at: 54, 562; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text number(aud.input * 100, 0, "%") { at: 422, 562; anchor: right center; size: 17; weight: 700; color: if(aud.input_muted, alert, ct.secondary); family: "Space Grotesk" }
            CtSlider(54, 594, 368, clamp(aud.input, 0, 1), ct_aud_in_track.hover, if(aud.input_muted, alert, ct.secondary))
            zone box ct_aud_in_track { from: 48, 582; size: 380, 24; cursor: pointer; label: "Microphone level" }
            on press ct_aud_in_track { emit center_input_set(clamp((pointer.x - ct.px - 54) / 368, 0, 1)) }
            on drag  ct_aud_in_track { emit center_input_set(clamp((pointer.x - ct.px - 54) / 368, 0, 1)) }

            box { from: 54, 620; size: 120, 28; corner: 14; color: if(aud.input_muted, alert, ct.secondary); opacity: if(aud.input_muted, 24%, 12%) + 10% * ct_aud_in_mute.hover }
            box { from: 54, 620; size: 120, 28; corner: 14; stroke: 1; color: if(aud.input_muted, alert, ct.secondary); opacity: 30% }
            text pick(aud.input_muted, "Mute mic", "Unmute mic") { at: 114, 634; anchor: center; size: 10.5; weight: 700; color: if(aud.input_muted, alert, ct.secondary); family: "Space Grotesk" }
            zone box ct_aud_in_mute { from: 54, 620; size: 120, 28; corner: 14; cursor: pointer; label: "Toggle mic mute" }
            on press ct_aud_in_mute { ripple ct_aud_in_mute; emit ui_sound; emit center_input_mute }

            //  ── Right Column (`464..1084`): Master Output, Per-App Mixer, 24-Band EQ ──
            box { from: 464, 114; size: 620, 74; corner: 18; color: ct.card2; opacity: 64% }
            box { from: 464, 114; size: 620, 74; corner: 18; stroke: 1; color: ink; opacity: 10% }
            text "MASTER OUTPUT" { at: 484, 134; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }
            text number(aud.volume * 100, 0, "%") { at: 1064, 134; anchor: right center; size: 18; weight: 700; color: if(aud.muted, alert, ink); family: "Space Grotesk" }
            CtSlider(484, 162, 580, clamp(aud.volume, 0, 1), ct_aud_track.hover, if(aud.muted, alert, ct.primary))
            zone box ct_aud_track { from: 478, 150; size: 592, 24; cursor: pointer; label: "Output volume" }
            on press ct_aud_track { emit center_audio_set(clamp((pointer.x - ct.px - 484) / 580, 0, 1)) }
            on drag  ct_aud_track { emit center_audio_set(clamp((pointer.x - ct.px - 484) / 580, 0, 1)) }

            //  Application Mixer Card (`y = 200..524`, 4 visible rows + smooth manual scroll up to 8 streams)
            box { from: 464, 200; size: 620, 324; corner: 18; color: ct.card2; opacity: 64% }
            box { from: 464, 200; size: 620, 324; corner: 18; stroke: 1; color: ink; opacity: 10% }
            text "APPLICATION MIXER" { at: 484, 222; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            box { from: 992, 212; size: 72, 20; corner: 10; color: ct.primary; opacity: if(audio_apps_count > 0, 16%, 6%) }
            text number(audio_apps_count, 0, " active") { at: 1028, 222; anchor: center; size: 9.5; weight: 700; color: if(audio_apps_count > 0, ct.primary, faint); family: "Space Grotesk" }

            group {
                clip box { from: 478, 244; size: 592, 268 }
                zone box ct_app_wheel { from: 478, 244; size: 592, 268 }
                on scroll ct_app_wheel { ct_app_sc_to = clamp(ct_app_sc_to - wheel * 48, 0, if(app.can_scroll, app.max_s, 0)) }

                group {
                    move: 0, -app.off
                    repeat a in 0..8 {
                        let ry = 248 + a * 64
                        let vis_y = ry - app.off
                        let row_in_view = a < audio_apps_count and vis_y + 56 > 244 and vis_y < 512
                        let app_col = if(mod(a, 2) == 0, ct.secondary, ct.primary)
                        let row_col = if(audio_apps.$a.muted, alert, app_col)
                        group {
                            show: a < audio_apps_count
                            box { from: 484, ry; size: 580, 56; corner: 12; color: deep; opacity: 34% + 12% * ct_app_sl.$a.hover }
                            box { from: 484, ry; size: 580, 56; corner: 12; stroke: 1; color: if(audio_apps.$a.active, row_col, ink); opacity: if(audio_apps.$a.active, 20%, 8%) }
                            ellipse { at: 500, ry + 28; radius: 3.5; color: if(audio_apps.$a.muted, alert, if(audio_apps.$a.active, app_col, faint)); opacity: if(audio_apps.$a.active or audio_apps.$a.muted, 92%, 45%) }
                            text audio_apps.$a.name  { at: 514, ry + 19; anchor: left center; size: 12; weight: 700; color: if(audio_apps.$a.muted, faint, ink); width: 154; lines: 1; family: "Space Grotesk" }
                            text audio_apps.$a.media { at: 514, ry + 37; anchor: left center; size: 9.5; color: faint; width: 154; lines: 1; family: "Space Grotesk" }

                            box { from: 676, ry + 15; size: 52, 26; corner: 13; color: if(audio_apps.$a.muted, alert, app_col); opacity: if(audio_apps.$a.muted, 24%, 11%) + 12% * ct_app_mute.$a.hover }
                            box { from: 676, ry + 15; size: 52, 26; corner: 13; stroke: 1; color: if(audio_apps.$a.muted, alert, app_col); opacity: 28% }
                            text if(audio_apps.$a.muted, "Muted", "Mute") { at: 702, ry + 28; anchor: center; size: 9.5; weight: 700; color: if(audio_apps.$a.muted, alert, app_col); family: "Space Grotesk" }
                            zone box ct_app_mute.$a { from: 676, ry + 15; size: 52, 26; corner: 13; cursor: pointer; active: row_in_view; label: audio_apps.$a.name }
                            on press  ct_app_mute.$a { ripple ct_app_mute.$a; emit ui_sound; emit center_app_mute(a) }
                            on scroll ct_app_mute.$a { ct_app_sc_to = clamp(ct_app_sc_to - wheel * 48, 0, if(app.can_scroll, app.max_s, 0)) }

                            CtSlider(744, ry + 28, 250, clamp(audio_apps.$a.vol, 0, 1), ct_app_sl.$a.hover, row_col)
                            zone box ct_app_sl.$a { from: 738, ry + 12; size: 262, 32; cursor: pointer; active: row_in_view; label: audio_apps.$a.name }
                            on press  ct_app_sl.$a { emit center_app_vol(a * 1000 + round(clamp((pointer.x - ct.px - 744) / 250, 0, 1) * 100)) }
                            on drag   ct_app_sl.$a { emit center_app_vol(a * 1000 + round(clamp((pointer.x - ct.px - 744) / 250, 0, 1) * 100)) }
                            on scroll ct_app_sl.$a { ct_app_sc_to = clamp(ct_app_sc_to - wheel * 48, 0, if(app.can_scroll, app.max_s, 0)) }

                            text number(clamp(audio_apps.$a.vol, 0, 1.5) * 100, 0, "%") { at: 1054, ry + 28; anchor: right center; size: 12.5; weight: 700; color: if(audio_apps.$a.muted, alert, ink); family: "Space Grotesk" }
                        }
                    }
                }
            }

            //  Per-App Mixer Scrollbar when > 4 streams are present
            group {
                show: app.can_scroll
                box { from: 1074, 244; size: 4, 268; corner: 2; color: ink; opacity: 8% }
                box { from: 1074, 244 + (268 - app.th) * clamp(app.sc / app.max_s, 0, 1); size: 4, app.th; corner: 2; color: if(ct_app_bar.hover > 0.4, ct.primary, ct.secondary); opacity: 48% + 42% * ct_app_bar.hover }
                zone box ct_app_bar { from: 1068, 244; size: 14, 268; cursor: pointer; active: app.can_scroll; label: "Scroll application mixer" }
                on press ct_app_bar { ct_app_sc_to = clamp((((pointer.y - notch_clock_h) - 244) - app.th / 2) / max(1, 268 - app.th) * app.max_s, 0, app.max_s) }
                on drag  ct_app_bar { ct_app_sc_to = clamp((((pointer.y - notch_clock_h) - 244) - app.th / 2) / max(1, 268 - app.th) * app.max_s, 0, app.max_s) }
            }

            text "No applications playing audio" { at: 774, 364; anchor: center; size: 13.5; weight: 700; color: faint; show: audio_apps_count < 1; family: "Space Grotesk" }
            text "Start playback in a browser or media player to control app levels." { at: 774, 386; anchor: center; size: 10.5; color: faint; opacity: 78%; show: audio_apps_count < 1; family: "Space Grotesk" }

            //  24-Band Frequency Spectrum (`y = 536..662`)
            box { from: 464, 536; size: 620, 126; corner: 18; color: ct.card2; opacity: 64% }
            box { from: 464, 536; size: 620, 126; corner: 18; stroke: 1; color: ink; opacity: 10% }
            text "FREQUENCY SPECTRUM" { at: 484, 554; anchor: left center; size: 10; weight: 700; color: ct.primary; family: "Space Grotesk" }
            box { from: 484, 568; size: 580, 82; corner: 12; color: deep; opacity: 38% }
            repeat b in 0..24 {
                let sv = clamp(pick(b, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), 0, 1)
                let bh = 4 + 62 * if(music_on, sv, 0.05)
                box { from: 496 + b * 23.6, 644 - bh; size: 16, bh; corner: 5; color: mix(ct.primary, ct.secondary, b / 23); opacity: if(music_on, 88%, 22%) }
            }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 5 · CALENDAR (directional month slide + full lunar/holiday UI)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 5
            text "CALENDAR" { at: 36, 119; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text ct_month     { at: 36, 145; anchor: left center; size: 24; weight: 700; color: ink; family: "Noto Sans CJK SC" }
            text ct_month_sub { at: 36, 166; anchor: left center; size: 10; weight: 700; color: faint; family: "Noto Sans CJK SC" }
            text "悬停日期查看农历" { at: 754, 166; anchor: right center; size: 10; weight: 600; color: faint; width: 400; lines: 1; show: center_cal_hover < 0; family: "Noto Sans CJK SC" }
            text ct_days[clamp(center_cal_hover, 0, 41)].hover { at: 754, 166; anchor: right center; size: 10.5; weight: 600; color: ct.primary; width: 400; lines: 1; show: center_cal_hover >= 0; family: "Noto Sans CJK SC" }

            box { from: 884, 128; size: 38, 34; corner: 17; color: ink; opacity: 5% + 10% * ct_cal_prev.hover }
            text "‹" { at: 903, 145; anchor: center; size: 20; color: ink; family: "Space Grotesk" }
            zone box ct_cal_prev { from: 884, 128; size: 38, 34; corner: 17; cursor: pointer; label: "Previous month" }
            on press ct_cal_prev { emit ui_sound; emit center_cal_step(-1) }

            box { from: 928, 128; size: 38, 34; corner: 17; color: ink; opacity: 5% + 10% * ct_cal_next.hover }
            text "›" { at: 947, 145; anchor: center; size: 20; color: ink; family: "Space Grotesk" }
            zone box ct_cal_next { from: 928, 128; size: 38, 34; corner: 17; cursor: pointer; label: "Next month" }
            on press ct_cal_next { emit ui_sound; emit center_cal_step(1) }

            box { from: 976, 128; size: 88, 34; corner: 17; color: ct.primary; opacity: 12% + 14% * ct_cal_today.hover }
            text "今天" { at: 1020, 145; anchor: center; size: 11; weight: 700; color: ct.primary; family: "Noto Sans CJK SC" }
            zone box ct_cal_today { from: 976, 128; size: 88, 34; corner: 17; cursor: pointer; label: "Today" }
            on press ct_cal_today { emit ui_sound; emit center_cal_today }

            //  Left: Month Grid Card with directional slide
            box { from: 36, 184; size: 720, 460; corner: 18; color: ct.card2; opacity: 62% }
            box { from: 36, 184; size: 720, 460; corner: 18; stroke: 1; color: ink; opacity: 10% }
            repeat w in 0..7 {
                text pick(w, "一", "二", "三", "四", "五", "六", "日") { at: 96 + w * 101, 208; anchor: center; size: 10; weight: 700; color: if(w > 4, ct.secondary, faint); family: "Noto Sans CJK SC" }
            }
            line { from: 50, 224; to: 742, 224; width: 1; color: ink; opacity: 9% }

            group {
                clip box { from: 38, 226; size: 716, 416; corner: 16 }
                group {
                    opacity: ct_cal_slide
                    move: center_cal_dir * 34 * (1 - ct_cal_slide) * if(motion.reduced, 0, 1), 0
                    repeat d in 0..42 {
                        let dc = mod(d, 7)
                        let dr = floor(d / 7)
                        let dx = 50 + dc * 101
                        let dy = 234 + dr * 66
                        let is_off = ct_days.$d.off
                        let is_work = ct_days.$d.work
                        let is_anniv = ct_days.$d.anniv_count > 0
                        let is_today = ct_days.$d.today
                        box { from: dx, dy; size: 92, 56; corner: 11; color: if(is_today, ct.primary, if(is_off, ct.off, if(is_work, ct.work, if(is_anniv, ct.secondary, ink)))); opacity: if(is_today, 14%, if(is_off or is_work, 8%, if(is_anniv, 5%, 2%))) + 5% * ct_day_hit.$d.hover }
                        box { from: dx, dy; size: 92, 56; corner: 11; stroke: 1; color: if(is_today, ct.primary, if(is_off, ct.off, if(is_work, ct.work, if(is_anniv, ct.secondary, ink)))); opacity: if(is_today, 42%, if(is_off or is_work, 30%, if(is_anniv, 20%, 5%))) + 14% * ct_day_hit.$d.hover }
                        text number(ct_days.$d.day, 0, "") { at: dx + 46, dy + 17; anchor: center; size: 17; weight: if(is_today, 700, 500); color: if(ct_days.$d.cur, if(is_today, ct.primary, ink), faint); opacity: if(ct_days.$d.cur, 100%, 45%); family: "Space Grotesk" }
                        ellipse { at: dx + 82, dy + 9; radius: 2.3; color: ct.primary; show: is_today }
                        text ct_days.$d.label { at: dx + 46, dy + 33; anchor: center; size: 7.5; color: if(is_today, ct.primary, if(is_off, ct.off, if(is_work, ct.work, if(is_anniv, ct.secondary, faint)))); width: 86; lines: 1; family: "Noto Sans CJK SC" }
                        text "休" { at: dx + 9, dy + 46; anchor: left center; size: 7; weight: 700; color: ct.off; show: is_off; family: "Noto Sans CJK SC" }
                        text "班" { at: dx + 9, dy + 46; anchor: left center; size: 7; weight: 700; color: ct.work; show: is_work; family: "Noto Sans CJK SC" }
                        text ct_days.$d.holiday { at: dx + 21, dy + 46; anchor: left center; size: 6.5; color: if(is_off, ct.off, ct.work); width: 50; lines: 1; show: is_off or is_work; family: "Noto Sans CJK SC" }
                        text ct_days.$d.anniv { at: dx + 8, dy + 46; anchor: left center; size: 6.5; color: ct.secondary; width: 66; lines: 1; show: is_anniv and not is_off and not is_work; family: "Noto Sans CJK SC" }
                        repeat a in 0..2 {
                            ellipse { at: dx + 78 + a * 6, dy + 46; radius: 2; color: ct.secondary; opacity: 82%; show: is_anniv and ct_days.$d.anniv_count > a }
                        }
                        zone box ct_day_hit.$d { from: dx, dy; size: 92, 56; corner: 11; cursor: pointer; label: ct_days.$d.hover }
                        on enter ct_day_hit.$d { center_cal_hover = d }
                        on leave ct_day_hit.$d { center_cal_hover = -1 }
                    }
                }
            }

            //  Right: Today Ring + Month Progress + Countdown Reminders
            box { from: 774, 184; size: 290, 460; corner: 18; color: ct.card2; opacity: 62% }
            box { from: 774, 184; size: 290, 460; corner: 18; stroke: 1; color: ink; opacity: 10% }
            ellipse { at: 919, 316; radius: 92; stroke: 6; color: ink; opacity: 7% }
            CtGlowArc(919, 316, 92, 360 * center_cal_progress * 1deg, 180 * center_cal_progress * 1deg, 6, ct.secondary)
            text ct_today_month { at: 919, 272; anchor: center; size: 11; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text ct_today_day   { at: 919, 318; anchor: center; size: 58; weight: 700; color: ink; family: "Space Grotesk" }
            text ct_today_year  { at: 919, 364; anchor: center; size: 11; color: faint; family: "Space Grotesk" }
            text ct_weekday     { at: 919, 434; anchor: center; size: 14; weight: 600; color: ct.primary; family: "Noto Sans CJK SC" }
            text ct_weeknum     { at: 919, 456; anchor: center; size: 10.5; color: faint; family: "Space Grotesk" }
            line { from: 800, 480; to: 1038, 480; width: 1; color: ink; opacity: 10% }
            text ct_countdown_title { at: 800, 502; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Noto Sans CJK SC" }
            repeat c in 0..2 {
                let cy = 524 + c * 56
                group {
                    show: c < ct_countdown.count
                    box { from: 800, cy; size: 240, 48; corner: 11; color: ink; opacity: 3% }
                    box { from: 800, cy; size: 240, 48; corner: 11; stroke: 1; color: ct.secondary; opacity: if(ct_countdown.$c.days >= 0 and ct_countdown.$c.days <= 7, 36%, 14%) }
                    line { from: 800, cy + 8; to: 800, cy + 40; width: 2.5; color: ct.secondary; opacity: if(ct_countdown.$c.days >= 0 and ct_countdown.$c.days <= 7, 90%, 55%) }
                    text ct_countdown.$c.title { at: 812, cy + 15; anchor: left center; size: 11; weight: 600; color: ink; width: 158; lines: 1; family: "Noto Sans CJK SC" }
                    text ct_countdown.$c.when  { at: 1028, cy + 15; anchor: right center; size: 9; weight: 700; color: if(ct_countdown.$c.days >= 0 and ct_countdown.$c.days <= 7, ct.primary, faint); family: "Noto Sans CJK SC" }
                    text ct_countdown.$c.date  { at: 812, cy + 33; anchor: left center; size: 9; color: faint; family: "Noto Sans CJK SC" }
                }
            }
            text "当月暂无纪念日" { at: 800, 536; anchor: left center; size: 11; color: faint; show: ct_countdown.count < 1; family: "Noto Sans CJK SC" }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  TAB 6 · ACTIONS (Surface ripples + Radial Q-fill + 1s Hold-to-Confirm)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: center_tab == 6
            text "QUICK ACTIONS" { at: 36, 120; anchor: left center; size: 10; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text "Jump straight to a surface, flip toggles, or hold 1 s on a session card." { at: 36, 140; anchor: left center; size: 13; color: faint; family: "Space Grotesk" }

            //  1. Surface Launcher Row
            text "SURFACES" { at: 36, 168; anchor: left center; size: 9.5; weight: 700; color: faint; family: "Space Grotesk" }
            box { from: 36, 184; size: 244, 100; corner: 16; color: ct.card2; opacity: 64% }
            box { from: 36, 184; size: 244, 100; corner: 16; color: ct.primary; opacity: 12% * ct_action_search.hover }
            box { from: 36, 184; size: 244, 100; corner: 16; stroke: 1; color: ct.primary; opacity: 16% + 36% * ct_action_search.hover }
            ellipse { at: 66, 214; radius: 13; stroke: 1.7; color: ct.primary }
            line { from: 75, 223; to: 83, 231; width: 1.8; color: ct.primary }
            text "Search" { at: 54, 250; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "Apps, clipboard & web" { at: 54, 268; anchor: left center; size: 10.5; color: faint; family: "Space Grotesk" }
            zone box ct_action_search { from: 36, 184; size: 244, 100; corner: 16; cursor: pointer; label: "Search" }
            on press ct_action_search { ripple ct_action_search; emit ui_sound; emit ipc_open_search }

            box { from: 290, 184; size: 244, 100; corner: 16; color: ct.card2; opacity: 64% }
            box { from: 290, 184; size: 244, 100; corner: 16; color: ct.secondary; opacity: 12% * ct_action_settings.hover }
            box { from: 290, 184; size: 244, 100; corner: 16; stroke: 1; color: ct.secondary; opacity: 16% + 36% * ct_action_settings.hover }
            ellipse { at: 320, 214; radius: 11; stroke: 1.7; color: ct.secondary }
            ellipse { at: 320, 214; radius: 4; stroke: 1.4; color: ct.secondary }
            text "Settings" { at: 308, 250; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "Glass, frame & theme" { at: 308, 268; anchor: left center; size: 10.5; color: faint; family: "Space Grotesk" }
            zone box ct_action_settings { from: 290, 184; size: 244, 100; corner: 16; cursor: pointer; label: "Settings" }
            on press ct_action_settings { ripple ct_action_settings; emit ui_sound; emit ipc_open_settings }

            box { from: 544, 184; size: 244, 100; corner: 16; color: ct.card2; opacity: 64% }
            box { from: 544, 184; size: 244, 100; corner: 16; color: ct.primary; opacity: 12% * ct_action_notifications.hover }
            box { from: 544, 184; size: 244, 100; corner: 16; stroke: 1; color: ct.primary; opacity: 16% + 36% * ct_action_notifications.hover }
            path { at: 574, 216; stroke: 1.7; color: ct.primary; move -8, 6; line -8, -1; curve 8, -1 via 0, -13; line 8, 6; close }
            text "Notifications" { at: 562, 250; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "History & DND" { at: 562, 268; anchor: left center; size: 10.5; color: faint; family: "Space Grotesk" }
            zone box ct_action_notifications { from: 544, 184; size: 244, 100; corner: 16; cursor: pointer; label: "Notifications" }
            on press ct_action_notifications { ripple ct_action_notifications; emit ui_sound; emit ipc_open_notifications }

            box { from: 798, 184; size: 244, 100; corner: 16; color: ct.card2; opacity: 64% }
            box { from: 798, 184; size: 244, 100; corner: 16; color: ct.secondary; opacity: 12% * ct_action_lock.hover }
            box { from: 798, 184; size: 244, 100; corner: 16; stroke: 1; color: ct.secondary; opacity: 16% + 36% * ct_action_lock.hover }
            box { from: 816, 212; size: 18, 13; corner: 3; stroke: 1.6; color: ct.secondary }
            path { at: 825, 212; stroke: 1.6; color: ct.secondary; move -5, 0; line -5, -5; curve 5, -5 via 0, -10; line 5, 0 }
            text "Lock" { at: 816, 250; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
            text "Lock screen now" { at: 816, 268; anchor: left center; size: 10.5; color: faint; family: "Space Grotesk" }
            zone box ct_action_lock { from: 798, 184; size: 244, 100; corner: 16; cursor: pointer; label: "Lock" }
            on press ct_action_lock { ripple ct_action_lock; emit ui_sound; emit lock_now }

            //  2. Quick Controls with Clipped Radial Accent Wash + Press-Squash Switches
            text "QUICK CONTROLS" { at: 36, 308; anchor: left center; size: 9.5; weight: 700; color: faint; family: "Space Grotesk" }
            repeat q in 0..4 {
                let qx = 36 + q * 254
                let qy = 324
                let q_on = pick(q, music_frame_on, glass_on, bt_on, wall_auto)
                let q_k  = pick(q, ct_q_knob.0, ct_q_knob.1, ct_q_knob.2, ct_q_knob.3)
                let q_fl = pick(q, ct_q_fill.0, ct_q_fill.1, ct_q_fill.2, ct_q_fill.3)
                let q_col = pick(q, ct.primary, ct.secondary, ct.primary, ct.secondary)
                let ps = ct_action_quick.$q.pressed

                box { from: qx, qy; size: 244, 96; corner: 16; color: ct.card2; opacity: 64% }
                group {
                    clip box { from: qx, qy; size: 244, 96; corner: 16 }
                    ellipse { at: qx + 22, qy + 28; radius: 280 * clamp(q_fl, 0, 1); color: q_col; opacity: 16% * clamp(q_fl, 0, 1); show: q_fl > 0.01 }
                }
                box { from: qx, qy; size: 244, 96; corner: 16; stroke: 1; color: if(q_on, q_col, ink); opacity: if(q_on, 36%, 9%) + 14% * ct_action_quick.$q.hover }
                ellipse { at: qx + 22, qy + 28; radius: 6; color: q_col; opacity: if(q_on, 92%, 28%) }
                text pick(q, "Frame music", "Glass", "Bluetooth", "Wallpaper") { at: qx + 38, qy + 28; anchor: left center; size: 13.5; weight: 700; color: ink; family: "Space Grotesk" }
                text pick(q, "Notch frame bars", "Lens & refraction", bt_sub, "Auto rotate pictures") { at: qx + 18, qy + 52; anchor: left center; size: 10; color: faint; width: 196; lines: 1; family: "Space Grotesk" }
                //  Press-squash capsule switch
                let m = clamp(4 * q_k * (1 - q_k), 0, 1)
                box { from: qx + 200, qy + 66 + 0.8 * ps; size: 30, 16 - 1.6 * ps; corner: 8; color: mix(ink, q_col, q_k); opacity: 22% + 70% * q_k }
                box { at: qx + 208 + 14 * q_k, qy + 74; size: (11 + 5 * m) * (1 + 0.14 * ps), (11 - 2 * m) * (1 - 0.14 * ps); corner: 5.5; color: mix(faint, ct.card, q_k) }
                zone box ct_action_quick.$q { from: qx, qy; size: 244, 96; corner: 16; cursor: pointer; role: toggle; checked: q_on; label: pick(q, "Frame music", "Glass", "Bluetooth", "Wallpaper rotation") }
                on press ct_action_quick.$q { emit ui_sound; emit center_quick(q) }
            }

            //  3. Session Safety Row: 1-second Hold-to-Confirm + Liquid Fill + Shake + Countdown + Particle Shatter
            text "SESSION (HOLD 1 S)" { at: 36, 444; anchor: left center; size: 9.5; weight: 700; color: faint; family: "Space Grotesk" }

            //  Card 0: Log out
            let pwx0 = sin(ct_clk * 4200) * 3.5 * pw_hp0 * if(motion.reduced, 0, 1)
            let pwy0 = cos(ct_clk * 5100 + 1.1) * 3.5 * pw_hp0 * if(motion.reduced, 0, 1)
            let pwt0 = pw_hp0 < 0.03 and ct_clk - pw_h0 >= 0 and ct_clk - pw_h0 < 1.3
            group {
                move: pwx0, pwy0
                box { from: 36, 462; size: 330, 104; corner: 16; color: ct.card2; opacity: 64% }
                group {
                    clip box { from: 36, 462; size: 330, 104; corner: 16 }
                    let fh0 = 104 * clamp(pw_hp0, 0, 1)
                    box { from: 36, 566 - fh0; size: 330, fh0; color: ct.primary; opacity: 26% }
                    box { from: 36, 566 - fh0; size: 330, 2; color: ct.primary; opacity: 80% * clamp(pw_hp0 * 8, 0, 1) }
                }
                box { from: 36, 462; size: 330, 104; corner: 16; stroke: 1.2; color: ct.primary; opacity: 18% + 36% * max(ct_pwr_0.hover, pw_hp0) }
                ellipse { at: 72, 498; radius: 16; color: ct.primary; opacity: 14% }
                line { from: 66, 498; to: 78, 498; width: 1.6; color: ct.primary }
                path { at: 78, 498; stroke: 1.6; color: ct.primary; move -4, -5; line 4, 0; line -4, 5 }
                text "Log out" { at: 102, 490; anchor: left center; size: 17; weight: 700; color: ink; show: pw_hp0 < 0.03 and not pwt0; family: "Space Grotesk" }
                text "Hold " .. number(max(0, 1 - pw_hp0), 1, " s") { at: 102, 490; anchor: left center; size: 17; weight: 700; color: ct.primary; show: pw_hp0 >= 0.03; family: "Space Grotesk" }
                text "Hold 1 s to log out" { at: 102, 490; anchor: left center; size: 15.5; weight: 700; color: ct.primary; show: pwt0; family: "Space Grotesk" }
                text "End niri session cleanly" { at: 102, 514; anchor: left center; size: 11; color: faint; family: "Space Grotesk" }
            }
            particles { at: 201, 514; area: 280, 84; count: 28; life: 0.45s .. 0.9s; speed: 80 .. 240; spread: 360deg
                gravity: 0, 380; drag: 1.3; size: 6, 2; colors: ct.primary, ink; opacity: 100%, 0%; shape: square; burst: pw_shatter0 }
            zone box ct_pwr_0 { from: 36, 462; size: 330, 104; corner: 16; cursor: pointer; label: "Hold 1 second to log out" }
            on press   ct_pwr_0 { pw_s0 = ct_clk; pw_d0 = true; pw_h0 = -10 }
            on release ct_pwr_0 { pw_d0 = false; pw_h0 = if(ct_clk - pw_s0 < 0.98 and (ct_clk - pw_b0 > 1.0), ct_clk, -10) }
            on hold    ct_pwr_0 for 1000ms { pw_d0 = false; pw_h0 = -10; pw_b0 = ct_clk; emit ui_sound; emit pw_shatter0; emit center_power_exec(0) }

            //  Card 1: Restart
            let pwx1 = sin(ct_clk * 4200 + 1.7) * 3.5 * pw_hp1 * if(motion.reduced, 0, 1)
            let pwy1 = cos(ct_clk * 5100 + 2.8) * 3.5 * pw_hp1 * if(motion.reduced, 0, 1)
            let pwt1 = pw_hp1 < 0.03 and ct_clk - pw_h1 >= 0 and ct_clk - pw_h1 < 1.3
            group {
                move: pwx1, pwy1
                box { from: 386, 462; size: 330, 104; corner: 16; color: ct.card2; opacity: 64% }
                group {
                    clip box { from: 386, 462; size: 330, 104; corner: 16 }
                    let fh1 = 104 * clamp(pw_hp1, 0, 1)
                    box { from: 386, 566 - fh1; size: 330, fh1; color: ct.secondary; opacity: 26% }
                    box { from: 386, 566 - fh1; size: 330, 2; color: ct.secondary; opacity: 80% * clamp(pw_hp1 * 8, 0, 1) }
                }
                box { from: 386, 462; size: 330, 104; corner: 16; stroke: 1.2; color: ct.secondary; opacity: 18% + 36% * max(ct_pwr_1.hover, pw_hp1) }
                ellipse { at: 422, 498; radius: 16; color: ct.secondary; opacity: 14% }
                arc { at: 422, 498; radius: 8; span: 300deg; width: 1.6; color: ct.secondary; rotate: -120deg }
                path { at: 429, 491; stroke: 1.6; color: ct.secondary; move -3, -3; line 3, 0; line -3, 3 }
                text "Restart" { at: 452, 490; anchor: left center; size: 17; weight: 700; color: ink; show: pw_hp1 < 0.03 and not pwt1; family: "Space Grotesk" }
                text "Hold " .. number(max(0, 1 - pw_hp1), 1, " s") { at: 452, 490; anchor: left center; size: 17; weight: 700; color: ct.secondary; show: pw_hp1 >= 0.03; family: "Space Grotesk" }
                text "Hold 1 s to restart" { at: 452, 490; anchor: left center; size: 15.5; weight: 700; color: ct.secondary; show: pwt1; family: "Space Grotesk" }
                text "Reboot this computer" { at: 452, 514; anchor: left center; size: 11; color: faint; family: "Space Grotesk" }
            }
            particles { at: 551, 514; area: 280, 84; count: 28; life: 0.45s .. 0.9s; speed: 80 .. 240; spread: 360deg
                gravity: 0, 380; drag: 1.3; size: 6, 2; colors: ct.secondary, ink; opacity: 100%, 0%; shape: square; burst: pw_shatter1 }
            zone box ct_pwr_1 { from: 386, 462; size: 330, 104; corner: 16; cursor: pointer; label: "Hold 1 second to restart" }
            on press   ct_pwr_1 { pw_s1 = ct_clk; pw_d1 = true; pw_h1 = -10 }
            on release ct_pwr_1 { pw_d1 = false; pw_h1 = if(ct_clk - pw_s1 < 0.98 and (ct_clk - pw_b1 > 1.0), ct_clk, -10) }
            on hold    ct_pwr_1 for 1000ms { pw_d1 = false; pw_h1 = -10; pw_b1 = ct_clk; emit ui_sound; emit pw_shatter1; emit center_power_exec(1) }

            //  Card 2: Shut down
            let pwx2 = sin(ct_clk * 4200 + 3.1) * 3.5 * pw_hp2 * if(motion.reduced, 0, 1)
            let pwy2 = cos(ct_clk * 5100 + 4.4) * 3.5 * pw_hp2 * if(motion.reduced, 0, 1)
            let pwt2 = pw_hp2 < 0.03 and ct_clk - pw_h2 >= 0 and ct_clk - pw_h2 < 1.3
            group {
                move: pwx2, pwy2
                box { from: 736, 462; size: 330, 104; corner: 16; color: ct.card2; opacity: 64% }
                group {
                    clip box { from: 736, 462; size: 330, 104; corner: 16 }
                    let fh2 = 104 * clamp(pw_hp2, 0, 1)
                    box { from: 736, 566 - fh2; size: 330, fh2; color: alert; opacity: 28% }
                    box { from: 736, 566 - fh2; size: 330, 2; color: alert; opacity: 85% * clamp(pw_hp2 * 8, 0, 1) }
                }
                box { from: 736, 462; size: 330, 104; corner: 16; stroke: 1.2; color: alert; opacity: 22% + 42% * max(ct_pwr_2.hover, pw_hp2) }
                ellipse { at: 772, 498; radius: 16; color: alert; opacity: 16% }
                arc { at: 772, 498; radius: 7.5; span: 280deg; width: 1.7; color: alert; rotate: -50deg }
                line { from: 772, 490; to: 772, 498; width: 1.7; color: alert }
                text "Shut down" { at: 802, 490; anchor: left center; size: 17; weight: 700; color: ink; show: pw_hp2 < 0.03 and not pwt2; family: "Space Grotesk" }
                text "Hold " .. number(max(0, 1 - pw_hp2), 1, " s") { at: 802, 490; anchor: left center; size: 17; weight: 700; color: alert; show: pw_hp2 >= 0.03; family: "Space Grotesk" }
                text "Hold 1 s to shut down" { at: 802, 490; anchor: left center; size: 15.5; weight: 700; color: alert; show: pwt2; family: "Space Grotesk" }
                text "Power off hardware safely" { at: 802, 514; anchor: left center; size: 11; color: faint; family: "Space Grotesk" }
            }
            particles { at: 901, 514; area: 280, 84; count: 28; life: 0.45s .. 0.9s; speed: 80 .. 240; spread: 360deg
                gravity: 0, 380; drag: 1.3; size: 6, 2; colors: alert, ct.primary; opacity: 100%, 0%; shape: square; burst: pw_shatter2 }
            zone box ct_pwr_2 { from: 736, 462; size: 330, 104; corner: 16; cursor: pointer; label: "Hold 1 second to shut down" }
            on press   ct_pwr_2 { pw_s2 = ct_clk; pw_d2 = true; pw_h2 = -10 }
            on release ct_pwr_2 { pw_d2 = false; pw_h2 = if(ct_clk - pw_s2 < 0.98 and (ct_clk - pw_b2 > 1.0), ct_clk, -10) }
            on hold    ct_pwr_2 for 1000ms { pw_d2 = false; pw_h2 = -10; pw_b2 = ct_clk; emit ui_sound; emit pw_shatter2; emit center_power_exec(2) }

            text "**Session cards** require a continuous 1-second hold so an accidental tap won't sign you out. No suspend or sleep action lives here." { at: 36, 610; anchor: left center; size: 11; color: faint; family: "Space Grotesk"; markdown: true; selectable: true }
            text "Esc or the cross closes the panel." { at: 1064, 610; anchor: right center; size: 10; color: faint; opacity: 70%; family: "Space Grotesk" }
        }
    }

    //  Keyboard hint & Escape handling
    text "1–7  TABS   ·   TAB  NEXT   ·   ESC  CLOSE" { at: 36, 697; anchor: left center; size: 9; weight: 700; color: faint; opacity: 45%; family: "Space Grotesk" }
    on key Escape while center_open { emit center_key_escape }

    //  ── External Power Fallback Modal (if `center_power_confirm` set) ───
    group {
        show: center_open and (center_power_confirm >= 0 or ct_power_p > 0.01)
        opacity: ct_power_p
        box { from: 0, 0; size: 1120, 720; corner: 26; color: #00000075 }
        zone box ct_power_shield { from: 0, 0; size: 1120, 720; active: center_power_confirm >= 0; label: "Dismiss session confirmation" }
        on press ct_power_shield { emit center_power_cancel }
        group {
            move: 260, 215
            pivot: 300, 145
            scale: 0.94 + 0.06 * ct_power_p
            box { from: 40, 40; size: 520, 210; corner: 22; color: ct.card; opacity: 94% }
            box { from: 40, 40; size: 520, 210; corner: 22; stroke: 1.5; color: alert; opacity: 38% }
            zone box ct_power_body { from: 40, 40; size: 520, 210; corner: 22; active: center_power_confirm >= 0; label: "Session confirmation card" }
            on press ct_power_body { center_power_confirm = center_power_confirm }
            text "SESSION ACTION" { at: 68, 66; anchor: left center; size: 9.5; weight: 700; color: ct.secondary; family: "Space Grotesk" }
            text pick(center_power_confirm, "Log out?", "Restart?", "Shut down?") { at: 68, 108; anchor: left center; size: 28; weight: 700; color: ink; family: "Space Grotesk" }
            text pick(center_power_confirm, "End this niri session and return to the greeter.", "Reboot the machine. Open work will be interrupted.", "Power off the machine. Open work will be interrupted.") { at: 68, 138; anchor: left top; size: 12; color: faint; width: 464; lines: 2; line_height: 1.3; family: "Space Grotesk" }
            box { from: 68, 194; size: 130, 34; corner: 17; color: ink; opacity: 6% + 8% * ct_power_cancel.hover }
            text "Cancel" { at: 133, 211; anchor: center; size: 12; weight: 700; color: ink; family: "Space Grotesk" }
            zone box ct_power_cancel { from: 68, 194; size: 130, 34; corner: 17; cursor: pointer; role: button; label: "Cancel power action" }
            on press ct_power_cancel { emit ui_sound; emit center_power_cancel }
            box { from: 402, 194; size: 130, 34; corner: 17; color: alert; opacity: 76% + 24% * ct_power_confirm.hover }
            text "Confirm" { at: 467, 211; anchor: center; size: 12; weight: 700; color: ct.card; family: "Space Grotesk" }
            zone box ct_power_confirm { from: 402, 194; size: 130, 34; corner: 17; cursor: pointer; role: button; agent: no; label: "Confirm power action" }
            on press ct_power_confirm { emit ui_sound; emit center_power_do }
        }
    }

    //  ── Audio Output Device Picker Shield (`audio_outputs` rendered by popup in frame.plm) ──
    group {
        show: center_open and audio_pick_open and center_tab == 4
        box { from: 0, 0; size: 1120, 720; corner: 26; color: #00000075 }
        zone box ap_shield { from: 0, 0; size: 1120, 720; label: "Close output picker" }
        on press ap_shield { audio_pick_open = false }
    }
}
