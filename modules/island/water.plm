part IslandWater {
    //  Four screen-edge water strips for the Island layout.  The bar lives in
    //  its own surface; this part only paints the music.
    surface island_water_top {
        size: full, 120
        anchor: top
        reserve: 0
        rate: 120, 30 while quiet

        shader water {
            at: 46, 0
            size: island_water_top.width - 92, 72
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, wave_h + wave_b, wave_ripples * 10 + wave_amp
            colors: aqua, azure
            show: wave_on and music_on
        }
        box { from: 46, 0; size: island_water_top.width - 92, 1.5; color: aqua; opacity: 22% }

        shader corner {
            at: 0, 0
            size: 46, 46
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, wave_h + wave_b, if(wave_on and music_on, 100, 0) + wave_ripples * 1000 + wave_amp * 0.1
            colors: aqua, azure
        }
        shader corner {
            at: island_water_top.width - 46, 0
            size: 46, 46
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, wave_h + wave_b, if(wave_on and music_on, 101, 1) + wave_ripples * 1000 + wave_amp * 0.1
            colors: aqua, azure
        }
    }

    surface island_water_left {
        size: 120, full
        anchor: left
        reserve: 0
        rate: 120, 30 while quiet

        shader water {
            at: 0, 46
            size: 72, island_water_left.height - 92
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, 2000000 + wave_h + wave_b, wave_ripples * 10 + wave_amp
            colors: aqua, azure
            show: wave_on and music_on
        }
        box { from: 0, 46; size: 1.5, island_water_left.height - 92; color: aqua; opacity: 22% }
    }

    surface island_water_right {
        size: 120, full
        anchor: right
        reserve: 0
        rate: 120, 30 while quiet

        shader water {
            at: 48, 46
            size: 72, island_water_right.height - 92
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, 3000000 + wave_h + wave_b, wave_ripples * 10 + wave_amp
            colors: aqua, azure
            show: wave_on and music_on
        }
        box { from: 118.5, 46; size: 1.5, island_water_right.height - 92; color: aqua; opacity: 22% }
    }

    surface island_water_bottom {
        size: full, 120
        anchor: bottom
        reserve: 0
        rate: 120, 30 while quiet

        shader water {
            at: 46, 48
            size: island_water_bottom.width - 92, 72
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, 1000000 + wave_h + wave_b, wave_ripples * 10 + wave_amp
            colors: aqua, azure
            show: wave_on and music_on
        }
        box { from: 46, 118.5; size: island_water_bottom.width - 92, 1.5; color: aqua; opacity: 22% }

        shader corner {
            at: 0, 74
            size: 46, 46
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, wave_h + wave_b, if(wave_on and music_on, 102, 2) + wave_ripples * 1000 + wave_amp * 0.1
            colors: aqua, azure
        }
        shader corner {
            at: island_water_bottom.width - 46, 74
            size: 46, 46
            values: band.s.0 * depth_k, band.s.1 * depth_k, band.s.2 * depth_k, band.s.3 * depth_k, band.s.4 * depth_k, band.s.5 * depth_k, wave_h + wave_b, if(wave_on and music_on, 103, 3) + wave_ripples * 1000 + wave_amp * 0.1
            colors: aqua, azure
        }
    }
}
