part IslandBar {
    //  Split-flap seconds: the ones leaf turns every second, the tens leaf
    //  only when the tens digit actually changes (09→10, 19→20, …).  The
    //  colour stays the same; the leaf only rises and scales into place.
    prop isl_sec_ones = 1 ~quick
    prop isl_sec_tens = 1 ~quick
    //  The iNiR-style Island: one floating capsule, 8 px inside the frame
    //  (when the frame is on), sized by the clock only.
    surface island {
        size: full, 120
        anchor: top
        reserve: 0
        rate: 120, 30 while quiet

        //  The capsule is as wide as the clock and its padding; isl_time is
        //  a layout, so its width is known before the glass behind it is drawn.
        let isl.pad = 16
        let isl.h = clamp(bar_height, 32, 80)
        let isl.w = isl_time.width + isl.pad * 2
        let isl.x = (island.width - isl.w) / 2
        let isl.y = 8
        let isl.cy = isl.y + isl.h / 2
        let isl.by = isl.y + (isl.h - 34) / 2
        let isl.right = isl.x + isl.w
        let isl.cx = isl.x + isl.w / 2

        PanelBackdrop(isl.x, isl.y, isl.w, isl.h, isl.h / 2)
        body {
            color: bar_bg
            glass: if(glass_on, 100%, 0%)
            opacity: 1% * glass_tint
            lens: glass_on and glass_bend
            frost: glass_frost / 100
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            smoke: glass_smoke
            vivid: glass_vivid
            mirror: glass_mirror
            highlight: glass_highlight
            ripple: glass_ripple
            border: 1.5 * glass_border / 100, ink
            rim: 1% * glass_edge
            shine: pointer
            shadow: 0, 4, 14, 26%, glass_shadow
            box { from: isl.x, isl.y; size: isl.w, isl.h; corner: isl.h / 2 }
        }
        box { from: isl.x, isl.y; size: isl.w, isl.h; corner: isl.h / 2; stroke: 1; color: ink; opacity: 7% }
        box { from: isl.x + 16, isl.y + 1; size: isl.w - 32, 1; corner: 0.5; color: ink; opacity: 10% }

        //  HH:MM in the wallpaper's primary colour, the colon in its
        //  secondary, with seconds small at the lower right.  Digits are
        //  separate texts so the leading zero is exact and the colon can
        //  have its own colour.  This column is what sizes the capsule.
        row isl_time {
            at: isl.x + isl.pad, isl.cy
            anchor: left center
            gap: 0
            align: end
            text "{floor(tick.hour / 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.hour, 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text ":" { size: 19; weight: 600; color: azure; family: "Space Grotesk" }
            text "{floor(tick.minute / 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.minute, 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            space 1
            //  The seconds sit on the same baseline as the minutes, in the
            //  secondary colour and a smaller face.  A changed digit starts
            //  low and small, then rises into place.
            text "{floor(tick.second / 10)}" { size: 11; weight: 600; color: azure; family: "Space Grotesk"; letter_move: 0, -3 + (1 - isl_sec_tens) * 4; letter_scale: 0.88 + 0.12 * isl_sec_tens }
            text "{mod(tick.second, 10)}" { size: 11; weight: 600; color: azure; family: "Space Grotesk"; letter_move: 0, -3 + (1 - isl_sec_ones) * 4; letter_scale: 0.88 + 0.12 * isl_sec_ones }
        }
        on change tick.second {
            isl_sec_ones: 0 ~10ms
            isl_sec_ones: 1 ~190ms after 10ms
        }
        on change floor(tick.second / 10) {
            isl_sec_tens: 0 ~10ms
            isl_sec_tens: 1 ~190ms after 10ms
        }

        //  No settings glyph: the capsule itself remains the clock and a
        //  clickable way into settings.
        zone box isl_clock { from: isl.x + isl.pad, isl.y; size: isl.w - isl.pad * 2, isl.h; corner: isl.h / 2; cursor: pointer; label: "Open settings" }
        on press isl_clock while ready { emit ui_sound; panel_open = not panel_open; launch_open = false }
    }
}
