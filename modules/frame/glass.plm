part FrameGlass {
    //  One continuous glass ring: four rails and four corner wedges melted into
    //  a single body.  The wedge fills the square inner corner outside the 22 px
    //  arc, so the window's corner is rounded and the band is unbroken.  The
    //  body carries the glass/lens/rim/shadow for the whole ring, not per side.
    surface frame_glass {
        size: full, full
        anchor: top_left
        reserve: 0
        rate: 120, 30 while quiet

        body {
            color: bar_bg
            glass: if(glass_on, 100%, 0%)
            opacity: 1% * glass_tint
            lens: glass_on and glass_bend
            frost: glass_frost / 100
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            rim: 1% * glass_edge
            shadow: 0, 2, 12, 24%, glass_shadow

            box { from: 0, 0; size: 2560, 10 }
            box { from: 0, 1430; size: 2560, 10 }
            box { from: 0, 10; size: 10, 1420 }
            box { from: 2550, 10; size: 10, 1420 }

            path { at: 0, 0; move 32, 10; curve 10, 32 via 10, 10; line 10, 10; close }
            path { at: 0, 0; move 2528, 10; curve 2550, 32 via 2550, 10; line 2550, 10; close }
            path { at: 0, 0; move 32, 1430; curve 10, 1408 via 10, 1430; line 10, 1430; close }
            path { at: 0, 0; move 2528, 1430; curve 2550, 1408 via 2550, 1430; line 2550, 1430; close }
        }
    }
}
