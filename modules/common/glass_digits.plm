    //  Pair crisp solid-core stroke with restrained glass bevel sheen so thin bar
    //  glyphs keep true primary/secondary hues and never hollow-split across 12..26 px.
    component BarGlassPair(d0: number, d1: number, d2: number, d3: number, sep: number, x: number, cy: number, h: number, wt: number, col: color, gl: number, rimv: number, frostv: number, op: number) {
        BarGlassLayer(d0, d1, d2, d3, sep, x, cy, h, wt, col, 0%, 0, 0, 1.0, 0, 0, op * 0.84)
        BarGlassLayer(d0, d1, d2, d3, sep, x, cy, h, wt, mix(col, #ffffff, 0.28), clamp(gl, 0, 0.28), clamp(rimv, 0, 0.45), frostv, 0.35, 0.22, 0.48, op * 0.42)
    }

    component BarGlassNum2(d0: number, d1: number, x: number, cy: number, h: number, wt: number, col: color, gl: number, rimv: number, frostv: number, op: number) {
        BarGlassPair(d0, d1, -1, -1, -1, x, cy, h, wt, col, gl, rimv, frostv, op)
    }
}
