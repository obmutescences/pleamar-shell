language 0.9

//  Single-stroke Vitreus-style glass digits for the Notches top bar, using the
//  same curve geometry as Vitreus/desktopclock/clockface.plm. Each pair draws
//  all strokes inside one unified `body` so glass rim/frost/shadow stay crisp
//  and cheap at any scale `h` (88 px nominal).

library GlassDigits {
    component BarGlassLayer(d0: number, d1: number, d2: number, d3: number, sep: number, x: number, cy: number, h: number, wt: number, col: color, gl: number, rimv: number, frostv: number, tintv: number, mirv: number, hiv: number, op: number) {
