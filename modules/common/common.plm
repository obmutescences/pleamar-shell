part Common {
    //  Shared Notches state: the palette, audio bands, panel flags and the
    //  clock service.  The scene owns its surfaces and permissions.
    //  The glass palette.  It follows the shape Vitreus's glass uses: a dark
    //  tint, a mint crest, and enough edge light for the rim to read without
    //  a shadow turning the strip into a dirty ring.
    //  The palette follows the wallpaper (bin/pleamar-colors): three facts per
    //  colour, so a change is a change of facts and the scene does not reload.
    //  The defaults are the old hand-picked glass palette, so a shell without
    //  a wallpaper still starts in the same colours.
    fact pal_ink_r: number = 0.918
    fact pal_ink_g: number = 0.969
    fact pal_ink_b: number = 0.961
    fact pal_faint_r: number = 0.624
    fact pal_faint_g: number = 0.722
    fact pal_faint_b: number = 0.714
    fact pal_aqua_r: number = 0.561
    fact pal_aqua_g: number = 0.961
    fact pal_aqua_b: number = 0.875
    fact pal_azure_r: number = 0.345
    fact pal_azure_g: number = 0.784
    fact pal_azure_b: number = 1
    //  Material roles from the same wallpaper read: the centre panel uses
    //  primary and secondary explicitly, while the water keeps aqua/azure.
    fact pal_primary_r: number = 0.561
    fact pal_primary_g: number = 0.961
    fact pal_primary_b: number = 0.875
    fact pal_secondary_r: number = 0.345
    fact pal_secondary_g: number = 0.784
    fact pal_secondary_b: number = 1
    fact pal_deep_r: number = 0.020
    fact pal_deep_g: number = 0.047
    fact pal_deep_b: number = 0.059
    fact pal_tint_r: number = 0.047
    fact pal_tint_g: number = 0.102
    fact pal_tint_b: number = 0.118
    fact pal_panel_r: number = 0.039
    fact pal_panel_g: number = 0.090
    fact pal_panel_b: number = 0.106

    let ink = rgb(pal_ink_r, pal_ink_g, pal_ink_b)
    let faint = rgb(pal_faint_r, pal_faint_g, pal_faint_b)
    let aqua = rgb(pal_aqua_r, pal_aqua_g, pal_aqua_b)
    let azure = rgb(pal_azure_r, pal_azure_g, pal_azure_b)
    let primary = rgb(pal_primary_r, pal_primary_g, pal_primary_b)
    let secondary = rgb(pal_secondary_r, pal_secondary_g, pal_secondary_b)
    let deep = rgb(pal_deep_r, pal_deep_g, pal_deep_b)
    let tint = rgb(pal_tint_r, pal_tint_g, pal_tint_b)
    let panel = rgb(pal_panel_r, pal_panel_g, pal_panel_b)
    let alert = #ef4444
    let glass_shadow = #000000

    //  The water follows every sound the sink plays (cava, PipeWire monitor).
    //  The six facts are filled by the logic at cava's pace; the springs smooth
    //  them to the renderer's pace so the shader never steps.
    fact glass_on = true
    fact glass_mix: number = 100
    fact glass_bend = true
    fact glass_shine = true
    fact glass_frost_auto = false
    fact glass_color_tint: number = 22
    fact glass_shadow_amt: number = 24
    fact glass_refr: number = 1
    fact glass_disp: number = 1
    fact glass_dome: number = 0
    fact glass_milk: number = 0
    //  P0 material controls.  Values are the same units as the renderer:
    //  smoke/milk/ripple are 0..1, vivid/mirror/highlight are 1 = 100%.
    fact glass_smoke: number = 0
    fact glass_vivid: number = 1.18
    fact glass_mirror: number = 1
    fact glass_highlight: number = 1
    fact glass_ripple: number = 1
    //  Inner light is a soft top sheen; 0 is off.
    fact glass_light: number = 0
    //  Inner border width, in percent of 1.5 px.
    fact glass_border: number = 0
    //  Panel backdrop behind the glass: off by default, so the current look
    //  is unchanged until the Theme page turns it on.
    fact panel_gradient: number = 0          // 0 off, 1 linear, 2 radial
    fact panel_gradient_strength: number = 55
    //  Optical water / liquid backdrop shader shared across all drawers.
    shader panel_water_fx = file "shaders/panel_water.wgsl"
    fact panel_water_on = true
    fact panel_water_style: number = 0       // 0 caustics, 1 ripples, 2 droplets
    fact panel_water_strength: number = 42   // 0..100%
    fact panel_water_speed: number = 100     // 0..200%
    fact panel_water_color_mix: number = 50  // 0..100% (primary -> secondary)
    fact panel_water_pointer: number = 50    // 0..100%
    fact pw_caustic_scale: number = 100      // 40..200%
    fact pw_caustic_sharp: number = 55       // 0..100%
    fact pw_caustic_ripple: number = 55      // 0..100%
    fact pw_rip_rate: number = 100           // 20..200%
    fact pw_rip_rings: number = 60           // 0..100%
    fact pw_rip_gloss: number = 65           // 0..100%
    fact pw_drop_size: number = 100          // 50..180%
    fact pw_drop_density: number = 60        // 0..100%
    fact pw_drop_trails: number = 65         // 0..100%
    //  Shared panel background: 0 uses primary, 1 uses secondary; the depth
    //  is how much of that role is mixed into the panel card.
    fact panel_bg_role: number = 0
    fact panel_bg_tint: number = 0
    let panel_bg = mix(panel, pick(panel_bg_role, primary, secondary), panel_bg_tint / 100)
    //  The bar and Frame keep their darker chrome base; only the chosen role
    //  and depth are layered over it, so depth 0 is still the old look.
    let bar_bg = mix(tint, pick(panel_bg_role, primary, secondary), panel_bg_tint / 100)

    //  Panel backdrop inside every Notches drawer: optional role tint,
    //  wallpaper-derived gradient, live water shader, and soft top inner light.
    component PanelBackdrop(x: number, y: number, w: number, h: number, corner: number) {
        let pb.role = pick(panel_bg_role, primary, secondary)
        let pb.a = mix(panel_bg, primary, 0.55)
        let pb.b = mix(panel_bg, secondary, 0.38)
        let pb.c = mix(panel_bg, deep, 0.22)
        body {
            show: panel_bg_tint > 0.5
            color: pb.role
            opacity: clamp(panel_bg_tint / 100, 0, 1) * 0.28
            box { from: x, y; size: w, h; corner: corner }
        }
        body {
            show: panel_gradient == 1 and panel_gradient_strength > 0.5
            gradient: x, y to x + w, y + h, pb.a, pb.b 55%, pb.c
            opacity: clamp(panel_gradient_strength / 100, 0, 1) * 0.48
            box { from: x, y; size: w, h; corner: corner }
        }
        body {
            show: panel_gradient == 2 and panel_gradient_strength > 0.5
            gradient: radial x + w / 2, y + h / 2 radius max(w, h) / 2, pb.a, pb.b 55%, pb.c
            opacity: clamp(panel_gradient_strength / 100, 0, 1) * 0.48
            box { from: x, y; size: w, h; corner: corner }
        }
        let pb.wd1 = pick(panel_water_style, clamp(pw_caustic_scale / 100, 0.4, 2), clamp(pw_rip_rate / 100, 0.2, 2), clamp(pw_drop_size / 100, 0.5, 1.8))
        let pb.wd2 = pick(panel_water_style, clamp(pw_caustic_sharp / 100, 0, 1), clamp(pw_rip_rings / 100, 0, 1), clamp(pw_drop_density / 100, 0, 1))
        let pb.wd3 = pick(panel_water_style, clamp(pw_caustic_ripple / 100, 0, 1), clamp(pw_rip_gloss / 100, 0, 1), clamp(pw_drop_trails / 100, 0, 1))
        shader panel_water_fx {
            at: x, y
            size: w, h
            corner: corner
            show: panel_water_on and panel_water_strength > 0.5
            values: panel_water_style, clamp(panel_water_strength / 100, 0, 1), if(motion.reduced, 0, clamp(panel_water_speed / 100, 0, 2)), clamp(panel_water_color_mix / 100, 0, 1), clamp(panel_water_pointer / 100, 0, 1), pb.wd1, pb.wd2, pb.wd3
            colors: primary, secondary
        }
        body {
            show: glass_light > 0.01
            gradient: x, y to x, y + h * 0.42, #ffffff22, #ffffff06 45%, #ffffff00
            light: 3%, y, 140
            opacity: clamp(glass_light, 0, 1) * 0.55
            box { from: x, y; size: w, h; corner: corner }
        }
    }

    //  ── Pure Optical Glass Block Material System ─────────────────────────
    //  Four-tier neutral crystal hierarchy used across Center & Settings panels:
    //  1. GlassCard      – carved crystal block (cards, sidebars, panes)
    //  2. GlassLensShell – ultra-clear refractive shell over live shaders
    //  3. GlassPrism     – raised high-index optical lens pill (active tabs/pills)
    //  4. GlassWell      – recessed smoked-crystal basin (charts, inputs, grooves)
    //  Plus GlassOrb (convex droplet buttons) & GlassModal (frosted dialog sheet).

    component GlassCard(x: number, y: number, w: number, h: number, r: number = 16, hot: number = 0, active: number = 0) {
        let gc.h = clamp(hot, 0, 1)
        let gc.a = clamp(active, 0, 1)
        let gc.hi = max(gc.h, gc.a)
        body {
            color: if(glass_on, #ffffff, #141c24)
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, 36% + 6% * gc.h + 5% * gc.a, 46% + 10% * gc.h)
            lens: glass_on and glass_bend
            frost: 0.18 - 0.04 * gc.h
            tint: 0.05 + 0.03 * gc.h + 0.03 * gc.a
            smoke: 0.15 - 0.04 * gc.a
            milk: 0.065 + 0.045 * gc.h + 0.045 * gc.a
            refraction: 1.15 + 0.28 * gc.h
            dispersion: 1.65 + 0.45 * gc.h
            dome: 0.06 + 0.03 * gc.h
            mirror: 1.55 + 0.3 * gc.h
            highlight: 1.55 + 0.35 * gc.h + 0.25 * gc.a
            ripple: glass_ripple * 0.5
            rim: 50% + 24% * gc.h + 14% * gc.a
            border: 0.75 + 0.3 * gc.hi, mix(#ffffff22, #ffffff5c, gc.hi)
            shine: if(glass_shine, pointer.x, screen.width * 0.32), if(glass_shine, pointer.y, 120)
            shadow: 0, 6, 18, 22% + 6% * gc.h
            box { from: x, y; size: w, h; corner: r }
        }
    }

    component GlassLensShell(x: number, y: number, w: number, h: number, r: number = 18, hot: number = 0) {
        let gl.h = clamp(hot, 0, 1)
        body {
            color: if(glass_on, #ffffff, #141c24)
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, 35% + 5% * gl.h, 14% + 8% * gl.h)
            lens: glass_on and glass_bend
            frost: 0.08
            tint: 0.03 + 0.02 * gl.h
            smoke: 0.09
            milk: 0.045 + 0.035 * gl.h
            refraction: 1.25 + 0.3 * gl.h
            dispersion: 1.75 + 0.45 * gl.h
            dome: 0.08 + 0.03 * gl.h
            mirror: 1.62 + 0.28 * gl.h
            highlight: 1.6 + 0.35 * gl.h
            ripple: glass_ripple * 0.55
            rim: 54% + 24% * gl.h
            border: 0.8 + 0.3 * gl.h, mix(#ffffff26, #ffffff64, gl.h)
            shine: if(glass_shine, pointer.x, screen.width * 0.32), if(glass_shine, pointer.y, 120)
            shadow: 0, 6, 18, 22% + 6% * gl.h
            box { from: x, y; size: w, h; corner: r }
        }
    }

    component GlassPrism(x: number, y: number, w: number, h: number, r: number, hot: number = 0, active: number = 1, alpha: number = 1) {
        let gp.h = clamp(hot, 0, 1)
        let gp.a = clamp(active, 0, 1)
        let gp.hi = max(gp.h, gp.a)
        let gp.al = clamp(alpha, 0, 1)
        body {
            show: gp.al > 0.02
            color: if(glass_on, #ffffff, #1a242e)
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, (36% + 10% * gp.a + 6% * gp.h) * gp.al, (42% + 14% * gp.a + 10% * gp.h) * gp.al)
            lens: glass_on and glass_bend
            frost: 0.08 - 0.03 * gp.a
            tint: 0.05 + 0.04 * gp.a + 0.03 * gp.h
            smoke: 0.12 - 0.06 * gp.a
            milk: 0.05 + 0.065 * gp.a + 0.045 * gp.h
            refraction: 1.2 + 0.25 * gp.a + 0.2 * gp.h
            dispersion: 1.65 + 0.35 * gp.a + 0.25 * gp.h
            dome: 0.11 + 0.04 * gp.a
            mirror: 1.55 + 0.28 * gp.hi
            highlight: 1.6 + 0.35 * gp.a + 0.25 * gp.h
            ripple: glass_ripple * 0.6
            rim: (48% + 24% * gp.a + 16% * gp.h) * gp.al
            border: 0.8 + 0.25 * gp.hi, mix(#ffffff26, #ffffff64, gp.hi)
            shine: if(glass_shine, pointer.x, screen.width * 0.32), if(glass_shine, pointer.y, 120)
            shadow: 0, 4, 14, (18% + 10% * gp.a + 6% * gp.h) * gp.al
            box { from: x, y; size: w, h; corner: r }
        }
    }

    component GlassWell(x: number, y: number, w: number, h: number, r: number = 12, hot: number = 0) {
        let gw.h = clamp(hot, 0, 1)
        body {
            color: #0b141a
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, 34% + 4% * gw.h, 42% + 6% * gw.h)
            lens: false
            frost: 0.12
            tint: 0.14
            smoke: 0.32
            milk: 0.0
            mirror: 0.45 + 0.2 * gw.h
            highlight: 0.55 + 0.3 * gw.h
            rim: 20% + 20% * gw.h
            border: 0.8 + 0.2 * gw.h, mix(#ffffff1a, #ffffff44, gw.h)
            shine: if(glass_shine, pointer.x, screen.width * 0.5), if(glass_shine, pointer.y, 600)
            box { from: x, y; size: w, h; corner: r }
        }
    }

    component GlassOrb(cx: number, cy: number, radius: number, hot: number = 0) {
        let go.h = clamp(hot, 0, 1)
        body {
            color: if(glass_on, #ffffff, #1a242e)
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, 36% + 8% * go.h, 48% + 14% * go.h)
            lens: glass_on and glass_bend
            frost: 0.06
            tint: 0.05 + 0.04 * go.h
            smoke: 0.12
            milk: 0.05 + 0.05 * go.h
            refraction: 1.35 + 0.25 * go.h
            dispersion: 1.75 + 0.35 * go.h
            dome: 0.28 + 0.08 * go.h
            mirror: 1.55 + 0.3 * go.h
            highlight: 1.6 + 0.35 * go.h
            ripple: glass_ripple * 0.6
            rim: 56% + 26% * go.h
            border: 0.9 + 0.25 * go.h, mix(#ffffff34, #ffffff6c, go.h)
            shine: if(glass_shine, pointer.x, screen.width * 0.5), if(glass_shine, pointer.y, 60)
            shadow: 0, 3, 12, 18% + 8% * go.h
            ellipse { at: cx, cy; radius: radius }
        }
    }

    component GlassModal(x: number, y: number, w: number, h: number, r: number = 22) {
        body {
            color: if(glass_on, #ffffff, #10171f)
            glass: if(glass_on, 100%, 0%)
            opacity: if(glass_on, 64%, 88%)
            lens: glass_on and glass_bend
            frost: 0.55
            tint: 0.12
            smoke: 0.44
            milk: 0.06
            refraction: 1.15
            dispersion: 1.55
            dome: 0.06
            mirror: 1.5
            highlight: 1.55
            rim: 62%
            border: 1.1, #ffffff44
            shine: if(glass_shine, pointer.x, screen.width * 0.5), if(glass_shine, pointer.y, 160)
            shadow: 0, 14, 34, 46%
            box { from: x, y; size: w, h; corner: r }
        }
    }

    component NotchDrawerContent(p: number, w: number, h: number, effect: number) {
        let nd.p = clamp(p, 0, 1)
        let nd.cx = screen.width / 2
        //  Content starts at the bottom of the clock notch, flush with the frame.
        let nd.y = notch_clock_h
        let nd.pop = clamp(drawer_pop / 100, 0, 2)
        let nd.s = 1 - (1 - (0.86 + 0.14 * nd.p)) * nd.pop
        let nd.sx = if(effect == 5, nd.s, if(effect == 1, 0.70 + 0.30 * nd.p, if(effect == 4, 0.38 + 0.62 * nd.p, 1)))
        let nd.sy = if(effect == 5, nd.s, if(effect == 1, 0.58 + 0.42 * nd.p, if(effect == 2, pow(nd.p, 1.55), if(effect == 3, 0.82 + 0.18 * nd.p, nd.p))))
        let nd.fade = if(effect == 5, clamp((nd.p - 0.65) / 0.35, 0, 1), if(effect == 1, min(1, nd.p * 2), min(1, nd.p * 1.5)))
        let nd.dy = if(effect == 3, -56 * (1 - nd.p), if(effect == 4, -14 * (1 - nd.p), 0))
        group {
            move: nd.cx - w / 2, nd.y + nd.dy
            pivot: w / 2, if(effect == 5, h / 2, 0)
            scale: nd.sx, max(nd.sy, 0.015)
            opacity: clamp(nd.fade, 0, 1)
            children
        }
    }

    fact settings_page: number = 1
    fact slider_fill: number = 0          // 0 Pencil · 1 Marker · 2 Gradient · 3 Plain · 4 Dots
    fact glass_preset_i: number = 0       // 0..4 preset index, -1 custom
    event wall_random ->
    text lb_pw = ""
    fact lb_ok = false
    model lb_glyphs max 18 { idx: number; rot: number; outline: bool; ci: number; sym: text }
    event lb_submit ->
    event nt_history_dismiss ->
    //  Notification motion settings (0 fade, 1 spin, 2 unfold, 3 drop,
    //  4 aperture, 5 random).  The toast and notification centre keep their
    //  pose through close; drawers and search use notch_drop and the wave.
    fact anim_toast: number = 0
    fact anim_center: number = 0
    fact toast_fx: number = 0
    fact center_fx: number = 0
    //  Liquid drawer / frame controls (0..200%, 100 is the default).
    fact drawer_motion: number = 100
    fact drawer_neck: number = 100
    fact drawer_pop: number = 100
    fact frame_wave_on = true
    fact frame_wave_strength: number = 100
    fact frame_wave_speed: number = 100
    event anim_set ->
    //  0 Liquid · 1 Clear · 2 Smoked · 3 Milky · 4 Mirror
    event glass_preset ->
    fact glass_tint: number = 58
    fact glass_frost: number = 100
    fact glass_edge: number = 34
    //  Cava envelope gain for the frame bands.
    fact wave_gain: number = 1.4

    //  The Notches frame's music: the six-band bars draw on the frame.
    //  0 is the top edge; 1 is all four sides.
    fact music_frame_on = true
    fact music_frame_sides: number = 1
    //  Optional colour for the whole unified frame body.  Off keeps the
    //  neutral glass; depth mixes the palette primary into it.
    fact notch_tint_on = false
    fact notch_tint_depth: number = 55
    //  Music frame visual parameters — mirrors Vitreus fw_* settings.
    fact music_frame_sens: number = 1          // sensitivity multiplier 0.3–3.0
    fact music_frame_hgt: number = 50          // max bar height in px, 10–120
    fact music_frame_blend: number = 100       // liquid blend 0–100 (maps to fw.bl)
    fact music_frame_cols: number = 12         // bars per edge: 6, 12, 24, 48
    //  Clock notch height in the frame bar (px), configurable from settings.
    fact notch_clock_h: number = 56
    fact notch_clock_w: number = 168
    //  Bar date, lunar date, weekday and seconds toggles (Settings › Bar).
    fact bar_show_date = true
    fact bar_show_lunar = true
    fact bar_show_weekday = true
    fact bar_show_secs = true
    fact bar_has_date = false
    fact bar_has_lunar = false
    fact bar_has_weekday = false
    fact bar_date_any = false
    text bar_date_txt = ""
    text bar_lunar_txt = ""
    text bar_weekday_txt = ""
    //  Bar system monitors & nearest countdown toggles (Settings › Bar).
    fact bar_show_cpu = true
    fact bar_show_mem = true
    fact bar_show_net = true
    fact bar_show_countdown = true
    fact bar_has_cd = false
    fact bar_cd_urgent = false
    fact bar_rx_act: number = 0
    fact bar_tx_act: number = 0
    fact bar_mon_tick: number = 0
    text bar_rx_txt = "0K"
    text bar_tx_txt = "0K"
    text bar_cd_title = ""
    text bar_cd_days = ""
    //  Display order inside the center top bar (0..5).
    fact bar_ord_cpu: number = 0
    fact bar_ord_mem: number = 1
    fact bar_ord_net: number = 2
    fact bar_ord_clock: number = 3
    fact bar_ord_date: number = 4
    fact bar_ord_cd: number = 5
    model bar_order_slots max 6 { key: text; label: text; enabled: bool }
    event bar_order_move ->
    event bar_order_reset ->
    //  Bar typography & Vitreus-style glass numeric rendering (Settings › Bar).
    fact bar_font_size: number = 18        // 12..26 px
    fact bar_num_style: number = 1         // 0 Plain · 1 Glass · 2 Frosted · 3 Tinted
    fact bar_num_weight: number = 105      // 70..145 % stroke weight for glass digits & rings
    fact bar_mon_d0: number = 0
    fact bar_mon_d1: number = 1
    fact bar_day_d0: number = 0
    fact bar_day_d1: number = 1

    //  Lock screen settings.  The lock scene is a separate process, so these
    //  live in the shell config and are pushed to it when it opens.
    fact lock_blur: number = 36
    fact lock_12h = true
    fact lock_ampm = true
    fact lock_media = true
    fact lock_secs = false
    fact lock_power = true
    fact lock_px: number = 200
    fact lock_date: number = 0          // 0 long, 1 short, 2 day first, 3 ISO
    fact lock_mask: number = 0          // 0 shapes, 1 dots, 2 stars, 3 special
    fact lock_pal: number = 1           // 0 vibrant, 1 accent, 2 neon, 3 pastel, 4 mono

    //  Idle: 0 is Never; the seconds are what swayidle waits for.
    fact idle_lock_i: number = 0
    fact idle_off_i: number = 0
    fact idle_lock_seconds: number = 0
    fact idle_off_seconds: number = 0
    text idle_lock_t = "Never"
    text idle_off_t = "Never"
    event lock_now ->
    event lock_test ->

    fact music_on = false
    fact quiet = true
    fact ready = false
    fact bands.0 = 0
    fact bands.1 = 0
    fact bands.2 = 0
    fact bands.3 = 0
    fact bands.4 = 0
    fact bands.5 = 0

    //  Fast enough to show a kick; still damped enough not to jitter.
    spring wave_smooth = 900, 45
    prop band.s.0 = 0 ~wave_smooth
    follow band.s.0 = bands.0
    prop band.s.1 = 0 ~wave_smooth
    follow band.s.1 = bands.1
    prop band.s.2 = 0 ~wave_smooth
    follow band.s.2 = bands.2
    prop band.s.3 = 0 ~wave_smooth
    follow band.s.3 = bands.3
    prop band.s.4 = 0 ~wave_smooth
    follow band.s.4 = bands.4
    prop band.s.5 = 0 ~wave_smooth
    follow band.s.5 = bands.5

    //  All 24 raw cava bars for the Notches frame music visualiser,
    //  like Vitreus spec.0..spec.23 with spike spring = 520, 26.
    spring nf_spike = 520, 26
    fact spec.0 = 0
    fact spec.1 = 0
    fact spec.2 = 0
    fact spec.3 = 0
    fact spec.4 = 0
    fact spec.5 = 0
    fact spec.6 = 0
    fact spec.7 = 0
    fact spec.8 = 0
    fact spec.9 = 0
    fact spec.10 = 0
    fact spec.11 = 0
    fact spec.12 = 0
    fact spec.13 = 0
    fact spec.14 = 0
    fact spec.15 = 0
    fact spec.16 = 0
    fact spec.17 = 0
    fact spec.18 = 0
    fact spec.19 = 0
    fact spec.20 = 0
    fact spec.21 = 0
    fact spec.22 = 0
    fact spec.23 = 0
    prop spec.s.0  = 0 ~nf_spike
    follow spec.s.0  = spec.0
    prop spec.s.1  = 0 ~nf_spike
    follow spec.s.1  = spec.1
    prop spec.s.2  = 0 ~nf_spike
    follow spec.s.2  = spec.2
    prop spec.s.3  = 0 ~nf_spike
    follow spec.s.3  = spec.3
    prop spec.s.4  = 0 ~nf_spike
    follow spec.s.4  = spec.4
    prop spec.s.5  = 0 ~nf_spike
    follow spec.s.5  = spec.5
    prop spec.s.6  = 0 ~nf_spike
    follow spec.s.6  = spec.6
    prop spec.s.7  = 0 ~nf_spike
    follow spec.s.7  = spec.7
    prop spec.s.8  = 0 ~nf_spike
    follow spec.s.8  = spec.8
    prop spec.s.9  = 0 ~nf_spike
    follow spec.s.9  = spec.9
    prop spec.s.10 = 0 ~nf_spike
    follow spec.s.10 = spec.10
    prop spec.s.11 = 0 ~nf_spike
    follow spec.s.11 = spec.11
    prop spec.s.12 = 0 ~nf_spike
    follow spec.s.12 = spec.12
    prop spec.s.13 = 0 ~nf_spike
    follow spec.s.13 = spec.13
    prop spec.s.14 = 0 ~nf_spike
    follow spec.s.14 = spec.14
    prop spec.s.15 = 0 ~nf_spike
    follow spec.s.15 = spec.15
    prop spec.s.16 = 0 ~nf_spike
    follow spec.s.16 = spec.16
    prop spec.s.17 = 0 ~nf_spike
    follow spec.s.17 = spec.17
    prop spec.s.18 = 0 ~nf_spike
    follow spec.s.18 = spec.18
    prop spec.s.19 = 0 ~nf_spike
    follow spec.s.19 = spec.19
    prop spec.s.20 = 0 ~nf_spike
    follow spec.s.20 = spec.20
    prop spec.s.21 = 0 ~nf_spike
    follow spec.s.21 = spec.21
    prop spec.s.22 = 0 ~nf_spike
    follow spec.s.22 = spec.22
    prop spec.s.23 = 0 ~nf_spike
    follow spec.s.23 = spec.23

    //  Semantic motion curves paired with Vitreus-style leading/trailing stretch.
    spring sp_lead = 560, 34
    spring sp_trail = 150, 22
    spring sp_pop = 420, 19
    spring sp_calm = 220, 28

    //  Drawer motion: the drop overshoots, then sag/wobble settle it like a
    //  drop landing.  Kept in Common so NotchFrame drives the unified glass
    //  silhouette while each drawer's UI sleeps via `include … while`.
    spring notch_drop = 170, 18
    spring notch_hang = 260, 32
    spring notch_splash = 420, 13
    prop cp_np = 0 ~notch_drop
    prop cp_sag = 0 ~notch_hang
    prop cp_wobble = 0 ~notch_splash
    follow cp_np = panel_open
    on change cp_np > 0.97 while cp_np > 0.97 and not motion.reduced {
        impulse cp_sag 220
        impulse cp_wobble -260
    }
    prop ct_np = 0 ~notch_drop
    prop ct_sag = 0 ~notch_hang
    prop ct_wobble = 0 ~notch_splash
    follow ct_np = center_open
    on change ct_np > 0.97 while ct_np > 0.97 and not motion.reduced {
        impulse ct_sag 220
        impulse ct_wobble -260
    }
    prop la_p = 0 ~notch_drop
    prop la_sag = 0 ~notch_hang
    prop la_wobble = 0 ~notch_splash
    follow la_p = launch_open
    on change la_p > 0.97 while la_p > 0.97 and not motion.reduced {
        impulse la_sag 220
        impulse la_wobble -260
    }
    prop nt_np = 0 ~notch_drop
    prop nt_sag = 0 ~notch_hang
    prop nt_wobble = 0 ~notch_splash
    follow nt_np = nt_has and not nt_drift
    on change nt_np > 0.97 while nt_np > 0.97 and not motion.reduced {
        impulse nt_sag 140
        impulse nt_wobble -180
    }
    prop music_frame_knob = 0 ~quick
    follow music_frame_knob = music_frame_on
    prop notch_tint_knob = 0 ~quick
    follow notch_tint_knob = notch_tint_on
    prop glass_knob = 0 ~quick
    follow glass_knob = glass_on
    prop bend_knob = 0 ~quick
    follow bend_knob = glass_bend
    prop shine_knob = 1 ~quick
    follow shine_knob = glass_shine
    prop wall_knob = 0 ~quick
    follow wall_knob = wall_auto
    prop snd_knob = 0 ~quick
    follow snd_knob = snd_on
    prop bar_date_knob = 0 ~quick
    follow bar_date_knob = bar_show_date
    prop bar_lunar_knob = 0 ~quick
    follow bar_lunar_knob = bar_show_lunar
    prop bar_weekday_knob = 0 ~quick
    follow bar_weekday_knob = bar_show_weekday
    prop bar_sec_knob = 0 ~quick
    follow bar_sec_knob = bar_show_secs
    prop bar_cpu_knob = 1 ~quick
    follow bar_cpu_knob = bar_show_cpu
    prop bar_mem_knob = 1 ~quick
    follow bar_mem_knob = bar_show_mem
    prop bar_net_knob = 1 ~quick
    follow bar_net_knob = bar_show_net
    prop bar_cd_knob = 1 ~quick
    follow bar_cd_knob = bar_show_countdown
    prop nt_snd_knob = 0 ~quick
    follow nt_snd_knob = nt_snd_on
    prop nt_drift_knob = 0 ~quick
    follow nt_drift_knob = nt_drift
    prop nt_dnd_knob = 0 ~quick
    follow nt_dnd_knob = nt_dnd
    prop panel_grad_knob = 0 ~quick
    follow panel_grad_knob = panel_gradient != 0
    prop panel_water_knob = 1 ~quick
    follow panel_water_knob = panel_water_on
    prop frame_wave_knob = 0 ~quick
    follow frame_wave_knob = frame_wave_on

    //  Panels and the launcher.  They share the bar's facts and the same glass.
    fact panel_open = false
    fact launch_open = false
    fact notch_mode = true
    text layout = ""
    text query = ""
    //  Global typeface.  Every text is drawn in "Space Grotesk"; the launch
    //  wrapper maps that name to font_family through fontconfig, so the choice
    //  needs a restart.  font_choice is the row picked in the settings panel,
    //  and font_query searches the installed families.
    text font_family = "Space Grotesk"
    text font_choice = "Space Grotesk"
    text font_query = ""
    text font_status = ""
    text weather_city = ""
    model font_rows max 64 { name: text }

    //  ── wallpaper ───────────────────────────────────────────────────────
    //  The wallpaper is handed to swaybg (the background layer), as Vitreus
    //  hands it to awww; the logic lists the folder, makes thumbnails and
    //  reads the palette.  The path lives in the config, so both layouts see
    //  the same picture.
    text wallpaper = ""
    text wallpaper_dir = ""
    text wall_name = ""
    text wall_choice = ""
    text wall_count = ""
    fact wp_page: number = 0
    fact wp_pages: number = 1
    //  A slideshow in the folder's order: the logic counts whole minutes,
    //  then sets the next picture; off until the picker's switch turns it on.
    fact wall_auto = false
    //  The small Vitreus panel click (assets/panel.wav), on bar and panel presses.
    fact snd_on = true
    event ui_sound ->
    event snd_toggle ->

    //  ── notifications ───────────────────────────────────────────────────
    //  Pleamar is the org.freedesktop.Notifications server.  The logic watches
    //  its list, keeps a history and decides what is shown; this is the state
    //  the toast and the centre draw.
    fact nt_has = false
    fact nt_center = false
    fact nt_dnd = false
    fact nt_urgent = false
    fact nt_snd_on = true
    fact nt_sound: number = 1
    fact nt_pos: number = 1
    fact nt_drift = false
    fact nt_unread: number = 0
    //  Auto-close countdown.  The seconds are a preference; `nt_left` is
    //  the 1..0 progress driven by the shell's timer, and `nt_timed` hides
    //  the rail for urgent notifications that stay until dismissed.
    fact nt_secs: number = 6
    fact nt_left: number = 1
    fact nt_timed = false
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    text nt_time = ""
    text nt_icon = ""
    text nt_countdown = ""
    text nt_sound_name = "Message"
    model nt_actions max 3 { label: text }
    model nt_history max 8 { app: text; title: text; body: text; when: text; urgent: bool }
    event nt_close ->
    event nt_act ->
    event nt_clear ->
    event nt_dnd_toggle ->
    event nt_sound_toggle ->
    event nt_sound_set ->
    event nt_pos_set ->
    event nt_drift_toggle ->
    event nt_test ->
    event nt_center_toggle ->
    event nt_center_close ->
    event nt_history_act ->
    event nt_settings ->
    fact wall_minutes: number = 5
    fact wall_remain: number = 0
    //  skwd-wall's transition index (0 is "off") and duration.  The catalog
    //  itself lives in scenes/lib/shell.luau; the settings row only needs the
    //  current name.
    fact wall_transition: number = 5
    fact wall_transition_ms: number = 650
    fact wall_transition_count: number = 41
    text wall_transition_name = "crossfade"
    text wall_next = "Auto rotation off"
    model wp_rows max 9 { thumb: image 176, 99; name: text; path: text; cur: bool }
    event wall_apply ->
    event wall_refresh ->
    //  The launcher is a search, not an app list: rows carry what they need
    //  to be drawn and what the logic runs when one is picked.
    model la_apps max 10 { name: text; sub: text; exec: text; icon: image 48, 32; glyph: text; has_glyph: bool; is_thumb: bool; kind: text }
    fact la_sel: number = 0
    text la_mode = "APPS"
    text la_hint = "Search apps…"
    event launch ->
    event launch_close ->
    event launch_submit ->
    event la_move ->
    event la_hint ->
    event font_apply ->
    event font_pick ->
    event weather_apply ->
    event settings_close ->
    //  Terminal entry points.  `pleamar --say notches "emit ipc_open_search"`
    //  and `… "emit ipc_open_settings"` open the two panels from anywhere.
    event ipc_open_search ->
    event ipc_open_settings ->
    event ipc_open_notifications ->

    //  ── centre panel boundary state ─────────────────────────────────────
    //  Declared at scene boundary so NotchFrame, audio_picker and center.luau
    //  can read/write them while CenterPanel sleeps via `include … while`.
    fact center_open = false
    fact center_tab: number = 0
    fact center_tab_dir: number = 1
    fact center_sys_scroll: number = 0
    fact center_sys_jump: number = -1
    fact sys_proc_sort: number = 0
    fact center_cal_off: number = 0
    fact center_cal_dir: number = 1
    fact center_cal_tick: number = 0
    fact center_cal_progress: number = 1
    fact center_power_confirm: number = -1
    fact sys_ready = false
    fact sys_hist_count: number = 0
    fact sys_cpu: number = 0
    fact sys_mem: number = 0
    fact sys_cache: number = 0
    fact sys_swap: number = 0
    fact sys_gpu: number = 0
    fact sys_vram: number = 0
    fact sys_pw: number = 0
    fact sys_gpu_on = false
    fact sys_net_up = false
    text sys_host = "This machine"
    text sys_cpu_name = ""
    text sys_kernel = ""
    text sys_uptime = ""
    text sys_load = ""
    text sys_cpu_txt = "—"
    text sys_cpu_meta = ""
    text sys_threads = ""
    text sys_mem_pct = "—"
    text sys_mem_total = ""
    text sys_mem_used = ""
    text sys_mem_cache = ""
    text sys_mem_free = ""
    text sys_swap_txt = ""
    text sys_gpu_name = ""
    text sys_gpu_txt = "—"
    text sys_gpu_vram = ""
    text sys_gpu_power = "—"
    text sys_gpu_temp = "—"
    text sys_gpu_fan = "—"
    text sys_gpu_clock = "—"
    text sys_iface = ""
    text sys_ip = ""
    text sys_rx_txt = ""
    text sys_tx_txt = ""
    text sys_rx_total = ""
    text sys_tx_total = ""
    text sys_rx_spark = ""
    text sys_tx_spark = ""
    text sys_rx_hist = ""
    text sys_tx_hist = ""
    text sys_gpu_hist = ""
    text sys_cpu_hist = ""
    text sys_mem_hist = ""
    text sys_dr_txt = ""
    text sys_dw_speed = ""
    text sys_fans = ""
    model sys_cores max 24 { pct: number }
    model sys_hist max 64 { cpu: number; mem: number; gpu: number; rx: number; tx: number; dr: number; dw: number }
    model sys_hist30 max 36 { cpu: number; mem: number; gpu: number; rx: number; tx: number }
    model sys_mounts max 4 { name: text; info: text; pct: number }
    model sys_temps max 8 { label: text; f: number; heat: number; txt: text }
    model sys_procs max 6 { name: text; cpu: number; cpu_txt: text; mem: number; mem_txt: text }
    text ct_media_len = ""
    fact ct_has_track = false
    text ct_art_path = ""
    fact ct_art_on = false
    fact ct_media_pos: number = 0
    fact ct_media_len_s: number = 0
    text ct_media_pos_txt = "0:00"
    fact ct_track_tick: number = 0
    fact bt_present = false
    fact bt_on = false
    fact bt_count: number = 0
    text bt_sub = "No adapter"
    fact audio_pick_open = false
    text audio_out_name = "Default sink"
    model audio_outputs max 8 { name: text; current: bool }
    fact audio_apps_count: number = 0
    model audio_apps max 8 { name: text; media: text; vol: number; muted: bool; active: bool }
    fact tray_count: number = 0
    model tray_items max 32 { icon: image 24, 24; has_icon: bool; name: text; sub: text; status: text; has_sub: bool }
    fact tray_menu_open = false
    fact tray_menu_row: number = -1
    fact tray_menu_sel: number = -1
    fact tray_menu_count: number = 0
    model tray_menu max 32 { label: text; enabled: bool; separator: bool; checked: bool; sub: bool }
    fact tray_submenu_open = false
    fact tray_submenu_count: number = 0
    model tray_submenu max 32 { label: text; enabled: bool; separator: bool; checked: bool; sub: bool }
    text ct_header_date = ""
    text ct_month = ""
    text ct_month_sub = ""
    text ct_weekday = ""
    text ct_weeknum = ""
    text ct_today_day = ""
    text ct_today_month = ""
    text ct_today_year = ""
    text ct_countdown_title = "本月倒计时"
    fact center_cal_hover = -1
    model ct_days max 42 { day: number; cur: bool; today: bool; label: text; lunar: text; hover: text; term: text; festival: text; holiday: text; off: bool; work: bool; anniv: text; anniv_count: number }
    model ct_countdown max 2 { title: text; date: text; when: text; days: number }
    fact wx_ready = false
    fact wx_configured = false
    text wx_city = ""
    text wx_desc = ""
    text wx_icon = "·"
    text wx_temp = "--"
    text wx_feels = ""
    text wx_hi = ""
    text wx_lo = ""
    text wx_humidity = ""
    text wx_wind = ""
    text wx_updated = ""
    text wx_status = ""
    fact wx_kind: number = 0
    fact wx_dl: number = 1
    fact wx_sun: number = 0.5
    fact wx_moon: number = 0.25
    fact wx_wind_n: number = 5
    fact wx_wdir: number = 1
    fact wx_hlo: number = 0
    fact wx_hhi: number = 25
    fact wx_wlo: number = 0
    fact wx_whi: number = 25
    fact wx_hv: number = -1
    fact wx_hrs_count: number = 0
    model wx_hrs max 26 { t: number; deg: text; label: text; icon: text; kind: number }
    model wx_hourly max 6 { label: text; temp: text; icon: text; night: bool }
    model wx_daily max 4 { day: text; icon: text; hi: text; lo: text; kind: number; desc: text; hi_n: number; lo_n: number }
    event center_toggle ->
    event center_close ->
    event center_scroll ->
    event center_audio_set ->
    event center_audio_mute ->
    event center_audio_default ->
    event center_input_set ->
    event center_input_mute ->
    event center_app_vol ->
    event center_app_mute ->
    event center_media ->
    event center_media_seek ->
    event center_quick ->
    event center_cal_step ->
    event center_cal_today ->
    event center_key_digit ->
    event center_key_tab ->
    event center_key_escape ->
    event center_key_blur ->
    event center_tray_activate ->
    event center_tray_menu ->
    event center_tray_menu_hover ->
    event center_tray_menu_click ->
    event center_tray_submenu_click ->
    event center_tray_menu_close ->
    event center_power_ask ->
    event center_power_cancel ->
    event center_power_do ->
    event center_power_exec ->
    event ipc_open_center ->
}
