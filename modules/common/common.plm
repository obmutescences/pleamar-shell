part Common {
    //  Shared Notches state: the palette, audio bands, panel flags and the
    //  clock service.  The scene owns its surfaces and permissions.
    //  The glass palette.  It follows the shape Vitreus's glass uses: a dark
    //  tint, a mint crest, and enough edge light for the rim to read without
    //  a shadow turning the strip into a dirty ring.
    //  The palette follows the wallpaper (bin/pleamar-colors): three facts per
    //  colour, so a change is a change of facts and the scene does not reload.
    //  The defaults are the old hand-picked glass palette, so a shell without
    //  a wallpaper still starts in the same colours.
    fact pal_ink_r: number = 0.918
    fact pal_ink_g: number = 0.969
    fact pal_ink_b: number = 0.961
    fact pal_faint_r: number = 0.624
    fact pal_faint_g: number = 0.722
    fact pal_faint_b: number = 0.714
    fact pal_aqua_r: number = 0.561
    fact pal_aqua_g: number = 0.961
    fact pal_aqua_b: number = 0.875
    fact pal_azure_r: number = 0.345
    fact pal_azure_g: number = 0.784
    fact pal_azure_b: number = 1
    //  Material roles from the same wallpaper read: the centre panel uses
    //  primary and secondary explicitly, while the water keeps aqua/azure.
    fact pal_primary_r: number = 0.561
    fact pal_primary_g: number = 0.961
    fact pal_primary_b: number = 0.875
    fact pal_secondary_r: number = 0.345
    fact pal_secondary_g: number = 0.784
    fact pal_secondary_b: number = 1
    fact pal_deep_r: number = 0.020
    fact pal_deep_g: number = 0.047
    fact pal_deep_b: number = 0.059
    fact pal_tint_r: number = 0.047
    fact pal_tint_g: number = 0.102
    fact pal_tint_b: number = 0.118
    fact pal_panel_r: number = 0.039
    fact pal_panel_g: number = 0.090
    fact pal_panel_b: number = 0.106

    let ink = rgb(pal_ink_r, pal_ink_g, pal_ink_b)
    let faint = rgb(pal_faint_r, pal_faint_g, pal_faint_b)
    let aqua = rgb(pal_aqua_r, pal_aqua_g, pal_aqua_b)
    let azure = rgb(pal_azure_r, pal_azure_g, pal_azure_b)
    let primary = rgb(pal_primary_r, pal_primary_g, pal_primary_b)
    let secondary = rgb(pal_secondary_r, pal_secondary_g, pal_secondary_b)
    let deep = rgb(pal_deep_r, pal_deep_g, pal_deep_b)
    let tint = rgb(pal_tint_r, pal_tint_g, pal_tint_b)
    let panel = rgb(pal_panel_r, pal_panel_g, pal_panel_b)
    let alert = #ef4444
    let glass_shadow = #000000

    //  The water follows every sound the sink plays (cava, PipeWire monitor).
    //  The six facts are filled by the logic at cava's pace; the springs smooth
    //  them to the renderer's pace so the shader never steps.
    fact glass_on = true
    fact glass_bend = true
    fact glass_refr: number = 1
    fact glass_disp: number = 1
    fact glass_dome: number = 0
    fact glass_milk: number = 0
    //  P0 material controls.  Values are the same units as the renderer:
    //  smoke/milk/ripple are 0..1, vivid/mirror/highlight are 1 = 100%.
    fact glass_smoke: number = 0
    fact glass_vivid: number = 1.18
    fact glass_mirror: number = 1
    fact glass_highlight: number = 1
    fact glass_ripple: number = 1
    //  Inner light is a soft top sheen; 0 is off.
    fact glass_light: number = 0
    //  Inner border width, in percent of 1.5 px.
    fact glass_border: number = 0
    //  Panel backdrop behind the glass: off by default, so the current look
    //  is unchanged until the Theme page turns it on.
    fact panel_gradient: number = 0          // 0 off, 1 linear, 2 radial
    fact panel_gradient_strength: number = 55
    //  Shared panel background: 0 uses primary, 1 uses secondary; the depth
    //  is how much of that role is mixed into the panel card.
    fact panel_bg_role: number = 0
    fact panel_bg_tint: number = 0
    let panel_bg = mix(panel, pick(panel_bg_role, primary, secondary), panel_bg_tint / 100)
    //  The bar and Frame keep their darker chrome base; only the chosen role
    //  and depth are layered over it, so depth 0 is still the old look.
    let bar_bg = mix(tint, pick(panel_bg_role, primary, secondary), panel_bg_tint / 100)

    //  P0 panel backdrop.  One component for every large panel: a wallpaper-
    //  derived gradient behind the glass, plus an optional soft top light.
    //  Both are behind the existing glass body, so the card's lens still does
    //  its job; neither adds a surface or a capture.
    component PanelBackdrop(x: number, y: number, w: number, h: number, corner: number) {
        let pb.a = mix(panel_bg, primary, 0.55)
        let pb.b = mix(panel_bg, secondary, 0.38)
        let pb.c = mix(panel_bg, deep, 0.22)
        body {
            show: not notch_mode and panel_gradient == 1 and panel_gradient_strength > 0
            gradient: x, y to x + w, y + h, pb.a, pb.b 55%, pb.c
            opacity: panel_gradient_strength / 100
            box { from: x, y; size: w, h; corner: corner }
        }
        body {
            show: not notch_mode and panel_gradient == 2 and panel_gradient_strength > 0
            gradient: radial x + w / 2, y + h / 2 radius max(w, h) / 2, pb.a, pb.b 55%, pb.c
            opacity: panel_gradient_strength / 100
            box { from: x, y; size: w, h; corner: corner }
        }
        body {
            show: not notch_mode and glass_light > 0
            //  `light`'s amount is read once by the engine, so the slider is
            //  the opacity of this subtle top sheet rather than a rebuild.
            gradient: x, y to x, y + h, mix(panel_bg, ink, 0.20), mix(panel_bg, ink, 0.04) 38%, panel_bg
            light: 3%, y, 140
            opacity: glass_light * 0.55
            box { from: x, y; size: w, h; corner: corner }
        }
    }

    component NotchDrawerContent(p: number, w: number, effect: number) {
        let nd.p = clamp(p, 0, 1)
        let nd.cx = screen.width / 2
        //  Content starts at the bottom of the clock notch, flush with the frame.
        let nd.y = notch_clock_h
        let nd.sx = if(effect == 1, 0.70 + 0.30 * nd.p, if(effect == 4, 0.38 + 0.62 * nd.p, 1))
        let nd.sy = if(effect == 1, 0.58 + 0.42 * nd.p, if(effect == 2, pow(nd.p, 1.55), if(effect == 3, 0.82 + 0.18 * nd.p, nd.p)))
        let nd.fade = if(effect == 1, min(1, nd.p * 2), min(1, nd.p * 1.5))
        let nd.dy = if(effect == 3, -56 * (1 - nd.p), if(effect == 4, -14 * (1 - nd.p), 0))
        group {
            move: nd.cx - w / 2, nd.y + nd.dy
            pivot: w / 2, 0
            scale: nd.sx, max(nd.sy, 0.015)
            opacity: clamp(nd.fade, 0, 1)
            children
        }
    }

    component NotchDrawerRipples(p: number) {
        //  Ripple ellipses are no longer drawn: the frame glass silhouette
        //  provides the visual connection.  Component kept for call-site compat.
    }

    //  Legacy panels draw their own neck.  Notches reuses only the content
    //  pose and shares the glass silhouette with the full-screen frame.
    //  Note: NotchDrawer is not used in notch_mode; the frame handles everything.

    fact settings_page: number = 1
    //  Per-panel opening motion (0 fade, 1 spin, 2 unfold, 3 drop,
    //  4 aperture, 5 random).  The *_fx facts are the pose chosen when a
    //  panel opens; the close keeps that pose, so it never changes mid-move.
    fact anim_search: number = 0
    fact anim_panel: number = 0
    fact anim_toast: number = 0
    fact anim_center: number = 0
    fact anim_center_panel: number = 0
    fact search_fx: number = 0
    fact panel_fx: number = 0
    fact toast_fx: number = 0
    fact center_fx: number = 0
    fact center_panel_fx: number = 0
    event anim_set ->
    //  0 Liquid · 1 Clear · 2 Smoked · 3 Milky · 4 Mirror
    event glass_preset ->
    fact glass_tint: number = 58
    fact glass_frost: number = 100
    fact glass_edge: number = 34
    //  Cava envelope gain for the frame bands.
    fact wave_gain: number = 1.4

    //  The Notches frame's music: the six-band bars draw on the frame.
    //  0 is the top edge; 1 is all four sides.
    fact music_frame_on = true
    fact music_frame_sides: number = 1
    //  Music frame visual parameters — mirrors Vitreus fw_* settings.
    fact music_frame_sens: number = 1          // sensitivity multiplier 0.3–3.0
    fact music_frame_hgt: number = 50          // max bar height in px, 10–120
    fact music_frame_blend: number = 100       // liquid blend 0–100 (maps to fw.bl)
    fact music_frame_cols: number = 12         // bars per edge: 6, 12, 24, 48
    //  Clock notch height in the frame bar (px), configurable from settings.
    fact notch_clock_h: number = 56
    fact notch_clock_w: number = 168

    //  Lock screen settings.  The lock scene is a separate process, so these
    //  live in the shell config and are pushed to it when it opens.
    fact lock_blur: number = 36
    fact lock_12h = true
    fact lock_ampm = true
    fact lock_media = true
    fact lock_secs = false
    fact lock_power = true
    fact lock_px: number = 200
    fact lock_date: number = 0          // 0 long, 1 short, 2 day first, 3 ISO
    fact lock_mask: number = 0          // 0 shapes, 1 dots, 2 stars, 3 special
    fact lock_pal: number = 1           // 0 vibrant, 1 accent, 2 neon, 3 pastel, 4 mono

    //  Idle: 0 is Never; the seconds are what swayidle waits for.
    fact idle_lock_i: number = 0
    fact idle_off_i: number = 0
    fact idle_lock_seconds: number = 0
    fact idle_off_seconds: number = 0
    text idle_lock_t = "Never"
    text idle_off_t = "Never"
    event lock_now ->
    event lock_test ->

    fact music_on = false
    fact quiet = true
    fact ready = false
    fact bands.0 = 0
    fact bands.1 = 0
    fact bands.2 = 0
    fact bands.3 = 0
    fact bands.4 = 0
    fact bands.5 = 0

    //  Fast enough to show a kick; still damped enough not to jitter.
    spring wave_smooth = 900, 45
    prop band.s.0 = 0 ~wave_smooth
    follow band.s.0 = bands.0
    prop band.s.1 = 0 ~wave_smooth
    follow band.s.1 = bands.1
    prop band.s.2 = 0 ~wave_smooth
    follow band.s.2 = bands.2
    prop band.s.3 = 0 ~wave_smooth
    follow band.s.3 = bands.3
    prop band.s.4 = 0 ~wave_smooth
    follow band.s.4 = bands.4
    prop band.s.5 = 0 ~wave_smooth
    follow band.s.5 = bands.5

    //  All 24 raw cava bars for the Notches frame music visualiser,
    //  like Vitreus spec.0..spec.23 with spike spring = 520, 26.
    spring nf_spike = 520, 26
    fact spec.0 = 0
    fact spec.1 = 0
    fact spec.2 = 0
    fact spec.3 = 0
    fact spec.4 = 0
    fact spec.5 = 0
    fact spec.6 = 0
    fact spec.7 = 0
    fact spec.8 = 0
    fact spec.9 = 0
    fact spec.10 = 0
    fact spec.11 = 0
    fact spec.12 = 0
    fact spec.13 = 0
    fact spec.14 = 0
    fact spec.15 = 0
    fact spec.16 = 0
    fact spec.17 = 0
    fact spec.18 = 0
    fact spec.19 = 0
    fact spec.20 = 0
    fact spec.21 = 0
    fact spec.22 = 0
    fact spec.23 = 0
    prop spec.s.0  = 0 ~nf_spike
    follow spec.s.0  = spec.0
    prop spec.s.1  = 0 ~nf_spike
    follow spec.s.1  = spec.1
    prop spec.s.2  = 0 ~nf_spike
    follow spec.s.2  = spec.2
    prop spec.s.3  = 0 ~nf_spike
    follow spec.s.3  = spec.3
    prop spec.s.4  = 0 ~nf_spike
    follow spec.s.4  = spec.4
    prop spec.s.5  = 0 ~nf_spike
    follow spec.s.5  = spec.5
    prop spec.s.6  = 0 ~nf_spike
    follow spec.s.6  = spec.6
    prop spec.s.7  = 0 ~nf_spike
    follow spec.s.7  = spec.7
    prop spec.s.8  = 0 ~nf_spike
    follow spec.s.8  = spec.8
    prop spec.s.9  = 0 ~nf_spike
    follow spec.s.9  = spec.9
    prop spec.s.10 = 0 ~nf_spike
    follow spec.s.10 = spec.10
    prop spec.s.11 = 0 ~nf_spike
    follow spec.s.11 = spec.11
    prop spec.s.12 = 0 ~nf_spike
    follow spec.s.12 = spec.12
    prop spec.s.13 = 0 ~nf_spike
    follow spec.s.13 = spec.13
    prop spec.s.14 = 0 ~nf_spike
    follow spec.s.14 = spec.14
    prop spec.s.15 = 0 ~nf_spike
    follow spec.s.15 = spec.15
    prop spec.s.16 = 0 ~nf_spike
    follow spec.s.16 = spec.16
    prop spec.s.17 = 0 ~nf_spike
    follow spec.s.17 = spec.17
    prop spec.s.18 = 0 ~nf_spike
    follow spec.s.18 = spec.18
    prop spec.s.19 = 0 ~nf_spike
    follow spec.s.19 = spec.19
    prop spec.s.20 = 0 ~nf_spike
    follow spec.s.20 = spec.20
    prop spec.s.21 = 0 ~nf_spike
    follow spec.s.21 = spec.21
    prop spec.s.22 = 0 ~nf_spike
    follow spec.s.22 = spec.22
    prop spec.s.23 = 0 ~nf_spike
    follow spec.s.23 = spec.23

    //  A slower, underdamped spring for the Notches drawer: the neck stretches
    //  and settles like the reference's drip, instead of easing like a card.
    spring notch_drip = 170, 18
    prop music_frame_knob = 0 ~quick
    follow music_frame_knob = music_frame_on
    prop glass_knob = 0 ~quick
    follow glass_knob = glass_on
    prop bend_knob = 0 ~quick
    follow bend_knob = glass_bend
    prop wall_knob = 0 ~quick
    follow wall_knob = wall_auto
    prop snd_knob = 0 ~quick
    follow snd_knob = snd_on
    prop nt_snd_knob = 0 ~quick
    follow nt_snd_knob = nt_snd_on
    prop nt_drift_knob = 0 ~quick
    follow nt_drift_knob = nt_drift
    prop nt_dnd_knob = 0 ~quick
    follow nt_dnd_knob = nt_dnd
    prop panel_grad_knob = 0 ~quick
    follow panel_grad_knob = panel_gradient != 0

    //  Panels and the launcher.  They share the bar's facts and the same glass.
    fact panel_open = false
    fact launch_open = false
    fact notch_mode = true
    text layout = ""
    text query = ""
    //  Global typeface.  Every text is drawn in "Space Grotesk"; the launch
    //  wrapper maps that name to font_family through fontconfig, so the choice
    //  needs a restart.  font_choice is the row picked in the settings panel,
    //  and font_query searches the installed families.
    text font_family = "Space Grotesk"
    text font_choice = "Space Grotesk"
    text font_query = ""
    text font_status = ""
    text weather_city = ""
    model font_rows max 64 { name: text }

    //  ── wallpaper ───────────────────────────────────────────────────────
    //  The wallpaper is handed to swaybg (the background layer), as Vitreus
    //  hands it to awww; the logic lists the folder, makes thumbnails and
    //  reads the palette.  The path lives in the config, so both layouts see
    //  the same picture.
    text wallpaper = ""
    text wallpaper_dir = ""
    text wall_name = ""
    text wall_choice = ""
    text wall_count = ""
    fact wp_page: number = 0
    fact wp_pages: number = 1
    //  A slideshow in the folder's order: the logic counts whole minutes,
    //  then sets the next picture; off until the picker's switch turns it on.
    fact wall_auto = false
    //  The small Vitreus panel click (assets/panel.wav), on bar and panel presses.
    fact snd_on = true
    event ui_sound ->
    event snd_toggle ->

    //  ── notifications ───────────────────────────────────────────────────
    //  Pleamar is the org.freedesktop.Notifications server.  The logic watches
    //  its list, keeps a history and decides what is shown; this is the state
    //  the toast and the centre draw.
    fact nt_has = false
    fact nt_center = false
    fact nt_dnd = false
    fact nt_urgent = false
    fact nt_snd_on = true
    fact nt_sound: number = 1
    fact nt_pos: number = 1
    fact nt_drift = false
    fact nt_unread: number = 0
    //  Auto-close countdown.  The seconds are a preference; `nt_left` is
    //  the 1..0 progress driven by the shell's timer, and `nt_timed` hides
    //  the rail for urgent notifications that stay until dismissed.
    fact nt_secs: number = 6
    fact nt_left: number = 1
    fact nt_timed = false
    text nt_app = ""
    text nt_title = ""
    text nt_body = ""
    text nt_time = ""
    text nt_icon = ""
    text nt_countdown = ""
    text nt_sound_name = "Message"
    model nt_actions max 3 { label: text }
    model nt_history max 8 { app: text; title: text; body: text; when: text; urgent: bool }
    event nt_close ->
    event nt_act ->
    event nt_clear ->
    event nt_dnd_toggle ->
    event nt_sound_toggle ->
    event nt_sound_set ->
    event nt_pos_set ->
    event nt_drift_toggle ->
    event nt_test ->
    event nt_center_toggle ->
    event nt_center_close ->
    event nt_history_act ->
    event nt_settings ->
    fact wall_minutes: number = 5
    fact wall_remain: number = 0
    //  skwd-wall's transition index (0 is "off") and duration.  The catalog
    //  itself lives in scenes/lib/shell.luau; the settings row only needs the
    //  current name.
    fact wall_transition: number = 5
    fact wall_transition_ms: number = 650
    fact wall_transition_count: number = 41
    text wall_transition_name = "crossfade"
    text wall_next = "Auto rotation off"
    model wp_rows max 9 { thumb: image 176, 99; name: text; path: text; cur: bool }
    event wall_apply ->
    event wall_refresh ->
    //  The launcher is a search, not an app list: rows carry what they need
    //  to be drawn and what the logic runs when one is picked.
    model la_apps max 10 { name: text; sub: text; exec: text; icon: image 22, 22; glyph: text; has_glyph: bool; kind: text }
    fact la_sel: number = 0
    text la_mode = "APPS"
    text la_hint = "Search apps…"
    event launch ->
    event launch_close ->
    event launch_submit ->
    event la_move ->
    event la_hint ->
    event font_apply ->
    event font_pick ->
    event weather_apply ->
    event settings_close ->
    //  Terminal entry points.  `pleamar --say notches "emit ipc_open_search"`
    //  and `… "emit ipc_open_settings"` open the two panels from anywhere.
    event ipc_open_search ->
    event ipc_open_settings ->
    event ipc_open_notifications ->


}
