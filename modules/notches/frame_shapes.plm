part NotchFrameShapes {
    //  Ring
    box { from: 0 - nf.over / 2, 0 - nf.over / 2; size: nf.w + nf.over, nf.h + nf.over; corner: nf.inner_r + (nf.rail + nf.over) / 2; stroke: nf.rail + nf.over }
    //  Clock notch
    box { from: nf.cx - nf.clock_w / 2, 0; size: nf.clock_w, nf.clock_h; corner: 20; blend: 34 }
    box { from: nf.cx - nf.clock_w / 2 + 14, nf.clock_h - 2; size: nf.clock_w - 28, 1; corner: 0.5 }
    //  Settings drawer
    box { from: nf.cx - nf.cp_ew / 2 + nf.cp_shift + nf.cp_wob * 0.5, 0; size: nf.cp_ew, max(0.3, nf.cp_eh); corner: mix(20, 26, nf.cp_p); blend: mix(34, 36, nf.cp_p) * nf.cp_p; show: panel_open or nf.cp_p > 0.01 }
    ellipse { at: nf.cx - nf.cp_ew / 2 + 20 + nf.cp_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.cp_bell); blend: 16 * nf.cp_bell; show: (panel_open or nf.cp_p > 0.01) and nf.cp_bell > 0.02 }
    ellipse { at: nf.cx + nf.cp_ew / 2 - 20 + nf.cp_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.cp_bell); blend: 16 * nf.cp_bell; show: (panel_open or nf.cp_p > 0.01) and nf.cp_bell > 0.02 }
    //  Centre drawer
    box { from: nf.cx - nf.ct_ew / 2 + nf.ct_shift + nf.ct_wob * 0.5, 0; size: nf.ct_ew, max(0.3, nf.ct_eh); corner: mix(20, 30, nf.ct_p); blend: mix(34, 36, nf.ct_p) * nf.ct_p; show: center_open or nf.ct_p > 0.01 }
    ellipse { at: nf.cx - nf.ct_ew / 2 + 20 + nf.ct_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.ct_bell); blend: 16 * nf.ct_bell; show: (center_open or nf.ct_p > 0.01) and nf.ct_bell > 0.02 }
    ellipse { at: nf.cx + nf.ct_ew / 2 - 20 + nf.ct_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.ct_bell); blend: 16 * nf.ct_bell; show: (center_open or nf.ct_p > 0.01) and nf.ct_bell > 0.02 }
    //  Search drawer
    box { from: nf.cx - nf.la_ew / 2 + nf.la_shift + nf.la_wob * 0.5, 0; size: nf.la_ew, max(0.3, nf.la_eh); corner: mix(20, 24, nf.launch_p); blend: mix(34, 36, nf.launch_p) * nf.launch_p; show: launch_open or nf.launch_p > 0.01 }
    ellipse { at: nf.cx - nf.la_ew / 2 + 20 + nf.la_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.la_bell); blend: 16 * nf.la_bell; show: (launch_open or nf.launch_p > 0.01) and nf.la_bell > 0.02 }
    ellipse { at: nf.cx + nf.la_ew / 2 - 20 + nf.la_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.la_bell); blend: 16 * nf.la_bell; show: (launch_open or nf.launch_p > 0.01) and nf.la_bell > 0.02 }
    //  Notification centre drawer
    box { from: nf.cx - mix(nf.clock_w, 480, nf.ntc_p) / 2 + if(nt_center or nf.ntc_p > 0.01, 0, 30000), 0; size: mix(nf.clock_w, 480, nf.ntc_p), max(0.3, nf.notify_h * nf.ntc_p); corner: mix(20, 26, nf.ntc_p); blend: mix(34, 36, nf.ntc_p) * nf.ntc_p; show: nt_center or nf.ntc_p > 0.01 }
    //  Docked notification toast (top center)
    box { from: nf.cx - nf.nt_cw / 2 + nf.nt_c_shift + nf.nt_wob * 0.4, 0; size: nf.nt_cw, max(0.3, nf.nt_ch); corner: mix(20, 22, nf.nt_p); blend: mix(28, 34, nf.nt_p) * nf.nt_p; show: nf.nt_c_on }
    ellipse { at: nf.cx - nf.nt_cw / 2 + 18 + nf.nt_c_shift, nf.clock_h; radius: 15; scale: 1, max(0.15, nf.nt_bell); blend: 14 * nf.nt_bell; show: nf.nt_c_on and nf.nt_bell > 0.02 }
    ellipse { at: nf.cx + nf.nt_cw / 2 - 18 + nf.nt_c_shift, nf.clock_h; radius: 15; scale: 1, max(0.15, nf.nt_bell); blend: 14 * nf.nt_bell; show: nf.nt_c_on and nf.nt_bell > 0.02 }
    //  Docked notification toast (top right — fuses into top & right rails)
    box { from: nf.w - nf.nt_rw + nf.nt_r_shift, 0; size: nf.nt_rw, max(0.3, nf.nt_rh); corner: mix(14, 22, nf.nt_p); blend: mix(24, 32, nf.nt_p) * nf.nt_p; show: nf.nt_r_on }
    ellipse { at: nf.w - nf.nt_rw + 18 + nf.nt_r_shift, nf.rail + 4; radius: 14; scale: 1, max(0.15, nf.nt_bell); blend: 14 * nf.nt_bell; show: nf.nt_r_on and nf.nt_bell > 0.02 }
    ellipse { at: nf.w - nf.rail - 4 + nf.nt_r_shift, nf.nt_rh - 14; radius: 14; scale: max(0.15, nf.nt_bell), 1; blend: 14 * nf.nt_bell; show: nf.nt_r_on and nf.nt_bell > 0.02 }

    //  Top edge bars

    box { at: nf.w * 0.5 / nf.nuse + if(nf.h.0 > 1 and abs(nf.w * 0.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 0.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.0 / 2; size: nf.bw, nf.h.0; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.0 > 1 and abs(nf.w * 0.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 0.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 1.5 / nf.nuse + if(nf.h.1 > 1 and abs(nf.w * 1.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 1.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.1 / 2; size: nf.bw, nf.h.1; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.1 > 1 and abs(nf.w * 1.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 1.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 2.5 / nf.nuse + if(nf.h.2 > 1 and abs(nf.w * 2.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 2.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.2 / 2; size: nf.bw, nf.h.2; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.2 > 1 and abs(nf.w * 2.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 2.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 3.5 / nf.nuse + if(nf.h.3 > 1 and abs(nf.w * 3.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 3.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.3 / 2; size: nf.bw, nf.h.3; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.3 > 1 and abs(nf.w * 3.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 3.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 4.5 / nf.nuse + if(nf.h.4 > 1 and abs(nf.w * 4.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 4.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.4 / 2; size: nf.bw, nf.h.4; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.4 > 1 and abs(nf.w * 4.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 4.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 5.5 / nf.nuse + if(nf.h.5 > 1 and abs(nf.w * 5.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 5.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.5 / 2; size: nf.bw, nf.h.5; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.5 > 1 and abs(nf.w * 5.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 5.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 6.5 / nf.nuse + if(nf.h.6 > 1 and abs(nf.w * 6.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 6.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.6 / 2; size: nf.bw, nf.h.6; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.6 > 1 and abs(nf.w * 6.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 6.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 7.5 / nf.nuse + if(nf.h.7 > 1 and abs(nf.w * 7.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 7.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.7 / 2; size: nf.bw, nf.h.7; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.7 > 1 and abs(nf.w * 7.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 7.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 8.5 / nf.nuse + if(nf.h.8 > 1 and abs(nf.w * 8.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 8.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.8 / 2; size: nf.bw, nf.h.8; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.8 > 1 and abs(nf.w * 8.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 8.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 9.5 / nf.nuse + if(nf.h.9 > 1 and abs(nf.w * 9.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 9.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.9 / 2; size: nf.bw, nf.h.9; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.9 > 1 and abs(nf.w * 9.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 9.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 10.5 / nf.nuse + if(nf.h.10 > 1 and abs(nf.w * 10.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 10.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.10 / 2; size: nf.bw, nf.h.10; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.10 > 1 and abs(nf.w * 10.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 10.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 11.5 / nf.nuse + if(nf.h.11 > 1 and abs(nf.w * 11.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 11.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.11 / 2; size: nf.bw, nf.h.11; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.11 > 1 and abs(nf.w * 11.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 11.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 12.5 / nf.nuse + if(nf.h.12 > 1 and abs(nf.w * 12.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 12.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.12 / 2; size: nf.bw, nf.h.12; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.12 > 1 and abs(nf.w * 12.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 12.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 13.5 / nf.nuse + if(nf.h.13 > 1 and abs(nf.w * 13.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 13.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.13 / 2; size: nf.bw, nf.h.13; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.13 > 1 and abs(nf.w * 13.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 13.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
    box { at: nf.w * 14.5 / nf.nuse + if(nf.h.14 > 1 and abs(nf.w * 14.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 14.5 / nf.nuse < nf.w - nf.nt_rw - 14), 0, 30000), nf.rail + nf.h.14 / 2; size: nf.bw, nf.h.14; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.h.14 > 1 and abs(nf.w * 14.5 / nf.nuse - nf.cx) > nf.clock_w / 2 + 16 and (not nf.nt_r_on or nf.w * 14.5 / nf.nuse < nf.w - nf.nt_rw - 14) }
