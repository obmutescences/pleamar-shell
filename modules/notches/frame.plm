        let nf.h.43 = if(43 < nf.nuse and nf.bon > 0.5, min(1, pow(mix(pick(nf.l.43, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.l.43, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.b.43 - nf.l.43), 1.4) * nf.sm) * clamp(min(43.5, nf.nuse - 43.5) / (0.05 * nf.nuse), 0, 1) * nf.hm, 0)
        let nf.b.44 = abs(2 * (44.5 / nf.nuse) - 1) * 23
        let nf.l.44 = clamp(floor(nf.b.44), 0, 22)
        let nf.h.44 = if(44 < nf.nuse and nf.bon > 0.5, min(1, pow(mix(pick(nf.l.44, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.l.44, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.b.44 - nf.l.44), 1.4) * nf.sm) * clamp(min(44.5, nf.nuse - 44.5) / (0.05 * nf.nuse), 0, 1) * nf.hm, 0)
        let nf.b.45 = abs(2 * (45.5 / nf.nuse) - 1) * 23
