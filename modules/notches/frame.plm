part NotchFrame {
    shader frame_wave = file "frame_wave.wgsl"
    prop nf_sec_ones = 1 ~quick
    prop nf_sec_tens = 1 ~quick
    prop ap_p = 0 ~180ms
    follow ap_p = audio_pick_open
    measure nf_clk_m
    measure nf_date_m
    measure nf_lunar_m
    measure nf_week_m
    measure nf_dot_m
    measure nf_cpu_m
    measure nf_mem_m
    measure nf_rx_m
    measure nf_tx_m
    measure nf_cd_t_m
    measure nf_cd_d_m
    let nf_m_cpu = bar_show_cpu
    let nf_m_mem = bar_show_mem
    let nf_m_net = bar_show_net
    let nf_m_clk = true
    let nf_m_date = bar_date_any
    let nf_m_cd = bar_show_countdown and bar_has_cd
    let nf_extra_any = nf_m_cpu or nf_m_mem or nf_m_net or nf_m_cd
    let nf_stacked = (not nf_extra_any) and bar_date_any and notch_clock_h >= 52
    let nf_inline = not nf_stacked
    let nf_fs = clamp(bar_font_size, 12, 26)
    let nf_sub_fs = clamp(nf_fs * 0.68, 10, 16)
    let nf_glass_on = bar_num_style >= 1
    let nf_g_h = nf_fs * 0.96
    let nf_g_pair_w = 266 * (nf_g_h / 88)
    let nf_g_sec_w = 108 * ((nf_fs * 0.56) / 88)
    let nf_g_wt = clamp(bar_num_weight, 70, 145) / 100
    let nf_clk_w = if(nf_glass_on,
        nf_g_pair_w + if(bar_show_secs, 4 + nf_g_sec_w, 0),
        max(nf_clk_m.width, nf_fs * 2.8) + if(bar_show_secs, nf_fs * 1.1, 0))
    let nf_dot_w = max(nf_dot_m.width, 4)
    let nf_d_w = if(bar_has_date, if(nf_glass_on, nf_g_pair_w, nf_date_m.width), 0)
    let nf_l_w = if(bar_has_lunar, nf_lunar_m.width, 0)
    let nf_w_w = if(bar_has_weekday, nf_week_m.width, 0)
    let nf_sep1 = bar_has_date and bar_has_lunar
    let nf_sep2 = (bar_has_date or bar_has_lunar) and bar_has_weekday
    let nf_before_week_w = nf_d_w + if(nf_sep1, 10 + nf_dot_w, 0) + nf_l_w
    let nf_date_w = nf_before_week_w + if(nf_sep2, 6, 0) + nf_w_w
    let nf_ring_r = clamp(nf_fs * 0.46, 6.8, 10.5)
    let nf_ring_w = clamp(nf_fs * 0.21, 2.8, 4.4) * nf_g_wt
    let nf_w_cpu = if(nf_m_cpu, nf_ring_r * 2 + nf_ring_w + 5 + max(nf_cpu_m.width, nf_sub_fs * 2.2), 0)
    let nf_w_mem = if(nf_m_mem, nf_ring_r * 2 + nf_ring_w + 5 + max(nf_mem_m.width, nf_sub_fs * 2.2), 0)
    let nf_w_net = if(nf_m_net, 12 + max(nf_rx_m.width, nf_sub_fs * 2.3) + 8 + 12 + max(nf_tx_m.width, nf_sub_fs * 2.3), 0)
    let nf_w_clk = nf_clk_w
    let nf_w_date = if(nf_m_date, nf_date_w, 0)
    let nf_w_cd = if(nf_m_cd, nf_cd_t_m.width + 3 + nf_cd_d_m.width + if(nf_glass_on, 10, 0), 0)
    let nf_m_gap = 14
    let nf_vis_n = if(nf_m_cpu, 1, 0) + if(nf_m_mem, 1, 0) + if(nf_m_net, 1, 0) + 1 + if(nf_m_date, 1, 0) + if(nf_m_cd, 1, 0)
    let nf_strip_w = nf_w_cpu + nf_w_mem + nf_w_net + nf_w_clk + nf_w_date + nf_w_cd + max(0, nf_vis_n - 1) * nf_m_gap
    let nf_rel_cpu = if(nf_m_mem and bar_ord_mem < bar_ord_cpu, nf_w_mem + nf_m_gap, 0) + if(nf_m_net and bar_ord_net < bar_ord_cpu, nf_w_net + nf_m_gap, 0) + if(nf_m_clk and bar_ord_clock < bar_ord_cpu, nf_w_clk + nf_m_gap, 0) + if(nf_m_date and bar_ord_date < bar_ord_cpu, nf_w_date + nf_m_gap, 0) + if(nf_m_cd and bar_ord_cd < bar_ord_cpu, nf_w_cd + nf_m_gap, 0)
    let nf_rel_mem = if(nf_m_cpu and bar_ord_cpu < bar_ord_mem, nf_w_cpu + nf_m_gap, 0) + if(nf_m_net and bar_ord_net < bar_ord_mem, nf_w_net + nf_m_gap, 0) + if(nf_m_clk and bar_ord_clock < bar_ord_mem, nf_w_clk + nf_m_gap, 0) + if(nf_m_date and bar_ord_date < bar_ord_mem, nf_w_date + nf_m_gap, 0) + if(nf_m_cd and bar_ord_cd < bar_ord_mem, nf_w_cd + nf_m_gap, 0)
    let nf_rel_net = if(nf_m_cpu and bar_ord_cpu < bar_ord_net, nf_w_cpu + nf_m_gap, 0) + if(nf_m_mem and bar_ord_mem < bar_ord_net, nf_w_mem + nf_m_gap, 0) + if(nf_m_clk and bar_ord_clock < bar_ord_net, nf_w_clk + nf_m_gap, 0) + if(nf_m_date and bar_ord_date < bar_ord_net, nf_w_date + nf_m_gap, 0) + if(nf_m_cd and bar_ord_cd < bar_ord_net, nf_w_cd + nf_m_gap, 0)
    let nf_rel_clk = if(nf_m_cpu and bar_ord_cpu < bar_ord_clock, nf_w_cpu + nf_m_gap, 0) + if(nf_m_mem and bar_ord_mem < bar_ord_clock, nf_w_mem + nf_m_gap, 0) + if(nf_m_net and bar_ord_net < bar_ord_clock, nf_w_net + nf_m_gap, 0) + if(nf_m_date and bar_ord_date < bar_ord_clock, nf_w_date + nf_m_gap, 0) + if(nf_m_cd and bar_ord_cd < bar_ord_clock, nf_w_cd + nf_m_gap, 0)
    let nf_rel_date = if(nf_m_cpu and bar_ord_cpu < bar_ord_date, nf_w_cpu + nf_m_gap, 0) + if(nf_m_mem and bar_ord_mem < bar_ord_date, nf_w_mem + nf_m_gap, 0) + if(nf_m_net and bar_ord_net < bar_ord_date, nf_w_net + nf_m_gap, 0) + if(nf_m_clk and bar_ord_clock < bar_ord_date, nf_w_clk + nf_m_gap, 0) + if(nf_m_cd and bar_ord_cd < bar_ord_date, nf_w_cd + nf_m_gap, 0)
    let nf_rel_cd = if(nf_m_cpu and bar_ord_cpu < bar_ord_cd, nf_w_cpu + nf_m_gap, 0) + if(nf_m_mem and bar_ord_mem < bar_ord_cd, nf_w_mem + nf_m_gap, 0) + if(nf_m_net and bar_ord_net < bar_ord_cd, nf_w_net + nf_m_gap, 0) + if(nf_m_clk and bar_ord_clock < bar_ord_cd, nf_w_clk + nf_m_gap, 0) + if(nf_m_date and bar_ord_date < bar_ord_cd, nf_w_date + nf_m_gap, 0)
    prop nf_pos_cpu = 0 ~quick
    follow nf_pos_cpu = nf_rel_cpu
    prop nf_pos_mem = 0 ~quick
    follow nf_pos_mem = nf_rel_mem
    prop nf_pos_net = 0 ~quick
    follow nf_pos_net = nf_rel_net
    prop nf_pos_clk = 0 ~quick
    follow nf_pos_clk = nf_rel_clk
    prop nf_pos_date = 0 ~quick
    follow nf_pos_date = nf_rel_date
    prop nf_pos_cd = 0 ~quick
    follow nf_pos_cd = nf_rel_cd
    let nf_need_w = if(nf_stacked,
        max(nf_clk_w, nf_date_w) + 40,
        nf_strip_w + 36)
    prop nf_clock_w = 168 ~quick
    follow nf_clock_w = max(notch_clock_w, nf_need_w)
    prop nf_beat = 0 ~quick
    follow nf_beat = if(music_frame_on and music_on and not motion.reduced, clamp(bands.0, 0, 1), 0)
    prop nf_bulge_p = 0 ~sp_calm
    prop nf_bulge_x = 960 ~sp_lead
    prop nf_cpu_s = 0 ~sp_calm
    follow nf_cpu_s = sys_cpu
    prop nf_mem_s = 0 ~sp_calm
    follow nf_mem_s = sys_mem
    prop nf_rx_s = 0 ~quick
    follow nf_rx_s = bar_rx_act
    prop nf_tx_s = 0 ~quick
    follow nf_tx_s = bar_tx_act

    surface notch_frame {
        size: full, full
        anchor: top_left
        reserve: 0
        level: top, overlay while panel_open or center_open or launch_open or nt_center or (nt_has and not nt_drift)
        open: true
        rate: 90, 60 while music_frame_on and music_on, 60 while panel_open or center_open or launch_open or nt_center or (nt_has and not nt_drift) or nt_np > 0.01, 15 while quiet
        keyboard: exclusive while launch_open or center_open or panel_open or nt_center

        let nf.w = notch_frame.width
        let nf.h = notch_frame.height
        let nf.cx = nf.w / 2
        let nf.clock_w = nf_clock_w + 4 * nf_beat
        let nf.clock_h = max(notch_clock_h, nf_fs + 10) + 2.5 * nf_beat
        let nf.settings_h = notch_clock_h + 820
        let nf.center_h = notch_clock_h + 720
        //  anchor:center places the row's top edge at y in plm.
        //  To visually centre text rows, shift up by ~0.62 * font size.
        let nf.bar_x0 = nf.cx - nf_strip_w / 2
        let nf.bar_cy = nf.clock_h / 2
        let nf.ic_s = clamp((nf.clock_h - 6) / max(22, nf_ring_r * 2 + nf_ring_w + 2), 0.75, 1.1)
        let nf.gm_gl = if(bar_num_style == 1, 0.82, if(bar_num_style == 2, 0.70, 0.65))
        //  Small 12..26px top-bar digits sit on the smoked notch; disable curved
        //  lens refraction on their 3 separate bodies while keeping glass/rim/glow.
        let nf.gm_lens = false
        let nf.gm_rim = if(bar_num_style == 1, 0.66, if(bar_num_style == 2, 0.34, 0.56))
        let nf.gm_fr = if(bar_num_style == 1, 0.12, if(bar_num_style == 2, 0.90, 0.16))
        let nf.gm_tint = if(bar_num_style == 1, 0.44, if(bar_num_style == 2, 0.58, 0.64))
        let nf.gm_milk = if(bar_num_style == 1, 0.04, if(bar_num_style == 2, 0.14, 0.0))
        let nf.gm_vivid = if(bar_num_style == 1, 1.25, if(bar_num_style == 2, 1.08, 1.48))
        let nf.gm_mir = if(bar_num_style == 1, 1.08, if(bar_num_style == 2, 0.45, 0.92))
        let nf.gm_hi = if(bar_num_style == 1, 1.38, if(bar_num_style == 2, 0.72, 1.26))
        let nf.gm_glow = if(bar_num_style == 1, 16%, if(bar_num_style == 2, 12%, 26%))
        let nf.gm_op = if(bar_num_style == 1, 74%, if(bar_num_style == 2, 82%, 74%))
        let nf.gm_col_a = if(bar_num_style == 3, mix(primary, #ffffff, 0.14), if(bar_num_style == 2, mix(ink, primary, 0.08), mix(ink, primary, 0.14)))
        let nf.gm_col_b = if(bar_num_style == 3, mix(secondary, #ffffff, 0.14), if(bar_num_style == 2, mix(faint, secondary, 0.22), mix(ink, secondary, 0.18)))
        let nf.gm_glow_a = if(bar_num_style == 3, nf.gm_col_a, #ffffff)
        let nf.gm_glow_b = if(bar_num_style == 3, nf.gm_col_b, #ffffff)
        let nf.clock_x = if(nf_stacked, nf.cx, nf.bar_x0 + nf_pos_clk + nf_w_clk / 2)
        let nf.clock_y = if(nf_stacked, nf.clock_h / 2 - nf_fs * 1.1, nf.bar_cy - nf_fs * 0.62)
        let nf.date_x = if(nf_stacked, nf.cx - nf_date_w / 2, nf.bar_x0 + nf_pos_date)
        let nf.date_y = if(nf_stacked, nf.clock_h / 2 + 12, nf.bar_cy)
        let nf.rail = 8
        let nf.inner_r = 23
        let nf.over = 50
        let nf.music = music_frame_on and music_on
        let nf.all_sides = music_frame_sides == 1
        let nf.cp_p = clamp(cp_np, 0, 1)
        let nf.ct_p = clamp(ct_np, 0, 1)
        let nf.launch_p = clamp(la_p, 0, 1)
        let nf.ntc_p = clamp(ntc_p, 0, 1)
        let nf.search_h = notch_clock_h + 600
        let nf.notify_h = notch_clock_h + 650
        //  Drawer geometry: the drop is a spring; halfway it narrows into a
        //  bell and opens its corners, and on landing sag/wobble settle it.
        let nf.cp_w = mix(nf.clock_w, 860, nf.cp_p)
        let nf.cp_h = nf.settings_h * nf.cp_p
        let nf.ct_w = mix(nf.clock_w, 1120, nf.ct_p)
        let nf.ct_h = nf.center_h * nf.ct_p
        let nf.la_w = mix(nf.clock_w, 620, nf.launch_p)
        let nf.la_h = nf.search_h * nf.launch_p
        let nf.motion_k = if(motion.reduced, 0, clamp(drawer_motion / 100, 0, 2))
        let nf.neck_k = if(motion.reduced, 0, clamp(drawer_neck / 100, 0, 2))
        let nf.wave_k = clamp(frame_wave_strength / 100, 0, 2)
        let nf.wave_speed = clamp(frame_wave_speed / 100, 0.25, 2)
        let nf.cp_bell = 4 * min(1, nf.cp_p) * (1 - min(1, nf.cp_p)) * nf.neck_k
        let nf.ct_bell = 4 * min(1, nf.ct_p) * (1 - min(1, nf.ct_p)) * nf.neck_k
        let nf.la_bell = 4 * min(1, nf.launch_p) * (1 - min(1, nf.launch_p)) * nf.neck_k
        let nf.cp_wob = clamp(cp_wobble * nf.motion_k, -60, 60)
        let nf.ct_wob = clamp(ct_wobble * nf.motion_k, -60, 60)
        let nf.la_wob = clamp(la_wobble * nf.motion_k, -60, 60)
        let nf.cp_ew = nf.cp_w * (1 + nf.cp_bell * 0.08 * nf.motion_k - 0.07 * nf.cp_bell + 0.005 * nf.cp_wob)
        let nf.cp_eh = nf.cp_h * (1 - nf.cp_bell * 0.04 * nf.motion_k - 0.002 * nf.cp_wob) + max(0, clamp(cp_sag, 0, 30)) * nf.motion_k
        let nf.ct_ew = nf.ct_w * (1 + nf.ct_bell * 0.08 * nf.motion_k - 0.07 * nf.ct_bell + 0.005 * nf.ct_wob)
        let nf.ct_eh = nf.ct_h * (1 - nf.ct_bell * 0.04 * nf.motion_k - 0.002 * nf.ct_wob) + max(0, clamp(ct_sag, 0, 30)) * nf.motion_k
        let nf.la_ew = nf.la_w * (1 + nf.la_bell * 0.08 * nf.motion_k - 0.07 * nf.la_bell + 0.005 * nf.la_wob)
        let nf.la_eh = nf.la_h * (1 - nf.la_bell * 0.04 * nf.motion_k - 0.002 * nf.la_wob) + max(0, clamp(la_sag, 0, 30)) * nf.motion_k
        //  The wave bends the frame and the open drawer's rim.  It sleeps
        //  outside music, reduced-motion mode, and the short opening window.
        let nf.wave_panel_on = if(nf.cp_p > 0.01, 1, if(nf.ct_p > 0.01, 1, if(nf.launch_p > 0.01, 1, 0)))
        let nf.wave_pw = if(nf.cp_p > 0.01, nf.cp_ew, if(nf.ct_p > 0.01, nf.ct_ew, if(nf.launch_p > 0.01, nf.la_ew, 0)))
        let nf.wave_ph = if(nf.cp_p > 0.01, nf.cp_eh, if(nf.ct_p > 0.01, nf.ct_eh, if(nf.launch_p > 0.01, nf.la_eh, 0)))
        let nf.wave_cy = nf.wave_ph / 2
        let nf.wave_bass = clamp(bands.0 * 1.8, 0, 1)
        let nf.wave_on = not motion.reduced and frame_wave_on and nf.wave_k > 0.001 and nf.wave_panel_on > 0.5 and (nf.music or (nf.cp_p > 0.01 and nf.cp_p < 0.995) or (nf.ct_p > 0.01 and nf.ct_p < 0.995) or (nf.launch_p > 0.01 and nf.launch_p < 0.995) or abs(nf.cp_wob) > 1 or abs(nf.ct_wob) > 1 or abs(nf.la_wob) > 1)
        let nf.sm = music_frame_sens
        let nf.hm = music_frame_hgt
        let nf.bon = if(nf.music, 1, 0)
        //  Unified column count (6, 12, 24 or 48) drives one shared glass body;
        //  vertical edges cap at 24 for aspect-matched spacing on 16:9 screens.
        let nf.nuse = clamp(music_frame_cols, 6, 48)
        let nf.nuse_v = min(nf.nuse, 24)
        let nf.drawer_waves_on = nf.music and (panel_open or nf.cp_p > 0.01 or center_open or nf.ct_p > 0.01)
        let nf.shine_x = if(glass_shine, floor(pointer.x / 24) * 24, 0)
        let nf.shine_y = if(glass_shine, floor(pointer.y / 24) * 24, 0)
        let nf.bw = 17 * mix(0.8, 1.9, music_frame_blend / 100)
        let nf.bbl = mix(10, 32, music_frame_blend / 100)
        let nf.cp_shift = if(panel_open or nf.cp_p > 0.01, 0, 30000)
        let nf.ct_shift = if(center_open or nf.ct_p > 0.01, 0, 30000)
        let nf.la_shift = if(launch_open or nf.launch_p > 0.01, 0, 30000)
        let nf.bulge_hot = not panel_open and not center_open and not launch_open and not nt_center and not motion.reduced and nf_clock.hover > 0.5
        follow nf_bulge_p = if(nf.bulge_hot, 1, 0)
        follow nf_bulge_x = if(nf.bulge_hot, clamp(pointer.x, nf.cx - nf.clock_w / 2 + 28, nf.cx + nf.clock_w / 2 - 28), nf.cx)
        let nf.bulge_shift = if(nf_bulge_p > 0.01, 0, 30000)
        let nf.nt_p = clamp(nt_np, 0, 1)
        let nf.nt_dock_on = not nt_drift and (nt_has or nf.nt_p > 0.01)
        let nf.nt_c_on = nf.nt_dock_on and nt_pos == 0
        let nf.nt_r_on = nf.nt_dock_on and nt_pos == 1
        let nf.nt_bell = 4 * min(1, nf.nt_p) * (1 - min(1, nf.nt_p)) * nf.neck_k
        let nf.nt_wob = clamp(nt_wobble * nf.motion_k, -40, 40)
        let nf.nt_cw = mix(nf.clock_w, 314, nf.nt_p) * (1 + nf.nt_bell * 0.06 * nf.motion_k - 0.06 * nf.nt_bell + 0.004 * nf.nt_wob)
        let nf.nt_ch = (nf.clock_h + 124) * nf.nt_p * (1 - nf.nt_bell * 0.03 * nf.motion_k) + max(0, clamp(nt_sag, 0, 22)) * nf.motion_k * nf.nt_p
        let nf.nt_c_shift = if(nf.nt_c_on, 0, 30000)
        let nf.nt_rw = mix(36, 318, nf.nt_p) * (1 + nf.nt_bell * 0.05 * nf.motion_k + 0.003 * nf.nt_wob)
        let nf.nt_rh = mix(24, 134, nf.nt_p) + max(0, clamp(nt_sag, 0, 18)) * nf.motion_k * nf.nt_p
        let nf.nt_r_shift = if(nf.nt_r_on, 0, 30000)
        let nf.smoke_bg = mix(tint, #000000, glass_smoke * 0.65)
        let nf.frame_color = mix(nf.smoke_bg, primary,
            if(notch_tint_on, clamp(notch_tint_depth / 100, 0, 1), 0))

        let nf.db.0 = abs(2 * (0.5 / 12) - 1) * 23
        let nf.dl.0 = clamp(floor(nf.db.0), 0, 22)
        let nf.dh.0 = if(nf.drawer_waves_on, min(1, pow(mix(pick(nf.dl.0, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.0 - nf.dl.0), 1.4) * nf.sm) * clamp(min(0.5, 11.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.1 = abs(2 * (1.5 / 12) - 1) * 23
        let nf.dl.1 = clamp(floor(nf.db.1), 0, 22)
        let nf.dh.1 = if(nf.drawer_waves_on, min(1, pow(mix(pick(nf.dl.1, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.1, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.1 - nf.dl.1), 1.4) * nf.sm) * clamp(min(1.5, 10.5) / 0.6, 0, 1) * nf.hm, 0)
