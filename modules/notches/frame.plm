part NotchFrame {
    shader frame_wave = file "frame_wave.wgsl"
    prop nf_sec_ones = 1 ~quick
    prop nf_sec_tens = 1 ~quick

    surface notch_frame {
        size: full, full
        anchor: top_left
        reserve: 0
        level: top, overlay while panel_open or center_open or launch_open or nt_center
        open: true
        rate: 90, 60 while music_frame_on and music_on, 60 while panel_open or center_open or launch_open or nt_center, 15 while quiet
        keyboard: on_demand while nt_center

        let nf.w = notch_frame.width
        let nf.h = notch_frame.height
        let nf.cx = nf.w / 2
        let nf.clock_w = notch_clock_w
        let nf.clock_h = notch_clock_h
        let nf.settings_h = notch_clock_h + 820
        let nf.center_h = notch_clock_h + 720
        //  anchor:center places the row's top edge at y in plm.
        //  To visually centre 19px text, shift up by ~half the text height.
        let nf.clock_y = nf.clock_h / 2 - 12
        let nf.rail = 8
        let nf.inner_r = 23
        let nf.over = 50
        let nf.music = music_frame_on and music_on
        let nf.all_sides = music_frame_sides == 1
        let nf.cp_p = clamp(cp_np, 0, 1)
        let nf.ct_p = clamp(ct_np, 0, 1)
        let nf.launch_p = clamp(la_p, 0, 1)
        let nf.ntc_p = clamp(ntc_p, 0, 1)
        let nf.search_h = notch_clock_h + 600
        let nf.notify_h = notch_clock_h + 650
        //  Drawer geometry: the drop is a spring; halfway it narrows into a
        //  bell and opens its corners, and on landing sag/wobble settle it.
        let nf.cp_w = mix(nf.clock_w, 860, nf.cp_p)
        let nf.cp_h = nf.settings_h * nf.cp_p
        let nf.ct_w = mix(nf.clock_w, 1120, nf.ct_p)
        let nf.ct_h = nf.center_h * nf.ct_p
        let nf.la_w = mix(nf.clock_w, 620, nf.launch_p)
        let nf.la_h = nf.search_h * nf.launch_p
        let nf.cp_bell = 4 * min(1, nf.cp_p) * (1 - min(1, nf.cp_p))
        let nf.ct_bell = 4 * min(1, nf.ct_p) * (1 - min(1, nf.ct_p))
        let nf.la_bell = 4 * min(1, nf.launch_p) * (1 - min(1, nf.launch_p))
        let nf.cp_wob = clamp(cp_wobble, -30, 30)
        let nf.ct_wob = clamp(ct_wobble, -30, 30)
        let nf.la_wob = clamp(la_wobble, -30, 30)
        let nf.cp_ew = nf.cp_w * (1 + nf.cp_bell * 0.08 - 0.07 * nf.cp_bell + 0.005 * nf.cp_wob)
        let nf.cp_eh = nf.cp_h * (1 - nf.cp_bell * 0.04 - 0.002 * nf.cp_wob) + max(0, clamp(cp_sag, 0, 30))
        let nf.ct_ew = nf.ct_w * (1 + nf.ct_bell * 0.08 - 0.07 * nf.ct_bell + 0.005 * nf.ct_wob)
        let nf.ct_eh = nf.ct_h * (1 - nf.ct_bell * 0.04 - 0.002 * nf.ct_wob) + max(0, clamp(ct_sag, 0, 30))
        let nf.la_ew = nf.la_w * (1 + nf.la_bell * 0.08 - 0.07 * nf.la_bell + 0.005 * nf.la_wob)
        let nf.la_eh = nf.la_h * (1 - nf.la_bell * 0.04 - 0.002 * nf.la_wob) + max(0, clamp(la_sag, 0, 30))
        //  The wave bends the frame and the open drawer's rim.  It sleeps
        //  outside music and the short opening/landing window.
        let nf.wave_panel_on = if(nf.cp_p > 0.01, 1, if(nf.ct_p > 0.01, 1, if(nf.launch_p > 0.01, 1, 0)))
        let nf.wave_pw = if(nf.cp_p > 0.01, nf.cp_ew, if(nf.ct_p > 0.01, nf.ct_ew, if(nf.launch_p > 0.01, nf.la_ew, 0)))
        let nf.wave_ph = if(nf.cp_p > 0.01, nf.cp_eh, if(nf.ct_p > 0.01, nf.ct_eh, if(nf.launch_p > 0.01, nf.la_eh, 0)))
        let nf.wave_cy = nf.wave_ph / 2
        let nf.wave_bass = clamp(bands.0 * 1.8, 0, 1)
        let nf.wave_on = nf.wave_panel_on > 0.5 and (nf.music or (nf.cp_p > 0.01 and nf.cp_p < 0.995) or (nf.ct_p > 0.01 and nf.ct_p < 0.995) or (nf.launch_p > 0.01 and nf.launch_p < 0.995) or abs(nf.cp_wob) > 1 or abs(nf.ct_wob) > 1 or abs(nf.la_wob) > 1)
        let nf.sm = music_frame_sens
        let nf.hm = music_frame_hgt
        let nf.bon = if(nf.music, 1, 0)
        //  nuse is clamped to the actual column count per body block.
        let nf.nuse = music_frame_cols
        //  Bar width and blend — same formula as Vitreus: fw.wf mixes 0.8..1.9
        let nf.bw = 17 * mix(0.8, 1.9, music_frame_blend / 100)
        //  blend pixels: mix(10, 32, fw_bl) in Vitreus
        let nf.bbl = mix(10, 32, music_frame_blend / 100)
        //  Open-drawer waves stay in the same body as the frame and music;
        //  only their positions move out of view while a drawer is closed.
        let nf.cp_shift = if(panel_open or nf.cp_p > 0.01, 0, 30000)
        let nf.ct_shift = if(center_open or nf.ct_p > 0.01, 0, 30000)
        let nf.la_shift = if(launch_open or nf.launch_p > 0.01, 0, 30000)
        //  The frame keeps its neutral glass base.  `bar_bg` carries the Bar
        //  page's Tint depth, so using it here would colour the clock/time
        //  ring while the music bars stayed glass and make the frame split.
        let nf.smoke_bg = mix(tint, #000000, glass_smoke * 0.65)
        let nf.frame_color = mix(nf.smoke_bg, primary,
            if(notch_tint_on, clamp(notch_tint_depth / 100, 0, 1), 0))

