        //  One glass group for the frame body and the music/drawer rims; the
        //  wave is gated so it is not a full-surface pass at rest.
        group {
            shader: frame_wave, nf.wave_bass, nf.wave_panel_on, nf.cx, nf.wave_cy, nf.wave_pw, nf.wave_ph, nf.cp_wob, 0 while nf.wave_on
        body {
            color: nf.frame_color
            glass: if(glass_on, 100%, 0%)
            opacity: 1% * glass_tint
            lens: glass_on and glass_bend
            frost: glass_frost / 100
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            smoke: glass_smoke
            vivid: glass_vivid
            mirror: glass_mirror
            highlight: glass_highlight
            ripple: glass_ripple
            border: 1.5 * glass_border / 100, ink
            rim: 1% * glass_edge
            shadow: 0, 2, 12, 24%, glass_shadow
            show: music_frame_cols == 6

            //  Ring
            box { from: 0 - nf.over / 2, 0 - nf.over / 2; size: nf.w + nf.over, nf.h + nf.over; corner: nf.inner_r + (nf.rail + nf.over) / 2; stroke: nf.rail + nf.over }
            //  Clock notch
            box { from: nf.cx - nf.clock_w / 2, 0; size: nf.clock_w, nf.clock_h; corner: 20; blend: 34 }
            box { from: nf.cx - nf.clock_w / 2 + 14, nf.clock_h - 2; size: nf.clock_w - 28, 1; corner: 0.5 }
            //  Settings drawer — single box growing from clock-width to full 860px,
            //  starting at y=0 so the entire top edge connects to the frame.
            box { from: nf.cx - nf.cp_ew / 2 + nf.cp_shift + nf.cp_wob * 0.5, 0; size: nf.cp_ew, max(0.3, nf.cp_eh); corner: mix(20, 26, nf.cp_p); blend: mix(34, 36, nf.cp_p) * nf.cp_p; show: panel_open or nf.cp_p > 0.01 }
            ellipse { at: nf.cx - nf.cp_ew / 2 + 20 + nf.cp_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.cp_bell); blend: 16 * nf.cp_bell; show: (panel_open or nf.cp_p > 0.01) and nf.cp_bell > 0.02 }
            ellipse { at: nf.cx + nf.cp_ew / 2 - 20 + nf.cp_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.cp_bell); blend: 16 * nf.cp_bell; show: (panel_open or nf.cp_p > 0.01) and nf.cp_bell > 0.02 }
            //  Centre drawer — same pattern, full width 1120px.
            box { from: nf.cx - nf.ct_ew / 2 + nf.ct_shift + nf.ct_wob * 0.5, 0; size: nf.ct_ew, max(0.3, nf.ct_eh); corner: mix(20, 30, nf.ct_p); blend: mix(34, 36, nf.ct_p) * nf.ct_p; show: center_open or nf.ct_p > 0.01 }
            ellipse { at: nf.cx - nf.ct_ew / 2 + 20 + nf.ct_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.ct_bell); blend: 16 * nf.ct_bell; show: (center_open or nf.ct_p > 0.01) and nf.ct_bell > 0.02 }
            ellipse { at: nf.cx + nf.ct_ew / 2 - 20 + nf.ct_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.ct_bell); blend: 16 * nf.ct_bell; show: (center_open or nf.ct_p > 0.01) and nf.ct_bell > 0.02 }
            //  Search and notifications share this glass body, while their
            //  toasts remain independent surfaces.
            box { from: nf.cx - nf.la_ew / 2 + nf.la_shift + nf.la_wob * 0.5, 0; size: nf.la_ew, max(0.3, nf.la_eh); corner: mix(20, 24, nf.launch_p); blend: mix(34, 36, nf.launch_p) * nf.launch_p; show: launch_open or nf.launch_p > 0.01 }
            ellipse { at: nf.cx - nf.la_ew / 2 + 20 + nf.la_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.la_bell); blend: 16 * nf.la_bell; show: (launch_open or nf.launch_p > 0.01) and nf.la_bell > 0.02 }
            ellipse { at: nf.cx + nf.la_ew / 2 - 20 + nf.la_shift, nf.clock_h; radius: 18; scale: 1, max(0.15, nf.la_bell); blend: 16 * nf.la_bell; show: (launch_open or nf.launch_p > 0.01) and nf.la_bell > 0.02 }
            box { from: nf.cx - mix(nf.clock_w, 480, nf.ntc_p) / 2 + if(nt_center or nf.ntc_p > 0.01, 0, 30000), 0; size: mix(nf.clock_w, 480, nf.ntc_p), max(0.3, nf.notify_h * nf.ntc_p); corner: mix(20, 26, nf.ntc_p); blend: mix(34, 36, nf.ntc_p) * nf.ntc_p; show: nt_center or nf.ntc_p > 0.01 }

            box { at: nf.w * 0.5 / 6 + if(nf6.h.0 > 1 and abs(nf.w * 0.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.0 / 2; size: nf.bw, nf6.h.0; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.0 > 1 and abs(nf.w * 0.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 1.5 / 6 + if(nf6.h.1 > 1 and abs(nf.w * 1.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.1 / 2; size: nf.bw, nf6.h.1; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.1 > 1 and abs(nf.w * 1.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 2.5 / 6 + if(nf6.h.2 > 1 and abs(nf.w * 2.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.2 / 2; size: nf.bw, nf6.h.2; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.2 > 1 and abs(nf.w * 2.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 3.5 / 6 + if(nf6.h.3 > 1 and abs(nf.w * 3.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.3 / 2; size: nf.bw, nf6.h.3; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.3 > 1 and abs(nf.w * 3.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 4.5 / 6 + if(nf6.h.4 > 1 and abs(nf.w * 4.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.4 / 2; size: nf.bw, nf6.h.4; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.4 > 1 and abs(nf.w * 4.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 5.5 / 6 + if(nf6.h.5 > 1 and abs(nf.w * 5.5 / 6 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail + nf6.h.5 / 2; size: nf.bw, nf6.h.5; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf6.h.5 > 1 and abs(nf.w * 5.5 / 6 - nf.cx) > nf.clock_w / 2 + 16 }
            box { at: nf.w * 0.5 / 6 + if(nf.all_sides and nf6.h.0 > 1, 0, 30000), nf.h - nf.rail - nf6.h.0 / 2; size: nf.bw, nf6.h.0; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.0 > 1 }
            box { at: nf.w * 1.5 / 6 + if(nf.all_sides and nf6.h.1 > 1, 0, 30000), nf.h - nf.rail - nf6.h.1 / 2; size: nf.bw, nf6.h.1; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.1 > 1 }
            box { at: nf.w * 2.5 / 6 + if(nf.all_sides and nf6.h.2 > 1, 0, 30000), nf.h - nf.rail - nf6.h.2 / 2; size: nf.bw, nf6.h.2; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.2 > 1 }
            box { at: nf.w * 3.5 / 6 + if(nf.all_sides and nf6.h.3 > 1, 0, 30000), nf.h - nf.rail - nf6.h.3 / 2; size: nf.bw, nf6.h.3; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.3 > 1 }
            box { at: nf.w * 4.5 / 6 + if(nf.all_sides and nf6.h.4 > 1, 0, 30000), nf.h - nf.rail - nf6.h.4 / 2; size: nf.bw, nf6.h.4; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.4 > 1 }
            box { at: nf.w * 5.5 / 6 + if(nf.all_sides and nf6.h.5 > 1, 0, 30000), nf.h - nf.rail - nf6.h.5 / 2; size: nf.bw, nf6.h.5; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.5 > 1 }
            box { at: nf.rail + nf6.h.0 / 2 + if(nf.all_sides and nf6.h.0 > 1, 0, 30000), nf.h * 0.5 / 6; size: nf6.h.0, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.0 > 1 }
            box { at: nf.rail + nf6.h.1 / 2 + if(nf.all_sides and nf6.h.1 > 1, 0, 30000), nf.h * 1.5 / 6; size: nf6.h.1, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.1 > 1 }
            box { at: nf.rail + nf6.h.2 / 2 + if(nf.all_sides and nf6.h.2 > 1, 0, 30000), nf.h * 2.5 / 6; size: nf6.h.2, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.2 > 1 }
            box { at: nf.rail + nf6.h.3 / 2 + if(nf.all_sides and nf6.h.3 > 1, 0, 30000), nf.h * 3.5 / 6; size: nf6.h.3, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.all_sides and nf6.h.3 > 1 }
