        let nf.db.7 = abs(2 * (7.5 / 12) - 1) * 23
        let nf.dl.7 = clamp(floor(nf.db.7), 0, 22)
        let nf.dh.7 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.7, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.7, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.7 - nf.dl.7), 1.4) * nf.sm) * clamp(min(7.5, 4.5) / 0.6, 0, 1) * nf.hm, 0)
