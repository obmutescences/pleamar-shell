part NotchFrame {
    //  One full-screen surface for the Notches shell: the ring, the clock,
    //  and the music bars all live here.  There are no water strips and no
    //  bar surface; the drawer panels are the only overlays.
    prop nf_sec_ones = 1 ~quick
    prop nf_sec_tens = 1 ~quick

    surface notch_frame {
        size: full, full
        anchor: top_left
        reserve: 0
        level: top, overlay while panel_open or center_open
        open: true
        rate: 120, 60 while music_frame_on and music_on, 30 while quiet
        keyboard: none

        let nf.w = notch_frame.width
        let nf.h = notch_frame.height
        let nf.cx = nf.w / 2
        let nf.clock_w = 220
        let nf.clock_h = 56
        let nf.clock_y = 27
        let nf.rail = 10
        let nf.corner = 32
        let nf.music = music_frame_on and music_on
        let nf.top_only = music_frame_sides == 0
        let nf.all_sides = music_frame_sides == 1
        let nf.cp_p = clamp(cp_np, 0, 1)
        let nf.ct_p = clamp(ct_np, 0, 1)
        let nf.cp_neck = mix(34, 104, min(1, nf.cp_p * 1.5))
        let nf.ct_neck = mix(34, 104, min(1, nf.ct_p * 1.5))

        //  Music visualization levels - same as Vitreus pattern
        let nf.bw = 13
        let nf.sens = 42
        let nf.level0 = nf.sens * band.s.0
        let nf.level1 = nf.sens * band.s.1
        let nf.level2 = nf.sens * band.s.2
        let nf.level3 = nf.sens * band.s.3
        let nf.level4 = nf.sens * band.s.4
        let nf.level5 = nf.sens * band.s.5

        //  ── the ring ─────────────────────────────────────────────────────
        body {
            color: bar_bg
            glass: if(glass_on, 100%, 0%)
            opacity: 1% * max(glass_tint, if(panel_open or center_open, 84, 0))
            lens: glass_on and glass_bend
            frost: glass_frost / 100
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            smoke: glass_smoke
            vivid: glass_vivid
            mirror: glass_mirror
            highlight: glass_highlight
            ripple: glass_ripple
            border: 1.5 * glass_border / 100, ink
            rim: 1% * glass_edge
            shadow: 0, 2, 12, 24%, glass_shadow

            //  Filled rails keep every edge visible; the corner pieces round
            //  the opening while leaving this one continuous glass body.
            box { from: 0, 0; size: nf.w, nf.rail }
            box { from: 0, nf.h - nf.rail; size: nf.w, nf.rail }
            box { from: 0, nf.rail; size: nf.rail, nf.h - nf.rail * 2 }
            box { from: nf.w - nf.rail, nf.rail; size: nf.rail, nf.h - nf.rail * 2 }
            path { at: 0, 0; move nf.corner, nf.rail; curve nf.rail, nf.corner via nf.rail, nf.rail; line nf.rail, nf.rail; close }
            path { at: 0, 0; move nf.w - nf.corner, nf.rail; curve nf.w - nf.rail, nf.corner via nf.w - nf.rail, nf.rail; line nf.w - nf.rail, nf.rail; close }
            path { at: 0, 0; move nf.corner, nf.h - nf.rail; curve nf.rail, nf.h - nf.corner via nf.rail, nf.h - nf.rail; line nf.rail, nf.h - nf.rail; close }
            path { at: 0, 0; move nf.w - nf.corner, nf.h - nf.rail; curve nf.w - nf.rail, nf.h - nf.corner via nf.w - nf.rail, nf.h - nf.rail; line nf.w - nf.rail, nf.h - nf.rail; close }

            //  The clock notch is part of the same glass: the top rail swells
            //  down into it, with no separate capsule and no seam.
            box { from: nf.cx - nf.clock_w / 2, 0; size: nf.clock_w, nf.clock_h; corner: 20; blend: 34 }
            box { from: nf.cx - nf.clock_w / 2 + 14, nf.clock_h - 2; size: nf.clock_w - 28, 1; corner: 0.5 }

            //  Each drawer silhouette grows from the clock inside this body,
            //  so its neck, card and the frame share one liquid glass edge.
            box { from: nf.cx - nf.cp_neck / 2 + if(panel_open or nf.cp_p > 0.01, 0, 30000), 0; size: nf.cp_neck, 24; corner: 12; blend: 22 * nf.cp_p }
            box { from: nf.cx - max(18, nf.cp_neck * 0.52) / 2 + if(panel_open or nf.cp_p > 0.01, 0, 30000), 18; size: max(18, nf.cp_neck * 0.52), 56; corner: 12; blend: 22 * nf.cp_p }
            box { from: nf.cx - 430 + if(panel_open or nf.cp_p > 0.01, 0, 30000), 68; size: 860, max(0.3, 820 * nf.cp_p); corner: min(26, nf.cp_p * 410); blend: 36 * nf.cp_p }
            box { from: nf.cx - nf.ct_neck / 2 + if(center_open or nf.ct_p > 0.01, 0, 30000), 0; size: nf.ct_neck, 24; corner: 12; blend: 22 * nf.ct_p }
            box { from: nf.cx - max(18, nf.ct_neck * 0.52) / 2 + if(center_open or nf.ct_p > 0.01, 0, 30000), 18; size: max(18, nf.ct_neck * 0.52), 56; corner: 12; blend: 22 * nf.ct_p }
            box { from: nf.cx - 560 + if(center_open or nf.ct_p > 0.01, 0, 30000), 68; size: 1120, max(0.3, 720 * nf.ct_p); corner: min(30, nf.ct_p * 360); blend: 36 * nf.ct_p }

            //  Music bars: ALL in the same body, like Vitreus bar_waves.plm
            //  Manually expanded (no repeat in body) - Top edge - 12 columns
            box { at: nf.w * 0.5 / 12 + if(nf.music and nf.level0 > 1.2 and abs(nf.w * 0.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level0 / 2; size: nf.bw, nf.level0; corner: 6.5; blend: 14 }
            box { at: nf.w * 1.5 / 12 + if(nf.music and nf.level0 > 1.2 and abs(nf.w * 1.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level0 / 2; size: nf.bw, nf.level0; corner: 6.5; blend: 14 }
            box { at: nf.w * 2.5 / 12 + if(nf.music and nf.level1 > 1.2 and abs(nf.w * 2.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level1 / 2; size: nf.bw, nf.level1; corner: 6.5; blend: 14 }
            box { at: nf.w * 3.5 / 12 + if(nf.music and nf.level1 > 1.2 and abs(nf.w * 3.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level1 / 2; size: nf.bw, nf.level1; corner: 6.5; blend: 14 }
            box { at: nf.w * 4.5 / 12 + if(nf.music and nf.level2 > 1.2 and abs(nf.w * 4.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level2 / 2; size: nf.bw, nf.level2; corner: 6.5; blend: 14 }
            box { at: nf.w * 5.5 / 12 + if(nf.music and nf.level2 > 1.2 and abs(nf.w * 5.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level2 / 2; size: nf.bw, nf.level2; corner: 6.5; blend: 14 }
            box { at: nf.w * 6.5 / 12 + if(nf.music and nf.level3 > 1.2 and abs(nf.w * 6.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level3 / 2; size: nf.bw, nf.level3; corner: 6.5; blend: 14 }
            box { at: nf.w * 7.5 / 12 + if(nf.music and nf.level3 > 1.2 and abs(nf.w * 7.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level3 / 2; size: nf.bw, nf.level3; corner: 6.5; blend: 14 }
            box { at: nf.w * 8.5 / 12 + if(nf.music and nf.level4 > 1.2 and abs(nf.w * 8.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level4 / 2; size: nf.bw, nf.level4; corner: 6.5; blend: 14 }
            box { at: nf.w * 9.5 / 12 + if(nf.music and nf.level4 > 1.2 and abs(nf.w * 9.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level4 / 2; size: nf.bw, nf.level4; corner: 6.5; blend: 14 }
            box { at: nf.w * 10.5 / 12 + if(nf.music and nf.level5 > 1.2 and abs(nf.w * 10.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level5 / 2; size: nf.bw, nf.level5; corner: 6.5; blend: 14 }
            box { at: nf.w * 11.5 / 12 + if(nf.music and nf.level5 > 1.2 and abs(nf.w * 11.5 / 12 - nf.cx) > nf.clock_w / 2 + 16, 0, 30000), nf.rail - 2 + nf.level5 / 2; size: nf.bw, nf.level5; corner: 6.5; blend: 14 }

            //  Bottom edge - only when all_sides mode
            box { at: nf.w * 0.5 / 12 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level0 / 2; size: nf.bw, nf.level0; corner: 6.5; blend: 14 }
            box { at: nf.w * 1.5 / 12 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level0 / 2; size: nf.bw, nf.level0; corner: 6.5; blend: 14 }
            box { at: nf.w * 2.5 / 12 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level1 / 2; size: nf.bw, nf.level1; corner: 6.5; blend: 14 }
            box { at: nf.w * 3.5 / 12 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level1 / 2; size: nf.bw, nf.level1; corner: 6.5; blend: 14 }
            box { at: nf.w * 4.5 / 12 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level2 / 2; size: nf.bw, nf.level2; corner: 6.5; blend: 14 }
            box { at: nf.w * 5.5 / 12 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level2 / 2; size: nf.bw, nf.level2; corner: 6.5; blend: 14 }
            box { at: nf.w * 6.5 / 12 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level3 / 2; size: nf.bw, nf.level3; corner: 6.5; blend: 14 }
            box { at: nf.w * 7.5 / 12 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level3 / 2; size: nf.bw, nf.level3; corner: 6.5; blend: 14 }
            box { at: nf.w * 8.5 / 12 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level4 / 2; size: nf.bw, nf.level4; corner: 6.5; blend: 14 }
            box { at: nf.w * 9.5 / 12 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level4 / 2; size: nf.bw, nf.level4; corner: 6.5; blend: 14 }
            box { at: nf.w * 10.5 / 12 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level5 / 2; size: nf.bw, nf.level5; corner: 6.5; blend: 14 }
            box { at: nf.w * 11.5 / 12 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h - nf.rail + 2 - nf.level5 / 2; size: nf.bw, nf.level5; corner: 6.5; blend: 14 }

            //  Left edge - only when all_sides mode
            box { at: nf.rail - 2 + nf.level0 / 2 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h * 0.5 / 12; size: nf.level0, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level0 / 2 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h * 1.5 / 12; size: nf.level0, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level1 / 2 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h * 2.5 / 12; size: nf.level1, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level1 / 2 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h * 3.5 / 12; size: nf.level1, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level2 / 2 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h * 4.5 / 12; size: nf.level2, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level2 / 2 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h * 5.5 / 12; size: nf.level2, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level3 / 2 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h * 6.5 / 12; size: nf.level3, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level3 / 2 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h * 7.5 / 12; size: nf.level3, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level4 / 2 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h * 8.5 / 12; size: nf.level4, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level4 / 2 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h * 9.5 / 12; size: nf.level4, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level5 / 2 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h * 10.5 / 12; size: nf.level5, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.rail - 2 + nf.level5 / 2 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h * 11.5 / 12; size: nf.level5, nf.bw; corner: 6.5; blend: 14 }

            //  Right edge - only when all_sides mode
            box { at: nf.w - nf.rail + 2 - nf.level0 / 2 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h * 0.5 / 12; size: nf.level0, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level0 / 2 + if(nf.all_sides and nf.level0 > 1.2, 0, 30000), nf.h * 1.5 / 12; size: nf.level0, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level1 / 2 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h * 2.5 / 12; size: nf.level1, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level1 / 2 + if(nf.all_sides and nf.level1 > 1.2, 0, 30000), nf.h * 3.5 / 12; size: nf.level1, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level2 / 2 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h * 4.5 / 12; size: nf.level2, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level2 / 2 + if(nf.all_sides and nf.level2 > 1.2, 0, 30000), nf.h * 5.5 / 12; size: nf.level2, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level3 / 2 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h * 6.5 / 12; size: nf.level3, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level3 / 2 + if(nf.all_sides and nf.level3 > 1.2, 0, 30000), nf.h * 7.5 / 12; size: nf.level3, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level4 / 2 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h * 8.5 / 12; size: nf.level4, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level4 / 2 + if(nf.all_sides and nf.level4 > 1.2, 0, 30000), nf.h * 9.5 / 12; size: nf.level4, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level5 / 2 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h * 10.5 / 12; size: nf.level5, nf.bw; corner: 6.5; blend: 14 }
            box { at: nf.w - nf.rail + 2 - nf.level5 / 2 + if(nf.all_sides and nf.level5 > 1.2, 0, 30000), nf.h * 11.5 / 12; size: nf.level5, nf.bw; corner: 6.5; blend: 14 }
        }

        //  The clock text sits in the frame's notch; its body is the ring above.
        row {
            at: nf.cx, nf.clock_y
            anchor: center
            gap: 0
            align: end
            text "{floor(tick.hour / 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.hour, 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text ":" { size: 19; weight: 600; color: azure; family: "Space Grotesk" }
            text "{floor(tick.minute / 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.minute, 10)}" { size: 19; weight: 600; color: aqua; family: "Space Grotesk" }
            space 1
            text "{floor(tick.second / 10)}" { size: 11; weight: 600; color: azure; family: "Space Grotesk"; letter_move: 0, -3 + (1 - nf_sec_tens) * 4; letter_scale: 0.88 + 0.12 * nf_sec_tens }
            text "{mod(tick.second, 10)}" { size: 11; weight: 600; color: azure; family: "Space Grotesk"; letter_move: 0, -3 + (1 - nf_sec_ones) * 4; letter_scale: 0.88 + 0.12 * nf_sec_ones }
        }
        on change tick.second {
            nf_sec_ones: 0 ~10ms
            nf_sec_ones: 1 ~190ms after 10ms
        }
        on change floor(tick.second / 10) {
            nf_sec_tens: 0 ~10ms
            nf_sec_tens: 1 ~190ms after 10ms
        }

        zone box nf_clock { from: nf.cx - nf.clock_w / 2, 0; size: nf.clock_w, nf.clock_h; corner: 20; cursor: pointer; label: "Open centre panel" }
        on press nf_clock { emit ui_sound; emit center_toggle }

        group {
            show: panel_open or cp_np > 0.01
            NotchDrawerRipples(cp_np)
            NotchDrawerContent(cp_np, 860) { ConfigPanelContent() }
        }
        group {
            show: center_open or ct_np > 0.01
            NotchDrawerRipples(ct_np)
            NotchDrawerContent(ct_np, 1120) { CenterPanelContent() }
        }

    }
}
