            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.5 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 5.5/12; size: nf12.h.5, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.5 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.6 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 6.5/12; size: nf12.h.6, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.6 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.7 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 7.5/12; size: nf12.h.7, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.7 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.8 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 8.5/12; size: nf12.h.8, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.8 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.9 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 9.5/12; size: nf12.h.9, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.9 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.10 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 10.5/12; size: nf12.h.10, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.10 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.11 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 11.5/12; size: nf12.h.11, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.11 > 1 }
            //  Centre panel — bottom edge (12 bars)
            box { at: nf.cx - nf.ct_w / 2 + nf.ct_w * 0.5/12 + nf.ct_shift, nf.ct_h - nf.rail - nf12.h.0 / 2; size: nf.bw, nf12.h.0; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf12.h.0 > 1 }
