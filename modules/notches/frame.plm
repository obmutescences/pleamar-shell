part NotchFrame {
    shader frame_wave = file "frame_wave.wgsl"
    prop nf_sec_ones = 1 ~quick
    prop nf_sec_tens = 1 ~quick
    prop ap_p = 0 ~180ms
    follow ap_p = audio_pick_open
    measure nf_clk_m
    measure nf_date_m
    measure nf_lunar_m
    measure nf_week_m
    measure nf_dot_m
    let nf_stacked = bar_date_any and notch_clock_h >= 52
    let nf_inline = bar_date_any and notch_clock_h < 52
    let nf_clk_w = max(nf_clk_m.width, 54) + if(bar_show_secs, 20, 0)
    let nf_dot_w = max(nf_dot_m.width, 4)
    let nf_d_w = if(bar_has_date, nf_date_m.width, 0)
    let nf_l_w = if(bar_has_lunar, nf_lunar_m.width, 0)
    let nf_w_w = if(bar_has_weekday, nf_week_m.width, 0)
    let nf_sep1 = bar_has_date and bar_has_lunar
    let nf_sep2 = (bar_has_date or bar_has_lunar) and bar_has_weekday
    let nf_before_week_w = nf_d_w + if(nf_sep1, 10 + nf_dot_w, 0) + nf_l_w
    let nf_date_w = nf_before_week_w + if(nf_sep2, 10 + nf_dot_w, 0) + nf_w_w
    let nf_need_w = if(nf_inline,
        nf_clk_w + 16 + nf_date_w + 40,
        if(nf_stacked,
            max(nf_clk_w, nf_date_w) + 40,
            0))
    prop nf_clock_w = 168 ~quick
    follow nf_clock_w = max(notch_clock_w, nf_need_w)

    surface notch_frame {
        size: full, full
        anchor: top_left
        reserve: 0
        level: top, overlay while panel_open or center_open or launch_open or nt_center
        open: true
        rate: 90, 60 while music_frame_on and music_on, 60 while panel_open or center_open or launch_open or nt_center, 15 while quiet
        keyboard: exclusive while launch_open or center_open or panel_open or nt_center

        let nf.w = notch_frame.width
        let nf.h = notch_frame.height
        let nf.cx = nf.w / 2
        let nf.clock_w = nf_clock_w
        let nf.clock_h = notch_clock_h
        let nf.settings_h = notch_clock_h + 820
        let nf.center_h = notch_clock_h + 720
        //  anchor:center places the row's top edge at y in plm.
        //  To visually centre 19px text, shift up by ~half the text height.
        let nf.inline_w = nf_clk_w + 16 + nf_date_w
        let nf.inline_x = nf.cx - nf.inline_w / 2
        let nf.clock_x = if(nf_inline, nf.inline_x + nf_clk_w / 2, nf.cx)
        let nf.clock_y = if(nf_stacked, nf.clock_h / 2 - 22, nf.clock_h / 2 - 12)
        let nf.clk_sep_x = nf.inline_x + nf_clk_w + 8
        let nf.date_x = if(nf_inline, nf.inline_x + nf_clk_w + 16, nf.cx - nf_date_w / 2)
        let nf.date_y = if(nf_stacked, nf.clock_h / 2 + 12, nf.clock_h / 2)
        let nf.rail = 8
        let nf.inner_r = 23
        let nf.over = 50
        let nf.music = music_frame_on and music_on
        let nf.all_sides = music_frame_sides == 1
        let nf.cp_p = clamp(cp_np, 0, 1)
        let nf.ct_p = clamp(ct_np, 0, 1)
        let nf.launch_p = clamp(la_p, 0, 1)
        let nf.ntc_p = clamp(ntc_p, 0, 1)
        let nf.search_h = notch_clock_h + 600
        let nf.notify_h = notch_clock_h + 650
        //  Drawer geometry: the drop is a spring; halfway it narrows into a
        //  bell and opens its corners, and on landing sag/wobble settle it.
        let nf.cp_w = mix(nf.clock_w, 860, nf.cp_p)
        let nf.cp_h = nf.settings_h * nf.cp_p
        let nf.ct_w = mix(nf.clock_w, 1120, nf.ct_p)
        let nf.ct_h = nf.center_h * nf.ct_p
        let nf.la_w = mix(nf.clock_w, 620, nf.launch_p)
        let nf.la_h = nf.search_h * nf.launch_p
        let nf.motion_k = if(motion.reduced, 0, clamp(drawer_motion / 100, 0, 2))
        let nf.neck_k = if(motion.reduced, 0, clamp(drawer_neck / 100, 0, 2))
        let nf.wave_k = clamp(frame_wave_strength / 100, 0, 2)
        let nf.wave_speed = clamp(frame_wave_speed / 100, 0.25, 2)
        let nf.cp_bell = 4 * min(1, nf.cp_p) * (1 - min(1, nf.cp_p)) * nf.neck_k
        let nf.ct_bell = 4 * min(1, nf.ct_p) * (1 - min(1, nf.ct_p)) * nf.neck_k
        let nf.la_bell = 4 * min(1, nf.launch_p) * (1 - min(1, nf.launch_p)) * nf.neck_k
        let nf.cp_wob = clamp(cp_wobble * nf.motion_k, -60, 60)
        let nf.ct_wob = clamp(ct_wobble * nf.motion_k, -60, 60)
        let nf.la_wob = clamp(la_wobble * nf.motion_k, -60, 60)
        let nf.cp_ew = nf.cp_w * (1 + nf.cp_bell * 0.08 * nf.motion_k - 0.07 * nf.cp_bell + 0.005 * nf.cp_wob)
        let nf.cp_eh = nf.cp_h * (1 - nf.cp_bell * 0.04 * nf.motion_k - 0.002 * nf.cp_wob) + max(0, clamp(cp_sag, 0, 30)) * nf.motion_k
        let nf.ct_ew = nf.ct_w * (1 + nf.ct_bell * 0.08 * nf.motion_k - 0.07 * nf.ct_bell + 0.005 * nf.ct_wob)
        let nf.ct_eh = nf.ct_h * (1 - nf.ct_bell * 0.04 * nf.motion_k - 0.002 * nf.ct_wob) + max(0, clamp(ct_sag, 0, 30)) * nf.motion_k
        let nf.la_ew = nf.la_w * (1 + nf.la_bell * 0.08 * nf.motion_k - 0.07 * nf.la_bell + 0.005 * nf.la_wob)
        let nf.la_eh = nf.la_h * (1 - nf.la_bell * 0.04 * nf.motion_k - 0.002 * nf.la_wob) + max(0, clamp(la_sag, 0, 30)) * nf.motion_k
        //  The wave bends the frame and the open drawer's rim.  It sleeps
        //  outside music, reduced-motion mode, and the short opening window.
        let nf.wave_panel_on = if(nf.cp_p > 0.01, 1, if(nf.ct_p > 0.01, 1, if(nf.launch_p > 0.01, 1, 0)))
        let nf.wave_pw = if(nf.cp_p > 0.01, nf.cp_ew, if(nf.ct_p > 0.01, nf.ct_ew, if(nf.launch_p > 0.01, nf.la_ew, 0)))
        let nf.wave_ph = if(nf.cp_p > 0.01, nf.cp_eh, if(nf.ct_p > 0.01, nf.ct_eh, if(nf.launch_p > 0.01, nf.la_eh, 0)))
        let nf.wave_cy = nf.wave_ph / 2
        let nf.wave_bass = clamp(bands.0 * 1.8, 0, 1)
        let nf.wave_on = not motion.reduced and frame_wave_on and nf.wave_k > 0.001 and nf.wave_panel_on > 0.5 and (nf.music or (nf.cp_p > 0.01 and nf.cp_p < 0.995) or (nf.ct_p > 0.01 and nf.ct_p < 0.995) or (nf.launch_p > 0.01 and nf.launch_p < 0.995) or abs(nf.cp_wob) > 1 or abs(nf.ct_wob) > 1 or abs(nf.la_wob) > 1)
        let nf.sm = music_frame_sens
        let nf.hm = music_frame_hgt
        let nf.bon = if(nf.music, 1, 0)
        //  Unified column count (6, 12, 24 or 48) drives one shared glass body.
        let nf.nuse = clamp(music_frame_cols, 6, 48)
        let nf.bw = 17 * mix(0.8, 1.9, music_frame_blend / 100)
        let nf.bbl = mix(10, 32, music_frame_blend / 100)
        let nf.cp_shift = if(panel_open or nf.cp_p > 0.01, 0, 30000)
        let nf.ct_shift = if(center_open or nf.ct_p > 0.01, 0, 30000)
        let nf.la_shift = if(launch_open or nf.launch_p > 0.01, 0, 30000)
        let nf.smoke_bg = mix(tint, #000000, glass_smoke * 0.65)
        let nf.frame_color = mix(nf.smoke_bg, primary,
            if(notch_tint_on, clamp(notch_tint_depth / 100, 0, 1), 0))

        let nf.db.0 = abs(2 * (0.5 / 12) - 1) * 23
        let nf.dl.0 = clamp(floor(nf.db.0), 0, 22)
        let nf.dh.0 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.0, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.0 - nf.dl.0), 1.4) * nf.sm) * clamp(min(0.5, 11.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.1 = abs(2 * (1.5 / 12) - 1) * 23
        let nf.dl.1 = clamp(floor(nf.db.1), 0, 22)
        let nf.dh.1 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.1, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.1, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.1 - nf.dl.1), 1.4) * nf.sm) * clamp(min(1.5, 10.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.2 = abs(2 * (2.5 / 12) - 1) * 23
        let nf.dl.2 = clamp(floor(nf.db.2), 0, 22)
        let nf.dh.2 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.2, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.2, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.2 - nf.dl.2), 1.4) * nf.sm) * clamp(min(2.5, 9.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.3 = abs(2 * (3.5 / 12) - 1) * 23
        let nf.dl.3 = clamp(floor(nf.db.3), 0, 22)
        let nf.dh.3 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.3, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.3, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.3 - nf.dl.3), 1.4) * nf.sm) * clamp(min(3.5, 8.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.4 = abs(2 * (4.5 / 12) - 1) * 23
        let nf.dl.4 = clamp(floor(nf.db.4), 0, 22)
        let nf.dh.4 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.4, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.4, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.4 - nf.dl.4), 1.4) * nf.sm) * clamp(min(4.5, 7.5) / 0.6, 0, 1) * nf.hm, 0)
        let nf.db.5 = abs(2 * (5.5 / 12) - 1) * 23
        let nf.dl.5 = clamp(floor(nf.db.5), 0, 22)
        let nf.dh.5 = if(nf.bon > 0.5, min(1, pow(mix(pick(nf.dl.5, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.dl.5, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.db.5 - nf.dl.5), 1.4) * nf.sm) * clamp(min(5.5, 6.5) / 0.6, 0, 1) * nf.hm, 0)
