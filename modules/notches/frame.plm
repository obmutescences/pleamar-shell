        let nf.h.45 = if(45 < nf.nuse and nf.bon > 0.5, min(1, pow(mix(pick(nf.l.45, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.l.45, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.b.45 - nf.l.45), 1.4) * nf.sm) * clamp(min(45.5, nf.nuse - 45.5) / (0.05 * nf.nuse), 0, 1) * nf.hm, 0)
        let nf.b.46 = abs(2 * (46.5 / nf.nuse) - 1) * 23
        let nf.l.46 = clamp(floor(nf.b.46), 0, 22)
        let nf.h.46 = if(46 < nf.nuse and nf.bon > 0.5, min(1, pow(mix(pick(nf.l.46, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.l.46, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.b.46 - nf.l.46), 1.4) * nf.sm) * clamp(min(46.5, nf.nuse - 46.5) / (0.05 * nf.nuse), 0, 1) * nf.hm, 0)
        let nf.b.47 = abs(2 * (47.5 / nf.nuse) - 1) * 23
        let nf.l.47 = clamp(floor(nf.b.47), 0, 22)
        let nf.h.47 = if(47 < nf.nuse and nf.bon > 0.5, min(1, pow(mix(pick(nf.l.47, spec.s.0, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23), pick(nf.l.47, spec.s.1, spec.s.2, spec.s.3, spec.s.4, spec.s.5, spec.s.6, spec.s.7, spec.s.8, spec.s.9, spec.s.10, spec.s.11, spec.s.12, spec.s.13, spec.s.14, spec.s.15, spec.s.16, spec.s.17, spec.s.18, spec.s.19, spec.s.20, spec.s.21, spec.s.22, spec.s.23, spec.s.23), nf.b.47 - nf.l.47), 1.4) * nf.sm) * clamp(min(47.5, nf.nuse - 47.5) / (0.05 * nf.nuse), 0, 1) * nf.hm, 0)

        //  One unified glass body for the frame, clock notch, open drawers,
        //  and all column counts (6 / 12 / 24 / 48).  Sleeping variants ensure
        //  only the needed shapes and frost mode are awake each frame.
        let nf.vh.0  = if(nf.nuse > 24, (nf.h.0  + nf.h.1 ) * 0.5, nf.h.0 )
        let nf.vh.1  = if(nf.nuse > 24, (nf.h.2  + nf.h.3 ) * 0.5, nf.h.1 )
        let nf.vh.2  = if(nf.nuse > 24, (nf.h.4  + nf.h.5 ) * 0.5, nf.h.2 )
        let nf.vh.3  = if(nf.nuse > 24, (nf.h.6  + nf.h.7 ) * 0.5, nf.h.3 )
        let nf.vh.4  = if(nf.nuse > 24, (nf.h.8  + nf.h.9 ) * 0.5, nf.h.4 )
        let nf.vh.5  = if(nf.nuse > 24, (nf.h.10 + nf.h.11) * 0.5, nf.h.5 )
        let nf.vh.6  = if(nf.nuse > 24, (nf.h.12 + nf.h.13) * 0.5, nf.h.6 )
        let nf.vh.7  = if(nf.nuse > 24, (nf.h.14 + nf.h.15) * 0.5, nf.h.7 )
        let nf.vh.8  = if(nf.nuse > 24, (nf.h.16 + nf.h.17) * 0.5, nf.h.8 )
        let nf.vh.9  = if(nf.nuse > 24, (nf.h.18 + nf.h.19) * 0.5, nf.h.9 )
        let nf.vh.10 = if(nf.nuse > 24, (nf.h.20 + nf.h.21) * 0.5, nf.h.10)
        let nf.vh.11 = if(nf.nuse > 24, (nf.h.22 + nf.h.23) * 0.5, nf.h.11)
        let nf.vh.12 = if(nf.nuse > 24, (nf.h.24 + nf.h.25) * 0.5, nf.h.12)
        let nf.vh.13 = if(nf.nuse > 24, (nf.h.26 + nf.h.27) * 0.5, nf.h.13)
        let nf.vh.14 = if(nf.nuse > 24, (nf.h.28 + nf.h.29) * 0.5, nf.h.14)
        let nf.vh.15 = if(nf.nuse > 24, (nf.h.30 + nf.h.31) * 0.5, nf.h.15)
        let nf.vh.16 = if(nf.nuse > 24, (nf.h.32 + nf.h.33) * 0.5, nf.h.16)
        let nf.vh.17 = if(nf.nuse > 24, (nf.h.34 + nf.h.35) * 0.5, nf.h.17)
        let nf.vh.18 = if(nf.nuse > 24, (nf.h.36 + nf.h.37) * 0.5, nf.h.18)
        let nf.vh.19 = if(nf.nuse > 24, (nf.h.38 + nf.h.39) * 0.5, nf.h.19)
        let nf.vh.20 = if(nf.nuse > 24, (nf.h.40 + nf.h.41) * 0.5, nf.h.20)
        let nf.vh.21 = if(nf.nuse > 24, (nf.h.42 + nf.h.43) * 0.5, nf.h.21)
        let nf.vh.22 = if(nf.nuse > 24, (nf.h.44 + nf.h.45) * 0.5, nf.h.22)
        let nf.vh.23 = if(nf.nuse > 24, (nf.h.46 + nf.h.47) * 0.5, nf.h.23)

        group {
            //  Matches frame_wave.wgsl (s.a: bass, panel, cx, cy; s.b: pw, ph, strength, speed).
            //  `while nf.wave_on` avoids an idle 2K offscreen pass and lets the scene sleep.
            shader: frame_wave, nf.wave_bass, nf.wave_panel_on, nf.cx, nf.wave_cy, nf.wave_pw, nf.wave_ph, nf.wave_k, nf.wave_speed while nf.wave_on
            include "frame_body_quiet.plm" while not nf.music and not glass_frost_auto
            include "frame_body_quiet_auto.plm" while not nf.music and glass_frost_auto
            include "frame_body_music.plm" while nf.music and not nf.drawer_waves_on and not glass_frost_auto
            include "frame_body_music_auto.plm" while nf.music and not nf.drawer_waves_on and glass_frost_auto
            include "frame_body_music_drawer.plm" while nf.music and nf.drawer_waves_on and not glass_frost_auto
            include "frame_body_music_drawer_auto.plm" while nf.music and nf.drawer_waves_on and glass_frost_auto
        }

        //  Reference glyph measurements for stable inline/stacked width.
        text "00:00" { at: nf.cx, nf.clock_h / 2; anchor: center; size: nf_fs; weight: 600; color: aqua; opacity: 0%; family: "Space Grotesk"; measure: nf_clk_m }
        text "·" { at: nf.cx, nf.clock_h / 2; anchor: center; size: nf_sub_fs; color: azure; opacity: 0%; family: "Noto Sans CJK SC"; measure: nf_dot_m }

        //  Clock: Plain type row OR Vitreus single-stroke Glass digits.
        row {
            show: not nf_glass_on
            at: nf.clock_x, nf.clock_y
            anchor: center
            gap: 0
            align: end
            text "{floor(tick.hour / 10)}" { size: nf_fs; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.hour, 10)}" { size: nf_fs; weight: 600; color: aqua; family: "Space Grotesk" }
            text ":" { size: nf_fs; weight: 600; color: azure; family: "Space Grotesk" }
            text "{floor(tick.minute / 10)}" { size: nf_fs; weight: 600; color: aqua; family: "Space Grotesk" }
            text "{mod(tick.minute, 10)}" { size: nf_fs; weight: 600; color: aqua; family: "Space Grotesk" }
            space 1
            text "{floor(tick.second / 10)}" { size: nf_fs * 0.58; weight: 600; color: azure; family: "Space Grotesk"; show: bar_show_secs; letter_move: 0, -3 + (1 - nf_sec_tens) * 4; letter_scale: 0.88 + 0.12 * nf_sec_tens }
            text "{mod(tick.second, 10)}" { size: nf_fs * 0.58; weight: 600; color: azure; family: "Space Grotesk"; show: bar_show_secs; letter_move: 0, -3 + (1 - nf_sec_ones) * 4; letter_scale: 0.88 + 0.12 * nf_sec_ones }
        }
        group {
            show: nf_glass_on
            let nf.g_cy = if(nf_stacked, nf.clock_h / 2 - nf_fs * 0.58, nf.bar_cy)
            BarGlassPair(floor(tick.hour / 10), mod(tick.hour, 10), floor(tick.minute / 10), mod(tick.minute, 10), 0, nf.clock_x - nf_w_clk / 2, nf.g_cy, nf_g_h, nf_g_wt, nf.gm_col_a, nf.gm_gl, nf.gm_lens, nf.gm_rim, nf.gm_fr, nf.gm_tint, nf.gm_milk, nf.gm_vivid, nf.gm_mir, nf.gm_hi, nf.gm_glow_a, nf.gm_glow, nf.gm_op)
            group {
                show: bar_show_secs
                BarGlassNum2(floor(tick.second / 10), mod(tick.second, 10), nf.clock_x - nf_w_clk / 2 + nf_g_pair_w + 4, nf.g_cy + nf_fs * 0.16, nf_fs * 0.56, nf_g_wt, nf.gm_col_b, nf.gm_gl, nf.gm_lens, nf.gm_rim, nf.gm_fr, nf.gm_tint, nf.gm_milk, nf.gm_vivid, nf.gm_mir, nf.gm_hi, nf.gm_glow_b, nf.gm_glow, nf.gm_op)
            }
        }
        //  Date (Plain text or Vitreus Glass MM-DD), lunar date and weekday (`·周二`).
        text bar_date_txt { at: nf.date_x, nf.date_y; anchor: left center; size: nf_fs; weight: 600; color: aqua; family: "Space Grotesk"; measure: nf_date_m; show: bar_has_date and not nf_glass_on }
        group {
            show: bar_has_date and nf_glass_on
            BarGlassPair(bar_mon_d0, bar_mon_d1, bar_day_d0, bar_day_d1, 1, nf.date_x, nf.date_y, nf_g_h, nf_g_wt, nf.gm_col_b, nf.gm_gl, nf.gm_lens, nf.gm_rim, nf.gm_fr, nf.gm_tint, nf.gm_milk, nf.gm_vivid, nf.gm_mir, nf.gm_hi, nf.gm_glow_b, nf.gm_glow, nf.gm_op)
        }
        text "·" { at: nf.date_x + nf_d_w + 5, nf.date_y; anchor: left center; size: nf_sub_fs; color: azure; opacity: 80%; family: "Noto Sans CJK SC"; show: nf_sep1 }
        text bar_lunar_txt { at: nf.date_x + nf_d_w + if(nf_sep1, 10 + nf_dot_w, 0), nf.date_y; anchor: left center; size: nf_sub_fs; weight: 600; color: aqua; family: "Noto Sans CJK SC"; measure: nf_lunar_m; show: bar_has_lunar }
        text bar_weekday_txt { at: nf.date_x + nf_before_week_w + if(nf_sep2, 6, 0), nf.date_y; anchor: left center; size: nf_sub_fs; weight: 500; color: azure; family: "Noto Sans CJK SC"; measure: nf_week_m; show: bar_has_weekday }
        on change tick.second while bar_show_secs and not nf_glass_on and not motion.reduced {
            nf_sec_ones: 0 ~10ms
            nf_sec_ones: 1 ~190ms after 10ms
        }
        on change floor(tick.second / 10) while bar_show_secs and not nf_glass_on and not motion.reduced {
            nf_sec_tens: 0 ~10ms
            nf_sec_tens: 1 ~190ms after 10ms
        }

        //  Centre bar modules: CPU, Memory, Network & nearest Countdown (ordered via bar_ord_*).
        let nf.cpu_u = clamp(nf_cpu_s, 0, 1)
        let nf.mem_u = clamp(nf_mem_s, 0, 1)
        let nf.cpu_x = nf.bar_x0 + nf_pos_cpu
        let nf.mem_x = nf.bar_x0 + nf_pos_mem
        let nf.cpu_cx = nf.cpu_x + nf_ring_r + nf_ring_w / 2
        let nf.mem_cx = nf.mem_x + nf_ring_r + nf_ring_w / 2
        let nf.cpu_col = mix(primary, alert, clamp((nf.cpu_u - 0.80) / 0.20, 0, 1))
        let nf.mem_col = mix(secondary, alert, clamp((nf.mem_u - 0.84) / 0.16, 0, 1))

        //  Unoccupied track: muted neutral translucent hollow glass rings.
        body {
            show: nf_glass_on and (nf_m_cpu or nf_m_mem)
            color: mix(deep, tint, 0.30)
            glass: nf.gm_gl
            lens: false
            tint: 0.72
            frost: nf.gm_fr * 0.55
            rim: 75% * nf.gm_rim
            shine: 0, 0
            opacity: 38%
            ellipse { at: nf.cpu_cx + if(nf_m_cpu, 0, 30000), nf.bar_cy; radius: nf_ring_r * nf.ic_s; stroke: nf_ring_w * nf.ic_s }
            ellipse { at: nf.mem_cx + if(nf_m_mem, 0, 30000), nf.bar_cy; radius: nf_ring_r * nf.ic_s; stroke: nf_ring_w * nf.ic_s }
        }

        //  CPU: hollow thick glass ring + percentage to its right
        group {
            show: nf_m_cpu
            group {
                move: nf.cpu_cx, nf.bar_cy
                pivot: 0, 0
                scale: nf.ic_s
                ellipse { at: 0, 0; radius: nf_ring_r; stroke: nf_ring_w; color: mix(deep, ink, 0.18); opacity: 26%; show: not nf_glass_on }
                group {
                    glow: 4, 22%
                    arc { at: 0, 0; radius: nf_ring_r; width: nf_ring_w + 0.2; span: 360deg * clamp(nf.cpu_u, 0.03, 1); rotate: 180deg * clamp(nf.cpu_u, 0.03, 1); color: nf.cpu_col; opacity: 100% }
                }
            }
            text sys_cpu_txt { at: nf.cpu_cx + (nf_ring_r + nf_ring_w / 2) * nf.ic_s + 5, nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 700; color: mix(ink, nf.cpu_col, 0.30 + 0.45 * nf.cpu_u); family: "Space Grotesk"; measure: nf_cpu_m }
        }

        //  Memory: hollow thick glass ring + percentage to its right
        group {
            show: nf_m_mem
            group {
                move: nf.mem_cx, nf.bar_cy
                pivot: 0, 0
                scale: nf.ic_s
                ellipse { at: 0, 0; radius: nf_ring_r; stroke: nf_ring_w; color: mix(deep, ink, 0.18); opacity: 26%; show: not nf_glass_on }
                group {
                    glow: 4, 22%
                    arc { at: 0, 0; radius: nf_ring_r; width: nf_ring_w + 0.2; span: 360deg * clamp(nf.mem_u, 0.03, 1); rotate: 180deg * clamp(nf.mem_u, 0.03, 1); color: nf.mem_col; opacity: 100% }
                }
            }
            text sys_mem_pct { at: nf.mem_cx + (nf_ring_r + nf_ring_w / 2) * nf.ic_s + 5, nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 700; color: mix(ink, nf.mem_col, 0.30 + 0.45 * nf.mem_u); family: "Space Grotesk"; measure: nf_mem_m }
        }

        //  Network: primary download chevron + secondary upload chevron
        let nf.net_x = nf.bar_x0 + nf_pos_net
        let nf.net_tx_x = nf.net_x + 12 + max(nf_rx_m.width, nf_sub_fs * 2.3) + 8
        let nf.rx_nudge = 1.4 * clamp(nf_rx_s, 0, 1)
        let nf.tx_nudge = -1.4 * clamp(nf_tx_s, 0, 1)
        group {
            show: nf_m_net
            line { from: nf.net_x + 4, nf.bar_cy + nf.rx_nudge - 4; to: nf.net_x + 4, nf.bar_cy + nf.rx_nudge + 3.5; width: 1.6; color: primary; opacity: 58% + 42% * clamp(nf_rx_s, 0, 1) }
            path { at: nf.net_x + 4, nf.bar_cy + nf.rx_nudge; stroke: 1.6; color: primary; opacity: 58% + 42% * clamp(nf_rx_s, 0, 1); move -3, 1; line 0, 4; line 3, 1 }
            text bar_rx_txt { at: nf.net_x + 12, nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 600; color: mix(ink, primary, 0.22 + 0.45 * clamp(nf_rx_s, 0, 1)); family: "Space Grotesk"; measure: nf_rx_m }
            line { from: nf.net_tx_x + 4, nf.bar_cy + nf.tx_nudge + 4; to: nf.net_tx_x + 4, nf.bar_cy + nf.tx_nudge - 3.5; width: 1.6; color: secondary; opacity: 58% + 42% * clamp(nf_tx_s, 0, 1) }
            path { at: nf.net_tx_x + 4, nf.bar_cy + nf.tx_nudge; stroke: 1.6; color: secondary; opacity: 58% + 42% * clamp(nf_tx_s, 0, 1); move -3, -1; line 0, -4; line 3, -1 }
            text bar_tx_txt { at: nf.net_tx_x + 12, nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 600; color: mix(ink, secondary, 0.28 + 0.45 * clamp(nf_tx_s, 0, 1)); family: "Space Grotesk"; measure: nf_tx_m }
        }

        //  Nearest anniversary / countdown (no icon; optional glass pill on days in Glass modes).
        let nf.cd_x = nf.bar_x0 + nf_pos_cd
        let nf.cd_col = if(bar_cd_urgent, primary, secondary)
        body {
            show: nf_glass_on and nf_m_cd
            color: nf.gm_col_b
            glass: if(bar_num_style == 1, 0.85, if(bar_num_style == 2, 0.75, 0.80))
            lens: false
            tint: if(bar_num_style == 3, 0.42, 0.30)
            frost: nf.gm_fr
            rim: 72%
            shine: 0, 0
            opacity: 52%
            box { from: nf.cd_x + nf_cd_t_m.width + 2, nf.bar_cy - (nf_sub_fs + 6) / 2; size: max(18, nf_cd_d_m.width + 10), nf_sub_fs + 6; corner: (nf_sub_fs + 6) / 2 }
        }
        group {
            show: nf_m_cd
            text bar_cd_title { at: nf.cd_x, nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 600; color: ink; family: "Noto Sans CJK SC"; measure: nf_cd_t_m }
            text bar_cd_days { at: nf.cd_x + nf_cd_t_m.width + if(nf_glass_on, 7, 3), nf.bar_cy; anchor: left center; size: nf_sub_fs; weight: 700; color: nf.cd_col; family: "Noto Sans CJK SC"; measure: nf_cd_d_m }
        }

        //  Click anywhere outside an open drawer to dismiss it (inner panel shields sit above this).
        zone box nf_drawer_dismiss { from: 0, 0; size: nf.w, nf.h; active: panel_open or center_open or launch_open or nt_center; label: "Close open drawer" }
        on press nf_drawer_dismiss while audio_pick_open { emit ui_sound; audio_pick_open = false }
        on press nf_drawer_dismiss while panel_open and not audio_pick_open { emit ui_sound; emit settings_close }
        on press nf_drawer_dismiss while center_open and not audio_pick_open { emit ui_sound; emit center_close }
        on press nf_drawer_dismiss while launch_open and not audio_pick_open { emit ui_sound; emit launch_close }
        on press nf_drawer_dismiss while nt_center and not audio_pick_open { emit ui_sound; emit nt_center_close }

        zone box nf_clock { from: nf.cx - nf.clock_w / 2, 0; size: nf.clock_w, nf.clock_h; corner: 20; cursor: pointer; role: button; label: "Open centre panel" }
        on press nf_clock { ripple nf_clock; emit ui_sound; emit center_toggle }
        on key Escape while nt_center { nt_center = false }

        zone box nf_cpu_hit { from: nf.cpu_x - 4, 0; size: max(1, nf_w_cpu + 8), nf.clock_h; corner: 12; cursor: pointer; active: nf_m_cpu; role: button; label: "Open system monitor" }
        on press nf_cpu_hit { ripple nf_cpu_hit; emit ui_sound; emit ipc_open_center(1) }
        zone box nf_mem_hit { from: nf.mem_x - 4, 0; size: max(1, nf_w_mem + 8), nf.clock_h; corner: 12; cursor: pointer; active: nf_m_mem; role: button; label: "Open system monitor" }
        on press nf_mem_hit { ripple nf_mem_hit; emit ui_sound; emit ipc_open_center(1) }
        zone box nf_net_hit { from: nf.net_x - 4, 0; size: max(1, nf_w_net + 8), nf.clock_h; corner: 12; cursor: pointer; active: nf_m_net; role: button; label: "Open system monitor" }
        on press nf_net_hit { ripple nf_net_hit; emit ui_sound; emit ipc_open_center(1) }
        zone box nf_cd_hit { from: nf.cd_x - 4, 0; size: max(1, nf_w_cd + 8), nf.clock_h; corner: 12; cursor: pointer; active: nf_m_cd; role: button; label: "Open calendar" }
        on press nf_cd_hit { ripple nf_cd_hit; emit ui_sound; emit ipc_open_center(5) }

        group {
            show: panel_open or cp_np > 0.01
            NotchDrawerContent(cp_np, 860, nf.settings_h, 5) {
                include "../settings/panel.plm" while panel_open or cp_np > 0.01
            }
        }
        group {
            show: center_open or ct_np > 0.01
            NotchDrawerContent(ct_np, 1120, nf.center_h, 5) {
                include "../center/panel.plm" while center_open or ct_np > 0.01
            }
        }
        group {
            show: launch_open or la_p > 0.01
            NotchDrawerContent(la_p, 620, nf.search_h, 5) {
                include "../launcher/launcher.plm" while launch_open or la_p > 0.01
            }
        }
        group {
            show: nt_center or ntc_p > 0.01
            NotchDrawerContent(ntc_p, 480, nf.notify_h, center_fx) {
                NotificationCenterContent()
            }
        }
        let nf.nt_dx = if(nt_pos == 0, nf.cx - 147, nf.w - nf.rail - 302)
        let nf.nt_dy = if(nt_pos == 0, nf.clock_h + 6, nf.rail + 6)
        group {
            show: nf.nt_dock_on
            move: nf.nt_dx, nf.nt_dy
            pivot: 147, 0
            scale: 0.90 + 0.10 * nf.nt_p, max(0.05, 0.85 + 0.15 * nf.nt_p)
            opacity: clamp((nf.nt_p - 0.35) / 0.65, 0, 1)

            zone box nt_dock_hit { from: 0, 0; size: 294, 112; active: nt_has and not nt_drift; cursor: pointer; label: "Dismiss notification" }
            on press nt_dock_hit { emit ui_sound; emit nt_close }
            clip inset 0 box { from: 0, 0; size: 294, 112; corner: 17 }
            group {
                scale: 0.7
                pivot: 0, 0
                NotificationToastCard(true)
            }
        }
    }

    //  Audio output device picker: scene-level popup with glass frost,
    //  positioned dynamically relative to the centre drawer on any monitor.
    popup audio_picker {
        at: screen.width / 2 - 560 + 36, notch_clock_h + 152
        size: 420, 500
        open: audio_pick_open
        keyboard: true

        group {
            pivot: 210, 250
            scale: 0.96 + 0.04 * ap_p
            opacity: ap_p
            zone box ap_body { from: 0, 0; size: 420, 500; corner: 18; label: "Output devices" }
            on press ap_body { audio_pick_open = audio_pick_open }
            body {
                show: not glass_frost_auto
                color: mix(panel, primary, 0.35)
                opacity: 1% * max(glass_tint, 84)
                tint: glass_color_tint / 100
                glass: if(glass_on, 1% * glass_mix, 0%)
                lens: glass_on and glass_bend
                frost: glass_frost / 100
                refraction: glass_refr
                dispersion: glass_disp
                dome: glass_dome
                milk: glass_milk
                smoke: glass_smoke
                vivid: glass_vivid
                mirror: glass_mirror
                highlight: glass_highlight
                ripple: glass_ripple
                border: 1.5 * glass_border / 100, ink
                shine: if(glass_shine, pointer.x, 0), if(glass_shine, pointer.y, 0)
                shadow: 0, 10, 28, 1% * glass_shadow_amt, glass_shadow
                box { from: 0, 0; size: 420, 500; corner: 18 }
            }
            body {
                show: glass_frost_auto
                color: mix(panel, primary, 0.35)
                opacity: 1% * max(glass_tint, 84)
                tint: glass_color_tint / 100
                glass: if(glass_on, 1% * glass_mix, 0%)
                lens: glass_on and glass_bend
                frost: auto
                refraction: glass_refr
                dispersion: glass_disp
                dome: glass_dome
                milk: glass_milk
                smoke: glass_smoke
                vivid: glass_vivid
                mirror: glass_mirror
                highlight: glass_highlight
                ripple: glass_ripple
                border: 1.5 * glass_border / 100, ink
                shine: if(glass_shine, pointer.x, 0), if(glass_shine, pointer.y, 0)
                shadow: 0, 10, 28, 1% * glass_shadow_amt, glass_shadow
                box { from: 0, 0; size: 420, 500; corner: 18 }
            }
            box { from: 0, 0; size: 420, 500; corner: 18; stroke: 1.5; color: primary; opacity: 34% }
            text "OUTPUT DEVICE" { at: 22, 26; anchor: left center; size: 10; weight: 700; color: secondary; family: "Space Grotesk" }
            line { from: 22, 44; to: 398, 44; width: 1; color: ink; opacity: 10% }
            repeat o in 0..8 {
                let oy = 56 + o * 46
                group {
                    show: o < audio_outputs.count
                    box { from: 16, oy; size: 388, 38; corner: 9; color: if(audio_outputs.$o.current, primary, ink); opacity: if(audio_outputs.$o.current, 12%, 3%) + 6% * ct_audio_out.$o.hover }
                    ellipse { at: 34, oy + 19; radius: 4; color: if(audio_outputs.$o.current, primary, faint); opacity: 80% }
                    text audio_outputs.$o.name { at: 48, oy + 19; anchor: left center; size: 12; weight: if(audio_outputs.$o.current, 700, 500); color: if(audio_outputs.$o.current, primary, ink); width: 330; lines: 1; family: "Space Grotesk" }
                    zone box ct_audio_out.$o { from: 16, oy; size: 388, 38; corner: 9; cursor: pointer; role: item; selected: audio_outputs.$o.current; label: audio_outputs.$o.name }
                    on press ct_audio_out.$o { emit ui_sound; emit center_audio_default(o) }
                }
            }
            text "No output devices." { at: 22, 70; anchor: left center; size: 12; color: faint; show: audio_outputs.count < 1; family: "Space Grotesk" }
            line { from: 22, 432; to: 398, 432; width: 1; color: ink; opacity: 10% }
            text "Cancel" { at: 210, 456; anchor: center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            zone box ct_audio_pick_close { from: 114, 438; size: 192, 36; corner: 18; cursor: pointer; role: button; label: "Close output picker" }
            on press ct_audio_pick_close { audio_pick_open = false }
        }
        on key Escape while audio_pick_open { audio_pick_open = false }
    }
}
