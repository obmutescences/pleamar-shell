            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.2 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 2.5/12; size: nf12.h.2, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.2 > 1 }
            box { at: nf.cx + nf.cp_w / 2 - nf.rail - nf12.h.3 / 2 + nf.cp_shift, nf.clock_h + (nf.cp_h - nf.clock_h) * 3.5/12; size: nf12.h.3, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.cp_shift == 0 and nf12.h.3 > 1 }
