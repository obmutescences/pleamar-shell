    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.5 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 5.5 / 12; size: nf.dh.5, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.5 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.6 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 6.5 / 12; size: nf.dh.6, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.6 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.7 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 7.5 / 12; size: nf.dh.7, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.7 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.8 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 8.5 / 12; size: nf.dh.8, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.8 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.9 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 9.5 / 12; size: nf.dh.9, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.9 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.10 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 10.5 / 12; size: nf.dh.10, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.10 > 1 }
    box { at: nf.cx + nf.ct_w / 2 - nf.rail - nf.dh.11 / 2 + nf.ct_shift, nf.clock_h + (nf.ct_h - nf.clock_h) * 11.5 / 12; size: nf.dh.11, nf.bw; corner: nf.bw * 0.45; rotate: 0; blend: nf.bbl; show: nf.ct_shift == 0 and nf.dh.11 > 1 }
