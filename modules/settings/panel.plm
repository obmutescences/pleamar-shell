            text number(glass_vivid * 100, 0, "%") { at: 734, 582; anchor: right center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_vivid_track { from: 594, 567; size: 140, 30; cursor: pointer; label: "Glass vividness" }
            on press cp_vivid_track { glass_vivid = clamp((pointer.x - 604) / 120 * 2, 0, 2) }
            on drag cp_vivid_track { glass_vivid = clamp((pointer.x - 604) / 120 * 2, 0, 2) }

            CpCard(250, 624, 570, 70)
            text "Mirror" { at: 266, 634; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(340, 658, 120, cp.mirror_pct, cp_mirror_track.hover, cp.mint, ink, cp.track)
            text number(glass_mirror * 100, 0, "%") { at: 470, 658; anchor: right center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_mirror_track { from: 330, 643; size: 140, 30; cursor: pointer; label: "Mirror rim" }
            on press cp_mirror_track { glass_mirror = clamp((pointer.x - 340) / 120 * 2, 0, 2) }
            on drag cp_mirror_track { glass_mirror = clamp((pointer.x - 340) / 120 * 2, 0, 2) }
            text "Highlight" { at: 530, 634; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(604, 658, 120, cp.highlight_pct, cp_highlight_track.hover, cp.mint, ink, cp.track)
            text number(glass_highlight * 100, 0, "%") { at: 734, 658; anchor: right center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_highlight_track { from: 594, 643; size: 140, 30; cursor: pointer; label: "Rim highlight" }
            on press cp_highlight_track { glass_highlight = clamp((pointer.x - 604) / 120 * 2, 0, 2) }
            on drag cp_highlight_track { glass_highlight = clamp((pointer.x - 604) / 120 * 2, 0, 2) }

            CpCard(250, 700, 570, 70)
            text "Press ripple" { at: 266, 710; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A ring of light through the glass when it is pressed." { at: 266, 728; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 752, 200, cp.ripple_pct, cp_ripple_track.hover, cp.mint, ink, cp.track)
            text number(glass_ripple * 100, 0, "%") { at: 820, 752; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_ripple_track { from: 510, 737; size: 240, 30; cursor: pointer; label: "Press ripple" }
            on press cp_ripple_track { glass_ripple = clamp((pointer.x - 520) / 200, 0, 1) }
            on drag cp_ripple_track { glass_ripple = clamp((pointer.x - 520) / 200, 0, 1) }

            text "Presets are a starting point; every slider below stays live." { at: 266, 796; anchor: left center; size: 12; color: faint; opacity: 78%; family: "Space Grotesk" }
        }
