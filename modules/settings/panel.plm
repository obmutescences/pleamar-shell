        //  ── IDLE ──────────────────────────────────────────────────────────
        group {
            show: settings_page == 8

            CpCard(250, 176, 570, 62)
            text "Lock after" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Start the lock screen after this much inactivity." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 223, 200, cp.idle_lock_pct, cp_idle_lock.hover, cp.mint, ink, cp.track)
            text idle_lock_t { at: 820, 223; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_idle_lock { from: 510, 208; size: 240, 30; cursor: pointer; label: "Lock after" }
            on press cp_idle_lock { idle_lock_i = clamp(round((pointer.x - 520) / 200 * 16), 0, 16) }
            on drag cp_idle_lock { idle_lock_i = clamp(round((pointer.x - 520) / 200 * 16), 0, 16) }

            CpCard(250, 242, 570, 62)
            text "Screen off after" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Turn the monitors off after this much inactivity." { at: 266, 270; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 289, 200, cp.idle_off_pct, cp_idle_off.hover, cp.mint, ink, cp.track)
            text idle_off_t { at: 820, 289; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_idle_off { from: 510, 274; size: 240, 30; cursor: pointer; label: "Screen off after" }
            on press cp_idle_off { idle_off_i = clamp(round((pointer.x - 520) / 200 * 16), 0, 16) }
            on drag cp_idle_off { idle_off_i = clamp(round((pointer.x - 520) / 200 * 16), 0, 16) }

            text "Never first. 5 seconds is the shortest. No suspend." { at: 266, 344; anchor: left center; size: 13; color: faint; opacity: 78%; width: 540; lines: 1; family: "Space Grotesk" }
        }

        //  ── WEATHER ───────────────────────────────────────────────────────
        group {
            show: settings_page == 9

            CpCard(250, 176, 570, 62)
            text "Weather city" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "The centre panel asks Open-Meteo for this city; no API key." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }

            CpCard(250, 244, 570, 62)
            input weather_city { at: 266, 262; width: 460; size: 17; color: ink; family: "Noto Sans CJK SC"; placeholder: "City name, for example Hangzhou" }
            CpPill(744, 258, 68, 34, 1, cp_weather_apply.hover, cp.mint, ink)
            text "Apply" { at: 778, 275; anchor: center; size: 13; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box cp_weather_apply { from: 744, 258; size: 68, 34; corner: 17; cursor: pointer; label: "Apply weather city" }
            on press cp_weather_apply { emit ui_sound; emit weather_apply }

            text "The city is saved with the rest of the settings. Weather refreshes when the centre panel opens and every 15 minutes; a failed request keeps the last result." { at: 266, 330; anchor: left top; size: 13; color: faint; opacity: 78%; width: 540; lines: 3; line_height: 1.35; family: "Space Grotesk" }
        }

        //  ── THEME / MATERIAL ─────────────────────────────────────────────
        group {
            show: settings_page == 11

            CpCard(250, 176, 570, 96)
            text "Material" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "One click sets the shared glass; tune it below." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            repeat p in 0..5 {
                let gpx = 266 + p * 102
                CpPill(gpx, 226, 98, 28, 0, cp_gp_hit.$p.hover, cp.mint, ink)
                text pick(p, "Liquid", "Clear", "Smoked", "Milky", "Mirror") { at: gpx + 49, 240; anchor: center; size: 11; weight: 600; color: ink; family: "Space Grotesk" }
                zone box cp_gp_hit.$p { from: gpx, 226; size: 98, 28; corner: 14; cursor: pointer; label: pick(p, "Liquid glass", "Clear glass", "Smoked glass", "Milky glass", "Mirror glass") }
                on press cp_gp_hit.$p { emit ui_sound; emit glass_preset(p) }
            }

            CpCard(250, 278, 570, 112)
            text "Gradient" { at: 266, 288; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A wallpaper-tinted backdrop behind the glass." { at: 266, 306; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 291, 44, 24, if(panel_gradient != 0, 1, 0), panel_grad_knob, cp_grad_switch.hover, cp.mint, ink, cp.track)
            zone box cp_grad_switch { from: 760, 282; size: 64, 38; corner: 19; cursor: pointer; label: "Gradient backdrop" }
            on press cp_grad_switch { emit ui_sound; panel_gradient = if(panel_gradient == 0, 1, 0) }
            text "Shape" { at: 266, 336; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpPill(520, 322, 90, 28, if(panel_gradient == 1, 1, 0), cp_grad_linear.hover, cp.mint, ink)
            text "Linear" { at: 565, 336; anchor: center; size: 12; weight: 600; color: if(panel_gradient == 1, cp.mint, ink); family: "Space Grotesk" }
            zone box cp_grad_linear { from: 520, 322; size: 90, 28; corner: 14; cursor: pointer; label: "Linear gradient" }
            on press cp_grad_linear { emit ui_sound; panel_gradient = 1 }
            CpPill(618, 322, 90, 28, if(panel_gradient == 2, 1, 0), cp_grad_radial.hover, cp.mint, ink)
            text "Radial" { at: 663, 336; anchor: center; size: 12; weight: 600; color: if(panel_gradient == 2, cp.mint, ink); family: "Space Grotesk" }
            zone box cp_grad_radial { from: 618, 322; size: 90, 28; corner: 14; cursor: pointer; label: "Radial gradient" }
            on press cp_grad_radial { emit ui_sound; panel_gradient = 2 }
            text "Strength" { at: 266, 366; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 366, 200, cp.grad_pct, cp_grad_track.hover, cp.mint, ink, cp.track)
            text number(panel_gradient_strength, 0, "%") { at: 820, 366; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_grad_track { from: 510, 351; size: 240, 30; cursor: pointer; label: "Gradient strength" }
            on press cp_grad_track { panel_gradient_strength = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
            on drag cp_grad_track { panel_gradient_strength = clamp((pointer.x - 520) / 200 * 100, 0, 100) }

            CpCard(250, 396, 570, 70)
            text "Inner light" { at: 266, 406; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A soft sheet of light from the top inside the glass." { at: 266, 424; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 455, 200, cp.light_pct, cp_light_track.hover, cp.mint, ink, cp.track)
            text number(glass_light * 100, 0, "%") { at: 820, 455; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_light_track { from: 510, 440; size: 240, 30; cursor: pointer; label: "Inner light" }
            on press cp_light_track { glass_light = clamp((pointer.x - 520) / 200, 0, 1) }
            on drag cp_light_track { glass_light = clamp((pointer.x - 520) / 200, 0, 1) }

            CpCard(250, 472, 570, 70)
            text "Inner border" { at: 266, 482; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A hairline just inside the glass edge." { at: 266, 500; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 531, 200, cp.border_pct, cp_border_track.hover, cp.mint, ink, cp.track)
            text number(glass_border, 0, "%") { at: 820, 531; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_border_track { from: 510, 516; size: 240, 30; cursor: pointer; label: "Inner border" }
            on press cp_border_track { glass_border = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
            on drag cp_border_track { glass_border = clamp((pointer.x - 520) / 200 * 100, 0, 100) }

            CpCard(250, 548, 570, 70)
