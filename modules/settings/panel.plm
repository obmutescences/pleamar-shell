part ConfigPanel {
    //  Settings drawer: Vitreus-inspired layout, single-line leader alignment,
    //  dual-edge jelly controls, GPU pencil/marker/gradient/dots fills, liquid tilt
    //  wallpaper cards, interactive Lock screen example bar, Idle sequence flow,
    //  and conditional frame clock (zero work while closed).

    prop cp_clk = 0
    spin cp_clk by if(panel_open and not motion.reduced, 1, 0)
    let cp_fr = floor(cp_clk * 6)

    //  Shading shaders (declared once inside ConfigPanel with relative paths).
    shader cp_leader = file "../common/shaders/leader.wgsl"
    shader cp_hatch = file "../common/shaders/pencilhatch.wgsl"
    shader cp_fill = file "../common/shaders/fillstyle.wgsl"
    shader cp_liquid = file "../common/shaders/liquid.wgsl"
    figure lkshp = file "../../lockscreen/shapes.svg"

    //  Shared visual tokens.
    let cp.card = rgb(pal_panel_r, pal_panel_g, pal_panel_b)
    let cp.track = mix(tint, ink, 0.11)
    let cp.mint = aqua
    let cp.step = 68
    let cp.y0 = 172
    let cp.sl_x = 532
    let cp.sl_w = 196
    let cp.vx = 250
    let cp.vw = 570
    let cp.vy = 172
    let cp.vh = 616
    let cp.rx = 804
    let cp.nav_y = 108
    let cp.nav_step = 32
    let cp.sx = screen.width / 2 - 430

    //  Header gear ratchet animation: each page change rotates one 45° click.
    fact cp_gear_n = 0
    prop cp_gear_rot = 0 ~sp_pop
    follow cp_gear_rot = cp_gear_n * 45

    //  Sidebar dual-edge jelly thumb + group heading highlight.
    let cp.nav_slot = pick(settings_page, 2, 3, 6, 7, 1, 9, 8, 11, 12, 14, 4)
    let cp.grp_slot = pick(settings_page, 0, 0, 1, 1, 0, 1, 1, 2, 2, 3, 0)
    prop cp_nav_ld = 3 ~sp_lead
    prop cp_nav_tl = 3 ~sp_trail
    prop cp_grp = 0 ~sp_calm
    follow cp_nav_ld = cp.nav_slot
    follow cp_nav_tl = cp.nav_slot
    follow cp_grp = cp.grp_slot

    //  Page fade on tab switches.
    prop cp_page_p = 1 ~quick

    //  Per-page smooth scroll targets & settled positions.
    fact cp_sc_gl_to = 0
    prop cp_sc_gl = 0 ~quick
    follow cp_sc_gl = cp_sc_gl_to

    fact cp_sc_br_to = 0
    prop cp_sc_br = 0 ~quick
    follow cp_sc_br = cp_sc_br_to

    fact cp_sc_mo_to = 0
    prop cp_sc_mo = 0 ~quick
    follow cp_sc_mo = cp_sc_mo_to

    fact cp_sc_lk_to = 0
    prop cp_sc_lk = 0 ~quick
    follow cp_sc_lk = cp_sc_lk_to

    fact cp_sc_th_to = 0
    prop cp_sc_th = 0 ~quick
    follow cp_sc_th = cp_sc_th_to

    //  Random die click-spin on Wallpaper page.
    fact cp_die_n = 0
    prop cp_die_rot = 0 ~sp_pop
    follow cp_die_rot = cp_die_n * 180

    //  Wallpaper card specular sweep triggers on hover entry.
    prop cp_wp_sw.0 = 0 ~sp_calm
    prop cp_wp_sw.1 = 0 ~sp_calm
    prop cp_wp_sw.2 = 0 ~sp_calm
    prop cp_wp_sw.3 = 0 ~sp_calm
    prop cp_wp_sw.4 = 0 ~sp_calm
    prop cp_wp_sw.5 = 0 ~sp_calm
    prop cp_wp_sw.6 = 0 ~sp_calm
    prop cp_wp_sw.7 = 0 ~sp_calm
    prop cp_wp_sw.8 = 0 ~sp_calm

    //  Focus helpers for text fields.
    prop cp_focus_font = 0 ~100ms
    prop cp_focus_wx = 0 ~100ms

    //  Label measurements for dynamic dotted leaders.
    measure cp_parent
    measure m_nf_en
    measure m_nf_sides
    measure m_nf_sens
    measure m_nf_hgt
    measure m_nf_bl
    measure m_nf_cols
    measure m_nf_tint
    measure m_nf_tdep
    measure m_gl_en
    measure m_gl_mix
    measure m_gl_bend
    measure m_gl_shine
    measure m_gl_frost
    measure m_gl_ctint
    measure m_gl_opac
    measure m_gl_edge
    measure m_gl_refr
    measure m_gl_disp
    measure m_gl_dome
    measure m_gl_milk
    measure m_gl_shad
    measure m_br_ch
    measure m_br_cw
    measure m_br_fs
    measure m_br_ns
    measure m_br_nw
    measure m_br_date
    measure m_br_lunar
    measure m_br_week
    measure m_br_secs
    measure m_br_ord
    measure m_br_cpu
    measure m_br_mem
    measure m_br_net
    measure m_br_cd
    measure m_br_snd
    measure m_br_role
    measure m_br_tint
    measure m_wp_auto
    measure m_wp_min
    measure m_wp_tr
    measure m_nt_pos
    measure m_nt_drift
    measure m_nt_snd
    measure m_nt_tune
    measure m_nt_time
    measure m_nt_dnd
    measure m_mo_str
    measure m_mo_neck
    measure m_mo_pop
    measure m_mo_wave
    measure m_mo_wstr
    measure m_mo_wspd
    measure m_lk_blur
    measure m_lk_clk
    measure m_lk_secs
    measure m_lk_sz
    measure m_lk_date
    measure m_lk_mask
    measure m_lk_pal
    measure m_lk_ext
    measure m_id_lock
    measure m_id_off
    measure m_th_fill
    measure m_th_pre
    measure m_th_wat
    measure m_th_wst
    measure m_th_wstr
    measure m_th_wspd
    measure m_th_wmix
    measure m_th_wptr
    measure m_th_wc0
    measure m_th_wc1
    measure m_th_wc2
    measure m_th_wf0
    measure m_th_wf1
    measure m_th_wf2
    measure m_th_ws0
    measure m_th_ws1
    measure m_th_ws2
    measure m_th_grad
    measure m_th_gshp
    measure m_th_gstr
    measure m_th_lgt
    measure m_th_brd
    measure m_th_smk
    measure m_th_viv
    measure m_th_mir
    measure m_th_hi
    measure m_th_rip

    //  Normalized percentage mirrors.
    let cp.tint_pct = clamp((glass_tint - 20) / 80, 0, 1)
    let cp.mix_pct = clamp(glass_mix / 100, 0, 1)
    let cp.color_tint_pct = clamp(glass_color_tint / 100, 0, 1)
    let cp.shadow_pct = clamp(glass_shadow_amt / 60, 0, 1)
    let cp.panel_pct = clamp(panel_bg_tint / 100, 0, 1)
    let cp.frost_pct = clamp(glass_frost / 100, 0, 1)
    let cp.edge_pct = clamp(glass_edge / 100, 0, 1)
    let cp.refr_pct = clamp(glass_refr / 2, 0, 1)
    let cp.disp_pct = clamp(glass_disp / 2, 0, 1)
    let cp.dome_pct = clamp((glass_dome + 1) / 2, 0, 1)
    let cp.milk_pct = clamp(glass_milk, 0, 1)
    let cp.smoke_pct = clamp(glass_smoke, 0, 1)
    let cp.vivid_pct = clamp(glass_vivid / 2, 0, 1)
    let cp.mirror_pct = clamp(glass_mirror / 2, 0, 1)
    let cp.highlight_pct = clamp(glass_highlight / 2, 0, 1)
    let cp.ripple_pct = clamp(glass_ripple, 0, 1)
    let cp.light_pct = clamp(glass_light, 0, 1)
    let cp.border_pct = clamp(glass_border / 100, 0, 1)
    let cp.grad_pct = clamp(panel_gradient_strength / 100, 0, 1)
    let cp.wstr_pct = clamp(panel_water_strength / 100, 0, 1)
    let cp.wspd_pct = clamp(panel_water_speed / 200, 0, 1)
    let cp.wmix_pct = clamp(panel_water_color_mix / 100, 0, 1)
    let cp.wptr_pct = clamp(panel_water_pointer / 100, 0, 1)
    let cp.wc0_pct = clamp((pw_caustic_scale - 40) / 160, 0, 1)
    let cp.wc1_pct = clamp(pw_caustic_sharp / 100, 0, 1)
    let cp.wc2_pct = clamp(pw_caustic_ripple / 100, 0, 1)
    let cp.wf0_pct = clamp((pw_rip_rate - 20) / 180, 0, 1)
    let cp.wf1_pct = clamp(pw_rip_rings / 100, 0, 1)
    let cp.wf2_pct = clamp(pw_rip_gloss / 100, 0, 1)
    let cp.ws0_pct = clamp((pw_drop_size - 50) / 130, 0, 1)
    let cp.ws1_pct = clamp(pw_drop_density / 100, 0, 1)
    let cp.ws2_pct = clamp(pw_drop_trails / 100, 0, 1)
    let cp.motion_pct = clamp(drawer_motion / 200, 0, 1)
    let cp.neck_pct = clamp(drawer_neck / 200, 0, 1)
    let cp.pop_pct = clamp(drawer_pop / 200, 0, 1)
    let cp.wave_pct = clamp(frame_wave_strength / 200, 0, 1)
    let cp.wave_speed_pct = clamp(frame_wave_speed / 200, 0, 1)
    let cp.idle_lock_pct = clamp(idle_lock_i / 16, 0, 1)
    let cp.idle_off_pct = clamp(idle_off_i / 16, 0, 1)
    let wp.min_pct = clamp((wall_minutes - 1) / 59, 0, 1)

    //  Reactive hooks for page switches and drawer visibility.
    on change panel_open while panel_open {
        cp_nav_ld: cp.nav_slot
        cp_nav_tl: cp.nav_slot
        cp_grp: cp.grp_slot
        cp_page_p: 0 ~10ms
        cp_page_p: 1 ~200ms after 10ms
        cp_sc_gl_to = 0
        cp_sc_br_to = 0
        cp_sc_mo_to = 0
        cp_sc_lk_to = 0
        cp_sc_th_to = 0
    }
    on change settings_page {
        cp_gear_n = cp_gear_n + 1
        cp_page_p: 0 ~10ms
        cp_page_p: 1 ~200ms after 10ms
        cp_sc_gl_to = 0
        cp_sc_br_to = 0
        cp_sc_mo_to = 0
        cp_sc_lk_to = 0
        cp_sc_th_to = 0
    }
    on change settings_page while panel_open and settings_page == 3 { cp_focus_font: 1 after 120ms }
    on change settings_page while settings_page != 3 { cp_focus_font: 0 }
    on change settings_page while panel_open and settings_page == 9 { cp_focus_wx: 1 after 120ms }
    on change settings_page while settings_page != 9 { cp_focus_wx: 0 }
    on change panel_open while panel_open and settings_page == 3 { cp_focus_font: 1 after 140ms }
    on change panel_open while panel_open and settings_page == 9 { cp_focus_wx: 1 after 140ms }
    on change panel_open while not panel_open { cp_focus_font: 0; cp_focus_wx: 0 }
    on change cp_focus_font > 0.05 while panel_open and settings_page == 3 { focus font_query }
    on change cp_focus_wx > 0.05 while panel_open and settings_page == 9 { focus weather_city }

    //  ── Shared Components ───────────────────────────────────────────────

    //  Pure sculpted crystal-glass setting block (neutral refraction + pointer rim).
    component CpCard(x: number, y: number, w: number, h: number, hot: number = 0) {
        GlassCard(x, y, w, h, 14, hot)
    }

    //  Floating crystal-glass scroll cue pill for tall settings pages.
    component CpMoreCue(cue: number, cuey: number, hot: number) {
        repeat f in 0..12 {
            let fk = (f + 1) / 12
            box { from: cp.vx, 740 + f * 4; size: cp.vw, 4.5; color: #05090e; opacity: 26% * fk * fk * cue }
        }
        GlassPrism(493, cuey - 13, 84, 26, 13, hot, 1, cue)
        path { at: 511, cuey - 1; stroke: 1.5; color: cp.mint; opacity: cue; move -4, -2; line 0, 2; line 4, -2 }
        text "More" { at: 545, cuey; anchor: center; size: 12.5; weight: 700; color: ink; opacity: cue; family: "Space Grotesk" }
    }

    //  GPU pencil dotted leader connecting label right edge to control left edge.
    component CpLeader(x0: number, x1: number, y: number, hot: number, dim: number = 0) {
        shader cp_leader {
            at: x0, y - 6
            size: max(1, x1 - x0), 12
            values: 7.2, 1.15, 0.25 + 0.35 * hot, if(hot > 0.02, cp_fr, 0), 0.35, 1, 0, 0
            colors: mix(faint, cp.mint, hot)
            opacity: (24% + 52% * hot) * (1 - 0.55 * dim)
            show: x1 - x0 > 14
        }
    }

    //  Dual-edge pinched GPU slider supporting all 5 `slider_fill` styles
    //  (0 Pencil · 1 Marker · 2 Gradient · 3 Plain · 4 Dots) and optional left deadzone.
    component CpSlider(x0: number, y: number, w: number, lv: number, hot: number, accent: color, dim: number = 0, dead: number = 0) {
        prop p_ld = 0 ~sp_lead
        prop p_tl = 0 ~sp_trail
        follow p_ld = clamp(lv, 0, 1)
        follow p_tl = clamp(lv, 0, 1)
        let h = 7
        let p_lo = min(p_ld, p_tl)
        let p_hi = max(p_ld, p_tl)
        let kx_lo = clamp(x0 + h * 0.5 + (w - h) * p_lo, x0 + h * 0.5, x0 + w - h * 0.5)
        let kx_hi = clamp(x0 + h * 0.5 + (w - h) * p_hi, x0 + h * 0.5, x0 + w - h * 0.5)
        let m = clamp(abs(p_ld - p_tl) * 3.5, 0, 1)
        let hh = h * (1 - 0.18 * m)
        let col = mix(accent, faint, 0.55 * dim)
        let fr = if(hot > 0.02, cp_fr, 0)
        let jt = 0.28 + 0.35 * hot

        //  Recessed smoked-glass groove + optional floor dead-zone indicator.
        box { from: x0, y - 6; size: w, 12; corner: 6; color: #091118; opacity: 44% * (1 - 0.45 * dim) }
        box { from: x0 + 1, y - 5; size: max(1, w * dead - 2), 10; corner: 5; color: #ffffff; opacity: 10% * (1 - 0.45 * dim); show: dead > 0.01 }
        line { from: x0 + w * dead, y - 6; to: x0 + w * dead, y + 6; width: 1; color: faint; opacity: 36%; show: dead > 0.01 }
        box { from: x0, y - 6; size: w, 12; corner: 6; stroke: 1; color: #ffffff; opacity: (14% + 18% * hot) * (1 - 0.5 * dim) }

        //  Active GPU fill (pencil hatch or fillstyle).
        shader cp_hatch {
            at: x0 - 6, y - h
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), 3.4, hh * 0.9, jt, fr, 1.15, 0
            colors: col
            opacity: (58% + 22% * hot) * (1 - 0.55 * dim)
            show: slider_fill == 0 and p_hi > 0.008
        }
        shader cp_hatch {
            at: x0 - 5.6, y - h + 0.3
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), 3.4, hh * 0.9, jt, fr, 0.85, 1
            colors: col
            opacity: (24% + 12% * hot) * (1 - 0.55 * dim)
            show: slider_fill == 0 and p_hi > 0.008
        }
        shader cp_fill {
            at: x0 - 6, y - h
            size: w + 12, 2 * h
            values: 8, 6 + max(6, kx_hi - x0), hh * 1.4, hh * 0.7, slider_fill, fr, jt, 1
            colors: col
            opacity: (62% + 22% * hot) * (1 - 0.55 * dim)
            show: slider_fill > 0 and p_hi > 0.008
        }

        //  Jelly thumb stretching between lead & trail positions.
        let tw = max(5, kx_hi - kx_lo + 4.5)
        let th = 16 - 3 * m
        box { at: (kx_lo + kx_hi) / 2, y + 1; size: tw + 2, th + 2; corner: (th + 2) / 2; color: #000000; opacity: 28% * (1 - 0.5 * dim) }
        box { at: (kx_lo + kx_hi) / 2, y; size: tw, th; corner: th / 2; color: mix(ink, accent, 0.45 + 0.55 * hot); opacity: (92% + 8% * hot) * (1 - 0.5 * dim) }
    }

    //  Capsule switch with liquid mid-travel elongation and press squash.
    component CpSwitch(x: number, y: number, w: number, h: number, on: number, knob: number, hot: number, press: number, accent: color, fg: color, bg: color) {
        let cy = y + h / 2
        let sw = 34 + 4 * knob
        let rx = x + w
        let scx = rx - sw / 2
        let sl = scx - sw / 2
        let kx = sl + 11 + knob * (sw - 22)
        let m = clamp(4 * knob * (1 - knob), 0, 1)
        let ps = clamp(press, 0, 1)
        let kw = (16 + 8 * m) * (1 + 0.14 * ps)
        let kh = (16 - 3 * m) * (1 - 0.14 * ps)
        box { at: scx, cy; size: sw + 2 * ps, 22 - 1.6 * ps; corner: 11; color: mix(#0c151d, accent, clamp(on, 0, 1)); opacity: (48% + 40% * clamp(on, 0, 1)) + 12% * hot }
        box { at: scx, cy; size: sw + 2 * ps, 22 - 1.6 * ps; corner: 11; stroke: 1; color: mix(#ffffff, accent, clamp(on, 0, 1)); opacity: 22% + 28% * hot }
        box { at: kx, cy; size: kw, kh; corner: kh / 2; color: mix(#ffffff, #071014, clamp(on, 0, 1)); opacity: 96% }
    }

    //  Segmented picker: recessed smoked-glass trough + gliding crystal-glass lens thumb.
    component CpSetPick(x0: number, y: number, w: number, h: number, n: number, sel: number, hot: number, accent: color, dim: number = 0) {
        prop ld = 0 ~sp_lead
        prop tl = 0 ~sp_trail
        follow ld = clamp(sel, 0, max(0, n - 1))
        follow tl = clamp(sel, 0, max(0, n - 1))
        let seg = w / max(1, n)
        let lx = x0 + min(ld, tl) * seg + 2
        let rx = x0 + (max(ld, tl) + 1) * seg - 2
        let tw = max(8, rx - lx)
        let has_sel = sel >= 0 and sel < n

        GlassWell(x0, y - h / 2, w, h, h / 2, hot * (1 - dim))
        GlassPrism(lx, y - h / 2 + 2, tw, h - 4, (h - 4) / 2, hot, 1 - 0.45 * dim, if(has_sel, 1 - 0.45 * dim, 0))
        box { at: (lx + rx) / 2, y + h / 2 - 3.5; size: min(22, tw * 0.42), 2; corner: 1; color: accent; opacity: (82% + 18% * hot) * (1 - 0.55 * dim); show: has_sel }
    }

    //  Standalone pure crystal-glass pill button.
    component CpPill(x: number, y: number, w: number, h: number, active: number, hot: number, accent: color, fg: color) {
        GlassPrism(x, y, w, h, h / 2, hot, active)
    }

    component FontRow(r: record, pick: event) {
        group {
            size: 552, 42
            box { from: 0, 0; size: 552, 42; corner: 10; color: #ffffff; opacity: 3% + 8% * hit.hover }
            box { from: 0, 0; size: 552, 42; corner: 10; stroke: 1; color: #ffffff; opacity: 10% + 26% * hit.hover }
            box { from: 2, 10; size: 2.5, 22; corner: 1.25; color: cp.mint; opacity: 85% * hit.hover }
            text r.name { at: 14, 21; anchor: left center; size: 15.5; weight: 600; color: ink; width: 516; lines: 1; family: "Space Grotesk" }
            zone box hit { from: 0, 0; size: 552, 42; corner: 10; cursor: pointer; label: r.name }
            on press hit { emit ui_sound; emit pick(r.index) }
        }
    }

    //  ── Panel Frame + Modal Shield ──────────────────────────────────────

    zone box cp_shield { from: 0, 0; size: 860, 820; active: panel_open; label: "Settings" }
    on press cp_shield { panel_open = panel_open }
    clip inset 0 box { from: 0, 0; size: 860, 820; corner: 26 }
    PanelBackdrop(0, 0, 860, 820, 26)

    //  ── Header (28..832) + Ratchet Gear + Breadcrumb ────────────────────
    group {
        //  8-tooth gear badge rotating 45° per page navigation.
        group {
            pivot: 46, 44
            rotate: cp_gear_rot * 1deg
            ellipse { at: 46, 44; radius: 10.5; stroke: 1.8; color: cp.mint }
            ellipse { at: 46, 44; radius: 4; stroke: 1.4; color: faint }
            repeat gt in 0..8 {
                let ga = gt * 45
                line { from: 46 + 10.5 * cos(ga), 44 + 10.5 * sin(ga); to: 46 + 13.5 * cos(ga), 44 + 13.5 * sin(ga); width: 2.2; color: cp.mint }
            }
        }
        text "Settings" { at: 70, 44; anchor: left center; size: 23; weight: 700; color: ink; family: "Space Grotesk" }
        text "·" { at: 182, 44; anchor: center; size: 16; color: faint; opacity: 55% }
        text pick(settings_page, "LOOK", "LOOK", "SHELL", "SHELL", "LOOK", "SHELL", "SHELL", "SCREEN", "SCREEN", "SYSTEM", "LOOK") {
            at: 198, 45; anchor: left center; size: 12.5; weight: 700; color: faint; family: "Space Grotesk"; measure: cp_parent
        }
        text "›" { at: 207 + cp_parent.width, 44; anchor: center; size: 14; color: faint; opacity: 50% }
        text pick(settings_page, "Frame music", "Glass", "Bar", "Font", "Wallpaper", "Notifications", "Motion", "Lock screen", "Idle", "Weather", "Theme") {
            at: 217 + cp_parent.width, 45; anchor: left center; size: 14; weight: 700; color: cp.mint; family: "Space Grotesk"
        }

        GlassOrb(812, 44, 15, cp_close.hover)
        line { from: 807, 39; to: 817, 49; width: 1.7; color: ink }
        line { from: 817, 39; to: 807, 49; width: 1.7; color: ink }
        zone box cp_close { from: 794, 26; size: 36, 36; corner: 18; cursor: pointer; label: "Close settings" }
        on press cp_close { emit ui_sound; panel_open = false }
        line { from: 28, 78; to: 832, 78; width: 1; color: #ffffff; opacity: 14% }
    }

    //  ── Sidebar Navigation (Pure Sculpted Crystal Slab + Gliding Lens Pill) ─
    group {
        GlassCard(28, 100, 194, 520, 18)

        //  Dual-edge stretching crystal-glass active indicator pill.
        let nav_top = cp.nav_y + min(cp_nav_ld, cp_nav_tl) * cp.nav_step + 1
        let nav_bot = cp.nav_y + max(cp_nav_ld, cp_nav_tl) * cp.nav_step + 27
        let nav_h = max(26, nav_bot - nav_top)
        GlassPrism(38, nav_top, 174, nav_h, 9, 0, 1)
        box { from: 41.5, nav_top + 6; size: 2.8, max(12, nav_h - 12); corner: 1.4; color: cp.mint; opacity: 96% }

        //  0: LOOK
        let g0 = clamp(1 - abs(cp_grp - 0), 0, 1)
        text "LOOK" { at: 44, cp.nav_y + 14; anchor: left center; size: 11; weight: 700; color: mix(faint, cp.mint, g0); family: "Space Grotesk" }
        line { from: 88, cp.nav_y + 14; to: 204, cp.nav_y + 14; width: 1; color: mix(faint, cp.mint, g0); opacity: 24% + 24% * g0 }
        zone box cp_group_look { from: 38, cp.nav_y; size: 174, 28; corner: 10; cursor: pointer; label: "Look group" }
        on press cp_group_look { emit ui_sound; settings_page = 4 }

        //  1: Wallpaper (settings_page == 4)
        group {
            let yy = cp.nav_y + 1 * cp.nav_step
            let on = if(settings_page == 4, 1, 0)
            let hl = max(on, cp_page_wallpaper.hover * 0.5)
            box { from: 48, yy + 7; size: 16, 12; corner: 3; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            path { at: 50, yy + 17; stroke: 1.4; color: mix(faint, cp.mint, hl); move 0, 0; line 4, -5; line 8, -2; line 12, -6 }
            text "Wallpaper" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_wallpaper { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 4; label: "Wallpaper settings" }
            on press cp_page_wallpaper { emit ui_sound; settings_page = 4 }
        }

        //  2: Frame music (settings_page == 0)
        group {
            let yy = cp.nav_y + 2 * cp.nav_step
            let on = if(settings_page == 0, 1, 0)
            let hl = max(on, cp_page_music.hover * 0.5)
            line { from: 50, yy + 18; to: 50, yy + 12; width: 2; color: mix(faint, cp.mint, hl) }
            line { from: 54, yy + 19; to: 54, yy + 8;  width: 2; color: mix(faint, cp.mint, hl) }
            line { from: 58, yy + 18; to: 58, yy + 10; width: 2; color: mix(faint, cp.mint, hl) }
            line { from: 62, yy + 19; to: 62, yy + 13; width: 2; color: mix(faint, cp.mint, hl) }
            text "Frame music" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_music { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 0; label: "Frame music settings" }
            on press cp_page_music { emit ui_sound; settings_page = 0 }
        }

        //  3: Glass (settings_page == 1)
        group {
            let yy = cp.nav_y + 3 * cp.nav_step
            let on = if(settings_page == 1, 1, 0)
            let hl = max(on, cp_page_glass.hover * 0.5)
            box { from: 48, yy + 7; size: 16, 14; corner: 4; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            line { from: 51, yy + 11; to: 58, yy + 11; width: 1.2; color: mix(faint, cp.mint, hl); opacity: 70% }
            text "Glass" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_glass { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 1; label: "Glass settings" }
            on press cp_page_glass { emit ui_sound; settings_page = 1 }
        }

        //  4: Theme (settings_page == 10)
        group {
            let yy = cp.nav_y + 4 * cp.nav_step
            let on = if(settings_page == 10, 1, 0)
            let hl = max(on, cp_page_theme.hover * 0.5)
            ellipse { at: 56, yy + 14; radius: 6.5; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            ellipse { at: 53.5, yy + 12.5; radius: 1.3; color: mix(faint, cp.mint, hl) }
            ellipse { at: 58.5, yy + 12.5; radius: 1.3; color: mix(faint, cp.mint, hl) }
            ellipse { at: 56, yy + 16.5; radius: 1.3; color: mix(faint, cp.mint, hl) }
            text "Theme" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_theme { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 10; label: "Theme settings" }
            on press cp_page_theme { emit ui_sound; settings_page = 10 }
        }

        //  5: SHELL
        let g1 = clamp(1 - abs(cp_grp - 1), 0, 1)
        text "SHELL" { at: 44, cp.nav_y + 5 * cp.nav_step + 14; anchor: left center; size: 11; weight: 700; color: mix(faint, cp.mint, g1); family: "Space Grotesk" }
        line { from: 94, cp.nav_y + 5 * cp.nav_step + 14; to: 204, cp.nav_y + 5 * cp.nav_step + 14; width: 1; color: mix(faint, cp.mint, g1); opacity: 24% + 24% * g1 }
        zone box cp_group_shell { from: 38, cp.nav_y + 5 * cp.nav_step; size: 174, 28; corner: 10; cursor: pointer; label: "Shell group" }
        on press cp_group_shell { emit ui_sound; settings_page = 2 }

        //  6: Bar (settings_page == 2)
        group {
            let yy = cp.nav_y + 6 * cp.nav_step
            let on = if(settings_page == 2, 1, 0)
            let hl = max(on, cp_page_bar.hover * 0.5)
            box { from: 48, yy + 10; size: 16, 8; corner: 4; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            ellipse { at: 53, yy + 14; radius: 1.1; color: mix(faint, cp.mint, hl) }
            ellipse { at: 56, yy + 14; radius: 1.1; color: mix(faint, cp.mint, hl) }
            ellipse { at: 59, yy + 14; radius: 1.1; color: mix(faint, cp.mint, hl) }
            text "Bar" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_bar { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 2; label: "Bar settings" }
            on press cp_page_bar { emit ui_sound; settings_page = 2 }
        }

        //  7: Font (settings_page == 3)
        group {
            let yy = cp.nav_y + 7 * cp.nav_step
            let on = if(settings_page == 3, 1, 0)
            let hl = max(on, cp_page_font.hover * 0.5)
            text "Aa" { at: 56, yy + 14; anchor: center; size: 12; weight: 700; color: mix(faint, cp.mint, hl); family: "Space Grotesk" }
            text "Font" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_font { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 3; label: "Font settings" }
            on press cp_page_font { emit ui_sound; settings_page = 3 }
        }

        //  8: Motion (settings_page == 6)
        group {
            let yy = cp.nav_y + 8 * cp.nav_step
            let on = if(settings_page == 6, 1, 0)
            let hl = max(on, cp_page_motion.hover * 0.5)
            path { at: 56, yy + 14; stroke: 1.5; color: mix(faint, cp.mint, hl); move -7, 2; curve -2, -6 via -4.5, -6; curve 2, 4 via 0, 4; curve 7, -2 via 4.5, -6 }
            text "Motion" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_motion { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 6; label: "Motion settings" }
            on press cp_page_motion { emit ui_sound; settings_page = 6 }
        }

        //  9: Notifications (settings_page == 5)
        group {
            let yy = cp.nav_y + 9 * cp.nav_step
            let on = if(settings_page == 5, 1, 0)
            let hl = max(on, cp_page_nt.hover * 0.5)
            path { at: 56, yy + 14; stroke: 1.4; color: mix(faint, cp.mint, hl); move -5, 4; line -5, -1; curve 5, -1 via 0, -8; line 5, 4; close }
            ellipse { at: 56, yy + 19.5; radius: 1.4; color: mix(faint, cp.mint, hl) }
            text "Notifications" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_nt { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 5; label: "Notifications settings" }
            on press cp_page_nt { emit ui_sound; settings_page = 5 }
        }

        //  10: SCREEN
        let g2 = clamp(1 - abs(cp_grp - 2), 0, 1)
        text "SCREEN" { at: 44, cp.nav_y + 10 * cp.nav_step + 14; anchor: left center; size: 11; weight: 700; color: mix(faint, cp.mint, g2); family: "Space Grotesk" }
        line { from: 104, cp.nav_y + 10 * cp.nav_step + 14; to: 204, cp.nav_y + 10 * cp.nav_step + 14; width: 1; color: mix(faint, cp.mint, g2); opacity: 24% + 24% * g2 }
        zone box cp_group_screen { from: 38, cp.nav_y + 10 * cp.nav_step; size: 174, 28; corner: 10; cursor: pointer; label: "Screen group" }
        on press cp_group_screen { emit ui_sound; settings_page = 7 }

        //  11: Lock screen (settings_page == 7)
        group {
            let yy = cp.nav_y + 11 * cp.nav_step
            let on = if(settings_page == 7, 1, 0)
            let hl = max(on, cp_page_lock.hover * 0.5)
            box { from: 50, yy + 13; size: 12, 9; corner: 2.5; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            path { at: 56, yy + 13; stroke: 1.4; color: mix(faint, cp.mint, hl); move -3.5, 0; line -3.5, -3; curve 3.5, -3 via 0, -7; line 3.5, 0 }
            text "Lock screen" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_lock { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 7; label: "Lock screen settings" }
            on press cp_page_lock { emit ui_sound; settings_page = 7 }
        }

        //  12: Idle (settings_page == 8)
        group {
            let yy = cp.nav_y + 12 * cp.nav_step
            let on = if(settings_page == 8, 1, 0)
            let hl = max(on, cp_page_idle.hover * 0.5)
            ellipse { at: 56, yy + 14; radius: 6.5; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            line { from: 56, yy + 14; to: 56, yy + 10.5; width: 1.3; color: mix(faint, cp.mint, hl) }
            line { from: 56, yy + 14; to: 59, yy + 15.5; width: 1.3; color: mix(faint, cp.mint, hl) }
            text "Idle" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_idle { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 8; label: "Idle settings" }
            on press cp_page_idle { emit ui_sound; settings_page = 8 }
        }

        //  13: SYSTEM
        let g3 = clamp(1 - abs(cp_grp - 3), 0, 1)
        text "SYSTEM" { at: 44, cp.nav_y + 13 * cp.nav_step + 14; anchor: left center; size: 11; weight: 700; color: mix(faint, cp.mint, g3); family: "Space Grotesk" }
        line { from: 104, cp.nav_y + 13 * cp.nav_step + 14; to: 204, cp.nav_y + 13 * cp.nav_step + 14; width: 1; color: mix(faint, cp.mint, g3); opacity: 24% + 24% * g3 }
        zone box cp_group_system { from: 38, cp.nav_y + 13 * cp.nav_step; size: 174, 28; corner: 10; cursor: pointer; label: "System group" }
        on press cp_group_system { emit ui_sound; settings_page = 9 }

        //  14: Weather (settings_page == 9)
        group {
            let yy = cp.nav_y + 14 * cp.nav_step
            let on = if(settings_page == 9, 1, 0)
            let hl = max(on, cp_page_weather.hover * 0.5)
            ellipse { at: 56, yy + 14; radius: 4; stroke: 1.4; color: mix(faint, cp.mint, hl) }
            line { from: 56, yy + 8;  to: 56, yy + 6.5;  width: 1.3; color: mix(faint, cp.mint, hl) }
            line { from: 56, yy + 20; to: 56, yy + 21.5; width: 1.3; color: mix(faint, cp.mint, hl) }
            line { from: 50, yy + 14; to: 48.5, yy + 14; width: 1.3; color: mix(faint, cp.mint, hl) }
            line { from: 62, yy + 14; to: 63.5, yy + 14; width: 1.3; color: mix(faint, cp.mint, hl) }
            text "Weather" { at: 74, yy + 14; anchor: left center; size: 13.5; weight: 600; color: mix(ink, cp.mint, hl); family: "Space Grotesk" }
            zone box cp_page_weather { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; role: tab; selected: settings_page == 9; label: "Weather settings" }
            on press cp_page_weather { emit ui_sound; settings_page = 9 }
        }

        //  Palette footer card: pure crystal glass block housing live wallpaper swatches.
        GlassCard(28, 636, 194, 108, 16, cp_pal_card.hover)
        text "PALETTE" { at: 44, 656; anchor: left center; size: 10; weight: 700; color: faint; family: "Space Grotesk" }
        text "Theme ›" { at: 206, 656; anchor: right center; size: 10.5; weight: 600; color: cp.mint; opacity: 70% + 30% * cp_pal_card.hover; family: "Space Grotesk" }
        ellipse { at: 58,  684; radius: 10; color: primary }
        ellipse { at: 58,  684; radius: 10; stroke: 1; color: ink; opacity: 55% }
        ellipse { at: 88,  684; radius: 10; color: secondary }
        ellipse { at: 118, 684; radius: 10; color: aqua }
        ellipse { at: 148, 684; radius: 10; color: ink }
        ellipse { at: 178, 684; radius: 10; color: panel }
        ellipse { at: 178, 684; radius: 10; stroke: 1; color: faint; opacity: 55% }
        text wall_name { at: 44, 718; anchor: left center; size: 11; color: faint; width: 162; lines: 1; family: "Space Grotesk" }
        zone box cp_pal_card { from: 28, 636; size: 194, 108; corner: 16; cursor: pointer; label: "Open Theme settings" }
        on press cp_pal_card { emit ui_sound; settings_page = 10 }
    }

    //  ── Right Content Area: Page Title + Description ────────────────────
    group {
        opacity: cp_page_p
        move: 0, 10 * (1 - cp_page_p) * if(motion.reduced, 0, 1)

        text pick(settings_page,
            "Frame music", "Glass", "Bar & Shell", "Font", "Wallpaper",
            "Notifications", "Motion", "Lock screen", "Idle", "Weather", "Theme & Surface"
        ) { at: 250, 118; anchor: left center; size: 22; weight: 700; color: ink; family: "Space Grotesk" }

        text pick(settings_page,
            "Spectrum bars round the frame edges and clock notch tint.",
            "Frost, lens refraction, dispersion, milk and drop shadow.",
            "Notch clock size, bar date lines, click sound and panel tint.",
            "Choose an installed UI typeface and preview it.",
            "Browse wallpaper folder, liquid hover tilt and auto rotation.",
            "Banner position, alert sounds, countdown duration and DND.",
            "Drawer spring physics, frame wave and notification poses.",
            "Interactive mask bar preview, blur, clock and lock controls.",
            "Automatic lock and screen-off timers across the idle ladder.",
            "City lookup used by the Center Panel Overview weather card.",
            "Material presets, water backdrop, slider texture, gradient and finish."
        ) { at: 250, 144; anchor: left center; size: 13.5; color: faint; width: 570; lines: 1; family: "Space Grotesk" }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 0 · FRAME MUSIC (fixed fit inside viewport)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 0
            text "SPECTRUM FRAME" { at: 250, 178; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

            //  0.1 Enable
            let y0 = 194
            let h0 = max(cp_notch_switch.hover, cp_notch_switch.pressed)
            CpCard(250, y0, 570, 62)
            text "Frame music" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_en }
            CpLeader(266 + m_nf_en.width + 10, 746, y0 + 20, h0)
            text "Animated Cava audio spectrum along the desktop screen edges." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpSwitch(756, y0 + 8, 48, 24, if(music_frame_on, 1, 0), music_frame_knob, cp_notch_switch.hover, cp_notch_switch.pressed, cp.mint, ink, cp.track)
            zone box cp_notch_switch { from: 750, y0 + 4; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle frame music" }
            on press cp_notch_switch { emit ui_sound; toggle music_frame_on }

            //  0.2 Coverage (CpSetPick 2-stop)
            let d_mf = if(music_frame_on, 0, 1)
            group {
                opacity: if(music_frame_on, 1, 0.42)
                let y1 = 262
                let h1 = max(cp_notch_top.hover, cp_notch_four.hover)
                CpCard(250, y1, 570, 62)
                text "Coverage" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_sides }
                CpLeader(266 + m_nf_sides.width + 10, 594, y1 + 20, h1, d_mf)
                text "Spread bars across top edge only or all four screen edges." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSetPick(604, y1 + 20, 200, 28, 2, music_frame_sides, h1, cp.mint, d_mf)
                text "Top only" { at: 654, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(music_frame_sides == 0, cp.mint, faint); family: "Space Grotesk" }
                text "Four edges" { at: 754, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(music_frame_sides == 1, cp.mint, faint); family: "Space Grotesk" }
                zone box cp_notch_top  { from: 604, y1 + 6; size: 100, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "Top only" }
                zone box cp_notch_four { from: 704, y1 + 6; size: 100, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "Four edges" }
                on press cp_notch_top  { emit ui_sound; music_frame_sides = 0 }
                on press cp_notch_four { emit ui_sound; music_frame_sides = 1 }

                //  0.3 Sensitivity
                let y2 = 330
                let hs = max(cp_nf_sens_track.hover, cp_nf_sens_track.pressed)
                CpCard(250, y2, 570, 62)
                text "Sensitivity" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_sens }
                CpLeader(266 + m_nf_sens.width + 10, cp.sl_x - 10, y2 + 20, hs, d_mf)
                text "Gain applied to incoming spectrum levels." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSlider(cp.sl_x, y2 + 20, cp.sl_w, clamp((music_frame_sens - 0.3) / 2.7, 0, 1), hs, cp.mint, d_mf)
                text number(music_frame_sens, 1, "×") { at: cp.rx, y2 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                zone box cp_nf_sens_track { from: cp.sl_x - 6, y2 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: music_frame_on; label: "Spectrum sensitivity" }
                on press cp_nf_sens_track { music_frame_sens = clamp(0.3 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2.7, 0.3, 3.0) }
                on drag  cp_nf_sens_track { music_frame_sens = clamp(0.3 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2.7, 0.3, 3.0) }

                //  0.4 Bar height
                let y3 = 398
                let hh = max(cp_nf_hgt_track.hover, cp_nf_hgt_track.pressed)
                CpCard(250, y3, 570, 62)
                text "Bar height" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_hgt }
                CpLeader(266 + m_nf_hgt.width + 10, cp.sl_x - 10, y3 + 20, hh, d_mf)
                text "Maximum inward reach from each monitor edge." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSlider(cp.sl_x, y3 + 20, cp.sl_w, clamp((music_frame_hgt - 10) / 110, 0, 1), hh, cp.mint, d_mf)
                text number(music_frame_hgt, 0, " px") { at: cp.rx, y3 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                zone box cp_nf_hgt_track { from: cp.sl_x - 6, y3 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: music_frame_on; label: "Bar height" }
                on press cp_nf_hgt_track { music_frame_hgt = clamp(round(10 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 110), 10, 120) }
                on drag  cp_nf_hgt_track { music_frame_hgt = clamp(round(10 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 110), 10, 120) }

                //  0.5 Liquid blend
                let y4 = 466
                let hb = max(cp_nf_bl_track.hover, cp_nf_bl_track.pressed)
                CpCard(250, y4, 570, 62)
                text "Liquid blend" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_bl }
                CpLeader(266 + m_nf_bl.width + 10, cp.sl_x - 10, y4 + 20, hb, d_mf)
                text "Melt neighbouring columns together at the corners." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSlider(cp.sl_x, y4 + 20, cp.sl_w, clamp(music_frame_blend / 100, 0, 1), hb, cp.mint, d_mf)
                text number(music_frame_blend, 0, "%") { at: cp.rx, y4 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                zone box cp_nf_bl_track { from: cp.sl_x - 6, y4 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: music_frame_on; label: "Liquid blend" }
                on press cp_nf_bl_track { music_frame_blend = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                on drag  cp_nf_bl_track { music_frame_blend = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                //  0.6 Columns (CpSetPick 4-stop: 6, 12, 24, 48)
                let y5 = 534
                let col_idx = if(music_frame_cols <= 6, 0, if(music_frame_cols <= 12, 1, if(music_frame_cols <= 24, 2, 3)))
                let hc = max(max(cp_nf_c6.hover, cp_nf_c12.hover), max(cp_nf_c24.hover, cp_nf_c48.hover))
                CpCard(250, y5, 570, 62)
                text "Columns" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_cols }
                CpLeader(266 + m_nf_cols.width + 10, 566, y5 + 20, hc, d_mf)
                text "Bar count along every edge." { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSetPick(576, y5 + 20, 228, 28, 4, col_idx, hc, cp.mint, d_mf)
                text "6"  { at: 604.5, y5 + 20; anchor: center; size: 12; weight: 700; color: if(col_idx == 0, cp.mint, faint); family: "Space Grotesk" }
                text "12" { at: 661.5, y5 + 20; anchor: center; size: 12; weight: 700; color: if(col_idx == 1, cp.mint, faint); family: "Space Grotesk" }
                text "24" { at: 718.5, y5 + 20; anchor: center; size: 12; weight: 700; color: if(col_idx == 2, cp.mint, faint); family: "Space Grotesk" }
                text "48" { at: 775.5, y5 + 20; anchor: center; size: 12; weight: 700; color: if(col_idx == 3, cp.mint, faint); family: "Space Grotesk" }
                zone box cp_nf_c6  { from: 576, y5 + 6; size: 57, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "6 columns" }
                zone box cp_nf_c12 { from: 633, y5 + 6; size: 57, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "12 columns" }
                zone box cp_nf_c24 { from: 690, y5 + 6; size: 57, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "24 columns" }
                zone box cp_nf_c48 { from: 747, y5 + 6; size: 57, 28; corner: 14; cursor: pointer; active: music_frame_on; label: "48 columns" }
                on press cp_nf_c6  { emit ui_sound; music_frame_cols =  6 }
                on press cp_nf_c12 { emit ui_sound; music_frame_cols = 12 }
                on press cp_nf_c24 { emit ui_sound; music_frame_cols = 24 }
                on press cp_nf_c48 { emit ui_sound; music_frame_cols = 48 }
            }

            text "NOTCH TINT" { at: 250, 616; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

            //  0.7 Notch tint switch
            let y6 = 632
            let hnt = max(cp_notch_tint_switch.hover, cp_notch_tint_switch.pressed)
            CpCard(250, y6, 570, 62)
            text "Notch colour shift" { at: 266, y6 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_tint }
            CpLeader(266 + m_nf_tint.width + 10, 746, y6 + 20, hnt)
            text "Tint the top bar and clock pill with wallpaper accent." { at: 266, y6 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpSwitch(756, y6 + 8, 48, 24, if(notch_tint_on, 1, 0), notch_tint_knob, cp_notch_tint_switch.hover, cp_notch_tint_switch.pressed, cp.mint, ink, cp.track)
            zone box cp_notch_tint_switch { from: 750, y6 + 4; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle notch tint" }
            on press cp_notch_tint_switch { emit ui_sound; toggle notch_tint_on }

            //  0.8 Notch tint depth
            let d_nt = if(notch_tint_on, 0, 1)
            group {
                opacity: if(notch_tint_on, 1, 0.42)
                let y7 = 700
                let hnd = max(cp_notch_tint_depth_track.hover, cp_notch_tint_depth_track.pressed)
                CpCard(250, y7, 570, 62)
                text "Shift strength" { at: 266, y7 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nf_tdep }
                CpLeader(266 + m_nf_tdep.width + 10, cp.sl_x - 10, y7 + 20, hnd, d_nt)
                text "How much wallpaper accent is blended into the top frame." { at: 266, y7 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSlider(cp.sl_x, y7 + 20, cp.sl_w, clamp(notch_tint_depth / 100, 0, 1), hnd, cp.mint, d_nt)
                text number(notch_tint_depth, 0, "%") { at: cp.rx, y7 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                zone box cp_notch_tint_depth_track { from: cp.sl_x - 6, y7 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: notch_tint_on; label: "Notch shift strength" }
                on press cp_notch_tint_depth_track { notch_tint_depth = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                on drag  cp_notch_tint_depth_track { notch_tint_depth = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
            }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 1 · GLASS (scrollable + More pill + draggable scrollbar)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 1
            let gl.h = 928
            let gl.max_s = max(1, gl.h - cp.vh)
            let gl.sc = clamp(cp_sc_gl, 0, gl.max_s)
            let gl.off = floor(gl.sc + 0.5)
            let gl.cue = clamp((gl.max_s - gl.sc) / 28, 0, 1) * clamp(1 - gl.sc / 18, 0, 1)
            let gl.th = max(44, cp.vh * min(1, cp.vh / gl.h))

            group {
                clip box { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                zone box cp_gl_wheel { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                on scroll cp_gl_wheel { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }

                group {
                    move: 0, -gl.off
                    let d_gl = if(glass_on, 0, 1)
                    text "OPTICAL GLASS" { at: 250, 184; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  1.1 Glass master switch
                    let y0 = 200
                    let h0 = max(cp_glass_switch.hover, cp_glass_switch.pressed)
                    CpCard(250, y0, 570, 62)
                    text "Liquid glass" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_en }
                    CpLeader(266 + m_gl_en.width + 10, 746, y0 + 20, h0)
                    text "Backdrop blur and optical lens surface across panels." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, y0 + 8, 48, 24, if(glass_on, 1, 0), glass_knob, cp_glass_switch.hover, cp_glass_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_glass_switch { from: 750, y0 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y0 + 20) - gl.off > 176 and (y0 + 20) - gl.off < 784; label: "Toggle glass" }
                    on scroll cp_glass_switch { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                    on press cp_glass_switch { emit ui_sound; toggle glass_on }

                    group {
                        opacity: if(glass_on, 1, 0.42)

                        //  1.2 Mix
                        let y1 = 268
                        let h1 = max(cp_mix_track.hover, cp_mix_track.pressed)
                        CpCard(250, y1, 570, 62)
                        text "Mix" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_mix }
                        CpLeader(266 + m_gl_mix.width + 10, cp.sl_x - 10, y1 + 20, h1, d_gl)
                        text "Blend between solid panel surface and refractive glass." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y1 + 20, cp.sl_w, cp.mix_pct, h1, cp.mint, d_gl)
                        text number(glass_mix, 0, "%") { at: cp.rx, y1 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_mix_track { from: cp.sl_x - 6, y1 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y1 + 20) - gl.off > 176 and (y1 + 20) - gl.off < 784; label: "Glass mix" }
                        on scroll cp_mix_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_mix_track { glass_mix = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_mix_track { glass_mix = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        //  1.3 Bend
                        let y2 = 336
                        let h2 = max(cp_bend_switch.hover, cp_bend_switch.pressed)
                        CpCard(250, y2, 570, 62)
                        text "Bend backdrop" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_bend }
                        CpLeader(266 + m_gl_bend.width + 10, 746, y2 + 20, h2, d_gl)
                        text "Curved lens distortion and chromatic dispersion." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSwitch(756, y2 + 8, 48, 24, if(glass_bend, 1, 0), bend_knob, cp_bend_switch.hover, cp_bend_switch.pressed, cp.mint, ink, cp.track)
                        zone box cp_bend_switch { from: 750, y2 + 4; size: 60, 32; corner: 16; cursor: pointer; active: glass_on and (y2 + 20) - gl.off > 176 and (y2 + 20) - gl.off < 784; label: "Toggle lens bend" }
                        on scroll cp_bend_switch { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_bend_switch { emit ui_sound; toggle glass_bend }

                        //  1.4 Shine
                        let y3 = 404
                        let h3 = max(cp_shine_switch.hover, cp_shine_switch.pressed)
                        CpCard(250, y3, 570, 62)
                        text "Pointer sheen" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_shine }
                        CpLeader(266 + m_gl_shine.width + 10, 746, y3 + 20, h3, d_gl)
                        text "Soft light catching bevels near the cursor." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSwitch(756, y3 + 8, 48, 24, if(glass_shine, 1, 0), shine_knob, cp_shine_switch.hover, cp_shine_switch.pressed, cp.mint, ink, cp.track)
                        zone box cp_shine_switch { from: 750, y3 + 4; size: 60, 32; corner: 16; cursor: pointer; active: glass_on and (y3 + 20) - gl.off > 176 and (y3 + 20) - gl.off < 784; label: "Toggle pointer sheen" }
                        on scroll cp_shine_switch { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_shine_switch { emit ui_sound; toggle glass_shine }

                        //  1.5 Frost (with Auto toggle chip on same card header)
                        let y4 = 472
                        let d_fr = if(glass_on and not glass_frost_auto, 0, 1)
                        let h4 = max(max(cp_frost_track.hover, cp_frost_track.pressed), cp_frost_auto.hover)
                        CpCard(250, y4, 570, 62)
                        text "Frost" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_frost }
                        CpLeader(266 + m_gl_frost.width + 10, 466, y4 + 20, h4, d_fr)
                        CpPill(476, y4 + 8, 46, 24, if(glass_frost_auto, 1, 0), cp_frost_auto.hover, cp.mint, ink)
                        text "Auto" { at: 499, y4 + 20; anchor: center; size: 11; weight: 700; color: if(glass_frost_auto, cp.mint, faint); family: "Space Grotesk" }
                        zone box cp_frost_auto { from: 476, y4 + 8; size: 46, 24; corner: 12; cursor: pointer; active: glass_on and (y4 + 20) - gl.off > 176 and (y4 + 20) - gl.off < 784; label: "Auto frost" }
                        on scroll cp_frost_auto { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_frost_auto { emit ui_sound; toggle glass_frost_auto }
                        text "Backdrop blur radius behind panels." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y4 + 20, cp.sl_w, cp.frost_pct, h4, cp.mint, d_fr)
                        text "Auto" { at: cp.rx, y4 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; show: glass_frost_auto; family: "Space Grotesk" }
                        text number(glass_frost, 0, "%") { at: cp.rx, y4 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; show: not glass_frost_auto; family: "Space Grotesk" }
                        zone box cp_frost_track { from: cp.sl_x - 6, y4 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y4 + 20) - gl.off > 176 and (y4 + 20) - gl.off < 784; label: "Frost" }
                        on scroll cp_frost_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_frost_track { glass_frost_auto = false; glass_preset_i = -1; glass_frost = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_frost_track { glass_frost_auto = false; glass_preset_i = -1; glass_frost = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        //  1.6 Colour tint
                        let y5 = 540
                        let h5 = max(cp_color_tint_track.hover, cp_color_tint_track.pressed)
                        CpCard(250, y5, 570, 62)
                        text "Colour tint" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_ctint }
                        CpLeader(266 + m_gl_ctint.width + 10, cp.sl_x - 10, y5 + 20, h5, d_gl)
                        text "Wallpaper tint mixed through the glass body." { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y5 + 20, cp.sl_w, cp.color_tint_pct, h5, cp.mint, d_gl)
                        text number(glass_color_tint, 0, "%") { at: cp.rx, y5 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_color_tint_track { from: cp.sl_x - 6, y5 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y5 + 20) - gl.off > 176 and (y5 + 20) - gl.off < 784; label: "Glass colour tint" }
                        on scroll cp_color_tint_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_color_tint_track { glass_preset_i = -1; glass_color_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_color_tint_track { glass_preset_i = -1; glass_color_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        //  1.7 Opacity (with 20% deadzone guard marker)
                        let y6 = 608
                        let h6 = max(cp_tint_track.hover, cp_tint_track.pressed)
                        CpCard(250, y6, 570, 62)
                        text "Opacity" { at: 266, y6 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_opac }
                        CpLeader(266 + m_gl_opac.width + 10, cp.sl_x - 10, y6 + 20, h6, d_gl)
                        text "Surface opacity floor (clamped above 20% for legibility)." { at: 266, y6 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y6 + 20, cp.sl_w, glass_tint / 100, h6, cp.mint, d_gl, 0.20)
                        text number(glass_tint, 0, "%") { at: cp.rx, y6 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_tint_track { from: cp.sl_x - 6, y6 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y6 + 20) - gl.off > 176 and (y6 + 20) - gl.off < 784; label: "Glass opacity" }
                        on scroll cp_tint_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_tint_track { glass_preset_i = -1; glass_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 20, 100) }
                        on drag  cp_tint_track { glass_preset_i = -1; glass_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 20, 100) }

                        //  1.8 Edge rim
                        let y7 = 676
                        let h7 = max(cp_edge_track.hover, cp_edge_track.pressed)
                        CpCard(250, y7, 570, 62)
                        text "Edge highlight" { at: 266, y7 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_edge }
                        CpLeader(266 + m_gl_edge.width + 10, cp.sl_x - 10, y7 + 20, h7, d_gl)
                        text "Specular bevel strength around glass perimeters." { at: 266, y7 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y7 + 20, cp.sl_w, cp.edge_pct, h7, cp.mint, d_gl)
                        text number(glass_edge, 0, "%") { at: cp.rx, y7 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_edge_track { from: cp.sl_x - 6, y7 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y7 + 20) - gl.off > 176 and (y7 + 20) - gl.off < 784; label: "Edge highlight" }
                        on scroll cp_edge_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_edge_track { glass_preset_i = -1; glass_edge = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_edge_track { glass_preset_i = -1; glass_edge = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        text "LENS & FINISH" { at: 250, 758; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                        //  1.9..1.11 Lens optics (dimmed additionally when Bend is off)
                        let d_lens = if(glass_on and glass_bend, 0, 1)
                        group {
                            opacity: if(glass_bend, 1, 0.45)

                            let y8 = 774
                            let h8 = max(cp_refr_track.hover, cp_refr_track.pressed)
                            CpCard(250, y8, 570, 62)
                            text "Refraction" { at: 266, y8 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_refr }
                            CpLeader(266 + m_gl_refr.width + 10, cp.sl_x - 10, y8 + 20, h8, d_lens)
                            text "Bending index of light entering the glass slab." { at: 266, y8 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, y8 + 20, cp.sl_w, cp.refr_pct, h8, cp.mint, d_lens)
                            text number(glass_refr, 2, "×") { at: cp.rx, y8 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_refr_track { from: cp.sl_x - 6, y8 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and glass_bend and (y8 + 20) - gl.off > 176 and (y8 + 20) - gl.off < 784; label: "Refraction" }
                            on scroll cp_refr_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                            on press cp_refr_track { glass_preset_i = -1; glass_refr = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }
                            on drag  cp_refr_track { glass_preset_i = -1; glass_refr = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }

                            let y9 = 842
                            let h9 = max(cp_disp_track.hover, cp_disp_track.pressed)
                            CpCard(250, y9, 570, 62)
                            text "Dispersion" { at: 266, y9 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_disp }
                            CpLeader(266 + m_gl_disp.width + 10, cp.sl_x - 10, y9 + 20, h9, d_lens)
                            text "Prismatic RGB separation near sloped edges." { at: 266, y9 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, y9 + 20, cp.sl_w, cp.disp_pct, h9, cp.mint, d_lens)
                            text number(glass_disp, 2, "×") { at: cp.rx, y9 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_disp_track { from: cp.sl_x - 6, y9 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and glass_bend and (y9 + 20) - gl.off > 176 and (y9 + 20) - gl.off < 784; label: "Dispersion" }
                            on scroll cp_disp_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                            on press cp_disp_track { glass_preset_i = -1; glass_disp = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }
                            on drag  cp_disp_track { glass_preset_i = -1; glass_disp = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }

                            let y10 = 910
                            let h10 = max(cp_dome_track.hover, cp_dome_track.pressed)
                            CpCard(250, y10, 570, 62)
                            text "Dome curvature" { at: 266, y10 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_dome }
                            CpLeader(266 + m_gl_dome.width + 10, cp.sl_x - 10, y10 + 20, h10, d_lens)
                            text "Convex (+1) or concave (-1) surface profile." { at: 266, y10 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, y10 + 20, cp.sl_w, cp.dome_pct, h10, cp.mint, d_lens)
                            text number(glass_dome, 2, "") { at: cp.rx, y10 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_dome_track { from: cp.sl_x - 6, y10 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and glass_bend and (y10 + 20) - gl.off > 176 and (y10 + 20) - gl.off < 784; label: "Dome curvature" }
                            on scroll cp_dome_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                            on press cp_dome_track { glass_preset_i = -1; glass_dome = clamp(round(((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2 - 1) * 20) / 20, -1, 1) }
                            on drag  cp_dome_track { glass_preset_i = -1; glass_dome = clamp(round(((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2 - 1) * 20) / 20, -1, 1) }
                        }

                        //  1.12 Milk
                        let y11 = 978
                        let h11 = max(cp_milk_track.hover, cp_milk_track.pressed)
                        CpCard(250, y11, 570, 62)
                        text "Milky haze" { at: 266, y11 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_milk }
                        CpLeader(266 + m_gl_milk.width + 10, cp.sl_x - 10, y11 + 20, h11, d_gl)
                        text "Scatter light inside the glass like etched acrylic." { at: 266, y11 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y11 + 20, cp.sl_w, cp.milk_pct, h11, cp.mint, d_gl)
                        text number(glass_milk * 100, 0, "%") { at: cp.rx, y11 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_milk_track { from: cp.sl_x - 6, y11 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y11 + 20) - gl.off > 176 and (y11 + 20) - gl.off < 784; label: "Milky haze" }
                        on scroll cp_milk_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_milk_track { glass_preset_i = -1; glass_milk = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }
                        on drag  cp_milk_track { glass_preset_i = -1; glass_milk = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }

                        //  1.13 Drop shadow
                        let y12 = 1046
                        let h12 = max(cp_shadow_track.hover, cp_shadow_track.pressed)
                        CpCard(250, y12, 570, 62)
                        text "Drop shadow" { at: 266, y12 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_gl_shad }
                        CpLeader(266 + m_gl_shad.width + 10, cp.sl_x - 10, y12 + 20, h12, d_gl)
                        text "Depth cast onto desktop windows below drawers." { at: 266, y12 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y12 + 20, cp.sl_w, cp.shadow_pct, h12, cp.mint, d_gl)
                        text number(glass_shadow_amt, 0, "") { at: cp.rx, y12 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_shadow_track { from: cp.sl_x - 6, y12 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: glass_on and (y12 + 20) - gl.off > 176 and (y12 + 20) - gl.off < 784; label: "Drop shadow" }
                        on scroll cp_shadow_track { cp_sc_gl_to = clamp(cp_sc_gl_to - wheel * 48, 0, gl.max_s) }
                        on press cp_shadow_track { glass_preset_i = -1; glass_shadow_amt = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 60), 0, 60) }
                        on drag  cp_shadow_track { glass_preset_i = -1; glass_shadow_amt = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 60), 0, 60) }
                    }
                }

                //  Soft shadow fade + bobbing crystal-glass More pill.
                let gl.cuey = 762 + 2 * sin(cp_clk * 240)
                CpMoreCue(gl.cue, gl.cuey, gl_cue_hit.hover)
                zone box gl_cue_hit { at: 535, 762; size: 84, 28; corner: 14; cursor: pointer; active: gl.cue > 0.4; label: "Scroll down" }
                on press gl_cue_hit { emit ui_sound; cp_sc_gl_to = clamp(cp_sc_gl_to + 320, 0, gl.max_s) }
            }

            //  Draggable 14px scrollbar track.
            box { from: 829, cp.vy; size: 4, cp.vh; corner: 2; color: ink; opacity: 8% }
            box { from: 829, cp.vy + (cp.vh - gl.th) * clamp(gl.sc / gl.max_s, 0, 1); size: 4, gl.th; corner: 2; color: cp.mint; opacity: 45% + 40% * gl_bar_hit.hover }
            zone box gl_bar_hit { from: 824, cp.vy; size: 14, cp.vh; cursor: pointer; label: "Scroll Glass settings" }
            on press gl_bar_hit { cp_sc_gl_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - gl.th / 2) / max(1, cp.vh - gl.th) * gl.max_s, 0, gl.max_s) }
            on drag  gl_bar_hit { cp_sc_gl_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - gl.th / 2) / max(1, cp.vh - gl.th) * gl.max_s, 0, gl.max_s) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 2 · BAR & SHELL (scrollable)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 2
            let br.h = 1372
            let br.max_s = max(1, br.h - cp.vh)
            let br.sc = clamp(cp_sc_br, 0, br.max_s)
            let br.off = floor(br.sc + 0.5)
            let br.cue = clamp((br.max_s - br.sc) / 28, 0, 1) * clamp(1 - br.sc / 18, 0, 1)
            let br.th = max(44, cp.vh * min(1, cp.vh / br.h))

            group {
                clip box { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                zone box cp_br_wheel { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                on scroll cp_br_wheel { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }

                group {
                    move: 0, -br.off
                    text "NOTCH GEOMETRY" { at: 250, 184; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y0 = 200
                    let h0 = max(cp_nf_clkh_track.hover, cp_nf_clkh_track.pressed)
                    CpCard(250, y0, 570, 62)
                    text "Notch height" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_ch }
                    CpLeader(266 + m_br_ch.width + 10, cp.sl_x - 10, y0 + 20, h0)
                    text "Top clock pill & frame bar thickness." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y0 + 20, cp.sl_w, clamp((notch_clock_h - 10) / 86, 0, 1), h0, cp.mint)
                    text number(notch_clock_h, 0, " px") { at: cp.rx, y0 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_nf_clkh_track { from: cp.sl_x - 6, y0 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y0 + 20) - br.off > 176 and (y0 + 20) - br.off < 784; label: "Notch height" }
                    on scroll cp_nf_clkh_track { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_nf_clkh_track { notch_clock_h = clamp(round(10 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 86), 10, 96) }
                    on drag  cp_nf_clkh_track { notch_clock_h = clamp(round(10 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 86), 10, 96) }

                    let y1 = 268
                    let h1 = max(cp_nf_clkw_track.hover, cp_nf_clkw_track.pressed)
                    CpCard(250, y1, 570, 62)
                    text "Notch width" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_cw }
                    CpLeader(266 + m_br_cw.width + 10, cp.sl_x - 10, y1 + 20, h1)
                    text "Horizontal span of the center clock capsule." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y1 + 20, cp.sl_w, clamp((notch_clock_w - 120) / 360, 0, 1), h1, cp.mint)
                    text number(notch_clock_w, 0, " px") { at: cp.rx, y1 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_nf_clkw_track { from: cp.sl_x - 6, y1 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y1 + 20) - br.off > 176 and (y1 + 20) - br.off < 784; label: "Notch width" }
                    on scroll cp_nf_clkw_track { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_nf_clkw_track { notch_clock_w = clamp(round(120 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 360), 120, 480) }
                    on drag  cp_nf_clkw_track { notch_clock_w = clamp(round(120 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 360), 120, 480) }

                    text "BAR STYLE & NUMBERS" { at: 250, 350; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y_fs = 366
                    let h_fs = max(cp_bar_fs_track.hover, cp_bar_fs_track.pressed)
                    CpCard(250, y_fs, 570, 62)
                    text "Bar font size" { at: 266, y_fs + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_fs }
                    CpLeader(266 + m_br_fs.width + 10, cp.sl_x - 10, y_fs + 20, h_fs)
                    text "调整顶栏数字、日期、指标圆环及文字大小。" { at: 266, y_fs + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSlider(cp.sl_x, y_fs + 20, cp.sl_w, clamp((bar_font_size - 12) / 14, 0, 1), h_fs, cp.mint)
                    text number(bar_font_size, 0, " px") { at: cp.rx, y_fs + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_bar_fs_track { from: cp.sl_x - 6, y_fs + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y_fs + 20) - br.off > 176 and (y_fs + 20) - br.off < 784; label: "Bar font size" }
                    on scroll cp_bar_fs_track { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_fs_track { bar_font_size = clamp(round(12 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 14), 12, 26) }
                    on drag  cp_bar_fs_track { bar_font_size = clamp(round(12 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 14), 12, 26) }

                    let y_ns = 434
                    let h_ns = max(max(cp_bar_ns_0.hover, cp_bar_ns_1.hover), max(cp_bar_ns_2.hover, cp_bar_ns_3.hover))
                    CpCard(250, y_ns, 570, 62)
                    text "Number style" { at: 266, y_ns + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_ns }
                    CpLeader(266 + m_br_ns.width + 10, 522, y_ns + 20, h_ns)
                    text "顶栏数字与指标使用纯文本或 Vitreus 液态玻璃样式。" { at: 266, y_ns + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSetPick(532, y_ns + 20, 272, 28, 4, bar_num_style, h_ns, cp.mint)
                    text "Plain"   { at: 566, y_ns + 20; anchor: center; size: 11.5; weight: 700; color: if(bar_num_style == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Glass"   { at: 634, y_ns + 20; anchor: center; size: 11.5; weight: 700; color: if(bar_num_style == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Frosted" { at: 702, y_ns + 20; anchor: center; size: 11.5; weight: 700; color: if(bar_num_style == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "Tinted"  { at: 770, y_ns + 20; anchor: center; size: 11.5; weight: 700; color: if(bar_num_style == 3, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_bar_ns_0 { from: 532, y_ns + 6; size: 68, 28; corner: 14; cursor: pointer; active: (y_ns + 20) - br.off > 176 and (y_ns + 20) - br.off < 784; label: "Plain style" }
                    zone box cp_bar_ns_1 { from: 600, y_ns + 6; size: 68, 28; corner: 14; cursor: pointer; active: (y_ns + 20) - br.off > 176 and (y_ns + 20) - br.off < 784; label: "Glass style" }
                    zone box cp_bar_ns_2 { from: 668, y_ns + 6; size: 68, 28; corner: 14; cursor: pointer; active: (y_ns + 20) - br.off > 176 and (y_ns + 20) - br.off < 784; label: "Frosted style" }
                    zone box cp_bar_ns_3 { from: 736, y_ns + 6; size: 68, 28; corner: 14; cursor: pointer; active: (y_ns + 20) - br.off > 176 and (y_ns + 20) - br.off < 784; label: "Tinted style" }
                    on scroll cp_bar_ns_0 { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on scroll cp_bar_ns_1 { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on scroll cp_bar_ns_2 { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on scroll cp_bar_ns_3 { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_ns_0 { emit ui_sound; bar_num_style = 0 }
                    on press cp_bar_ns_1 { emit ui_sound; bar_num_style = 1 }
                    on press cp_bar_ns_2 { emit ui_sound; bar_num_style = 2 }
                    on press cp_bar_ns_3 { emit ui_sound; bar_num_style = 3 }

                    let y_nw = 502
                    let h_nw = max(cp_bar_nw_track.hover, cp_bar_nw_track.pressed)
                    CpCard(250, y_nw, 570, 62)
                    text "Glass stroke" { at: 266, y_nw + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_nw }
                    CpLeader(266 + m_br_nw.width + 10, cp.sl_x - 10, y_nw + 20, h_nw)
                    text "调整液态玻璃数字笔画与指标圆环粗细。" { at: 266, y_nw + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSlider(cp.sl_x, y_nw + 20, cp.sl_w, clamp((bar_num_weight - 70) / 75, 0, 1), h_nw, cp.mint)
                    text number(bar_num_weight, 0, "%") { at: cp.rx, y_nw + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_bar_nw_track { from: cp.sl_x - 6, y_nw + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y_nw + 20) - br.off > 176 and (y_nw + 20) - br.off < 784; label: "Glass stroke weight" }
                    on scroll cp_bar_nw_track { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_nw_track { bar_num_weight = clamp(round(70 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 75), 70, 145) }
                    on drag  cp_bar_nw_track { bar_num_weight = clamp(round(70 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 75), 70, 145) }

                    text "BAR DATE & TIME" { at: 250, 584; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y2 = 600
                    let h2 = max(cp_bar_date_switch.hover, cp_bar_date_switch.pressed)
                    CpCard(250, y2, 570, 62)
                    text "Gregorian date" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_date }
                    CpLeader(266 + m_br_date.width + 10, 746, y2 + 20, h2)
                    text "显示公历日期（月日）。" { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y2 + 8, 48, 24, if(bar_show_date, 1, 0), bar_date_knob, cp_bar_date_switch.hover, cp_bar_date_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_date_switch { from: 750, y2 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y2 + 20) - br.off > 176 and (y2 + 20) - br.off < 784; label: "Toggle date" }
                    on scroll cp_bar_date_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_date_switch { emit ui_sound; toggle bar_show_date }

                    let y3 = 668
                    let h3 = max(cp_bar_lunar_switch.hover, cp_bar_lunar_switch.pressed)
                    CpCard(250, y3, 570, 62)
                    text "Lunar date" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_lunar }
                    CpLeader(266 + m_br_lunar.width + 10, 746, y3 + 20, h3)
                    text "显示农历与节气日期。" { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y3 + 8, 48, 24, if(bar_show_lunar, 1, 0), bar_lunar_knob, cp_bar_lunar_switch.hover, cp_bar_lunar_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_lunar_switch { from: 750, y3 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y3 + 20) - br.off > 176 and (y3 + 20) - br.off < 784; label: "Toggle lunar date" }
                    on scroll cp_bar_lunar_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_lunar_switch { emit ui_sound; toggle bar_show_lunar }

                    let y4 = 736
                    let h4 = max(cp_bar_weekday_switch.hover, cp_bar_weekday_switch.pressed)
                    CpCard(250, y4, 570, 62)
                    text "Weekday" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_week }
                    CpLeader(266 + m_br_week.width + 10, 746, y4 + 20, h4)
                    text "显示当前星期几。" { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y4 + 8, 48, 24, if(bar_show_weekday, 1, 0), bar_weekday_knob, cp_bar_weekday_switch.hover, cp_bar_weekday_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_weekday_switch { from: 750, y4 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y4 + 20) - br.off > 176 and (y4 + 20) - br.off < 784; label: "Toggle weekday" }
                    on scroll cp_bar_weekday_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_weekday_switch { emit ui_sound; toggle bar_show_weekday }

                    let y5 = 804
                    let h5 = max(cp_bar_sec_switch.hover, cp_bar_sec_switch.pressed)
                    CpCard(250, y5, 570, 62)
                    text "Seconds" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_secs }
                    CpLeader(266 + m_br_secs.width + 10, 746, y5 + 20, h5)
                    text "显示时间秒数，关闭可减少静息刷新。" { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y5 + 8, 48, 24, if(bar_show_secs, 1, 0), bar_sec_knob, cp_bar_sec_switch.hover, cp_bar_sec_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_sec_switch { from: 750, y5 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y5 + 20) - br.off > 176 and (y5 + 20) - br.off < 784; label: "Toggle seconds" }
                    on scroll cp_bar_sec_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_sec_switch { emit ui_sound; toggle bar_show_secs }

                    let y6 = 872
                    let h6 = max(cp_snd_switch.hover, cp_snd_switch.pressed)
                    CpCard(250, y6, 570, 62)
                    text "Panel sound" { at: 266, y6 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_snd }
                    CpLeader(266 + m_br_snd.width + 10, 746, y6 + 20, h6)
                    text "Subtle click feedback when pressing controls and tabs." { at: 266, y6 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, y6 + 8, 48, 24, if(snd_on, 1, 0), snd_knob, cp_snd_switch.hover, cp_snd_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_snd_switch { from: 750, y6 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y6 + 20) - br.off > 176 and (y6 + 20) - br.off < 784; label: "Toggle sound" }
                    on scroll cp_snd_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_snd_switch { emit ui_sound; toggle snd_on }

                    text "PANEL TINT" { at: 250, 1376; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y7 = 1392
                    let h7 = max(cp_panel_role_primary.hover, cp_panel_role_secondary.hover)
                    CpCard(250, y7, 570, 62)
                    text "Panel colour" { at: 266, y7 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_role }
                    CpLeader(266 + m_br_role.width + 10, 594, y7 + 20, h7)
                    text "Wallpaper palette role washed behind panel surfaces." { at: 266, y7 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(604, y7 + 20, 200, 28, 2, panel_bg_role, h7, cp.mint)
                    text "Primary"   { at: 654, y7 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_bg_role == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Secondary" { at: 754, y7 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_bg_role == 1, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_panel_role_primary   { from: 604, y7 + 6; size: 100, 28; corner: 14; cursor: pointer; active: (y7 + 20) - br.off > 176 and (y7 + 20) - br.off < 784; label: "Primary tint" }
                    zone box cp_panel_role_secondary { from: 704, y7 + 6; size: 100, 28; corner: 14; cursor: pointer; active: (y7 + 20) - br.off > 176 and (y7 + 20) - br.off < 784; label: "Secondary tint" }
                    on scroll cp_panel_role_primary   { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on scroll cp_panel_role_secondary { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_panel_role_primary   { emit ui_sound; panel_bg_role = 0 }
                    on press cp_panel_role_secondary { emit ui_sound; panel_bg_role = 1 }

                    let y8 = 1460
                    let h8 = max(cp_panel_tint_track.hover, cp_panel_tint_track.pressed)
                    CpCard(250, y8, 570, 62)
                    text "Tint depth" { at: 266, y8 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_tint }
                    CpLeader(266 + m_br_tint.width + 10, cp.sl_x - 10, y8 + 20, h8)
                    text "Amount of chosen colour mixed into every drawer background." { at: 266, y8 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y8 + 20, cp.sl_w, cp.panel_pct, h8, cp.mint)
                    text number(panel_bg_tint, 0, "%") { at: cp.rx, y8 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_panel_tint_track { from: cp.sl_x - 6, y8 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y8 + 20) - br.off > 176 and (y8 + 20) - br.off < 784; label: "Panel tint depth" }
                    on scroll cp_panel_tint_track { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_panel_tint_track { panel_bg_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                    on drag  cp_panel_tint_track { panel_bg_tint = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                    text "BAR WIDGETS" { at: 250, 954; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y_ord = 970
                    CpCard(250, y_ord, 570, 112)
                    text "Module order" { at: 266, y_ord + 18; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_ord }
                    CpLeader(266 + m_br_ord.width + 10, 734, y_ord + 18, cp_ord_reset.hover)
                    text "点击左右箭头调整顶栏中间各模块的排列顺序。" { at: 266, y_ord + 36; anchor: left center; size: 12; color: faint; family: "Noto Sans CJK SC" }
                    GlassPrism(744, y_ord + 10, 60, 24, 12, cp_ord_reset.hover, 0)
                    text "Reset" { at: 774, y_ord + 22; anchor: center; size: 11; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_ord_reset { from: 744, y_ord + 10; size: 60, 24; corner: 12; cursor: pointer; active: (y_ord + 22) - br.off > 176 and (y_ord + 22) - br.off < 784; label: "Reset module order" }
                    on scroll cp_ord_reset { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_ord_reset { emit ui_sound; emit bar_order_reset }

                    repeat k in 0..6 {
                        let ox = 268 + k * 90
                        GlassWell(ox, y_ord + 52, 84, 48, 12, if(bar_order_slots.$k.enabled, 0.5, 0))
                        box { at: ox + 42, y_ord + 54; size: 18, 2; corner: 1; color: cp.mint; opacity: 88%; show: bar_order_slots.$k.enabled }
                        text bar_order_slots.$k.label { at: ox + 42, y_ord + 67; anchor: center; size: 12.5; weight: 700; color: if(bar_order_slots.$k.enabled, ink, faint); family: "Noto Sans CJK SC" }

                        box { from: ox + 5, y_ord + 78; size: 35, 18; corner: 9; color: #ffffff; opacity: if(k > 0, 6% + 12% * cp_ord_l.$k.hover, 2%) }
                        box { from: ox + 5, y_ord + 78; size: 35, 18; corner: 9; stroke: 0.8; color: #ffffff; opacity: if(k > 0, 14% + 20% * cp_ord_l.$k.hover, 4%) }
                        text "‹" { at: ox + 22.5, y_ord + 87; anchor: center; size: 13; weight: 700; color: if(k > 0, if(cp_ord_l.$k.hover > 0.5, cp.mint, ink), faint); opacity: if(k > 0, 92%, 25%); family: "Space Grotesk" }
                        zone box cp_ord_l.$k { from: ox + 5, y_ord + 78; size: 35, 18; corner: 9; cursor: pointer; active: k > 0 and (y_ord + 87) - br.off > 176 and (y_ord + 87) - br.off < 784; label: "Move left" }
                        on scroll cp_ord_l.$k { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                        on press cp_ord_l.$k { emit ui_sound; emit bar_order_move(k * 2) }

                        box { from: ox + 44, y_ord + 78; size: 35, 18; corner: 9; color: #ffffff; opacity: if(k < 5, 6% + 12% * cp_ord_r.$k.hover, 2%) }
                        box { from: ox + 44, y_ord + 78; size: 35, 18; corner: 9; stroke: 0.8; color: #ffffff; opacity: if(k < 5, 14% + 20% * cp_ord_r.$k.hover, 4%) }
                        text "›" { at: ox + 61.5, y_ord + 87; anchor: center; size: 13; weight: 700; color: if(k < 5, if(cp_ord_r.$k.hover > 0.5, cp.mint, ink), faint); opacity: if(k < 5, 92%, 25%); family: "Space Grotesk" }
                        zone box cp_ord_r.$k { from: ox + 44, y_ord + 78; size: 35, 18; corner: 9; cursor: pointer; active: k < 5 and (y_ord + 87) - br.off > 176 and (y_ord + 87) - br.off < 784; label: "Move right" }
                        on scroll cp_ord_r.$k { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                        on press cp_ord_r.$k { emit ui_sound; emit bar_order_move(k * 2 + 1) }
                    }

                    let y_cpu = 1090
                    let h_cpu = max(cp_bar_cpu_switch.hover, cp_bar_cpu_switch.pressed)
                    CpCard(250, y_cpu, 570, 62)
                    text "CPU monitor" { at: 266, y_cpu + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_cpu }
                    CpLeader(266 + m_br_cpu.width + 10, 746, y_cpu + 20, h_cpu)
                    text "在顶栏显示 CPU 占用玻璃圆环与数值。" { at: 266, y_cpu + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y_cpu + 8, 48, 24, if(bar_show_cpu, 1, 0), bar_cpu_knob, cp_bar_cpu_switch.hover, cp_bar_cpu_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_cpu_switch { from: 750, y_cpu + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y_cpu + 20) - br.off > 176 and (y_cpu + 20) - br.off < 784; label: "Toggle CPU monitor" }
                    on scroll cp_bar_cpu_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_cpu_switch { emit ui_sound; toggle bar_show_cpu }

                    let y_mem = 1158
                    let h_mem = max(cp_bar_mem_switch.hover, cp_bar_mem_switch.pressed)
                    CpCard(250, y_mem, 570, 62)
                    text "Memory monitor" { at: 266, y_mem + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_mem }
                    CpLeader(266 + m_br_mem.width + 10, 746, y_mem + 20, h_mem)
                    text "在顶栏显示内存占用玻璃圆环与数值。" { at: 266, y_mem + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y_mem + 8, 48, 24, if(bar_show_mem, 1, 0), bar_mem_knob, cp_bar_mem_switch.hover, cp_bar_mem_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_mem_switch { from: 750, y_mem + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y_mem + 20) - br.off > 176 and (y_mem + 20) - br.off < 784; label: "Toggle memory monitor" }
                    on scroll cp_bar_mem_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_mem_switch { emit ui_sound; toggle bar_show_mem }

                    let y_net = 1226
                    let h_net = max(cp_bar_net_switch.hover, cp_bar_net_switch.pressed)
                    CpCard(250, y_net, 570, 62)
                    text "Network speed" { at: 266, y_net + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_net }
                    CpLeader(266 + m_br_net.width + 10, 746, y_net + 20, h_net)
                    text "在顶栏显示实时网络上传与下载速度。" { at: 266, y_net + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y_net + 8, 48, 24, if(bar_show_net, 1, 0), bar_net_knob, cp_bar_net_switch.hover, cp_bar_net_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_net_switch { from: 750, y_net + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y_net + 20) - br.off > 176 and (y_net + 20) - br.off < 784; label: "Toggle network monitor" }
                    on scroll cp_bar_net_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_net_switch { emit ui_sound; toggle bar_show_net }

                    let y_cd = 1294
                    let h_cd = max(cp_bar_cd_switch.hover, cp_bar_cd_switch.pressed)
                    CpCard(250, y_cd, 570, 62)
                    text "Countdown" { at: 266, y_cd + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_br_cd }
                    CpLeader(266 + m_br_cd.width + 10, 746, y_cd + 20, h_cd)
                    text "在顶栏中间显示最近的倒计时日（如 恬恬3天）。" { at: 266, y_cd + 44; anchor: left center; size: 12.5; color: faint; family: "Noto Sans CJK SC" }
                    CpSwitch(756, y_cd + 8, 48, 24, if(bar_show_countdown, 1, 0), bar_cd_knob, cp_bar_cd_switch.hover, cp_bar_cd_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_bar_cd_switch { from: 750, y_cd + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y_cd + 20) - br.off > 176 and (y_cd + 20) - br.off < 784; label: "Toggle bar countdown" }
                    on scroll cp_bar_cd_switch { cp_sc_br_to = clamp(cp_sc_br_to - wheel * 48, 0, br.max_s) }
                    on press cp_bar_cd_switch { emit ui_sound; toggle bar_show_countdown }
                }

                let br.cuey = 762 + 2 * sin(cp_clk * 240)
                CpMoreCue(br.cue, br.cuey, br_cue_hit.hover)
                zone box br_cue_hit { at: 535, 762; size: 84, 28; corner: 14; cursor: pointer; active: br.cue > 0.4; label: "Scroll down" }
                on press br_cue_hit { emit ui_sound; cp_sc_br_to = clamp(cp_sc_br_to + 320, 0, br.max_s) }
            }

            box { from: 829, cp.vy; size: 4, cp.vh; corner: 2; color: ink; opacity: 8% }
            box { from: 829, cp.vy + (cp.vh - br.th) * clamp(br.sc / br.max_s, 0, 1); size: 4, br.th; corner: 2; color: cp.mint; opacity: 45% + 40% * br_bar_hit.hover }
            zone box br_bar_hit { from: 824, cp.vy; size: 14, cp.vh; cursor: pointer; label: "Scroll Bar settings" }
            on press br_bar_hit { cp_sc_br_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - br.th / 2) / max(1, cp.vh - br.th) * br.max_s, 0, br.max_s) }
            on drag  br_bar_hit { cp_sc_br_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - br.th / 2) / max(1, cp.vh - br.th) * br.max_s, 0, br.max_s) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 3 · FONT (with specimen strip + scrollable model list)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 3
            CpCard(250, 174, 570, 96)
            text "IN USE" { at: 266, 192; anchor: left center; size: 10; weight: 700; color: faint; family: "Space Grotesk" }
            text font_family { at: 266, 212; anchor: left center; size: 15.5; weight: 600; color: ink; width: 204; lines: 1; family: "Space Grotesk" }
            text "SELECTED" { at: 484, 192; anchor: left center; size: 10; weight: 700; color: faint; family: "Space Grotesk" }
            text font_choice { at: 484, 212; anchor: left center; size: 15.5; weight: 700; color: cp.mint; width: 238; lines: 1; family: "Space Grotesk" }
            CpPill(734, 194, 72, 28, 1, cp_font_apply.hover, cp.mint, ink)
            text "Save" { at: 770, 208; anchor: center; size: 13.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box cp_font_apply { from: 734, 194; size: 72, 28; corner: 14; cursor: pointer; label: "Save font choice" }
            on press cp_font_apply { emit ui_sound; emit font_apply }

            text "Aa Bb Cc 0123456789 · 中文字体预览" { at: 266, 240; anchor: left center; size: 13; color: faint; opacity: 82%; width: 350; lines: 1; family: "Noto Sans CJK SC" }
            text font_status { at: 804, 240; anchor: right center; size: 11; weight: 600; color: cp.mint; width: 190; lines: 1; align: right; family: "Space Grotesk" }

            //  Filter search bar (recessed smoked-crystal well).
            GlassWell(250, 280, 570, 38, 12)
            ellipse { at: 270, 298; radius: 6; stroke: 1.5; color: faint }
            line { from: 274.5, 302.5; to: 279, 307; width: 1.5; color: faint }
            input font_query { at: 290, 290; width: 512; size: 15; color: ink; family: "Space Grotesk"; placeholder: "Search installed fonts…" }

            column font_list {
                at: 250, 330
                view: 552, 420
                step: 48
                gap: 6
                content: font_rows.count * 48
                for r in font_rows { FontRow(r, pick: font_pick) }
            }
            let fl_max = max(1, font_list.content - font_list.height)
            let fl_th = max(40, 420 * min(1, 420 / max(1, font_list.content)))
            box { from: 814, 330; size: 4, 420; corner: 2; color: ink; opacity: 8%; show: font_list.content > font_list.height }
            box { from: 814, 330 + (420 - fl_th) * clamp(font_list.scroll / fl_max, 0, 1); size: 4, fl_th; corner: 2; color: cp.mint; opacity: 55%; show: font_list.content > font_list.height }

            text "No fonts match." { at: 266, 360; anchor: left center; size: 15; color: faint; show: font_rows.count < 1; family: "Space Grotesk" }
            text "Save writes config.json; restart pleamar-shell.service to apply." { at: 266, 770; anchor: left center; size: 12; color: faint; opacity: 72%; width: 540; lines: 1; family: "Space Grotesk" }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 4 · WALLPAPER (liquid.wgsl 3D tilt + true Random + dir path)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 4

            //  Header bar: folder path, count, true Random die button, Refresh.
            CpCard(250, 174, 570, 52)
            text wallpaper_dir { at: 266, 192; anchor: left center; size: 12.5; weight: 600; color: faint; width: 320; lines: 1; family: "Space Grotesk" }
            text wall_count { at: 266, 210; anchor: left center; size: 12; weight: 600; color: cp.mint; width: 300; lines: 1; family: "Space Grotesk" }

            //  Random button with rotating 3-pip die badge.
            CpPill(584, 186, 108, 28, 1, wp_random_pick.hover, cp.mint, ink)
            group {
                pivot: 602, 200
                rotate: cp_die_rot * 1deg
                box { at: 602, 200; size: 12, 12; corner: 3; stroke: 1.4; color: cp.mint }
                ellipse { at: 599, 197; radius: 1.1; color: cp.mint }
                ellipse { at: 602, 200; radius: 1.1; color: cp.mint }
                ellipse { at: 605, 203; radius: 1.1; color: cp.mint }
            }
            text "Random" { at: 648, 200; anchor: center; size: 12.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box wp_random_pick { from: 584, 186; size: 108, 28; corner: 14; cursor: pointer; label: "Apply random wallpaper" }
            on press wp_random_pick { emit ui_sound; cp_die_n = cp_die_n + 1; emit wall_random }

            CpPill(700, 186, 104, 28, 0, wp_refresh.hover, cp.mint, ink)
            text "Refresh" { at: 752, 200; anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk" }
            zone box wp_refresh { from: 700, 186; size: 104, 28; corner: 14; cursor: pointer; label: "Rescan wallpaper folder" }
            on press wp_refresh { emit ui_sound; emit wall_refresh }

            //  3×3 thumbnail gallery wrapped in liquid.wgsl 3D tilt + spotlight + sweep.
            repeat k in 0..9 {
                let col = mod(k, 3)
                let row = floor(k / 3)
                let wx = 250 + col * 194
                let wy = 238 + row * 124
                let wcx = wx + 90
                let wcy = wy + 57
                let relx = clamp((pointer.x - cp.sx - wcx) / 180, -0.5, 0.5)
                let rely = clamp((pointer.y - notch_clock_h - wcy) / 114, -0.5, 0.5)
                group {
                    show: k < wp_rows.count
                    group {
                        shader: cp_liquid, wp_row.$k.hover, if(motion.reduced, 0, 12), wp_row.$k.hover * cp_wp_sw.$k, relx, rely, 0, 0, 0
                        box { from: wx, wy; size: 180, 114; corner: 12; color: #ffffff; opacity: 5% + 6% * wp_row.$k.hover }
                        group {
                            opacity: if(wp_rows.$k.cur, 100%, 88% + 12% * wp_row.$k.hover)
                            clip box { from: wx + 5, wy + 4; size: 170, 96; corner: 9 }
                            image wp_rows.$k.thumb { at: wx + 5, wy + 4; size: 170, 96; fit: cover }
                        }
                        box { from: wx, wy; size: 180, 114; corner: 12; stroke: if(wp_rows.$k.cur, 1.8, 1); color: if(wp_rows.$k.cur, cp.mint, #ffffff); opacity: if(wp_rows.$k.cur, 95%, 18% + 32% * wp_row.$k.hover) }
                        box { at: wx + 162, wy + 16; size: 18, 18; corner: 9; color: cp.mint; show: wp_rows.$k.cur }
                        path { at: wx + 162, wy + 16; stroke: 1.8; color: #051116; move -3.5, 0.5; line -1, 3; line 4, -2.5; show: wp_rows.$k.cur }
                        text wp_rows.$k.name { at: wcx, wy + 105; anchor: center; size: 10.5; weight: 600; color: if(wp_rows.$k.cur, cp.mint, faint); width: 164; lines: 1; family: "Space Grotesk" }
                    }
                    zone box wp_row.$k { from: wx, wy; size: 180, 114; corner: 12; cursor: pointer; label: wp_rows.$k.name }
                    on enter wp_row.$k { cp_wp_sw.$k: 0 ~10ms; cp_wp_sw.$k: 1 after 10ms }
                    on press wp_row.$k { emit ui_sound; wall_choice = wp_rows.$k.path; emit wall_apply }
                }
            }
            text "No wallpapers found." { at: 266, 266; anchor: left center; size: 15; color: faint; show: wp_rows.count < 1; family: "Space Grotesk" }

            //  Pagination + Auto rotation + Transition picker.
            CpPill(250, 616, 76, 26, if(wp_page > 0, 1, 0), wp_prev.hover, cp.mint, ink)
            text "Prev" { at: 288, 629; anchor: center; size: 11.5; weight: 700; color: if(wp_page > 0, ink, faint); family: "Space Grotesk" }
            zone box wp_prev { from: 250, 616; size: 76, 26; corner: 13; cursor: pointer; active: wp_page > 0; label: "Previous page" }
            on press wp_prev { emit ui_sound; wp_page = max(0, wp_page - 1) }

            text number(wp_page + 1, 0, "") { at: 525, 629; anchor: right center; size: 12; weight: 700; color: cp.mint; family: "Space Grotesk" }
            text "/" { at: 533, 629; anchor: center; size: 12; color: faint; family: "Space Grotesk" }
            text number(max(1, wp_pages), 0, "") { at: 541, 629; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }

            CpPill(744, 616, 76, 26, if(wp_page + 1 < wp_pages, 1, 0), wp_next.hover, cp.mint, ink)
            text "Next" { at: 782, 629; anchor: center; size: 11.5; weight: 700; color: if(wp_page + 1 < wp_pages, ink, faint); family: "Space Grotesk" }
            zone box wp_next { from: 744, 616; size: 76, 26; corner: 13; cursor: pointer; active: wp_page + 1 < wp_pages; label: "Next page" }
            on press wp_next { emit ui_sound; wp_page = min(wp_pages - 1, wp_page + 1) }

            let y_w0 = 650
            let h_w0 = max(wp_auto_switch.hover, wp_auto_switch.pressed)
            CpCard(250, y_w0, 570, 44)
            text "Auto rotate" { at: 266, y_w0 + 22; anchor: left center; size: 14.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_wp_auto }
            CpLeader(266 + m_wp_auto.width + 10, 650, y_w0 + 22, h_w0)
            text wall_next { at: 742, y_w0 + 22; anchor: right center; size: 11.5; color: faint; width: 140; lines: 1; align: right; family: "Space Grotesk" }
            CpSwitch(756, y_w0 + 10, 48, 24, if(wall_auto, 1, 0), wall_knob, wp_auto_switch.hover, wp_auto_switch.pressed, cp.mint, ink, cp.track)
            zone box wp_auto_switch { from: 750, y_w0 + 6; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle auto wallpaper rotation" }
            on press wp_auto_switch { emit ui_sound; toggle wall_auto }

            let y_w1 = 700
            let d_wa = if(wall_auto, 0, 1)
            group {
                opacity: if(wall_auto, 1, 0.45)
                let h_w1 = max(wp_min_track.hover, wp_min_track.pressed)
                CpCard(250, y_w1, 570, 44)
                text "Every" { at: 266, y_w1 + 22; anchor: left center; size: 14.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_wp_min }
                CpLeader(266 + m_wp_min.width + 10, cp.sl_x - 10, y_w1 + 22, h_w1, d_wa)
                CpSlider(cp.sl_x, y_w1 + 22, cp.sl_w, wp.min_pct, h_w1, cp.mint, d_wa)
                text number(wall_minutes, 0, " m") { at: cp.rx, y_w1 + 22; anchor: right center; size: 14; weight: 700; color: cp.mint; family: "Space Grotesk" }
                zone box wp_min_track { from: cp.sl_x - 6, y_w1 + 10; size: cp.sl_w + 12, 24; cursor: pointer; active: wall_auto; label: "Rotation interval" }
                on press wp_min_track { wall_minutes = round(clamp(1 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 59, 1, 60)) }
                on drag  wp_min_track { wall_minutes = round(clamp(1 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 59, 1, 60)) }
            }

            let y_w2 = 750
            let h_wt = max(wp_trans_prev.hover, wp_trans_next.hover)
            CpCard(250, y_w2, 570, 44)
            text "Transition" { at: 266, y_w2 + 22; anchor: left center; size: 14.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_wp_tr }
            CpLeader(266 + m_wp_tr.width + 10, 560, y_w2 + 22, h_wt)
            CpPill(572, y_w2 + 9, 28, 26, 0, wp_trans_prev.hover, cp.mint, ink)
            text "‹" { at: 586, y_w2 + 22; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
            zone box wp_trans_prev { from: 572, y_w2 + 9; size: 28, 26; corner: 13; cursor: pointer; label: "Previous transition" }
            on press wp_trans_prev { emit ui_sound; wall_transition = mod(wall_transition - 1 + wall_transition_count, wall_transition_count) }
            text wall_transition_name { at: 688, y_w2 + 22; anchor: center; size: 13; weight: 700; color: cp.mint; width: 164; lines: 1; align: center; family: "Space Grotesk" }
            CpPill(776, y_w2 + 9, 28, 26, 0, wp_trans_next.hover, cp.mint, ink)
            text "›" { at: 790, y_w2 + 22; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
            zone box wp_trans_next { from: 776, y_w2 + 9; size: 28, 26; corner: 13; cursor: pointer; label: "Next transition" }
            on press wp_trans_next { emit ui_sound; wall_transition = mod(wall_transition + 1, wall_transition_count) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 5 · NOTIFICATIONS
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 5
            text "BANNER & SOUND" { at: 250, 178; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

            //  5.1 Position (dimmed while Floating pill / drift is active)
            let d_pos = if(nt_drift, 1, 0)
            group {
                opacity: if(nt_drift, 0.42, 1)
                let y0 = 194
                let h0 = max(nt_pos_center.hover, nt_pos_right.hover)
                CpCard(250, y0, 570, 62)
                text "Toast position" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_pos }
                CpLeader(266 + m_nt_pos.width + 10, 578, y0 + 20, h0, d_pos)
                text "Merged into the top glass bar (center or top-right) when Drift is off." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpSetPick(588, y0 + 20, 216, 28, 2, nt_pos, h0, cp.mint, d_pos)
                text "Top center" { at: 642, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(nt_pos == 0, cp.mint, faint); family: "Space Grotesk" }
                text "Top right"  { at: 750, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(nt_pos == 1, cp.mint, faint); family: "Space Grotesk" }
                zone box nt_pos_center { from: 588, y0 + 6; size: 108, 28; corner: 14; cursor: pointer; active: not nt_drift; label: "Top center" }
                zone box nt_pos_right  { from: 696, y0 + 6; size: 108, 28; corner: 14; cursor: pointer; active: not nt_drift; label: "Top right" }
                on press nt_pos_center { emit ui_sound; nt_pos = 0 }
                on press nt_pos_right  { emit ui_sound; nt_pos = 1 }
            }

            //  5.2 Floating pill / drift
            let y1 = 262
            let h1 = max(nt_drift_switch.hover, nt_drift_switch.pressed)
            CpCard(250, y1, 570, 62)
            text "Floating pill" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_drift }
            CpLeader(266 + m_nt_drift.width + 10, 746, y1 + 20, h1)
            text "Drift alerts round the notch edges instead of locking to top." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpSwitch(756, y1 + 8, 48, 24, if(nt_drift, 1, 0), nt_drift_knob, nt_drift_switch.hover, nt_drift_switch.pressed, cp.mint, ink, cp.track)
            zone box nt_drift_switch { from: 750, y1 + 4; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle floating toast" }
            on press nt_drift_switch { emit ui_sound; emit nt_drift_toggle }

            //  5.3 Alert sound switch
            let y2 = 330
            let h2 = max(nt_snd_switch.hover, nt_snd_switch.pressed)
            CpCard(250, y2, 570, 62)
            text "Alert sound" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_snd }
            CpLeader(266 + m_nt_snd.width + 10, 746, y2 + 20, h2)
            text "Chime when a new toast arrives (muted during DND)." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpSwitch(756, y2 + 8, 48, 24, if(nt_snd_on, 1, 0), nt_snd_knob, nt_snd_switch.hover, nt_snd_switch.pressed, cp.mint, ink, cp.track)
            zone box nt_snd_switch { from: 750, y2 + 4; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle notification sound" }
            on press nt_snd_switch { emit ui_sound; emit nt_sound_toggle }

            //  5.4 Sound tune stepper (dimmed if sound off)
            let d_ns = if(nt_snd_on, 0, 1)
            group {
                opacity: if(nt_snd_on, 1, 0.42)
                let y3 = 398
                let h3 = max(nt_snd_prev.hover, nt_snd_next.hover)
                CpCard(250, y3, 570, 62)
                text "Default chime" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_tune }
                CpLeader(266 + m_nt_tune.width + 10, 566, y3 + 20, h3, d_ns)
                text "Previewed whenever stepped left or right." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                CpPill(576, y3 + 7, 28, 26, 0, nt_snd_prev.hover, cp.mint, ink)
                text "‹" { at: 590, y3 + 20; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
                zone box nt_snd_prev { from: 576, y3 + 7; size: 28, 26; corner: 13; cursor: pointer; active: nt_snd_on; label: "Previous sound" }
                on press nt_snd_prev { emit nt_sound_set(-1) }
                text nt_sound_name { at: 690, y3 + 20; anchor: center; size: 13.5; weight: 700; color: cp.mint; width: 158; lines: 1; align: center; family: "Space Grotesk" }
                CpPill(776, y3 + 7, 28, 26, 0, nt_snd_next.hover, cp.mint, ink)
                text "›" { at: 790, y3 + 20; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
                zone box nt_snd_next { from: 776, y3 + 7; size: 28, 26; corner: 13; cursor: pointer; active: nt_snd_on; label: "Next sound" }
                on press nt_snd_next { emit nt_sound_set(1) }
            }

            //  5.5 Countdown seconds
            let y4 = 466
            let h4 = max(nt_secs_minus.hover, nt_secs_plus.hover)
            CpCard(250, y4, 570, 62)
            text "Toast duration" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_time }
            CpLeader(266 + m_nt_time.width + 10, 620, y4 + 20, h4)
            text "Auto-dismiss countdown on non-urgent notifications." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpPill(630, y4 + 7, 28, 26, 0, nt_secs_minus.hover, cp.mint, ink)
            text "−" { at: 644, y4 + 20; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
            zone box nt_secs_minus { from: 630, y4 + 7; size: 28, 26; corner: 13; cursor: pointer; label: "Fewer seconds" }
            on press nt_secs_minus { emit ui_sound; nt_secs = clamp(nt_secs - 1, 2, 60) }
            text number(nt_secs, 0, " s") { at: 717, y4 + 20; anchor: center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
            CpPill(776, y4 + 7, 28, 26, 0, nt_secs_plus.hover, cp.mint, ink)
            text "+" { at: 790, y4 + 20; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
            zone box nt_secs_plus { from: 776, y4 + 7; size: 28, 26; corner: 13; cursor: pointer; label: "More seconds" }
            on press nt_secs_plus { emit ui_sound; nt_secs = clamp(nt_secs + 1, 2, 60) }

            //  5.6 DND + Test / History actions
            let y5 = 534
            let h5 = max(nt_dnd_switch.hover, nt_dnd_switch.pressed)
            CpCard(250, y5, 570, 62)
            text "Do not disturb" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_nt_dnd }
            CpLeader(266 + m_nt_dnd.width + 10, 746, y5 + 20, h5)
            text "Hold normal banners silently in the Notification Center." { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            CpSwitch(756, y5 + 8, 48, 24, if(nt_dnd, 1, 0), nt_dnd_knob, nt_dnd_switch.hover, nt_dnd_switch.pressed, cp.mint, ink, cp.track)
            zone box nt_dnd_switch { from: 750, y5 + 4; size: 60, 32; corner: 16; cursor: pointer; label: "Toggle do not disturb" }
            on press nt_dnd_switch { emit ui_sound; emit nt_dnd_toggle }

            CpPill(250, 616, 152, 34, 1, nt_test_btn.hover, cp.mint, ink)
            text "Send test toast" { at: 326, 633; anchor: center; size: 12.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box nt_test_btn { from: 250, 616; size: 152, 34; corner: 17; cursor: pointer; label: "Send test notification" }
            on press nt_test_btn { emit ui_sound; emit nt_test }

            CpPill(414, 616, 152, 34, 0, nt_center_btn.hover, cp.mint, ink)
            text "Open history ›" { at: 490, 633; anchor: center; size: 12.5; weight: 700; color: ink; family: "Space Grotesk" }
            zone box nt_center_btn { from: 414, 616; size: 152, 34; corner: 17; cursor: pointer; label: "Open notification history" }
            on press nt_center_btn { emit ui_sound; nt_center = true; panel_open = false }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 6 · MOTION (scrollable + wave dependency dimming + 2×6 matrix)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 6
            let mo.h = 668
            let mo.max_s = max(1, mo.h - cp.vh)
            let mo.sc = clamp(cp_sc_mo, 0, mo.max_s)
            let mo.off = floor(mo.sc + 0.5)
            let mo.cue = clamp((mo.max_s - mo.sc) / 28, 0, 1) * clamp(1 - mo.sc / 18, 0, 1)
            let mo.th = max(44, cp.vh * min(1, cp.vh / mo.h))

            group {
                clip box { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                zone box cp_mo_wheel { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                on scroll cp_mo_wheel { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }

                group {
                    move: 0, -mo.off
                    text "DRAWERS & FRAME" { at: 250, 184; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    let y0 = 200
                    let h0 = max(cp_motion_track.hover, cp_motion_track.pressed)
                    CpCard(250, y0, 570, 62)
                    text "Motion strength" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_str }
                    CpLeader(266 + m_mo_str.width + 10, cp.sl_x - 10, y0 + 20, h0)
                    text "Bell curve, neck pull and landing spring amplitude." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y0 + 20, cp.sl_w, cp.motion_pct, h0, cp.mint)
                    text number(drawer_motion, 0, "%") { at: cp.rx, y0 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_motion_track { from: cp.sl_x - 6, y0 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y0 + 20) - mo.off > 176 and (y0 + 20) - mo.off < 784; label: "Motion strength" }
                    on scroll cp_motion_track { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on press cp_motion_track { drawer_motion = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                    on drag  cp_motion_track { drawer_motion = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }

                    let y1 = 268
                    let h1 = max(cp_neck_track.hover, cp_neck_track.pressed)
                    CpCard(250, y1, 570, 62)
                    text "Liquid neck" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_neck }
                    CpLeader(266 + m_mo_neck.width + 10, cp.sl_x - 10, y1 + 20, h1)
                    text "How tightly the drawer narrows into the top bar." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y1 + 20, cp.sl_w, cp.neck_pct, h1, cp.mint)
                    text number(drawer_neck, 0, "%") { at: cp.rx, y1 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_neck_track { from: cp.sl_x - 6, y1 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y1 + 20) - mo.off > 176 and (y1 + 20) - mo.off < 784; label: "Liquid neck" }
                    on scroll cp_neck_track { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on press cp_neck_track { drawer_neck = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                    on drag  cp_neck_track { drawer_neck = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }

                    let y2 = 336
                    let h2 = max(cp_pop_track.hover, cp_pop_track.pressed)
                    CpCard(250, y2, 570, 62)
                    text "Centre pop" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_pop }
                    CpLeader(266 + m_mo_pop.width + 10, cp.sl_x - 10, y2 + 20, h2)
                    text "How far drawer content scales up from the middle." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y2 + 20, cp.sl_w, cp.pop_pct, h2, cp.mint)
                    text number(drawer_pop, 0, "%") { at: cp.rx, y2 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_pop_track { from: cp.sl_x - 6, y2 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: (y2 + 20) - mo.off > 176 and (y2 + 20) - mo.off < 784; label: "Centre pop" }
                    on scroll cp_pop_track { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on press cp_pop_track { drawer_pop = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                    on drag  cp_pop_track { drawer_pop = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }

                    let y3 = 404
                    let h3 = max(cp_wave_switch.hover, cp_wave_switch.pressed)
                    CpCard(250, y3, 570, 62)
                    text "Frame wave" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_wave }
                    CpLeader(266 + m_mo_wave.width + 10, 746, y3 + 20, h3)
                    text "Bend the frame and drawer rim during motion; sleeps when idle." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, y3 + 8, 48, 24, if(frame_wave_on, 1, 0), frame_wave_knob, cp_wave_switch.hover, cp_wave_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_wave_switch { from: 750, y3 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y3 + 20) - mo.off > 176 and (y3 + 20) - mo.off < 784; label: "Toggle frame wave" }
                    on scroll cp_wave_switch { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on press cp_wave_switch { emit ui_sound; toggle frame_wave_on }

                    let d_fw = if(frame_wave_on, 0, 1)
                    group {
                        opacity: if(frame_wave_on, 1, 0.42)
                        let y4 = 472
                        let h4 = max(cp_wave_track.hover, cp_wave_track.pressed)
                        CpCard(250, y4, 570, 62)
                        text "Wave strength" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_wstr }
                        CpLeader(266 + m_mo_wstr.width + 10, cp.sl_x - 10, y4 + 20, h4, d_fw)
                        text "Displacement along the monitor edges and drawer rim." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y4 + 20, cp.sl_w, cp.wave_pct, h4, cp.mint, d_fw)
                        text number(frame_wave_strength, 0, "%") { at: cp.rx, y4 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wave_track { from: cp.sl_x - 6, y4 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: frame_wave_on and (y4 + 20) - mo.off > 176 and (y4 + 20) - mo.off < 784; label: "Wave strength" }
                        on scroll cp_wave_track { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                        on press cp_wave_track { frame_wave_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                        on drag  cp_wave_track { frame_wave_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }

                        let y5 = 540
                        let h5 = max(cp_wave_speed_track.hover, cp_wave_speed_track.pressed)
                        CpCard(250, y5, 570, 62)
                        text "Wave speed" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_mo_wspd }
                        CpLeader(266 + m_mo_wspd.width + 10, cp.sl_x - 10, y5 + 20, h5, d_fw)
                        text "How quickly the border wave travels." { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y5 + 20, cp.sl_w, cp.wave_speed_pct, h5, cp.mint, d_fw)
                        text number(frame_wave_speed, 0, "%") { at: cp.rx, y5 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wave_speed_track { from: cp.sl_x - 6, y5 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: frame_wave_on and (y5 + 20) - mo.off > 176 and (y5 + 20) - mo.off < 784; label: "Wave speed" }
                        on scroll cp_wave_speed_track { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                        on press cp_wave_speed_track { frame_wave_speed = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                        on drag  cp_wave_speed_track { frame_wave_speed = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                    }

                    text "NOTIFICATION EFFECTS" { at: 250, 622; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    repeat r in 0..2 {
                        let ry = 638 + r * 86
                        let chosen = pick(r, anim_toast, anim_center)
                        CpCard(250, ry, 570, 76)
                        text if(r == 0, "Toast banner", "Notification Center") { at: 266, ry + 18; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk" }
                        text "Random picks a fresh pose every opening." { at: 804, ry + 18; anchor: right center; size: 11; color: faint; opacity: 78%; show: chosen == 0; family: "Space Grotesk" }
                        CpSetPick(266, ry + 50, 538, 28, 6, chosen, 0, cp.mint)
                        repeat k in 0..6 {
                            let sx = 266 + k * (538 / 6) + (538 / 12)
                            text pick(k, "Random", "Slide", "Expand", "Rise", "Split", "Pop") {
                                at: sx, ry + 50; anchor: center; size: 11.5; weight: 700; color: if(chosen == k, cp.mint, faint); family: "Space Grotesk"
                            }
                        }
                    }
                    zone box cp_motion_0_0 { from: 266, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Random" }
                    zone box cp_motion_0_1 { from: 355.6, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Slide" }
                    zone box cp_motion_0_2 { from: 445.2, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Expand" }
                    zone box cp_motion_0_3 { from: 534.8, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Rise" }
                    zone box cp_motion_0_4 { from: 624.4, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Split" }
                    zone box cp_motion_0_5 { from: 714.0, 674; size: 89.6, 28; cursor: pointer; active: (688 - mo.off) > 176 and (688 - mo.off) < 784; label: "Toast Pop" }
                    zone box cp_motion_1_0 { from: 266, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Random" }
                    zone box cp_motion_1_1 { from: 355.6, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Slide" }
                    zone box cp_motion_1_2 { from: 445.2, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Expand" }
                    zone box cp_motion_1_3 { from: 534.8, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Rise" }
                    zone box cp_motion_1_4 { from: 624.4, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Split" }
                    zone box cp_motion_1_5 { from: 714.0, 760; size: 89.6, 28; cursor: pointer; active: (774 - mo.off) > 176 and (774 - mo.off) < 784; label: "Center Pop" }
                    on scroll cp_motion_0_0 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_0_1 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_0_2 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_0_3 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_0_4 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_0_5 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_0 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_1 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_2 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_3 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_4 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on scroll cp_motion_1_5 { cp_sc_mo_to = clamp(cp_sc_mo_to - wheel * 48, 0, mo.max_s) }
                    on press cp_motion_0_0 { emit ui_sound; emit anim_set(0) }
                    on press cp_motion_0_1 { emit ui_sound; emit anim_set(1) }
                    on press cp_motion_0_2 { emit ui_sound; emit anim_set(2) }
                    on press cp_motion_0_3 { emit ui_sound; emit anim_set(3) }
                    on press cp_motion_0_4 { emit ui_sound; emit anim_set(4) }
                    on press cp_motion_0_5 { emit ui_sound; emit anim_set(5) }
                    on press cp_motion_1_0 { emit ui_sound; emit anim_set(6) }
                    on press cp_motion_1_1 { emit ui_sound; emit anim_set(7) }
                    on press cp_motion_1_2 { emit ui_sound; emit anim_set(8) }
                    on press cp_motion_1_3 { emit ui_sound; emit anim_set(9) }
                    on press cp_motion_1_4 { emit ui_sound; emit anim_set(10) }
                    on press cp_motion_1_5 { emit ui_sound; emit anim_set(11) }
                }

                let mo.cuey = 762 + 2 * sin(cp_clk * 240)
                CpMoreCue(mo.cue, mo.cuey, mo_cue_hit.hover)
                zone box mo_cue_hit { at: 535, 762; size: 84, 28; corner: 14; cursor: pointer; active: mo.cue > 0.4; label: "Scroll down" }
                on press mo_cue_hit { emit ui_sound; cp_sc_mo_to = clamp(cp_sc_mo_to + 320, 0, mo.max_s) }
            }

            box { from: 829, cp.vy; size: 4, cp.vh; corner: 2; color: ink; opacity: 8% }
            box { from: 829, cp.vy + (cp.vh - mo.th) * clamp(mo.sc / mo.max_s, 0, 1); size: 4, mo.th; corner: 2; color: cp.mint; opacity: 45% + 40% * mo_bar_hit.hover }
            zone box mo_bar_hit { from: 824, cp.vy; size: 14, cp.vh; cursor: pointer; label: "Scroll Motion settings" }
            on press mo_bar_hit { cp_sc_mo_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - mo.th / 2) / max(1, cp.vh - mo.th) * mo.max_s, 0, mo.max_s) }
            on drag  mo_bar_hit { cp_sc_mo_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - mo.th / 2) / max(1, cp.vh - mo.th) * mo.max_s, 0, mo.max_s) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 7 · LOCK SCREEN (Example lockbar preview + CpSetPick + scroll)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 7
            let lk.h = 740
            let lk.max_s = max(1, lk.h - cp.vh)
            let lk.sc = clamp(cp_sc_lk, 0, lk.max_s)
            let lk.off = floor(lk.sc + 0.5)
            let lk.cue = clamp((lk.max_s - lk.sc) / 28, 0, 1) * clamp(1 - lk.sc / 18, 0, 1)
            let lk.th = max(44, cp.vh * min(1, cp.vh / lk.h))

            group {
                clip box { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                zone box cp_lk_wheel { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                on scroll cp_lk_wheel { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }

                group {
                    move: 0, -lk.off

                    //  7.0 Interactive Example Lock Bar card
                    CpCard(250, 176, 570, 108)
                    text "EXAMPLE LOCK BAR" { at: 266, 194; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                    CpPill(614, 182, 92, 26, 0, cp_lk_test.hover, cp.mint, ink)
                    text "Test lock" { at: 660, 195; anchor: center; size: 11.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_lk_test { from: 614, 182; size: 92, 26; corner: 13; cursor: pointer; active: 195 - lk.off > 176 and 195 - lk.off < 784; label: "Open safe test lock" }
                    on scroll cp_lk_test { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_test { emit ui_sound; emit lock_test }

                    CpPill(714, 182, 90, 26, 1, cp_lk_now.hover, cp.mint, ink)
                    text "Lock now" { at: 759, 195; anchor: center; size: 11.5; weight: 700; color: ink; family: "Space Grotesk" }
                    zone box cp_lk_now { from: 714, 182; size: 90, 26; corner: 13; cursor: pointer; active: 195 - lk.off > 176 and 195 - lk.off < 784; label: "Lock screen now" }
                    on scroll cp_lk_now { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_now { emit ui_sound; emit lock_now }

                    //  Simulated glass password pill + real SVG shape / dot / star / symbol mask.
                    GlassWell(266, 218, 538, 42, 21, max(cp_lb_hit.hover, if(lb_ok, 1, 0)))
                    box { from: 266, 218; size: 538, 42; corner: 21; stroke: 1.5; color: #10b981; opacity: 88%; show: lb_ok }
                    text if(lb_ok, "Preview submitted ✓", "Type here to preview mask · Enter to test") {
                        at: 286, 239; anchor: left center; size: 13; weight: if(lb_ok, 700, 500)
                        color: if(lb_ok, #10b981, faint); opacity: if(lb_ok, 100%, 72%)
                        show: lb_glyphs.count == 0
                        family: "Space Grotesk"
                    }
                    input lb_pw { at: 284, 229; width: 496; size: 15; color: ink; opacity: 0; secret: true; family: "Space Grotesk" }
                    on submit lb_pw { emit ui_sound; emit lb_submit }
                    zone box cp_lb_hit { from: 266, 218; size: 538, 42; corner: 21; cursor: text; active: 239 - lk.off > 176 and 239 - lk.off < 784; label: "Example password input" }
                    on scroll cp_lb_hit { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lb_hit { focus lb_pw }

                    //  Render up to 18 glyphs typed into `lb_pw` using chosen `lock_mask` & `lock_pal`.
                    group {
                        show: lb_glyphs.count > 0
                        for g in lb_glyphs {
                            let gx = 294 + g.index * 24
                            let gy = 239
                            let gc5 = mod(g.ci, 5)
                            let gc4 = mod(g.ci, 4)
                            let gv = mix(mix(mix(mix(#00f0ff, #7000ff, if(gc5 == 1, 1, 0)), #ff0055, if(gc5 == 2, 1, 0)), #00ff66, if(gc5 == 3, 1, 0)), #ffcc00, if(gc5 == 4, 1, 0))
                            let gn = mix(mix(mix(#ff0055, #00ffff, if(gc4 == 1, 1, 0)), #ffff00, if(gc4 == 2, 1, 0)), #ff00ff, if(gc4 == 3, 1, 0))
                            let gp = mix(mix(mix(#c4b5fd, #93c5fd, if(gc4 == 1, 1, 0)), #fbcfe8, if(gc4 == 2, 1, 0)), #fed7aa, if(gc4 == 3, 1, 0))
                            let gcol = mix(mix(mix(mix(gv, cp.mint, if(lock_pal == 1, 1, 0)), gn, if(lock_pal == 2, 1, 0)), gp, if(lock_pal == 3, 1, 0)), #ffffff, if(lock_pal == 4, 1, 0))

                            //  Mode 0: SVG geometric shapes (solid or outlined).
                            figure lkshp.s0  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 0  and not g.outline }
                            figure lkshp.s0  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 0  and g.outline }
                            figure lkshp.s1  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 1  and not g.outline }
                            figure lkshp.s1  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 1  and g.outline }
                            figure lkshp.s2  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 2  and not g.outline }
                            figure lkshp.s2  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 2  and g.outline }
                            figure lkshp.s3  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 3  and not g.outline }
                            figure lkshp.s3  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 3  and g.outline }
                            figure lkshp.s4  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 4  and not g.outline }
                            figure lkshp.s4  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 4  and g.outline }
                            figure lkshp.s5  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 5  and not g.outline }
                            figure lkshp.s5  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 5  and g.outline }
                            figure lkshp.s6  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 6  and not g.outline }
                            figure lkshp.s6  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 6  and g.outline }
                            figure lkshp.s7  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 7  and not g.outline }
                            figure lkshp.s7  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 7  and g.outline }
                            figure lkshp.s8  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 8  and not g.outline }
                            figure lkshp.s8  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 8  and g.outline }
                            figure lkshp.s9  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 9  and not g.outline }
                            figure lkshp.s9  { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 9  and g.outline }
                            figure lkshp.s10 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 10 and not g.outline }
                            figure lkshp.s10 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 10 and g.outline }
                            figure lkshp.s11 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 11 and not g.outline }
                            figure lkshp.s11 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 11 and g.outline }
                            figure lkshp.s12 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 12 and not g.outline }
                            figure lkshp.s12 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 12 and g.outline }
                            figure lkshp.s13 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 13 and not g.outline }
                            figure lkshp.s13 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 13 and g.outline }
                            figure lkshp.s14 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 14 and not g.outline }
                            figure lkshp.s14 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 14 and g.outline }
                            figure lkshp.s15 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; show: lock_mask == 0 and g.idx == 15 and not g.outline }
                            figure lkshp.s15 { at: gx, gy; size: 18, 18; rotate: g.rot * 1deg; color: gcol; stroke: 2.2; show: lock_mask == 0 and g.idx == 15 and g.outline }

                            //  Mode 1: Dots · Mode 2: Stars · Mode 3: Special symbols.
                            ellipse { at: gx, gy; radius: 5; color: gcol; show: lock_mask == 1 }
                            text "✦"   { at: gx, gy; anchor: center; size: 16; weight: 700; color: gcol; show: lock_mask == 2 }
                            text g.sym { at: gx, gy; anchor: center; size: 15; weight: 700; color: gcol; show: lock_mask == 3; family: "Space Grotesk" }
                        }
                    }

                    text "LOCK APPEARANCE" { at: 250, 304; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  7.1 Blur slider + fine stepper
                    let y0 = 320
                    let h0 = max(cp_lk_blur.hover, cp_lk_blur.pressed)
                    CpCard(250, y0, 570, 62)
                    text "Backdrop blur" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_blur }
                    CpLeader(266 + m_lk_blur.width + 10, cp.sl_x - 10, y0 + 20, h0)
                    text "Blur radius over the lock-screen wallpaper." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y0 + 20, 152, clamp(lock_blur / 120, 0, 1), h0, cp.mint)
                    text number(lock_blur, 0, " px") { at: 734, y0 + 20; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    CpPill(746, y0 + 8, 26, 24, 0, cp_lk_blur_minus.hover, cp.mint, ink)
                    text "−" { at: 759, y0 + 20; anchor: center; size: 14; weight: 700; color: ink }
                    CpPill(778, y0 + 8, 26, 24, 0, cp_lk_blur_plus.hover, cp.mint, ink)
                    text "+" { at: 791, y0 + 20; anchor: center; size: 14; weight: 700; color: ink }
                    zone box cp_lk_blur       { from: cp.sl_x - 6, y0 + 8; size: 164, 24; cursor: pointer; active: (y0 + 20) - lk.off > 176 and (y0 + 20) - lk.off < 784; label: "Lock blur" }
                    zone box cp_lk_blur_minus { from: 746, y0 + 8; size: 26, 24; corner: 12; cursor: pointer; active: (y0 + 20) - lk.off > 176 and (y0 + 20) - lk.off < 784; label: "Decrease blur" }
                    zone box cp_lk_blur_plus  { from: 778, y0 + 8; size: 26, 24; corner: 12; cursor: pointer; active: (y0 + 20) - lk.off > 176 and (y0 + 20) - lk.off < 784; label: "Increase blur" }
                    on scroll cp_lk_blur       { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_blur_minus { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_blur_plus  { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_blur       { lock_blur = clamp(round((pointer.x - cp.sx - cp.sl_x) / 152 * 120), 0, 120) }
                    on drag  cp_lk_blur       { lock_blur = clamp(round((pointer.x - cp.sx - cp.sl_x) / 152 * 120), 0, 120) }
                    on press cp_lk_blur_minus { emit ui_sound; lock_blur = clamp(round(lock_blur) - 1, 0, 120) }
                    on press cp_lk_blur_plus  { emit ui_sound; lock_blur = clamp(round(lock_blur) + 1, 0, 120) }

                    //  7.2 Clock format (12h | 24h)
                    let y1 = 388
                    let h1 = max(cp_lk_12h.hover, cp_lk_24h.hover)
                    CpCard(250, y1, 570, 62)
                    text "Clock format" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_clk }
                    CpLeader(266 + m_lk_clk.width + 10, 626, y1 + 20, h1)
                    text "Lock screen time notation." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(636, y1 + 20, 168, 28, 2, if(lock_12h, 0, 1), h1, cp.mint)
                    text "12 h" { at: 678, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_12h, cp.mint, faint); family: "Space Grotesk" }
                    text "24 h" { at: 762, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(not lock_12h, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_12h { from: 636, y1 + 6; size: 84, 28; corner: 14; cursor: pointer; active: (y1 + 20) - lk.off > 176 and (y1 + 20) - lk.off < 784; label: "12 hour clock" }
                    zone box cp_lk_24h { from: 720, y1 + 6; size: 84, 28; corner: 14; cursor: pointer; active: (y1 + 20) - lk.off > 176 and (y1 + 20) - lk.off < 784; label: "24 hour clock" }
                    on scroll cp_lk_12h { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_24h { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_12h { emit ui_sound; lock_12h = true; lock_ampm = true }
                    on press cp_lk_24h { emit ui_sound; lock_12h = false; lock_ampm = false }

                    //  7.3 Show seconds switch
                    let y2 = 456
                    let h2 = max(cp_lk_secs.hover, cp_lk_secs.pressed)
                    CpCard(250, y2, 570, 62)
                    text "Clock seconds" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_secs }
                    CpLeader(266 + m_lk_secs.width + 10, 746, y2 + 20, h2)
                    text "Render seconds readout beside the big lock clock." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, y2 + 8, 48, 24, if(lock_secs, 1, 0), if(lock_secs, 1, 0), cp_lk_secs.hover, cp_lk_secs.pressed, cp.mint, ink, cp.track)
                    zone box cp_lk_secs { from: 750, y2 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y2 + 20) - lk.off > 176 and (y2 + 20) - lk.off < 784; label: "Toggle lock seconds" }
                    on scroll cp_lk_secs { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_secs { emit ui_sound; lock_secs = not lock_secs }

                    //  7.4 Clock size (100 | 150 | 200)
                    let y3 = 524
                    let sz_idx = if(lock_px < 125, 0, if(lock_px < 175, 1, 2))
                    let h3 = max(cp_lk_px100.hover, max(cp_lk_px150.hover, cp_lk_px200.hover))
                    CpCard(250, y3, 570, 62)
                    text "Clock scale" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_sz }
                    CpLeader(266 + m_lk_sz.width + 10, 560, y3 + 20, h3)
                    text "Glyph height on the lock screen." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(570, y3 + 20, 234, 28, 3, sz_idx, h3, cp.mint)
                    text "Compact" { at: 609, y3 + 20; anchor: center; size: 11.5; weight: 700; color: if(sz_idx == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Medium"  { at: 687, y3 + 20; anchor: center; size: 11.5; weight: 700; color: if(sz_idx == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Large"   { at: 765, y3 + 20; anchor: center; size: 11.5; weight: 700; color: if(sz_idx == 2, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_px100 { from: 570, y3 + 6; size: 78, 28; corner: 14; cursor: pointer; active: (y3 + 20) - lk.off > 176 and (y3 + 20) - lk.off < 784; label: "Compact clock" }
                    zone box cp_lk_px150 { from: 648, y3 + 6; size: 78, 28; corner: 14; cursor: pointer; active: (y3 + 20) - lk.off > 176 and (y3 + 20) - lk.off < 784; label: "Medium clock" }
                    zone box cp_lk_px200 { from: 726, y3 + 6; size: 78, 28; corner: 14; cursor: pointer; active: (y3 + 20) - lk.off > 176 and (y3 + 20) - lk.off < 784; label: "Large clock" }
                    on scroll cp_lk_px100 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_px150 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_px200 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_px100 { emit ui_sound; lock_px = 100 }
                    on press cp_lk_px150 { emit ui_sound; lock_px = 150 }
                    on press cp_lk_px200 { emit ui_sound; lock_px = 200 }

                    //  7.5 Date format
                    let y4 = 592
                    let h4 = max(max(cp_lk_date0.hover, cp_lk_date1.hover), max(cp_lk_date2.hover, cp_lk_date3.hover))
                    CpCard(250, y4, 570, 62)
                    text "Date format" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_date }
                    CpLeader(266 + m_lk_date.width + 10, 504, y4 + 20, h4)
                    text "Date style centered below the clock." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(514, y4 + 20, 290, 28, 4, lock_date, h4, cp.mint)
                    text "Long"    { at: 550.25, y4 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_date == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Short"   { at: 622.75, y4 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_date == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Day-1st" { at: 695.25, y4 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_date == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "ISO"     { at: 767.75, y4 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_date == 3, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_date0 { from: 514,    y4 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y4 + 20) - lk.off > 176 and (y4 + 20) - lk.off < 784; label: "Long date" }
                    zone box cp_lk_date1 { from: 586.5,  y4 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y4 + 20) - lk.off > 176 and (y4 + 20) - lk.off < 784; label: "Short date" }
                    zone box cp_lk_date2 { from: 659,    y4 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y4 + 20) - lk.off > 176 and (y4 + 20) - lk.off < 784; label: "Day first date" }
                    zone box cp_lk_date3 { from: 731.5,  y4 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y4 + 20) - lk.off > 176 and (y4 + 20) - lk.off < 784; label: "ISO date" }
                    on scroll cp_lk_date0 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_date1 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_date2 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_date3 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_date0 { emit ui_sound; lock_date = 0 }
                    on press cp_lk_date1 { emit ui_sound; lock_date = 1 }
                    on press cp_lk_date2 { emit ui_sound; lock_date = 2 }
                    on press cp_lk_date3 { emit ui_sound; lock_date = 3 }

                    //  7.6 Password mask style
                    let y5 = 660
                    let h5 = max(max(cp_lk_mask0.hover, cp_lk_mask1.hover), max(cp_lk_mask2.hover, cp_lk_mask3.hover))
                    CpCard(250, y5, 570, 62)
                    text "Password mask" { at: 266, y5 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_mask }
                    CpLeader(266 + m_lk_mask.width + 10, 504, y5 + 20, h5)
                    text "Try typing in the preview bar above to see changes live." { at: 266, y5 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(514, y5 + 20, 290, 28, 4, lock_mask, h5, cp.mint)
                    text "Shapes"  { at: 550.25, y5 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_mask == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Dots"    { at: 622.75, y5 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_mask == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Stars"   { at: 695.25, y5 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_mask == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "Special" { at: 767.75, y5 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_mask == 3, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_mask0 { from: 514,   y5 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y5 + 20) - lk.off > 176 and (y5 + 20) - lk.off < 784; label: "Shapes mask" }
                    zone box cp_lk_mask1 { from: 586.5, y5 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y5 + 20) - lk.off > 176 and (y5 + 20) - lk.off < 784; label: "Dots mask" }
                    zone box cp_lk_mask2 { from: 659,   y5 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y5 + 20) - lk.off > 176 and (y5 + 20) - lk.off < 784; label: "Stars mask" }
                    zone box cp_lk_mask3 { from: 731.5, y5 + 6; size: 72.5, 28; corner: 14; cursor: pointer; active: (y5 + 20) - lk.off > 176 and (y5 + 20) - lk.off < 784; label: "Special mask" }
                    on scroll cp_lk_mask0 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_mask1 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_mask2 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_mask3 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_mask0 { emit ui_sound; lock_mask = 0 }
                    on press cp_lk_mask1 { emit ui_sound; lock_mask = 1 }
                    on press cp_lk_mask2 { emit ui_sound; lock_mask = 2 }
                    on press cp_lk_mask3 { emit ui_sound; lock_mask = 3 }

                    //  7.7 Mask colour palette
                    let y6 = 728
                    let h6 = max(max(cp_lk_pal0.hover, cp_lk_pal1.hover), max(cp_lk_pal2.hover, max(cp_lk_pal3.hover, cp_lk_pal4.hover)))
                    CpCard(250, y6, 570, 62)
                    text "Mask colour" { at: 266, y6 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_pal }
                    CpLeader(266 + m_lk_pal.width + 10, 444, y6 + 20, h6)
                    text "Palette applied to password mask glyphs." { at: 266, y6 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(454, y6 + 20, 350, 28, 5, lock_pal, h6, cp.mint)
                    text "Vibrant" { at: 489, y6 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_pal == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Accent"  { at: 559, y6 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_pal == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Neon"    { at: 629, y6 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_pal == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "Pastel"  { at: 699, y6 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_pal == 3, cp.mint, faint); family: "Space Grotesk" }
                    text "Mono"    { at: 769, y6 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_pal == 4, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_pal0 { from: 454, y6 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y6 + 20) - lk.off > 176 and (y6 + 20) - lk.off < 784; label: "Vibrant mask" }
                    zone box cp_lk_pal1 { from: 524, y6 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y6 + 20) - lk.off > 176 and (y6 + 20) - lk.off < 784; label: "Accent mask" }
                    zone box cp_lk_pal2 { from: 594, y6 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y6 + 20) - lk.off > 176 and (y6 + 20) - lk.off < 784; label: "Neon mask" }
                    zone box cp_lk_pal3 { from: 664, y6 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y6 + 20) - lk.off > 176 and (y6 + 20) - lk.off < 784; label: "Pastel mask" }
                    zone box cp_lk_pal4 { from: 734, y6 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y6 + 20) - lk.off > 176 and (y6 + 20) - lk.off < 784; label: "Monochrome mask" }
                    on scroll cp_lk_pal0 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_pal1 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_pal2 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_pal3 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_pal4 { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_pal0 { emit ui_sound; lock_pal = 0 }
                    on press cp_lk_pal1 { emit ui_sound; lock_pal = 1 }
                    on press cp_lk_pal2 { emit ui_sound; lock_pal = 2 }
                    on press cp_lk_pal3 { emit ui_sound; lock_pal = 3 }
                    on press cp_lk_pal4 { emit ui_sound; lock_pal = 4 }

                    //  7.8 Extras
                    let y7 = 796
                    let h7 = max(cp_lk_media.hover, cp_lk_power.hover)
                    CpCard(250, y7, 570, 62)
                    text "Lock controls" { at: 266, y7 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_lk_ext }
                    CpLeader(266 + m_lk_ext.width + 10, 610, y7 + 20, h7)
                    text "Widgets visible when locked." { at: 266, y7 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpPill(620, y7 + 6, 88, 28, if(lock_media, 1, 0), cp_lk_media.hover, cp.mint, ink)
                    text "Media" { at: 664, y7 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_media, cp.mint, faint); family: "Space Grotesk" }
                    CpPill(716, y7 + 6, 88, 28, if(lock_power, 1, 0), cp_lk_power.hover, cp.mint, ink)
                    text "Power" { at: 760, y7 + 20; anchor: center; size: 11.5; weight: 700; color: if(lock_power, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_lk_media { from: 620, y7 + 6; size: 88, 28; corner: 14; cursor: pointer; active: (y7 + 20) - lk.off > 176 and (y7 + 20) - lk.off < 784; label: "Toggle lock media widget" }
                    zone box cp_lk_power { from: 716, y7 + 6; size: 88, 28; corner: 14; cursor: pointer; active: (y7 + 20) - lk.off > 176 and (y7 + 20) - lk.off < 784; label: "Toggle lock power widget" }
                    on scroll cp_lk_media { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on scroll cp_lk_power { cp_sc_lk_to = clamp(cp_sc_lk_to - wheel * 48, 0, lk.max_s) }
                    on press cp_lk_media { emit ui_sound; lock_media = not lock_media }
                    on press cp_lk_power { emit ui_sound; lock_power = not lock_power }
                }

                let lk.cuey = 762 + 2 * sin(cp_clk * 240)
                CpMoreCue(lk.cue, lk.cuey, lk_cue_hit.hover)
                zone box lk_cue_hit { at: 535, 762; size: 84, 28; corner: 14; cursor: pointer; active: lk.cue > 0.4; label: "Scroll down" }
                on press lk_cue_hit { emit ui_sound; cp_sc_lk_to = clamp(cp_sc_lk_to + 320, 0, lk.max_s) }
            }

            box { from: 829, cp.vy; size: 4, cp.vh; corner: 2; color: ink; opacity: 8% }
            box { from: 829, cp.vy + (cp.vh - lk.th) * clamp(lk.sc / lk.max_s, 0, 1); size: 4, lk.th; corner: 2; color: cp.mint; opacity: 45% + 40% * lk_bar_hit.hover }
            zone box lk_bar_hit { from: 824, cp.vy; size: 14, cp.vh; cursor: pointer; label: "Scroll Lock screen settings" }
            on press lk_bar_hit { cp_sc_lk_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - lk.th / 2) / max(1, cp.vh - lk.th) * lk.max_s, 0, lk.max_s) }
            on drag  lk_bar_hit { cp_sc_lk_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - lk.th / 2) / max(1, cp.vh - lk.th) * lk.max_s, 0, lk.max_s) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 8 · IDLE (Sequence Flow Card + Discrete Ticks)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 8

            //  Visual Sequence Card: ACTIVE -> LOCK -> SCREEN OFF
            CpCard(250, 176, 570, 118)
            text "IDLE SEQUENCE LADDER" { at: 266, 196; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "No suspend triggered by shell." { at: 804, 196; anchor: right center; size: 11; color: faint; opacity: 78%; family: "Space Grotesk" }

            //  Stage 0: ACTIVE (raised crystal prism)
            GlassPrism(268, 214, 116, 52, 12, 0, 1)
            ellipse { at: 288, 232; radius: 4; color: cp.mint }
            text "ACTIVE" { at: 300, 232; anchor: left center; size: 11.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
            text "Working" { at: 326, 252; anchor: center; size: 11; color: ink; opacity: 82%; family: "Space Grotesk" }

            //  Arrow 0 -> 1
            let lock_active = idle_lock_i > 0
            line { from: 388, 240; to: 454, 240; width: 1.6; color: if(lock_active, cp.mint, faint); opacity: if(lock_active, 75%, 28%) }
            path { at: 454, 240; stroke: 1.6; color: if(lock_active, cp.mint, faint); opacity: if(lock_active, 75%, 28%); move -5, -4; line 0, 0; line -5, 4 }

            //  Stage 1: LOCK
            GlassPrism(462, 214, 132, 52, 12, 0, if(lock_active, 1, 0))
            box { at: 528, 216; size: 22, 2; corner: 1; color: cp.mint; opacity: 88%; show: lock_active }
            text "LOCK" { at: 528, 229; anchor: center; size: 11.5; weight: 700; color: if(lock_active, cp.mint, faint); family: "Space Grotesk" }
            text idle_lock_t { at: 528, 250; anchor: center; size: 13; weight: 700; color: if(lock_active, ink, faint); family: "Space Grotesk" }

            //  Arrow 1 -> 2
            let off_active = idle_off_i > 0
            line { from: 598, 240; to: 660, 240; width: 1.6; color: if(off_active, cp.mint, faint); opacity: if(off_active, 75%, 28%) }
            path { at: 660, 240; stroke: 1.6; color: if(off_active, cp.mint, faint); opacity: if(off_active, 75%, 28%); move -5, -4; line 0, 0; line -5, 4 }

            //  Stage 2: SCREEN OFF
            GlassPrism(668, 214, 132, 52, 12, 0, if(off_active, 1, 0))
            box { at: 734, 216; size: 22, 2; corner: 1; color: cp.mint; opacity: 88%; show: off_active }
            text "SCREEN OFF" { at: 734, 229; anchor: center; size: 11.5; weight: 700; color: if(off_active, cp.mint, faint); family: "Space Grotesk" }
            text idle_off_t { at: 734, 250; anchor: center; size: 13; weight: 700; color: if(off_active, ink, faint); family: "Space Grotesk" }

            text "TIMERS" { at: 250, 316; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

            //  8.1 Lock screen timer + 17 discrete step dots
            let y0 = 332
            let h0 = max(cp_idle_lock.hover, cp_idle_lock.pressed)
            CpCard(250, y0, 570, 72)
            text "Lock after" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_id_lock }
            CpLeader(266 + m_id_lock.width + 10, cp.sl_x - 10, y0 + 20, h0)
            CpSlider(cp.sl_x, y0 + 20, cp.sl_w, cp.idle_lock_pct, h0, cp.mint)
            repeat tk in 0..17 {
                let tx = cp.sl_x + 3.5 + (cp.sl_w - 7) * (tk / 16)
                ellipse { at: tx, y0 + 34; radius: if(tk == idle_lock_i, 2.2, 1.3); color: if(tk <= idle_lock_i and idle_lock_i > 0, cp.mint, faint); opacity: if(tk == idle_lock_i, 100%, 42%) }
            }
            text idle_lock_t { at: cp.rx, y0 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
            text "Never, 1 min … 2 hr discrete stops." { at: 266, y0 + 52; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            zone box cp_idle_lock { from: cp.sl_x - 6, y0 + 8; size: cp.sl_w + 12, 24; cursor: pointer; label: "Lock after idle" }
            on press cp_idle_lock { idle_lock_i = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 16), 0, 16) }
            on drag  cp_idle_lock { idle_lock_i = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 16), 0, 16) }

            //  8.2 Screen off timer + 17 discrete step dots
            let y1 = 412
            let h1 = max(cp_idle_off.hover, cp_idle_off.pressed)
            CpCard(250, y1, 570, 72)
            text "Screen off after" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_id_off }
            CpLeader(266 + m_id_off.width + 10, cp.sl_x - 10, y1 + 20, h1)
            CpSlider(cp.sl_x, y1 + 20, cp.sl_w, cp.idle_off_pct, h1, cp.mint)
            repeat tk in 0..17 {
                let tx = cp.sl_x + 3.5 + (cp.sl_w - 7) * (tk / 16)
                ellipse { at: tx, y1 + 34; radius: if(tk == idle_off_i, 2.2, 1.3); color: if(tk <= idle_off_i and idle_off_i > 0, cp.mint, faint); opacity: if(tk == idle_off_i, 100%, 42%) }
            }
            text idle_off_t { at: cp.rx, y1 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
            text "Turns outputs off; never suspends system." { at: 266, y1 + 52; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            zone box cp_idle_off { from: cp.sl_x - 6, y1 + 8; size: cp.sl_w + 12, 24; cursor: pointer; label: "Screen off after idle" }
            on press cp_idle_off { idle_off_i = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 16), 0, 16) }
            on drag  cp_idle_off { idle_off_i = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 16), 0, 16) }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 9 · WEATHER
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 9
            text "LOCATION" { at: 250, 178; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

            CpCard(250, 194, 570, 138)
            text "City name" { at: 266, 216; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk" }
            text "Used for live sky shader, 24 h curve and 4-day outlook in Center Panel." { at: 266, 238; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
            GlassWell(266, 258, 446, 38, 12, 0.35)
            input weather_city { at: 282, 268; width: 416; size: 15; color: ink; family: "Space Grotesk"; placeholder: "e.g. Shanghai, Tokyo, London" }
            on submit weather_city { emit ui_sound; emit weather_apply }

            CpPill(722, 260, 82, 34, 1, cp_weather_apply.hover, cp.mint, ink)
            text "Apply" { at: 763, 277; anchor: center; size: 13.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box cp_weather_apply { from: 722, 260; size: 82, 34; corner: 17; cursor: pointer; label: "Apply city" }
            on press cp_weather_apply { emit ui_sound; emit weather_apply }

            text wx_city { at: 266, 314; anchor: left center; size: 12; color: cp.mint; show: wx_ready; family: "Space Grotesk" }
            text wx_status { at: 266, 314; anchor: left center; size: 12; color: faint; show: not wx_ready and wx_configured; family: "Space Grotesk" }
            text "Enter a city and press Apply." { at: 266, 314; anchor: left center; size: 12; color: faint; show: not wx_configured; family: "Space Grotesk" }
            text wx_temp { at: 804, 314; anchor: right center; size: 12.5; weight: 700; color: ink; show: wx_ready; family: "Space Grotesk" }
        }

        //  ═══════════════════════════════════════════════════════════════
        //  PAGE 10 · THEME & SURFACE (scrollable + fill style + presets)
        //  ═══════════════════════════════════════════════════════════════
        group {
            show: settings_page == 10
            let th.h = 1586
            let th.max_s = max(1, th.h - cp.vh)
            let th.sc = clamp(cp_sc_th, 0, th.max_s)
            let th.off = floor(th.sc + 0.5)
            let th.cue = clamp((th.max_s - th.sc) / 28, 0, 1) * clamp(1 - th.sc / 18, 0, 1)
            let th.th = max(44, cp.vh * min(1, cp.vh / th.h))

            group {
                clip box { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                zone box cp_th_wheel { from: cp.vx, cp.vy; size: cp.vw, cp.vh }
                on scroll cp_th_wheel { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }

                group {
                    move: 0, -th.off

                    //  10.0 Live Wallpaper Palette swatch card
                    CpCard(250, 176, 570, 74)
                    text "WALLPAPER PALETTE" { at: 266, 195; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
                    text wall_name { at: 804, 195; anchor: right center; size: 11.5; weight: 600; color: cp.mint; width: 320; lines: 1; align: right; family: "Space Grotesk" }
                    ellipse { at: 282, 224; radius: 11; color: primary }
                    ellipse { at: 322, 224; radius: 11; color: secondary }
                    ellipse { at: 362, 224; radius: 11; color: aqua }
                    ellipse { at: 402, 224; radius: 11; color: ink }
                    ellipse { at: 442, 224; radius: 11; color: faint }
                    ellipse { at: 482, 224; radius: 11; color: panel }
                    ellipse { at: 482, 224; radius: 11; stroke: 1; color: faint; opacity: 55% }
                    text "Swatches update live whenever you change wallpaper." { at: 804, 224; anchor: right center; size: 11.5; color: faint; family: "Space Grotesk" }

                    text "CONTROLS & MATERIAL" { at: 250, 268; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  10.1 Slider fill style (`slider_fill` 0..4)
                    let y0 = 284
                    let h0 = max(max(cp_sf0.hover, cp_sf1.hover), max(cp_sf2.hover, max(cp_sf3.hover, cp_sf4.hover)))
                    CpCard(250, y0, 570, 62)
                    text "Slider fill style" { at: 266, y0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_fill }
                    CpLeader(266 + m_th_fill.width + 10, 444, y0 + 20, h0)
                    text "Texture painted inside every slider, tab and picker thumb." { at: 266, y0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(454, y0 + 20, 350, 28, 5, slider_fill, h0, cp.mint)
                    text "Pencil"   { at: 489, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(slider_fill == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Marker"   { at: 559, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(slider_fill == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Gradient" { at: 629, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(slider_fill == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "Plain"    { at: 699, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(slider_fill == 3, cp.mint, faint); family: "Space Grotesk" }
                    text "Dots"     { at: 769, y0 + 20; anchor: center; size: 11.5; weight: 700; color: if(slider_fill == 4, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_sf0 { from: 454, y0 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y0 + 20) - th.off > 176 and (y0 + 20) - th.off < 784; label: "Pencil fill" }
                    zone box cp_sf1 { from: 524, y0 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y0 + 20) - th.off > 176 and (y0 + 20) - th.off < 784; label: "Marker fill" }
                    zone box cp_sf2 { from: 594, y0 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y0 + 20) - th.off > 176 and (y0 + 20) - th.off < 784; label: "Gradient fill" }
                    zone box cp_sf3 { from: 664, y0 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y0 + 20) - th.off > 176 and (y0 + 20) - th.off < 784; label: "Plain fill" }
                    zone box cp_sf4 { from: 734, y0 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y0 + 20) - th.off > 176 and (y0 + 20) - th.off < 784; label: "Dots fill" }
                    on scroll cp_sf0 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_sf1 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_sf2 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_sf3 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_sf4 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_sf0 { emit ui_sound; slider_fill = 0 }
                    on press cp_sf1 { emit ui_sound; slider_fill = 1 }
                    on press cp_sf2 { emit ui_sound; slider_fill = 2 }
                    on press cp_sf3 { emit ui_sound; slider_fill = 3 }
                    on press cp_sf4 { emit ui_sound; slider_fill = 4 }

                    //  10.2 Material Presets (`glass_preset_i` 0..4, or -1 custom)
                    let y1 = 352
                    CpCard(250, y1, 570, 62)
                    text "Material presets" { at: 266, y1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_pre }
                    CpLeader(266 + m_th_pre.width + 10, 444, y1 + 20, max(max(cp_gp0.hover, cp_gp1.hover), max(cp_gp2.hover, max(cp_gp3.hover, cp_gp4.hover))))
                    text "One-click glass recipes (Liquid, Clear, Smoked, Milky, Mirror)." { at: 266, y1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSetPick(454, y1 + 20, 350, 28, 5, glass_preset_i, max(max(cp_gp0.hover, cp_gp1.hover), max(cp_gp2.hover, max(cp_gp3.hover, cp_gp4.hover))), cp.mint)
                    text "Liquid" { at: 489, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(glass_preset_i == 0, cp.mint, faint); family: "Space Grotesk" }
                    text "Clear"  { at: 559, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(glass_preset_i == 1, cp.mint, faint); family: "Space Grotesk" }
                    text "Smoked" { at: 629, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(glass_preset_i == 2, cp.mint, faint); family: "Space Grotesk" }
                    text "Milky"  { at: 699, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(glass_preset_i == 3, cp.mint, faint); family: "Space Grotesk" }
                    text "Mirror" { at: 769, y1 + 20; anchor: center; size: 11.5; weight: 700; color: if(glass_preset_i == 4, cp.mint, faint); family: "Space Grotesk" }
                    zone box cp_gp0 { from: 454, y1 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y1 + 20) - th.off > 176 and (y1 + 20) - th.off < 784; label: "Liquid preset" }
                    zone box cp_gp1 { from: 524, y1 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y1 + 20) - th.off > 176 and (y1 + 20) - th.off < 784; label: "Clear preset" }
                    zone box cp_gp2 { from: 594, y1 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y1 + 20) - th.off > 176 and (y1 + 20) - th.off < 784; label: "Smoked preset" }
                    zone box cp_gp3 { from: 664, y1 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y1 + 20) - th.off > 176 and (y1 + 20) - th.off < 784; label: "Milky preset" }
                    zone box cp_gp4 { from: 734, y1 + 6; size: 70, 28; corner: 14; cursor: pointer; active: (y1 + 20) - th.off > 176 and (y1 + 20) - th.off < 784; label: "Mirror preset" }
                    on scroll cp_gp0 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_gp1 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_gp2 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_gp3 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on scroll cp_gp4 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_gp0 { emit ui_sound; emit glass_preset(0) }
                    on press cp_gp1 { emit ui_sound; emit glass_preset(1) }
                    on press cp_gp2 { emit ui_sound; emit glass_preset(2) }
                    on press cp_gp3 { emit ui_sound; emit glass_preset(3) }
                    on press cp_gp4 { emit ui_sound; emit glass_preset(4) }

                    text "WATER BACKDROP" { at: 250, 434; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  10.3a Live Water Backdrop master switch
                    let w0 = 450
                    let hw0 = max(cp_wat_switch.hover, cp_wat_switch.pressed)
                    CpCard(250, w0, 570, 62)
                    text "Water backdrop" { at: 266, w0 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wat }
                    CpLeader(266 + m_th_wat.width + 10, 746, w0 + 20, hw0)
                    text "Animated optical water & liquid light flowing behind every glass panel." { at: 266, w0 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, w0 + 8, 48, 24, if(panel_water_on, 1, 0), panel_water_knob, cp_wat_switch.hover, cp_wat_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_wat_switch { from: 750, w0 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (w0 + 20) - th.off > 176 and (w0 + 20) - th.off < 784; label: "Toggle water backdrop" }
                    on scroll cp_wat_switch { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_wat_switch { emit ui_sound; toggle panel_water_on }

                    //  10.3b Water style, common sliders & per-wave detail sliders
                    let d_pw = if(panel_water_on, 0, 1)
                    group {
                        opacity: if(panel_water_on, 1, 0.42)

                        let w1 = 518
                        let hw1 = max(cp_ws_0.hover, max(cp_ws_1.hover, cp_ws_2.hover))
                        CpCard(250, w1, 570, 62)
                        text "Wave style" { at: 266, w1 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wst }
                        CpLeader(266 + m_th_wst.width + 10, 524, w1 + 20, hw1, d_pw)
                        text pick(panel_water_style,
                            "Sunlit underwater caustic web with gentle expanding rings.",
                            "3D concentric raindrop ripples interfering on dark mirror water.",
                            "3D crystal raindrops sliding down glass with dew & wet trails."
                        ) { at: 266, w1 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSetPick(534, w1 + 20, 270, 28, 3, panel_water_style, hw1, cp.mint, d_pw)
                        text "Caustics" { at: 579, w1 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_water_style == 0, cp.mint, faint); family: "Space Grotesk" }
                        text "Ripples"  { at: 669, w1 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_water_style == 1, cp.mint, faint); family: "Space Grotesk" }
                        text "Droplets" { at: 759, w1 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_water_style == 2, cp.mint, faint); family: "Space Grotesk" }
                        zone box cp_ws_0 { from: 534, w1 + 6; size: 90, 28; corner: 14; cursor: pointer; active: panel_water_on and (w1 + 20) - th.off > 176 and (w1 + 20) - th.off < 784; label: "Caustics water style" }
                        zone box cp_ws_1 { from: 624, w1 + 6; size: 90, 28; corner: 14; cursor: pointer; active: panel_water_on and (w1 + 20) - th.off > 176 and (w1 + 20) - th.off < 784; label: "Ripples water style" }
                        zone box cp_ws_2 { from: 714, w1 + 6; size: 90, 28; corner: 14; cursor: pointer; active: panel_water_on and (w1 + 20) - th.off > 176 and (w1 + 20) - th.off < 784; label: "Droplets water style" }
                        on scroll cp_ws_0 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on scroll cp_ws_1 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on scroll cp_ws_2 { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_ws_0 { emit ui_sound; panel_water_style = 0 }
                        on press cp_ws_1 { emit ui_sound; panel_water_style = 1 }
                        on press cp_ws_2 { emit ui_sound; panel_water_style = 2 }

                        let w2 = 586
                        let hw2 = max(cp_wstr_track.hover, cp_wstr_track.pressed)
                        CpCard(250, w2, 570, 56)
                        text "Intensity" { at: 266, w2 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wstr }
                        CpLeader(266 + m_th_wstr.width + 10, cp.sl_x - 10, w2 + 19, hw2, d_pw)
                        text "Overall visibility of the liquid light layer behind glass cards." { at: 266, w2 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, w2 + 19, cp.sl_w, cp.wstr_pct, hw2, cp.mint, d_pw)
                        text number(panel_water_strength, 0, "%") { at: cp.rx, w2 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wstr_track { from: cp.sl_x - 6, w2 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and (w2 + 19) - th.off > 176 and (w2 + 19) - th.off < 784; label: "Water intensity" }
                        on scroll cp_wstr_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_wstr_track { panel_water_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_wstr_track { panel_water_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        let w3 = 648
                        let hw3 = max(cp_wspd_track.hover, cp_wspd_track.pressed)
                        CpCard(250, w3, 570, 56)
                        text "Flow speed" { at: 266, w3 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wspd }
                        CpLeader(266 + m_th_wspd.width + 10, cp.sl_x - 10, w3 + 19, hw3, d_pw)
                        text "Drift tempo of ripples, currents and swells (0% freezes still)." { at: 266, w3 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, w3 + 19, cp.sl_w, cp.wspd_pct, hw3, cp.mint, d_pw)
                        text number(panel_water_speed, 0, "%") { at: cp.rx, w3 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wspd_track { from: cp.sl_x - 6, w3 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and (w3 + 19) - th.off > 176 and (w3 + 19) - th.off < 784; label: "Water flow speed" }
                        on scroll cp_wspd_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_wspd_track { panel_water_speed = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }
                        on drag  cp_wspd_track { panel_water_speed = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 200), 0, 200) }

                        let w4 = 710
                        let hw4 = max(cp_wmix_track.hover, cp_wmix_track.pressed)
                        CpCard(250, w4, 570, 56)
                        text "Colour mix" { at: 266, w4 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wmix }
                        CpLeader(266 + m_th_wmix.width + 10, cp.sl_x - 10, w4 + 19, hw4, d_pw)
                        text "Balance between wallpaper primary (0%) and secondary (100%)." { at: 266, w4 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, w4 + 19, cp.sl_w, cp.wmix_pct, hw4, cp.mint, d_pw)
                        text number(panel_water_color_mix, 0, "%") { at: cp.rx, w4 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wmix_track { from: cp.sl_x - 6, w4 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and (w4 + 19) - th.off > 176 and (w4 + 19) - th.off < 784; label: "Water colour mix" }
                        on scroll cp_wmix_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_wmix_track { panel_water_color_mix = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_wmix_track { panel_water_color_mix = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        let w5 = 772
                        let hw5 = max(cp_wptr_track.hover, cp_wptr_track.pressed)
                        CpCard(250, w5, 570, 56)
                        text "Pointer ripple" { at: 266, w5 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wptr }
                        CpLeader(266 + m_th_wptr.width + 10, cp.sl_x - 10, w5 + 19, hw5, d_pw)
                        text "Interactive ripple & specular wake following your cursor." { at: 266, w5 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, w5 + 19, cp.sl_w, cp.wptr_pct, hw5, cp.mint, d_pw)
                        text number(panel_water_pointer, 0, "%") { at: cp.rx, w5 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_wptr_track { from: cp.sl_x - 6, w5 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and (w5 + 19) - th.off > 176 and (w5 + 19) - th.off < 784; label: "Water pointer ripple" }
                        on scroll cp_wptr_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_wptr_track { panel_water_pointer = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_wptr_track { panel_water_pointer = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                        text pick(panel_water_style, "CAUSTICS DETAIL", "RIPPLES DETAIL", "DROPLETS DETAIL") { at: 250, 846; anchor: left center; size: 10.5; weight: 700; color: cp.mint; opacity: 82%; family: "Space Grotesk" }

                        let w6 = 862
                        let w7 = 924
                        let w8 = 986

                        //  Mode 0 · Caustics fine-tuning
                        group {
                            show: panel_water_style == 0

                            let hwc0 = max(cp_wc0_track.hover, cp_wc0_track.pressed)
                            CpCard(250, w6, 570, 56)
                            text "Caustic scale" { at: 266, w6 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wc0 }
                            CpLeader(266 + m_th_wc0.width + 10, cp.sl_x - 10, w6 + 19, hwc0, d_pw)
                            text "Cell size and density of interlocking caustic light ribbons." { at: 266, w6 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w6 + 19, cp.sl_w, cp.wc0_pct, hwc0, cp.mint, d_pw)
                            text number(pw_caustic_scale, 0, "%") { at: cp.rx, w6 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wc0_track { from: cp.sl_x - 6, w6 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 0 and (w6 + 19) - th.off > 176 and (w6 + 19) - th.off < 784; label: "Caustic scale" }
                            on scroll cp_wc0_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wc0_track { pw_caustic_scale = clamp(round(40 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 160), 40, 200) }
                            on drag  cp_wc0_track { pw_caustic_scale = clamp(round(40 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 160), 40, 200) }

                            let hwc1 = max(cp_wc1_track.hover, cp_wc1_track.pressed)
                            CpCard(250, w7, 570, 56)
                            text "Filament sharpness" { at: 266, w7 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wc1 }
                            CpLeader(266 + m_th_wc1.width + 10, cp.sl_x - 10, w7 + 19, hwc1, d_pw)
                            text "Soft underwater glow (0%) to crisp refractive filaments (100%)." { at: 266, w7 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w7 + 19, cp.sl_w, cp.wc1_pct, hwc1, cp.mint, d_pw)
                            text number(pw_caustic_sharp, 0, "%") { at: cp.rx, w7 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wc1_track { from: cp.sl_x - 6, w7 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 0 and (w7 + 19) - th.off > 176 and (w7 + 19) - th.off < 784; label: "Caustic sharpness" }
                            on scroll cp_wc1_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wc1_track { pw_caustic_sharp = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_wc1_track { pw_caustic_sharp = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                            let hwc2 = max(cp_wc2_track.hover, cp_wc2_track.pressed)
                            CpCard(250, w8, 570, 56)
                            text "Ambient rings" { at: 266, w8 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wc2 }
                            CpLeader(266 + m_th_wc2.width + 10, cp.sl_x - 10, w8 + 19, hwc2, d_pw)
                            text "Slow expanding concentric ripples blooming across the glass." { at: 266, w8 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w8 + 19, cp.sl_w, cp.wc2_pct, hwc2, cp.mint, d_pw)
                            text number(pw_caustic_ripple, 0, "%") { at: cp.rx, w8 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wc2_track { from: cp.sl_x - 6, w8 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 0 and (w8 + 19) - th.off > 176 and (w8 + 19) - th.off < 784; label: "Ambient water rings" }
                            on scroll cp_wc2_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wc2_track { pw_caustic_ripple = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_wc2_track { pw_caustic_ripple = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        }

                        //  Mode 1 · 3D Concentric Pond Ripples fine-tuning
                        group {
                            show: panel_water_style == 1

                            let hwf0 = max(cp_wf0_track.hover, cp_wf0_track.pressed)
                            CpCard(250, w6, 570, 56)
                            text "Drop frequency" { at: 266, w6 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wf0 }
                            CpLeader(266 + m_th_wf0.width + 10, cp.sl_x - 10, w6 + 19, hwf0, d_pw)
                            text "Pace and overlap count of raindrops landing on the pond." { at: 266, w6 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w6 + 19, cp.sl_w, cp.wf0_pct, hwf0, cp.mint, d_pw)
                            text number(pw_rip_rate, 0, "%") { at: cp.rx, w6 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wf0_track { from: cp.sl_x - 6, w6 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 1 and (w6 + 19) - th.off > 176 and (w6 + 19) - th.off < 784; label: "Ripple drop frequency" }
                            on scroll cp_wf0_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wf0_track { pw_rip_rate = clamp(round(20 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 180), 20, 200) }
                            on drag  cp_wf0_track { pw_rip_rate = clamp(round(20 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 180), 20, 200) }

                            let hwf1 = max(cp_wf1_track.hover, cp_wf1_track.pressed)
                            CpCard(250, w7, 570, 56)
                            text "Ring trains" { at: 266, w7 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wf1 }
                            CpLeader(266 + m_th_wf1.width + 10, cp.sl_x - 10, w7 + 19, hwf1, d_pw)
                            text "Single crisp ring (0%) to multi-ring interference trains (100%)." { at: 266, w7 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w7 + 19, cp.sl_w, cp.wf1_pct, hwf1, cp.mint, d_pw)
                            text number(pw_rip_rings, 0, "%") { at: cp.rx, w7 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wf1_track { from: cp.sl_x - 6, w7 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 1 and (w7 + 19) - th.off > 176 and (w7 + 19) - th.off < 784; label: "Ripple ring trains" }
                            on scroll cp_wf1_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wf1_track { pw_rip_rings = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_wf1_track { pw_rip_rings = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                            let hwf2 = max(cp_wf2_track.hover, cp_wf2_track.pressed)
                            CpCard(250, w8, 570, 56)
                            text "Mirror gloss" { at: 266, w8 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_wf2 }
                            CpLeader(266 + m_th_wf2.width + 10, cp.sl_x - 10, w8 + 19, hwf2, d_pw)
                            text "3D specular sheen and splash catchlights on wave slopes." { at: 266, w8 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w8 + 19, cp.sl_w, cp.wf2_pct, hwf2, cp.mint, d_pw)
                            text number(pw_rip_gloss, 0, "%") { at: cp.rx, w8 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_wf2_track { from: cp.sl_x - 6, w8 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 1 and (w8 + 19) - th.off > 176 and (w8 + 19) - th.off < 784; label: "Ripple mirror gloss" }
                            on scroll cp_wf2_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_wf2_track { pw_rip_gloss = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_wf2_track { pw_rip_gloss = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        }

                        //  Mode 2 · 3D Crystal Raindrops & Condensation fine-tuning
                        group {
                            show: panel_water_style == 2

                            let hws0 = max(cp_ws0_track.hover, cp_ws0_track.pressed)
                            CpCard(250, w6, 570, 56)
                            text "Drop size" { at: 266, w6 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_ws0 }
                            CpLeader(266 + m_th_ws0.width + 10, cp.sl_x - 10, w6 + 19, hws0, d_pw)
                            text "Delicate fine rain mist (50%) to bold crystal beads (180%)." { at: 266, w6 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w6 + 19, cp.sl_w, cp.ws0_pct, hws0, cp.mint, d_pw)
                            text number(pw_drop_size, 0, "%") { at: cp.rx, w6 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_ws0_track { from: cp.sl_x - 6, w6 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 2 and (w6 + 19) - th.off > 176 and (w6 + 19) - th.off < 784; label: "Droplet size" }
                            on scroll cp_ws0_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_ws0_track { pw_drop_size = clamp(round(50 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 130), 50, 180) }
                            on drag  cp_ws0_track { pw_drop_size = clamp(round(50 + (pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 130), 50, 180) }

                            let hws1 = max(cp_ws1_track.hover, cp_ws1_track.pressed)
                            CpCard(250, w7, 570, 56)
                            text "Condensation" { at: 266, w7 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_ws1 }
                            CpLeader(266 + m_th_ws1.width + 10, cp.sl_x - 10, w7 + 19, hws1, d_pw)
                            text "Density of sliding raindrops and static micro-dew beads." { at: 266, w7 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w7 + 19, cp.sl_w, cp.ws1_pct, hws1, cp.mint, d_pw)
                            text number(pw_drop_density, 0, "%") { at: cp.rx, w7 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_ws1_track { from: cp.sl_x - 6, w7 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 2 and (w7 + 19) - th.off > 176 and (w7 + 19) - th.off < 784; label: "Droplet condensation" }
                            on scroll cp_ws1_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_ws1_track { pw_drop_density = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_ws1_track { pw_drop_density = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                            let hws2 = max(cp_ws2_track.hover, cp_ws2_track.pressed)
                            CpCard(250, w8, 570, 56)
                            text "Slide trails" { at: 266, w8 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_ws2 }
                            CpLeader(266 + m_th_ws2.width + 10, cp.sl_x - 10, w8 + 19, hws2, d_pw)
                            text "Trailing micro-beads and wet vertical tracks behind drops." { at: 266, w8 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                            CpSlider(cp.sl_x, w8 + 19, cp.sl_w, cp.ws2_pct, hws2, cp.mint, d_pw)
                            text number(pw_drop_trails, 0, "%") { at: cp.rx, w8 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                            zone box cp_ws2_track { from: cp.sl_x - 6, w8 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_water_on and panel_water_style == 2 and (w8 + 19) - th.off > 176 and (w8 + 19) - th.off < 784; label: "Droplet slide trails" }
                            on scroll cp_ws2_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                            on press cp_ws2_track { pw_drop_trails = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                            on drag  cp_ws2_track { pw_drop_trails = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        }
                    }

                    text "BACKING GRADIENT" { at: 250, 1062; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  10.4 Gradient switch
                    let y2 = 1078
                    let h2 = max(cp_grad_switch.hover, cp_grad_switch.pressed)
                    CpCard(250, y2, 570, 62)
                    text "Panel gradient" { at: 266, y2 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_grad }
                    CpLeader(266 + m_th_grad.width + 10, 746, y2 + 20, h2)
                    text "Wash wallpaper primary & secondary tones behind drawers." { at: 266, y2 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                    CpSwitch(756, y2 + 8, 48, 24, if(panel_gradient > 0, 1, 0), panel_grad_knob, cp_grad_switch.hover, cp_grad_switch.pressed, cp.mint, ink, cp.track)
                    zone box cp_grad_switch { from: 750, y2 + 4; size: 60, 32; corner: 16; cursor: pointer; active: (y2 + 20) - th.off > 176 and (y2 + 20) - th.off < 784; label: "Toggle panel gradient" }
                    on scroll cp_grad_switch { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_grad_switch { emit ui_sound; panel_gradient = if(panel_gradient == 0, 1, 0) }

                    //  10.5..10.6 Gradient shape & strength (dimmed when panel_gradient == 0)
                    let d_pg = if(panel_gradient > 0, 0, 1)
                    group {
                        opacity: if(panel_gradient > 0, 1, 0.42)
                        let y3 = 1146
                        let h3 = max(cp_grad_linear.hover, cp_grad_radial.hover)
                        CpCard(250, y3, 570, 62)
                        text "Gradient shape" { at: 266, y3 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_gshp }
                        CpLeader(266 + m_th_gshp.width + 10, 626, y3 + 20, h3, d_pg)
                        text "Sweep direction across drawer surfaces." { at: 266, y3 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSetPick(636, y3 + 20, 168, 28, 2, if(panel_gradient == 2, 1, 0), h3, cp.mint, d_pg)
                        text "Linear" { at: 678, y3 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_gradient == 1, cp.mint, faint); family: "Space Grotesk" }
                        text "Radial" { at: 762, y3 + 20; anchor: center; size: 11.5; weight: 700; color: if(panel_gradient == 2, cp.mint, faint); family: "Space Grotesk" }
                        zone box cp_grad_linear { from: 636, y3 + 6; size: 84, 28; corner: 14; cursor: pointer; active: panel_gradient > 0 and (y3 + 20) - th.off > 176 and (y3 + 20) - th.off < 784; label: "Linear gradient" }
                        zone box cp_grad_radial { from: 720, y3 + 6; size: 84, 28; corner: 14; cursor: pointer; active: panel_gradient > 0 and (y3 + 20) - th.off > 176 and (y3 + 20) - th.off < 784; label: "Radial gradient" }
                        on scroll cp_grad_linear { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on scroll cp_grad_radial { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_grad_linear { emit ui_sound; panel_gradient = 1 }
                        on press cp_grad_radial { emit ui_sound; panel_gradient = 2 }

                        let y4 = 1214
                        let h4 = max(cp_grad_track.hover, cp_grad_track.pressed)
                        CpCard(250, y4, 570, 62)
                        text "Gradient strength" { at: 266, y4 + 20; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_gstr }
                        CpLeader(266 + m_th_gstr.width + 10, cp.sl_x - 10, y4 + 20, h4, d_pg)
                        text "Blend weight of the accent backdrop wash." { at: 266, y4 + 44; anchor: left center; size: 12.5; color: faint; family: "Space Grotesk" }
                        CpSlider(cp.sl_x, y4 + 20, cp.sl_w, cp.grad_pct, h4, cp.mint, d_pg)
                        text number(panel_gradient_strength, 0, "%") { at: cp.rx, y4 + 20; anchor: right center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }
                        zone box cp_grad_track { from: cp.sl_x - 6, y4 + 8; size: cp.sl_w + 12, 24; cursor: pointer; active: panel_gradient > 0 and (y4 + 20) - th.off > 176 and (y4 + 20) - th.off < 784; label: "Gradient strength" }
                        on scroll cp_grad_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                        on press cp_grad_track { panel_gradient_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                        on drag  cp_grad_track { panel_gradient_strength = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                    }

                    text "SURFACE FINISH" { at: 250, 1296; anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }

                    //  10.7 Light
                    let y5 = 1312
                    let h5 = max(cp_light_track.hover, cp_light_track.pressed)
                    CpCard(250, y5, 570, 56)
                    text "Light" { at: 266, y5 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_lgt }
                    CpLeader(266 + m_th_lgt.width + 10, cp.sl_x - 10, y5 + 19, h5)
                    text "Daylight mode (0% dark glass · 100% frost-white glass)." { at: 266, y5 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y5 + 19, cp.sl_w, cp.light_pct, h5, cp.mint)
                    text number(glass_light * 100, 0, "%") { at: cp.rx, y5 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_light_track { from: cp.sl_x - 6, y5 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y5 + 19) - th.off > 176 and (y5 + 19) - th.off < 784; label: "Glass light" }
                    on scroll cp_light_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_light_track { glass_preset_i = -1; glass_light = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }
                    on drag  cp_light_track { glass_preset_i = -1; glass_light = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }

                    //  10.8 Border
                    let y6 = 1374
                    let h6 = max(cp_border_track.hover, cp_border_track.pressed)
                    CpCard(250, y6, 570, 56)
                    text "Glass border" { at: 266, y6 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_brd }
                    CpLeader(266 + m_th_brd.width + 10, cp.sl_x - 10, y6 + 19, h6)
                    text "Thin specular line traced along outer glass frames." { at: 266, y6 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y6 + 19, cp.sl_w, cp.border_pct, h6, cp.mint)
                    text number(glass_border, 0, "%") { at: cp.rx, y6 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_border_track { from: cp.sl_x - 6, y6 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y6 + 19) - th.off > 176 and (y6 + 19) - th.off < 784; label: "Glass border" }
                    on scroll cp_border_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_border_track { glass_preset_i = -1; glass_border = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }
                    on drag  cp_border_track { glass_preset_i = -1; glass_border = clamp(round((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 100), 0, 100) }

                    //  10.9 Smoke
                    let y7 = 1436
                    let h7 = max(cp_smoke_track.hover, cp_smoke_track.pressed)
                    CpCard(250, y7, 570, 56)
                    text "Smoke" { at: 266, y7 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_smk }
                    CpLeader(266 + m_th_smk.width + 10, cp.sl_x - 10, y7 + 19, h7)
                    text "Neutral obsidian tint dampening bright wallpapers." { at: 266, y7 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y7 + 19, cp.sl_w, cp.smoke_pct, h7, cp.mint)
                    text number(glass_smoke * 100, 0, "%") { at: cp.rx, y7 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_smoke_track { from: cp.sl_x - 6, y7 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y7 + 19) - th.off > 176 and (y7 + 19) - th.off < 784; label: "Glass smoke" }
                    on scroll cp_smoke_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_smoke_track { glass_preset_i = -1; glass_smoke = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }
                    on drag  cp_smoke_track { glass_preset_i = -1; glass_smoke = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }

                    //  10.10 Vividness
                    let y8 = 1498
                    let h8 = max(cp_vivid_track.hover, cp_vivid_track.pressed)
                    CpCard(250, y8, 570, 56)
                    text "Vividness" { at: 266, y8 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_viv }
                    CpLeader(266 + m_th_viv.width + 10, cp.sl_x - 10, y8 + 19, h8)
                    text "Chroma boost of blurred colours behind the panel." { at: 266, y8 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y8 + 19, cp.sl_w, cp.vivid_pct, h8, cp.mint)
                    text number(glass_vivid, 2, "×") { at: cp.rx, y8 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_vivid_track { from: cp.sl_x - 6, y8 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y8 + 19) - th.off > 176 and (y8 + 19) - th.off < 784; label: "Glass vividness" }
                    on scroll cp_vivid_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_vivid_track { glass_preset_i = -1; glass_vivid = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }
                    on drag  cp_vivid_track { glass_preset_i = -1; glass_vivid = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }

                    //  10.11 Mirror
                    let y9 = 1560
                    let h9 = max(cp_mirror_track.hover, cp_mirror_track.pressed)
                    CpCard(250, y9, 570, 56)
                    text "Mirror" { at: 266, y9 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_mir }
                    CpLeader(266 + m_th_mir.width + 10, cp.sl_x - 10, y9 + 19, h9)
                    text "Fresnel edge reflection intensity." { at: 266, y9 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y9 + 19, cp.sl_w, cp.mirror_pct, h9, cp.mint)
                    text number(glass_mirror, 2, "×") { at: cp.rx, y9 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_mirror_track { from: cp.sl_x - 6, y9 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y9 + 19) - th.off > 176 and (y9 + 19) - th.off < 784; label: "Glass mirror" }
                    on scroll cp_mirror_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_mirror_track { glass_preset_i = -1; glass_mirror = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }
                    on drag  cp_mirror_track { glass_preset_i = -1; glass_mirror = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }

                    //  10.12 Highlight
                    let y10 = 1622
                    let h10 = max(cp_highlight_track.hover, cp_highlight_track.pressed)
                    CpCard(250, y10, 570, 56)
                    text "Highlight" { at: 266, y10 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_hi }
                    CpLeader(266 + m_th_hi.width + 10, cp.sl_x - 10, y10 + 19, h10)
                    text "Upper lip sheen across drawer rims." { at: 266, y10 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y10 + 19, cp.sl_w, cp.highlight_pct, h10, cp.mint)
                    text number(glass_highlight, 2, "×") { at: cp.rx, y10 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_highlight_track { from: cp.sl_x - 6, y10 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y10 + 19) - th.off > 176 and (y10 + 19) - th.off < 784; label: "Glass highlight" }
                    on scroll cp_highlight_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_highlight_track { glass_preset_i = -1; glass_highlight = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }
                    on drag  cp_highlight_track { glass_preset_i = -1; glass_highlight = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w * 2, 0, 2) }

                    //  10.13 Ripple
                    let y11 = 1684
                    let h11 = max(cp_ripple_track.hover, cp_ripple_track.pressed)
                    CpCard(250, y11, 570, 56)
                    text "Edge ripple" { at: 266, y11 + 19; anchor: left center; size: 15.5; weight: 700; color: ink; family: "Space Grotesk"; measure: m_th_rip }
                    CpLeader(266 + m_th_rip.width + 10, cp.sl_x - 10, y11 + 19, h11)
                    text "Subtle distortion travelling around interactive rims." { at: 266, y11 + 40; anchor: left center; size: 12; color: faint; family: "Space Grotesk" }
                    CpSlider(cp.sl_x, y11 + 19, cp.sl_w, cp.ripple_pct, h11, cp.mint)
                    text number(glass_ripple * 100, 0, "%") { at: cp.rx, y11 + 19; anchor: right center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }
                    zone box cp_ripple_track { from: cp.sl_x - 6, y11 + 7; size: cp.sl_w + 12, 24; cursor: pointer; active: (y11 + 19) - th.off > 176 and (y11 + 19) - th.off < 784; label: "Edge ripple" }
                    on scroll cp_ripple_track { cp_sc_th_to = clamp(cp_sc_th_to - wheel * 48, 0, th.max_s) }
                    on press cp_ripple_track { glass_preset_i = -1; glass_ripple = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }
                    on drag  cp_ripple_track { glass_preset_i = -1; glass_ripple = clamp((pointer.x - cp.sx - cp.sl_x) / cp.sl_w, 0, 1) }
                }

                let th.cuey = 762 + 2 * sin(cp_clk * 240)
                CpMoreCue(th.cue, th.cuey, th_cue_hit.hover)
                zone box th_cue_hit { at: 535, 762; size: 84, 28; corner: 14; cursor: pointer; active: th.cue > 0.4; label: "Scroll down" }
                on press th_cue_hit { emit ui_sound; cp_sc_th_to = clamp(cp_sc_th_to + 320, 0, th.max_s) }
            }

            box { from: 829, cp.vy; size: 4, cp.vh; corner: 2; color: ink; opacity: 8% }
            box { from: 829, cp.vy + (cp.vh - th.th) * clamp(th.sc / th.max_s, 0, 1); size: 4, th.th; corner: 2; color: cp.mint; opacity: 45% + 40% * th_bar_hit.hover }
            zone box th_bar_hit { from: 824, cp.vy; size: 14, cp.vh; cursor: pointer; label: "Scroll Theme settings" }
            on press th_bar_hit { cp_sc_th_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - th.th / 2) / max(1, cp.vh - th.th) * th.max_s, 0, th.max_s) }
            on drag  th_bar_hit { cp_sc_th_to = clamp((((pointer.y - notch_clock_h) - cp.vy) - th.th / 2) / max(1, cp.vh - th.th) * th.max_s, 0, th.max_s) }
        }
    }
}
