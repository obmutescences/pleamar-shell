            text "Clock" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "12 or 24 hour; seconds." { at: 266, 270; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
