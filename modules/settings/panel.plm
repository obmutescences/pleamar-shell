part ConfigPanel {
    //  Vitreus's settings panel, cut down to the pages we need: FRAME MUSIC,
    //  GLASS, BAR and FONT.  Header with badge/breadcrumb, sidebar, page of
    //  rows with sliders, switches and the font list; most changes apply
    //  right away, the font one restarts the shell.
    //  These follow the wallpaper palette: the settings card is its surface
    //  colour, the plates are a veil over it, and the accent is its primary.
    let cp.card = rgb(pal_panel_r, pal_panel_g, pal_panel_b)
    let cp.track = mix(tint, ink, 0.10)
    let cp.mint = aqua
    let cp.row = 62
    let cp.step = 66
    let cp.y0 = 176
    let cp.slider_x = 520
    let cp.slider_w = 200
    //  Sidebar rhythm, as Vitreus's settings panel: one slot for each group
    //  heading and one for each page.  The highlight follows the slot with a
    //  spring, so it slides between pages instead of jumping.
    let cp.nav_y = 108
    let cp.nav_step = 32

    //  The Control Center's slider: a pill track in a crooked double outline,
    //  the level drawn in tight pencil columns, and a ring for the knob.  The
    //  level follows a spring, but the outline is still, so a shut settings
    //  page does not keep the shell awake.
    component CpSlider(x0: number, y: number, w: number, lv: number, hot: number, accent: color, ink: color, track: color) {
        prop p = 0 ~quick
        follow p = lv
        let h = 12
        let kx = clamp(x0 + w * p, x0 + h * 0.6, x0 + w - h * 0.6)
        let xs = x0 + h * 0.5
        let sp = (w - h) / 40
        box { from: x0, y - h / 2; size: w, h; corner: h / 2; color: track; opacity: 48% }
        box { from: x0, y - h / 2; size: w, h; corner: h / 2; stroke: 1.4; color: ink; opacity: 52% + 12% * hot }
        box { from: x0 + 0.4, y - h / 2 + 0.35; size: w - 0.8, h - 0.7; corner: (h - 0.7) / 2; stroke: 0.9; color: ink; opacity: 20% + 10% * hot }
        box { from: x0 + 2, y - h / 2 + 2; size: max(2, kx - x0 - 2), h - 4; corner: (h - 4) / 2; color: accent; opacity: 13% }
        repeat i in 0..40 {
            let hx = xs + i * sp
            line { from: hx - 1.1, y - h * 0.36; to: hx + 1.1, y + h * 0.36; width: 1.2; color: accent; opacity: if(hx <= kx, 62%, 0) }
        }
        repeat i in 0..20 {
            let hx = xs + i * sp * 2 + 1.4
            line { from: hx - 0.6, y - h * 0.28; to: hx + 0.6, y + h * 0.28; width: 0.8; color: accent; opacity: if(hx <= kx, 24%, 0) }
        }
        ellipse { at: kx, y; radius: h * 0.85 + 1.2 * hot; stroke: 1.5; color: ink; opacity: 88% }
        ellipse { at: kx + 0.35, y + 0.28; radius: h * 0.7; stroke: 0.9; color: ink; opacity: 24% }
        ellipse { at: kx, y; radius: h * 0.55; color: ink; opacity: 12% }
    }

    //  SettingsSwitch as Vitreus draws it: the right edge fixed, the track
    //  34 px off and 38 px on, 22 px high, the knob 17 px across and turning
    //  from a circle into a rounded square.  `knob` is the spring, `on` the
    //  colour state; hit zones remain the caller's.
    component CpSwitch(x: number, y: number, w: number, h: number, on: number, knob: number, hot: number, accent: color, ink: color, off: color) {
        let cy = y + h / 2
        let sw = 34 + 4 * knob
        let rx = x + w
        let scx = rx - sw / 2
        let sl = scx - sw / 2
        let kx = sl + 11 + knob * (sw - 22)
        let m = clamp(4 * knob * (1 - knob), 0, 1)
        let kw = 17 + 9 * m
        let kh = 17 - 3 * m
        body {
            color: mix(off, accent, knob)
            shadow: 0, 0, 10 * knob, 48% * knob, accent
            rim: 16% * knob
            box { at: scx, cy; size: sw, 22; corner: 11 - 2 * knob }
        }
        group {
            clip inset 0 box { at: scx, cy; size: sw, 22; corner: 11 - 2 * knob }
            box { from: sl - 6, cy - 18; size: sw + 12, 9; color: #000000; opacity: 26% * (1 - knob) }
            box { from: sl, cy + 9.5; size: sw, 1.5; color: ink; opacity: 12% * (1 - knob) }
            repeat i in 0..8 {
                box { at: sl + 4.5 + 5 * i - (knob - 0.5) * 9, cy; size: 1.2, 9; corner: 0.6; color: ink; opacity: 24% * m }
            }
        }
        box { at: scx, cy; size: sw, 22; corner: 11 - 2 * knob; stroke: 1.3; color: ink; opacity: 54% + 12% * hot }
        box { at: scx + 0.35, cy + 0.28; size: sw - 0.7, 21.4; corner: 10.8 - 2 * knob; stroke: 0.9; color: ink; opacity: 18% + 8% * hot }
        body {
            color: ink
            shadow: 0, 2, 5, 26%
            box { at: kx, cy; size: kw, kh; corner: 8.5 - 2 * knob - 1.5 * m }
        }
    }

    //  A pill button: a quiet ink well at rest, an accent outline and a faint
    //  lit fill when selected or hovered.  Labels are still drawn by the page.
    component CpPill(x: number, y: number, w: number, h: number, sel: number, hot: number, accent: color, ink: color) {
        box { from: x, y; size: w, h; corner: h / 2; color: if(sel > 0.5, accent, ink); opacity: if(sel > 0.5, 18%, 5% + 7% * hot) }
        box { from: x, y; size: w, h; corner: h / 2; stroke: 1; color: if(sel > 0.5, accent, ink); opacity: if(sel > 0.5, 52%, 10% + 10% * hot) }
        box { from: x + 7, y + 2; size: w - 14, 1; corner: 0.5; color: ink; opacity: if(sel > 0.5, 10%, 5%) }
    }

    //  A row card with the hairline edge and the slightly raised plate used by
    //  Vitreus's settings pages.
    component CpCard(x: number, y: number, w: number, h: number) {
        box { from: x, y; size: w, h; corner: 12; color: ink; opacity: 3% }
        box { from: x, y; size: w, h; corner: 12; stroke: 1; color: ink; opacity: 9% }
    }
    let cp.tint_pct = clamp((glass_tint - 20) / 80, 0, 1)
    let cp.panel_pct = clamp(panel_bg_tint / 100, 0, 1)
    let cp.frost_pct = clamp(glass_frost / 100, 0, 1)
    let cp.edge_pct = clamp(glass_edge / 100, 0, 1)
    let cp.refr_pct = clamp(glass_refr / 2, 0, 1)
    let cp.disp_pct = clamp(glass_disp / 2, 0, 1)
    let cp.dome_pct = clamp(glass_dome / 1.5, 0, 1)
    let cp.milk_pct = clamp(glass_milk, 0, 1)
    let cp.smoke_pct = clamp(glass_smoke, 0, 1)
    let cp.vivid_pct = clamp(glass_vivid / 2, 0, 1)
    let cp.mirror_pct = clamp(glass_mirror / 2, 0, 1)
    let cp.highlight_pct = clamp(glass_highlight / 2, 0, 1)
    let cp.ripple_pct = clamp(glass_ripple, 0, 1)
    let cp.light_pct = clamp(glass_light, 0, 1)
    let cp.border_pct = clamp(glass_border / 100, 0, 1)
    let cp.grad_pct = clamp(panel_gradient_strength / 100, 0, 1)
    let cp.amp_pct = clamp((wave_amp - 0.2) / 2.0, 0, 1)
    let cp.height_pct = clamp(wave_height / 3, 0, 1)
    let cp.bar_pct = clamp((bar_height - 32) / 48, 0, 1)
    let cp.gain_pct = clamp((wave_gain - 0.8) / 1.6, 0, 1)
    let cp.rip_pct = clamp((wave_ripples - 1) / 9, 0, 1)
    let cp.blend_pct = clamp(wave_blend, 0, 1)
    let cp.win_size_pct = clamp((winpicker_size - 140) / 280, 0, 1)
    let cp.win_cols_pct = clamp((winpicker_cols - 2) / 6, 0, 1)
    let cp.win_ms_pct = clamp((winpicker_ms - 160) / 740, 0, 1)
    let cp.win_bg_blur_pct = clamp(winpicker_bg_blur / 100, 0, 1)
    //  IDLE_STEPS in scenes/lib/shell.luau has 17 entries (0, 5 s, 10 s, 30 s,
    //  then minutes to 2 h); the slider addresses its last index, 16.
    let cp.idle_lock_pct = clamp(idle_lock_i / 16, 0, 1)
    let cp.idle_off_pct = clamp(idle_off_i / 16, 0, 1)
    measure cp_parent
    let wp.min_pct = clamp((wall_minutes - 1) / 59, 0, 1)
    prop cp_p = 0 ~gentle
    follow cp_p = panel_open
    //  Sidebar slot of each page, in visual order:
    //  LOOK: Wallpaper, Glass, Theme · SHELL: Bar, Frame music, Typeface,
    //  Motion, Notifications, Windows · SCREEN: Lock, Idle · SYSTEM: Weather.
    prop cp_nav = 2 ~quick
    follow cp_nav = pick(settings_page, 6, 2, 5, 7, 1, 9, 8, 12, 13, 15, 10, 3)
    //  0 LOOK · 1 SHELL · 2 SCREEN · 3 SYSTEM; follows the page's parent.
    prop cp_grp = 0 ~quick
    follow cp_grp = pick(settings_page, 1, 0, 1, 1, 0, 1, 1, 2, 2, 3, 1, 0)

    surface config_panel {
        size: 860, 820
        anchor: center
        level: overlay
        open: panel_open or cp_p > 0.01
        rate: 120, 30 while quiet
        //  The invisible settingskeys helper owns the keyboard; main
        //  Pleamar scenes with many surfaces do not receive layer keys.
        keyboard: none

        //  A full-surface shield under the controls, so a click on an empty
        //  part of the page is still the panel's and never reaches the window
        //  behind it.  It is declared first; the real controls are above it.
        zone box cp_shield { from: 0, 0; size: 860, 820; active: panel_open; label: "Settings" }
        on press cp_shield { panel_open = panel_open }

        PanelPop(panel_fx, cp_p, 860, 820) {
        PanelBackdrop(0, 0, 860, 820, 26)
        body {
            color: panel_bg
            glass: if(glass_on, 100%, 0%)
            opacity: 1% * max(glass_tint, 82)
            lens: glass_on and glass_bend
            shine: pointer
            frost: glass_frost / 100
            refraction: glass_refr
            dispersion: glass_disp
            dome: glass_dome
            milk: glass_milk
            smoke: glass_smoke
            vivid: glass_vivid
            mirror: glass_mirror
            highlight: glass_highlight
            ripple: glass_ripple
            border: 1.5 * glass_border / 100, ink
            rim: 1% * glass_edge
            shadow: 0, 4, 12, 20%, glass_shadow
            box { from: 0, 0; size: 860, 820; corner: 26 }
        }
        box { from: 0, 0; size: 860, 820; corner: 26; stroke: 1; color: ink; opacity: 8% }

        //  ── header ───────────────────────────────────────────────────────
        box { from: 28, 28; size: 34, 34; corner: 9; color: cp.mint; opacity: 18% }
        repeat k in 0..7 {
            let a0 = k * 45
            let a1 = a0 + 45
            line { from: 45 + 9 * cos(a0), 45 + 9 * sin(a0); to: 45 + 9 * cos(a1), 45 + 9 * sin(a1); width: 1.4; color: cp.mint; opacity: 80% }
        }
        ellipse { at: 45, 45; radius: 4; stroke: 1.4; color: cp.mint }
        ellipse { at: 45, 45; radius: 1.5; color: cp.mint }

        text "SETTINGS" { at: 76, 45; anchor: left center; size: 21; weight: 700; color: ink; family: "Space Grotesk" }
        path { at: 190, 45; stroke: 1.3; color: faint; move -2, -3.5; line 2, 0; line -2, 3.5 }
        text pick(settings_page, "SHELL", "LOOK", "SHELL", "SHELL", "LOOK", "SHELL", "SHELL", "SCREEN", "SCREEN", "SYSTEM", "SHELL", "LOOK") { at: 202, 45; anchor: left center; size: 13.5; weight: 700; color: faint; family: "Space Grotesk"; measure: cp_parent }
        path { at: 202 + cp_parent.width + 10, 45; stroke: 1.3; color: faint; move -2, -3.5; line 2, 0; line -2, 3.5 }
        text pick(settings_page, "Frame music", "Glass", "Bar", "Font", "Wallpaper", "Notifications", "Motion", "Lock screen", "Idle", "Weather", "Windows", "Theme") { at: 202 + cp_parent.width + 22, 45; anchor: left center; size: 14.5; weight: 700; color: cp.mint; family: "Space Grotesk" }

        line { from: 824, 38; to: 834, 48; width: 1.5; color: ink; opacity: 55% + 45% * cp_close.hover }
        line { from: 834, 38; to: 824, 48; width: 1.5; color: ink; opacity: 55% + 45% * cp_close.hover }
        zone box cp_close { from: 816, 30; size: 28, 28; corner: 14; cursor: pointer; label: "Close settings" }
        on press cp_close { emit ui_sound; panel_open = false }

        line { from: 28, 84; to: 832, 84; width: 1; color: ink; opacity: 10% }

        //  ── sidebar ──────────────────────────────────────────────────────
        //  LOOK / SHELL / SCREEN / SYSTEM: the parent group owns the page's
        //  visual family.  Every group heading is a target for its first page.
        box { from: 28, 100; size: 194, 520; corner: 14; color: ink; opacity: 4% }
        box { from: 28, 100; size: 194, 520; corner: 14; stroke: 1; color: ink; opacity: 9% }

        //  The selected row: one highlight, sprung between slots.  Each page
        //  slot is 32 px apart; the headings use the same grid so the rail keeps
        //  its rhythm without a second layout table.
        box { from: 38, cp.nav_y + cp_nav * cp.nav_step; size: 174, 28; corner: 10; color: cp.mint; opacity: 14% }
        box { from: 38, cp.nav_y + cp_nav * cp.nav_step; size: 174, 28; corner: 10; stroke: 1; color: cp.mint; opacity: 26% }

        text "LOOK" { at: 44, cp.nav_y + 14; anchor: left center; size: 11.5; weight: 700; color: mix(faint, cp.mint, clamp(1 - abs(cp_grp - 0), 0, 1)); family: "Space Grotesk" }
        zone box cp_group_look { from: 38, cp.nav_y; size: 174, 28; corner: 9; cursor: pointer; label: "Look settings" }
        on press cp_group_look { emit ui_sound; settings_page = 4 }

        group {
            let yy = cp.nav_y + 1 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 1), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                box { at: 54, yy + 14; size: 16, 13; corner: 3; stroke: 1.4; color: sc }
                box { at: 56, yy + 17; size: 8, 7; corner: 1; color: sc; opacity: 32% }
                line { from: 52, yy + 24; to: 65, yy + 11; width: 1.2; color: sc; opacity: 70% }
            }
            text "Wallpaper" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_wallpaper { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Wallpaper settings" }
            on press cp_page_wallpaper { emit ui_sound; settings_page = 4 }
        }

        group {
            let yy = cp.nav_y + 6 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 6), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                line { from: 51, yy + 8; to: 51, yy + 20; width: 2; color: sc }
                line { from: 56, yy + 11; to: 56, yy + 17; width: 2; color: sc; opacity: 80% }
                line { from: 61, yy + 6; to: 61, yy + 22; width: 2; color: sc }
            }
            text "Frame music" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_music { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Frame music settings" }
            on press cp_page_music { emit ui_sound; settings_page = 0 }
        }

        group {
            let yy = cp.nav_y + 2 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 2), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                box { at: 54, yy + 14; size: 16, 16; corner: 4; stroke: 1.4; color: sc }
                line { from: 52, yy + 18; to: 66, yy + 24; width: 1.2; color: sc; opacity: 75% }
            }
            text "Glass" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_glass { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Glass settings" }
            on press cp_page_glass { emit ui_sound; settings_page = 1 }
        }

        group {
            let yy = cp.nav_y + 3 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 3), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                ellipse { at: 50, yy + 13; radius: 6; stroke: 1.3; color: sc; opacity: 85% }
                ellipse { at: 58, yy + 13; radius: 6; stroke: 1.3; color: sc; opacity: 60% }
                ellipse { at: 54, yy + 19; radius: 6; stroke: 1.3; color: sc; opacity: 45% }
            }
            text "Theme" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_theme { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Theme and material settings" }
            on press cp_page_theme { emit ui_sound; settings_page = 11 }
        }

        text "SHELL" { at: 44, cp.nav_y + 4 * cp.nav_step + 14; anchor: left center; size: 11.5; weight: 700; color: mix(faint, cp.mint, clamp(1 - abs(cp_grp - 1), 0, 1)); family: "Space Grotesk" }
        zone box cp_group_shell { from: 38, cp.nav_y + 4 * cp.nav_step; size: 174, 28; corner: 9; cursor: pointer; label: "Shell settings" }
        on press cp_group_shell { emit ui_sound; settings_page = 2 }

        group {
            let yy = cp.nav_y + 5 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 5), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                box { at: 54, yy + 14; size: 16, 6; corner: 3; stroke: 1.4; color: sc }
                box { at: 60, yy + 11; size: 4, 12; corner: 2; color: sc; opacity: 80% }
            }
            text "Bar" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_bar { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Bar settings" }
            on press cp_page_bar { emit ui_sound; settings_page = 2 }
        }

        group {
            let yy = cp.nav_y + 7 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 7), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                text "Aa" { at: 52, yy + 14; anchor: left center; size: 13; weight: 700; color: sc; family: "Space Grotesk" }
            }
            text "Typeface" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_font { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Font settings" }
            on press cp_page_font { emit ui_sound; settings_page = 3 }
        }

        group {
            let yy = cp.nav_y + 8 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 8), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                line { from: 52, yy + 11; to: 66, yy + 11; width: 1.4; color: sc; opacity: 85% }
                line { from: 52, yy + 17; to: 62, yy + 17; width: 1.4; color: sc; opacity: 70% }
                line { from: 52, yy + 23; to: 69, yy + 23; width: 1.4; color: sc; opacity: 85% }
            }
            text "Motion" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_motion { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Panel motion settings" }
            on press cp_page_motion { emit ui_sound; settings_page = 6 }
        }

        group {
            let yy = cp.nav_y + 9 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 9), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                path { at: 60, yy + 14; stroke: 1.4; color: sc; move -7, 4; line -5, -1; curve -5, -7 via 0, -9; curve 5, -7 via 5, -1; line 7, 4 }
                line { from: 53, yy + 18; to: 67, yy + 18; width: 1.3; color: sc; opacity: 85% }
            }
            text "Notifications" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_nt { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Notification settings" }
            on press cp_page_nt { emit ui_sound; settings_page = 5 }
        }

        group {
            let yy = cp.nav_y + 10 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 10), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                box { at: 54, yy + 14; size: 16, 12; corner: 3; stroke: 1.4; color: sc }
                box { at: 60, yy + 14; size: 7, 9; corner: 1.5; stroke: 1; color: sc; opacity: 75% }
            }
            text "Windows" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_windows { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Window picker settings" }
            on press cp_page_windows { emit ui_sound; settings_page = 10 }
        }

        text "SCREEN" { at: 44, cp.nav_y + 11 * cp.nav_step + 14; anchor: left center; size: 11.5; weight: 700; color: mix(faint, cp.mint, clamp(1 - abs(cp_grp - 2), 0, 1)); family: "Space Grotesk" }
        zone box cp_group_screen { from: 38, cp.nav_y + 11 * cp.nav_step; size: 174, 28; corner: 9; cursor: pointer; label: "Screen settings" }
        on press cp_group_screen { emit ui_sound; settings_page = 7 }

        group {
            let yy = cp.nav_y + 12 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 12), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                box { at: 54, yy + 16; size: 16, 12; corner: 3; stroke: 1.4; color: sc }
                path { at: 60, yy + 16; stroke: 1.4; color: sc; move -5, 0; line -5, -4; curve -5, -7 via 0, -8; curve 5, -7 via 5, -4; line 5, 0 }
            }
            text "Lock screen" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_lock { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Lock screen settings" }
            on press cp_page_lock { emit ui_sound; settings_page = 7 }
        }

        group {
            let yy = cp.nav_y + 13 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 13), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                ellipse { at: 54, yy + 14; radius: 8; stroke: 1.4; color: sc }
                line { from: 54, yy + 14; to: 54, yy + 8; width: 1.4; color: sc }
                line { from: 54, yy + 14; to: 59, yy + 17; width: 1.4; color: sc }
            }
            text "Idle" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_idle { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Idle settings" }
            on press cp_page_idle { emit ui_sound; settings_page = 8 }
        }

        text "SYSTEM" { at: 44, cp.nav_y + 14 * cp.nav_step + 14; anchor: left center; size: 11.5; weight: 700; color: mix(faint, cp.mint, clamp(1 - abs(cp_grp - 3), 0, 1)); family: "Space Grotesk" }
        zone box cp_group_system { from: 38, cp.nav_y + 14 * cp.nav_step; size: 174, 28; corner: 9; cursor: pointer; label: "System settings" }
        on press cp_group_system { emit ui_sound; settings_page = 9 }

        group {
            let yy = cp.nav_y + 15 * cp.nav_step
            let sel = clamp(1 - abs(cp_nav - 15), 0, 1)
            let sc = mix(faint, cp.mint, sel)
            group {
                pivot: 54, yy + 14
                scale: 1 + 0.10 * sel
                ellipse { at: 54, yy + 14; radius: 8; stroke: 1.4; color: sc }
                text "☀" { at: 54, yy + 14; anchor: center; size: 10; color: sc; family: "Noto Sans CJK SC" }
            }
            text "Weather" { at: 78, yy + 14; anchor: left center; size: 15; weight: 600; color: mix(faint, cp.mint, sel); opacity: 72% + 28% * sel; family: "Space Grotesk" }
            zone box cp_page_weather { from: 38, yy; size: 174, 28; corner: 10; cursor: pointer; label: "Weather settings" }
            on press cp_page_weather { emit ui_sound; settings_page = 9 }
        }

        //  ── page header ──────────────────────────────────────────────────
        text pick(settings_page, "Frame music", "Glass", "Bar", "Font", "Wallpaper", "Notifications", "Motion", "Lock screen", "Idle", "Weather", "Windows", "Theme") { at: 250, 132; anchor: left center; size: 19.5; weight: 700; color: ink; family: "Space Grotesk" }
        text pick(settings_page, "Changes apply right away.", "Changes apply right away.", "Changes apply right away.", "Apply restarts the shell.", "Click a picture to set it.", "Position, sounds, countdown.", "One pose per panel.", "Lock appearance and a safe test.", "Lock and screen-off timers; no suspend.", "City for the centre panel.", "Grid, letters, reveal and duration.", "Presets, gradient, light and border.") { at: 820, 132; anchor: right center; size: 15; color: faint; opacity: 80%; family: "Space Grotesk" }

        //  ── FRAME MUSIC ──────────────────────────────────────────────────
        group {
            show: settings_page == 0

            CpCard(250, 176, 570, 62)
            text "Frame music" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Let the four-edge wave follow the system sink." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 195, 44, 24, if(wave_on, 1, 0), cfg_knob, cp_music_switch.hover, cp.mint, ink, cp.track)
            zone box cp_music_switch { from: 760, 186; size: 64, 38; corner: 19; cursor: pointer; label: "Frame music" }
            on press cp_music_switch { emit ui_sound; toggle wave_on }

            CpCard(250, 242, 570, 62)
            text "Amplitude" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How far the wave reaches into the screen." { at: 266, 270; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 289, 200, cp.amp_pct, cp_amp_track.hover, cp.mint, ink, cp.track)
            text number(wave_amp * 100, 0, "%") { at: 820, 289; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_amp_track { from: 510, 274; size: 240, 30; cursor: pointer; label: "Amplitude" }
            on press cp_amp_track { wave_amp = clamp(0.2 + (pointer.x - 520) / 200 * 2.0, 0.2, 2.2) }
            on drag cp_amp_track { wave_amp = clamp(0.2 + (pointer.x - 520) / 200 * 2.0, 0.2, 2.2) }

            CpCard(250, 308, 570, 62)
            text "Sensitivity" { at: 266, 318; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How strongly quiet passages move the wave." { at: 266, 336; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 355, 200, cp.gain_pct, cp_gain_track.hover, cp.mint, ink, cp.track)
            text number(wave_gain * 100, 0, "%") { at: 820, 355; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_gain_track { from: 510, 340; size: 240, 30; cursor: pointer; label: "Sensitivity" }
            on press cp_gain_track { wave_gain = clamp(0.8 + (pointer.x - 520) / 200 * 1.6, 0.8, 2.4) }
            on drag cp_gain_track { wave_gain = clamp(0.8 + (pointer.x - 520) / 200 * 1.6, 0.8, 2.4) }

            CpCard(250, 374, 570, 62)
            text "Ripples" { at: 266, 384; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "One long wave, or up to ten finer trains." { at: 266, 402; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 421, 200, cp.rip_pct, cp_rip_track.hover, cp.mint, ink, cp.track)
            text number(wave_ripples, 0, "") { at: 820, 421; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_rip_track { from: 510, 406; size: 240, 30; cursor: pointer; label: "Ripples" }
            on press cp_rip_track { wave_ripples = clamp(round(1 + (pointer.x - 520) / 200 * 9), 1, 10) }
            on drag cp_rip_track { wave_ripples = clamp(round(1 + (pointer.x - 520) / 200 * 9), 1, 10) }

            CpCard(250, 440, 570, 62)
            text "Wave height" { at: 266, 450; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How tall each ripple rises; higher is less smooth." { at: 266, 468; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 487, 200, cp.height_pct, cp_height_track.hover, cp.mint, ink, cp.track)
            text number(wave_height * 100, 0, "%") { at: 820, 487; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_height_track { from: 510, 472; size: 240, 30; cursor: pointer; label: "Wave height" }
            on press cp_height_track { wave_height = clamp((pointer.x - 520) / 200 * 3, 0, 3) }
            on drag cp_height_track { wave_height = clamp((pointer.x - 520) / 200 * 3, 0, 3) }

            CpCard(250, 506, 570, 62)
            text "Blend" { at: 266, 516; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How much the bands melt into each other." { at: 266, 534; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 553, 200, cp.blend_pct, cp_blend_track.hover, cp.mint, ink, cp.track)
            text number(wave_blend * 100, 0, "%") { at: 820, 553; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_blend_track { from: 510, 538; size: 240, 30; cursor: pointer; label: "Blend" }
            on press cp_blend_track { wave_blend = clamp((pointer.x - 520) / 200, 0, 1) }
            on drag cp_blend_track { wave_blend = clamp((pointer.x - 520) / 200, 0, 1) }
        }

        //  ── GLASS ────────────────────────────────────────────────────────
        group {
            show: settings_page == 1

            CpCard(250, 176, 570, 62)
            text "Glass" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Off for a solid tint, with no glass at all." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 195, 44, 24, if(glass_on, 1, 0), glass_knob, cp_glass_switch.hover, cp.mint, ink, cp.track)
            zone box cp_glass_switch { from: 760, 186; size: 64, 38; corner: 19; cursor: pointer; label: "Glass" }
            on press cp_glass_switch { toggle glass_on }

            CpCard(250, 242, 570, 62)
            text "Bend what's behind" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Lens: bends the background. Off uses the compositor's blur." { at: 266, 270; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 261, 44, 24, if(glass_bend, 1, 0), bend_knob, cp_bend_switch.hover, cp.mint, ink, cp.track)
            zone box cp_bend_switch { from: 760, 252; size: 64, 38; corner: 19; cursor: pointer; label: "Bend what's behind" }
            on press cp_bend_switch { toggle glass_bend }

            CpCard(250, 308, 570, 62)
            text "Blur" { at: 266, 318; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Lens blur inside the glass; needs Bend on. 0% is clear." { at: 266, 336; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 355, 200, cp.frost_pct, cp_frost_track.hover, cp.mint, ink, cp.track)
            text number(glass_frost, 0, "%") { at: 820, 355; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            text "Bend off" { at: 820, 336; anchor: right center; size: 11; weight: 600; color: faint; show: not glass_bend; family: "Space Grotesk" }
            zone box cp_frost_track { from: 510, 340; size: 240, 30; cursor: pointer; label: "Blur" }
            on press cp_frost_track { glass_frost = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
            on drag cp_frost_track { glass_frost = clamp((pointer.x - 520) / 200 * 100, 0, 100) }

            CpCard(250, 374, 570, 62)
            text "Opacity" { at: 266, 384; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How solid; below 20% the glass would vanish." { at: 266, 402; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 421, 200, cp.tint_pct, cp_tint_track.hover, cp.mint, ink, cp.track)
            text number(glass_tint, 0, "%") { at: 820, 421; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_tint_track { from: 510, 406; size: 240, 30; cursor: pointer; label: "Opacity" }
            on press cp_tint_track { glass_tint = clamp(20 + (pointer.x - 520) / 200 * 80, 20, 100) }
            on drag cp_tint_track { glass_tint = clamp(20 + (pointer.x - 520) / 200 * 80, 20, 100) }

            CpCard(250, 440, 570, 62)
            text "Edge light" { at: 266, 450; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How bright the light along the glass edge is." { at: 266, 468; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 487, 200, cp.edge_pct, cp_edge_track.hover, cp.mint, ink, cp.track)
            text number(glass_edge, 0, "%") { at: 820, 487; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_edge_track { from: 510, 472; size: 240, 30; cursor: pointer; label: "Edge light" }
            on press cp_edge_track { glass_edge = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
            on drag cp_edge_track { glass_edge = clamp((pointer.x - 520) / 200 * 100, 0, 100) }

            CpCard(250, 506, 570, 62)
            text "Edge thickness" { at: 266, 516; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How much the edge bends what is behind it." { at: 266, 534; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 553, 200, cp.refr_pct, cp_refr_track.hover, cp.mint, ink, cp.track)
            text number(glass_refr, 1, "") { at: 820, 553; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_refr_track { from: 510, 538; size: 240, 30; cursor: pointer; label: "Edge thickness" }
            on press cp_refr_track { glass_refr = clamp((pointer.x - 520) / 200 * 2, 0, 2) }
            on drag cp_refr_track { glass_refr = clamp((pointer.x - 520) / 200 * 2, 0, 2) }

            CpCard(250, 572, 570, 62)
            text "Rainbow fringe" { at: 266, 582; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How far red, green and blue split at the edge." { at: 266, 600; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 619, 200, cp.disp_pct, cp_disp_track.hover, cp.mint, ink, cp.track)
            text number(glass_disp, 1, "") { at: 820, 619; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_disp_track { from: 510, 604; size: 240, 30; cursor: pointer; label: "Rainbow fringe" }
            on press cp_disp_track { glass_disp = clamp((pointer.x - 520) / 200 * 2, 0, 2) }
            on drag cp_disp_track { glass_disp = clamp((pointer.x - 520) / 200 * 2, 0, 2) }

            CpCard(250, 638, 570, 62)
            text "Dome" { at: 266, 648; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Magnifies what is behind, towards the middle." { at: 266, 666; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 685, 200, cp.dome_pct, cp_dome_track.hover, cp.mint, ink, cp.track)
            text number(glass_dome, 1, "") { at: 820, 685; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_dome_track { from: 510, 670; size: 240, 30; cursor: pointer; label: "Dome" }
            on press cp_dome_track { glass_dome = clamp((pointer.x - 520) / 200 * 1.5, 0, 1.5) }
            on drag cp_dome_track { glass_dome = clamp((pointer.x - 520) / 200 * 1.5, 0, 1.5) }

            CpCard(250, 704, 570, 62)
            text "Milk" { at: 266, 714; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A milky veil inside the glass." { at: 266, 732; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 751, 200, cp.milk_pct, cp_milk_track.hover, cp.mint, ink, cp.track)
            text number(glass_milk, 1, "") { at: 820, 751; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_milk_track { from: 510, 736; size: 240, 30; cursor: pointer; label: "Milk" }
            on press cp_milk_track { glass_milk = clamp((pointer.x - 520) / 200, 0, 1) }
            on drag cp_milk_track { glass_milk = clamp((pointer.x - 520) / 200, 0, 1) }
        }

        //  ── BAR ──────────────────────────────────────────────────────────
        group {
            show: settings_page == 2

            CpCard(250, 176, 570, 94)
            text "Height" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Height of the floating island bar." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 243, 200, cp.bar_pct, cp_bar_track.hover, cp.mint, ink, cp.track)
            text number(bar_height, 0, "px") { at: 820, 243; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_bar_track { from: 510, 228; size: 240, 30; cursor: pointer; label: "Bar height" }
            on press cp_bar_track { bar_height = clamp(32 + (pointer.x - 520) / 200 * 48, 32, 80) }
            on drag cp_bar_track { bar_height = clamp(32 + (pointer.x - 520) / 200 * 48, 32, 80) }

            CpCard(250, 286, 570, 62)
            text "Panel sound" { at: 266, 296; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "A small click when the bar or a panel is pressed." { at: 266, 314; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 305, 44, 24, if(snd_on, 1, 0), snd_knob, cp_snd_switch.hover, cp.mint, ink, cp.track)
            zone box cp_snd_switch { from: 760, 296; size: 64, 38; corner: 19; cursor: pointer; label: "Panel sound" }
            on press cp_snd_switch { emit ui_sound; toggle snd_on }

            text "PANEL TINT" { at: 250, 362; anchor: left center; size: 9; weight: 700; color: faint; family: "Space Grotesk" }
            CpCard(250, 376, 570, 62)
            text "Panel colour" { at: 266, 386; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Wallpaper role behind every panel." { at: 266, 404; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpPill(610, 392, 100, 30, if(panel_bg_role == 0, 1, 0), 0, cp.mint, ink)
            text "Primary" { at: 660, 407; anchor: center; size: 11; weight: 700; color: if(panel_bg_role == 0, cp.mint, faint); family: "Space Grotesk" }
            zone box cp_panel_role_primary { from: 610, 392; size: 100, 30; corner: 15; cursor: pointer; label: "Primary panel colour" }
            on press cp_panel_role_primary { panel_bg_role = 0 }
            CpPill(714, 392, 100, 30, if(panel_bg_role == 1, 1, 0), 0, cp.mint, ink)
            text "Secondary" { at: 764, 407; anchor: center; size: 11; weight: 700; color: if(panel_bg_role == 1, cp.mint, faint); family: "Space Grotesk" }
            zone box cp_panel_role_secondary { from: 714, 392; size: 100, 30; corner: 15; cursor: pointer; label: "Secondary panel colour" }
            on press cp_panel_role_secondary { panel_bg_role = 1 }

            CpCard(250, 442, 570, 62)
            text "Tint depth" { at: 266, 452; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How much of that colour to mix in." { at: 266, 470; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 489, 200, cp.panel_pct, cp_panel_tint_track.hover, cp.mint, ink, cp.track)
            text number(panel_bg_tint, 0, "%") { at: 820, 489; anchor: right center; size: 17; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_panel_tint_track { from: 510, 474; size: 240, 30; cursor: pointer; label: "Panel tint depth" }
            on press cp_panel_tint_track { panel_bg_tint = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
            on drag cp_panel_tint_track { panel_bg_tint = clamp((pointer.x - 520) / 200 * 100, 0, 100) }
        }

        //  ── FONT ─────────────────────────────────────────────────────────
        group {
            show: settings_page == 3

            CpCard(250, 176, 570, 62)
            text "Current" { at: 266, 186; anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" }
            text font_family { at: 266, 208; anchor: left center; size: 15; weight: 600; color: ink; width: 200; lines: 1; family: "Space Grotesk" }
            text "Selected" { at: 480, 186; anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" }
            text font_choice { at: 480, 208; anchor: left center; size: 15; weight: 600; color: cp.mint; width: 250; lines: 1; family: "Space Grotesk" }
            CpPill(750, 188, 80, 28, 1, cp_font_apply.hover, cp.mint, ink)
            text "Apply" { at: 790, 202; anchor: center; size: 14; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box cp_font_apply { from: 750, 188; size: 80, 28; corner: 14; cursor: pointer; label: "Apply font and restart" }
            on press cp_font_apply { emit ui_sound; emit font_apply }

            box { from: 250, 250; size: 570, 38; corner: 10; color: ink; opacity: 4% }
            ellipse { at: 270, 269; radius: 5; stroke: 1.4; color: faint }
            line { from: 273.5, 272.5; to: 278, 277; width: 1.4; color: faint }
            input font_query { at: 290, 259; width: 512; size: 15; color: ink; family: "Space Grotesk"; placeholder: "Search installed fonts" }

            repeat k in 0..10 {
                let fy = 300 + k * 48
                group {
                    show: k < font_rows.count
                    box { from: 250, fy; size: 570, 38; corner: 8; color: ink; opacity: 3% + 9% * font_row.$k.hover }
                    text font_rows.$k.name { at: 266, fy + 19; anchor: left center; size: 15; color: ink; width: 530; lines: 1; family: "Space Grotesk" }
                    zone box font_row.$k { from: 250, fy; size: 570, 38; corner: 8; cursor: pointer; label: font_rows.$k.name }
                    on press font_row.$k { emit ui_sound; font_choice = font_rows.$k.name }
                }
            }
            text "No fonts match." { at: 266, 320; anchor: left center; size: 15; color: faint; show: font_rows.count < 1 }
            text "Type to search · Apply restarts the shell." { at: 266, 790; anchor: left center; size: 13; color: faint; opacity: 70%; family: "Space Grotesk" }
        }

        //  ── WALLPAPER ────────────────────────────────────────────────────
        group {
            show: settings_page == 4

            CpCard(250, 176, 570, 52)
            text "Current" { at: 266, 186; anchor: left center; size: 13; weight: 700; color: faint; family: "Space Grotesk" }
            text wall_name { at: 266, 206; anchor: left center; size: 15; weight: 600; color: ink; width: 400; lines: 1; family: "Space Grotesk" }
            text wall_count { at: 820, 202; anchor: right center; size: 13; color: faint; family: "Space Grotesk" }
            CpPill(672, 176, 80, 24, if(wall_transition == 1, 1, 0), wp_random_pick.hover, cp.mint, ink)
            text "Random" { at: 712, 186; anchor: center; size: 12; weight: 700; color: if(wall_transition == 1, cp.mint, ink); family: "Space Grotesk" }
            zone box wp_random_pick { from: 672, 176; size: 80, 24; corner: 12; cursor: pointer; label: "Random transition" }
            on press wp_random_pick { wall_transition = 1 }
            CpPill(762, 176, 64, 24, 0, wp_refresh.hover, cp.mint, ink)
            text "Refresh" { at: 794, 188; anchor: center; size: 12; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box wp_refresh { from: 762, 176; size: 64, 24; corner: 12; cursor: pointer; label: "Refresh wallpapers" }
            on press wp_refresh { emit wall_refresh }

            repeat k in 0..9 {
                let wx = 250 + (k - 3 * floor(k / 3)) * 196
                let wy = 240 + floor(k / 3) * 118
                group {
                    show: k < wp_rows.count
                    group {
                        clip box { from: wx, wy; size: 176, 99; corner: 12 }
                        image wp_rows.$k.thumb { at: wx, wy; size: 176, 99; fit: cover }
                        box { from: wx, wy; size: 176, 99; corner: 12; stroke: 1; color: if(wp_rows.$k.cur, cp.mint, ink); opacity: if(wp_rows.$k.cur, 100%, 14%) }
                    }
                    text wp_rows.$k.name { at: wx + 4, wy + 110; anchor: left center; size: 12; color: if(wp_rows.$k.cur, cp.mint, faint); width: 168; lines: 1; family: "Space Grotesk" }
                    zone box wp_row.$k { from: wx, wy; size: 176, 118; cursor: pointer; label: wp_rows.$k.name }
                    on press wp_row.$k { wall_choice = wp_rows.$k.path; emit wall_apply }
                }
            }
            text "No wallpapers found." { at: 266, 260; anchor: left center; size: 15; color: faint; show: wp_rows.count < 1 }

            //  skwd-wall v2's shader transition.  The catalog is cycled here;
            //  the shell sends the selected name with the next apply.
            CpCard(250, 740, 570, 40)
            text "Transition" { at: 266, 760; anchor: left center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            text wall_transition_name { at: 540, 760; anchor: center; size: 12; weight: 600; color: cp.mint; width: 190; lines: 1; align: center; family: "Space Grotesk" }
            CpPill(685, 745, 30, 30, 0, wp_trans_prev.hover, cp.mint, ink)
            text "‹" { at: 700, 760; anchor: center; size: 18; weight: 700; color: ink; family: "Space Grotesk" }
            zone box wp_trans_prev { from: 685, 745; size: 30, 30; corner: 15; cursor: pointer; label: "Previous wallpaper transition" }
            on press wp_trans_prev { wall_transition = mod(wall_transition - 1 + wall_transition_count, wall_transition_count) }
            CpPill(775, 745, 30, 30, 0, wp_trans_next.hover, cp.mint, ink)
            text "›" { at: 790, 760; anchor: center; size: 18; weight: 700; color: ink; family: "Space Grotesk" }
            zone box wp_trans_next { from: 775, 745; size: 30, 30; corner: 15; cursor: pointer; label: "Next wallpaper transition" }
            on press wp_trans_next { wall_transition = mod(wall_transition + 1, wall_transition_count) }

            text "Bar, settings and launcher take their colour from the picture." { at: 266, 800; anchor: left center; size: 13; color: faint; opacity: 78%; width: 540; lines: 1; family: "Space Grotesk" }

            CpPill(250, 618, 70, 28, 0, wp_prev.hover, cp.mint, ink)
            text "‹ Prev" { at: 285, 632; anchor: center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wp_prev { from: 250, 618; size: 70, 28; corner: 14; cursor: pointer; label: "Previous wallpapers" }
            on press wp_prev { wp_page = max(0, wp_page - 1) }

            text number(wp_page + 1, 0, "") { at: 505, 632; anchor: center; size: 13; color: faint; family: "Space Grotesk" }
            text "/" { at: 520, 632; anchor: center; size: 13; color: faint; family: "Space Grotesk" }
            text number(wp_pages, 0, "") { at: 537, 632; anchor: center; size: 13; color: faint; family: "Space Grotesk" }

            CpPill(750, 618, 70, 28, 0, wp_next.hover, cp.mint, ink)
            text "Next ›" { at: 785, 632; anchor: center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wp_next { from: 750, 618; size: 70, 28; corner: 14; cursor: pointer; label: "Next wallpapers" }
            on press wp_next { wp_page = min(wp_pages - 1, wp_page + 1) }

            CpCard(250, 654, 570, 40)
            text "Auto rotate" { at: 266, 674; anchor: left center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            CpSwitch(380, 662, 44, 24, if(wall_auto, 1, 0), wall_knob, wp_auto_switch.hover, cp.mint, ink, cp.track)
            zone box wp_auto_switch { from: 370, 654; size: 64, 38; cursor: pointer; label: "Auto rotate wallpapers" }
            on press wp_auto_switch { toggle wall_auto }

            text "Every" { at: 456, 674; anchor: left center; size: 13; color: faint; family: "Space Grotesk" }
            CpSlider(520, 673, 200, wp.min_pct, wp_min_track.hover, cp.mint, ink, cp.track)
            text number(wall_minutes, 0, " min") { at: 820, 673; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box wp_min_track { from: 500, 658; size: 240, 30; cursor: pointer; label: "Minutes between wallpapers" }
            on press wp_min_track { wall_minutes = round(clamp(1 + (pointer.x - 520) / 200 * 59, 1, 60)) }
            on drag wp_min_track { wall_minutes = round(clamp(1 + (pointer.x - 520) / 200 * 59, 1, 60)) }

            text wall_next { at: 266, 704; anchor: left center; size: 13; color: faint; opacity: 78%; family: "Space Grotesk" }
        }

        //  ── NOTIFICATIONS ───────────────────────────────────────────────
        group {
            show: settings_page == 5

            CpCard(250, 176, 570, 62)
            text "Toast position" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Where it sits when Drift is off." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpPill(560, 190, 108, 28, if(nt_pos == 0, 1, 0), nt_pos_center.hover, cp.mint, ink)
            text "Top center" { at: 614, 204; anchor: center; size: 13; weight: 600; color: if(nt_pos == 0, cp.mint, ink); family: "Space Grotesk" }
            zone box nt_pos_center { from: 560, 190; size: 108, 28; corner: 14; cursor: pointer; label: "Notifications in the center" }
            on press nt_pos_center { emit ui_sound; nt_pos = 0 }
            CpPill(680, 190, 116, 28, if(nt_pos == 1, 1, 0), nt_pos_right.hover, cp.mint, ink)
            text "Top right" { at: 738, 204; anchor: center; size: 13; weight: 600; color: if(nt_pos == 1, cp.mint, ink); family: "Space Grotesk" }
            zone box nt_pos_right { from: 680, 190; size: 116, 28; corner: 14; cursor: pointer; label: "Notifications at the top right" }
            on press nt_pos_right { emit ui_sound; nt_pos = 1 }

            CpCard(250, 242, 570, 62)
            text "Drift left to right" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Slides the toast across the top over the countdown." { at: 266, 270; anchor: left center; size: 14; color: faint; width: 470; lines: 1; family: "Space Grotesk" }
            CpSwitch(770, 261, 44, 24, if(nt_drift, 1, 0), nt_drift_knob, nt_drift_switch.hover, cp.mint, ink, cp.track)
            zone box nt_drift_switch { from: 760, 252; size: 64, 38; corner: 19; cursor: pointer; label: "Drift notifications from left to right" }
            on press nt_drift_switch { emit ui_sound; emit nt_drift_toggle }

            CpCard(250, 308, 570, 62)
            text "Play a sound" { at: 266, 318; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "When a notification is shown." { at: 266, 336; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 327, 44, 24, if(nt_snd_on, 1, 0), nt_snd_knob, nt_snd_switch.hover, cp.mint, ink, cp.track)
            zone box nt_snd_switch { from: 760, 318; size: 64, 38; corner: 19; cursor: pointer; label: "Notification sounds" }
            on press nt_snd_switch { emit ui_sound; emit nt_sound_toggle }

            CpCard(250, 374, 570, 62)
            text "Default sound" { at: 266, 384; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text nt_sound_name { at: 266, 402; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpPill(700, 388, 36, 28, 0, nt_snd_prev.hover, cp.mint, ink)
            text "‹" { at: 718, 402; anchor: center; size: 18; color: ink; family: "Space Grotesk" }
            zone box nt_snd_prev { from: 700, 388; size: 36, 28; corner: 14; cursor: pointer; label: "Previous notification sound" }
            on press nt_snd_prev { emit nt_sound_set(-1) }
            CpPill(784, 388, 36, 28, 0, nt_snd_next.hover, cp.mint, ink)
            text "›" { at: 802, 402; anchor: center; size: 18; color: ink; family: "Space Grotesk" }
            zone box nt_snd_next { from: 784, 388; size: 36, 28; corner: 14; cursor: pointer; label: "Next notification sound" }
            on press nt_snd_next { emit nt_sound_set(1) }

            CpCard(250, 440, 570, 62)
            text "Toast countdown" { at: 266, 450; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Seconds before a toast closes itself." { at: 266, 468; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpPill(700, 454, 36, 28, 0, nt_secs_minus.hover, cp.mint, ink)
            text "−" { at: 718, 468; anchor: center; size: 18; color: ink; family: "Space Grotesk" }
            zone box nt_secs_minus { from: 700, 454; size: 36, 28; corner: 14; cursor: pointer; label: "Shorter toast countdown" }
            on press nt_secs_minus { emit ui_sound; nt_secs = clamp(nt_secs - 1, 2, 60) }
            CpPill(784, 454, 36, 28, 0, nt_secs_plus.hover, cp.mint, ink)
            text "+" { at: 802, 468; anchor: center; size: 18; color: ink; family: "Space Grotesk" }
            zone box nt_secs_plus { from: 784, 454; size: 36, 28; corner: 14; cursor: pointer; label: "Longer toast countdown" }
            on press nt_secs_plus { emit ui_sound; nt_secs = clamp(nt_secs + 1, 2, 60) }
            text number(nt_secs, 0, " s") { at: 760, 468; anchor: center; size: 15; weight: 700; color: cp.mint; family: "Space Grotesk" }

            CpCard(250, 506, 570, 62)
            text "Do Not Disturb" { at: 266, 516; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Keep them in the centre, without a toast." { at: 266, 534; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSwitch(770, 525, 44, 24, if(nt_dnd, 1, 0), nt_dnd_knob, nt_dnd_switch.hover, cp.mint, ink, cp.track)
            zone box nt_dnd_switch { from: 760, 516; size: 64, 38; corner: 19; cursor: pointer; label: "Do Not Disturb" }
            on press nt_dnd_switch { emit ui_sound; emit nt_dnd_toggle }

            CpPill(250, 572, 180, 34, 1, nt_test_btn.hover, cp.mint, ink)
            text "Send test" { at: 340, 589; anchor: center; size: 13; weight: 700; color: cp.mint; family: "Space Grotesk" }
            zone box nt_test_btn { from: 250, 572; size: 180, 34; corner: 17; cursor: pointer; label: "Send a test notification" }
            on press nt_test_btn { emit ui_sound; emit nt_test }

            CpPill(444, 572, 180, 34, 0, nt_center_btn.hover, cp.mint, ink)
            text "Open centre" { at: 534, 589; anchor: center; size: 13; weight: 600; color: ink; family: "Space Grotesk" }
            zone box nt_center_btn { from: 444, 572; size: 180, 34; corner: 17; cursor: pointer; label: "Open notification centre" }
            on press nt_center_btn { emit ui_sound; nt_center = true; panel_open = false }

            text "Sounds play through PipeWire; DND keeps the history. Urgent toasts stay until closed." { at: 266, 642; anchor: left center; size: 13; color: faint; opacity: 75%; width: 540; lines: 1; family: "Space Grotesk" }
        }

        //  ── WINDOW PICKER ────────────────────────────────────────────────
        group {
            show: settings_page == 10

            CpCard(250, 176, 570, 62)
            text "Thumbnail size" { at: 266, 186; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Largest a window card may grow; the grid shrinks to fit." { at: 266, 204; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 223, 200, cp.win_size_pct, cp_win_size.hover, cp.mint, ink, cp.track)
            text number(winpicker_size, 0, " px") { at: 820, 223; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_win_size { from: 510, 208; size: 240, 30; corner: 15; cursor: pointer; label: "Window thumbnail size" }
            on press cp_win_size { winpicker_size = clamp(round(140 + (pointer.x - 520) / 200 * 280), 140, 420) }
            on drag cp_win_size { winpicker_size = clamp(round(140 + (pointer.x - 520) / 200 * 280), 140, 420) }

            CpCard(250, 242, 570, 62)
            text "Per row" { at: 266, 252; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How many windows sit side by side; rows follow." { at: 266, 270; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 289, 200, cp.win_cols_pct, cp_win_cols.hover, cp.mint, ink, cp.track)
            text number(winpicker_cols, 0, "") { at: 820, 289; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_win_cols { from: 510, 274; size: 240, 30; corner: 15; cursor: pointer; label: "Windows per row" }
            on press cp_win_cols { winpicker_cols = clamp(round(2 + (pointer.x - 520) / 200 * 6), 2, 8) }
            on drag cp_win_cols { winpicker_cols = clamp(round(2 + (pointer.x - 520) / 200 * 6), 2, 8) }

            CpCard(250, 308, 570, 70)
            text "Reveal" { at: 266, 318; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "One motion for every card, or a different one each opening." { at: 266, 336; anchor: left center; size: 14; color: faint; width: 540; family: "Space Grotesk" }
            repeat k in 0..5 {
                let bx = 266 + k * 75
                let by = 352
                CpPill(bx, by, 70, 22, if(winpicker_mode == k, 1, 0), 0, cp.mint, ink)
                text pick(k, "Gather", "Cascade", "Pop", "Spiral", "Unfold", "Spin") { at: bx + 35, by + 11; anchor: center; size: 8.5; weight: 600; color: if(winpicker_mode == k, cp.mint, faint); width: 66; lines: 1; align: center; family: "Space Grotesk" }
                zone box cp_win_anim.$k { from: bx, by; size: 70, 22; corner: 11; cursor: pointer; label: pick(k, "Window reveal Gather", "Window reveal Cascade", "Window reveal Pop", "Window reveal Spiral", "Window reveal Unfold", "Window reveal Spin") }
                on press cp_win_anim.$k { emit ui_sound; winpicker_mode = k }
            }
            CpPill(716, 352, 70, 22, if(winpicker_mode == 6, 1, 0), 0, cp.mint, ink)
            text "Random" { at: 751, 363; anchor: center; size: 8.5; weight: 600; color: if(winpicker_mode == 6, cp.mint, faint); width: 66; lines: 1; align: center; family: "Space Grotesk" }
            zone box cp_win_anim_6 { from: 716, 352; size: 70, 22; corner: 11; cursor: pointer; label: "Window reveal Random" }
            on press cp_win_anim_6 { emit ui_sound; winpicker_mode = 6 }

            CpCard(250, 394, 570, 62)
            text "Duration" { at: 266, 404; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "How long the cards take to arrive and leave." { at: 266, 422; anchor: left center; size: 14; color: faint; family: "Space Grotesk" }
            CpSlider(520, 441, 200, cp.win_ms_pct, cp_win_ms.hover, cp.mint, ink, cp.track)
            text number(winpicker_ms, 0, " ms") { at: 820, 441; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_win_ms { from: 510, 426; size: 240, 30; corner: 15; cursor: pointer; label: "Window reveal duration" }
            on press cp_win_ms { winpicker_ms = clamp(round(160 + (pointer.x - 520) / 200 * 740), 160, 900) }
            on drag cp_win_ms { winpicker_ms = clamp(round(160 + (pointer.x - 520) / 200 * 740), 160, 900) }

            CpCard(250, 460, 570, 62)
            text "Letters" { at: 266, 470; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Which keys may pick a window; one per card, two when needed." { at: 266, 488; anchor: left center; size: 14; color: faint; width: 234; lines: 1; family: "Space Grotesk" }
            input winpicker_letters { at: 520, 478; width: 196; size: 14; color: ink; family: "Space Grotesk"; placeholder: "asdfghjkl" }
            text "A–Z · unique" { at: 820, 478; anchor: right center; size: 9; color: faint; opacity: 65%; family: "Space Grotesk" }


            CpCard(250, 526, 570, 62)
            text "Background blur" { at: 266, 536; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
            text "Blur of the wallpaper behind the picker; no glass layer." { at: 266, 554; anchor: left center; size: 14; color: faint; width: 540; family: "Space Grotesk" }
            CpSlider(520, 573, 200, cp.win_bg_blur_pct, cp_win_bg_blur.hover, cp.mint, ink, cp.track)
            text number(winpicker_bg_blur, 0, "%") { at: 820, 573; anchor: right center; size: 15; weight: 600; color: ink; family: "Space Grotesk" }
            zone box cp_win_bg_blur { from: 510, 558; size: 240, 30; corner: 15; cursor: pointer; label: "Window picker background blur" }
            on press cp_win_bg_blur { winpicker_bg_blur = clamp(round((pointer.x - 520) / 200 * 100), 0, 100) }
            on drag cp_win_bg_blur { winpicker_bg_blur = clamp(round((pointer.x - 520) / 200 * 100), 0, 100) }

            text "Type the key(s) while the picker is open; Esc closes it. Clicking a card also jumps." { at: 266, 614; anchor: left center; size: 13; color: faint; opacity: 75%; width: 540; lines: 1; family: "Space Grotesk" }
        }

        //  ── MOTION ───────────────────────────────────────────────────────
        group {
            show: settings_page == 6

            repeat r in 0..5 {
                let ry = 176 + r * 84
                CpCard(250, ry, 570, 74)
                text pick(r, "Search panel", "Settings panel", "Notification toast", "Notification centre", "Centre panel") { at: 266, ry + 18; anchor: left center; size: 17; weight: 700; color: ink; family: "Space Grotesk" }
                text pick(r, "Launcher card", "This settings card", "The toast under the bar", "The recent list", "The nine-tab glass panel") { at: 266, ry + 38; anchor: left center; size: 13; color: faint; family: "Space Grotesk" }
                repeat k in 0..6 {
                    let col = k - if(k < 3, 0, 3)
                    let row = if(k < 3, 0, 1)
                    let bx = 540 + col * 94
                    let by = ry + 8 + row * 30
                    let chosen = pick(r, anim_search, anim_panel, anim_toast, anim_center, anim_center_panel)
                    CpPill(bx, by, 88, 24, if(chosen == k, 1, 0), 0, cp.mint, ink)
                    text pick(k, "Fade", "Spin", "Unfold", "Drop", "Aperture", "Random") { at: bx + 44, by + 12; anchor: center; size: 9.5; weight: 600; color: if(chosen == k, cp.mint, faint); width: 84; lines: 1; align: center; family: "Space Grotesk" }
                }
            }
            //  Static hit areas keep every chip addressable by name; the
            //  visual chips above are drawn by the repeat.
            zone box cp_motion_0_0 { from: 540, 184; size: 88, 24; corner: 12; cursor: pointer; label: "Search Fade" }
            on press cp_motion_0_0 { emit ui_sound; emit anim_set(0) }
            zone box cp_motion_0_1 { from: 634, 184; size: 88, 24; corner: 12; cursor: pointer; label: "Search Spin" }
            on press cp_motion_0_1 { emit ui_sound; emit anim_set(1) }
            zone box cp_motion_0_2 { from: 728, 184; size: 88, 24; corner: 12; cursor: pointer; label: "Search Unfold" }
            on press cp_motion_0_2 { emit ui_sound; emit anim_set(2) }
            zone box cp_motion_0_3 { from: 540, 214; size: 88, 24; corner: 12; cursor: pointer; label: "Search Drop" }
            on press cp_motion_0_3 { emit ui_sound; emit anim_set(3) }
            zone box cp_motion_0_4 { from: 634, 214; size: 88, 24; corner: 12; cursor: pointer; label: "Search Aperture" }
            on press cp_motion_0_4 { emit ui_sound; emit anim_set(4) }
            zone box cp_motion_0_5 { from: 728, 214; size: 88, 24; corner: 12; cursor: pointer; label: "Search Random" }
            on press cp_motion_0_5 { emit ui_sound; emit anim_set(5) }
            zone box cp_motion_1_0 { from: 540, 268; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Fade" }
            on press cp_motion_1_0 { emit ui_sound; emit anim_set(6) }
            zone box cp_motion_1_1 { from: 634, 268; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Spin" }
            on press cp_motion_1_1 { emit ui_sound; emit anim_set(7) }
            zone box cp_motion_1_2 { from: 728, 268; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Unfold" }
            on press cp_motion_1_2 { emit ui_sound; emit anim_set(8) }
            zone box cp_motion_1_3 { from: 540, 298; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Drop" }
            on press cp_motion_1_3 { emit ui_sound; emit anim_set(9) }
            zone box cp_motion_1_4 { from: 634, 298; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Aperture" }
            on press cp_motion_1_4 { emit ui_sound; emit anim_set(10) }
            zone box cp_motion_1_5 { from: 728, 298; size: 88, 24; corner: 12; cursor: pointer; label: "Settings Random" }
            on press cp_motion_1_5 { emit ui_sound; emit anim_set(11) }
            zone box cp_motion_2_0 { from: 540, 352; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Fade" }
            on press cp_motion_2_0 { emit ui_sound; emit anim_set(12) }
            zone box cp_motion_2_1 { from: 634, 352; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Spin" }
            on press cp_motion_2_1 { emit ui_sound; emit anim_set(13) }
            zone box cp_motion_2_2 { from: 728, 352; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Unfold" }
            on press cp_motion_2_2 { emit ui_sound; emit anim_set(14) }
            zone box cp_motion_2_3 { from: 540, 382; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Drop" }
            on press cp_motion_2_3 { emit ui_sound; emit anim_set(15) }
            zone box cp_motion_2_4 { from: 634, 382; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Aperture" }
            on press cp_motion_2_4 { emit ui_sound; emit anim_set(16) }
            zone box cp_motion_2_5 { from: 728, 382; size: 88, 24; corner: 12; cursor: pointer; label: "Toast Random" }
            on press cp_motion_2_5 { emit ui_sound; emit anim_set(17) }
            zone box cp_motion_3_0 { from: 540, 436; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Fade" }
            on press cp_motion_3_0 { emit ui_sound; emit anim_set(18) }
            zone box cp_motion_3_1 { from: 634, 436; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Spin" }
            on press cp_motion_3_1 { emit ui_sound; emit anim_set(19) }
            zone box cp_motion_3_2 { from: 728, 436; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Unfold" }
            on press cp_motion_3_2 { emit ui_sound; emit anim_set(20) }
            zone box cp_motion_3_3 { from: 540, 466; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Drop" }
            on press cp_motion_3_3 { emit ui_sound; emit anim_set(21) }
            zone box cp_motion_3_4 { from: 634, 466; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Aperture" }
            on press cp_motion_3_4 { emit ui_sound; emit anim_set(22) }
            zone box cp_motion_3_5 { from: 728, 466; size: 88, 24; corner: 12; cursor: pointer; label: "Centre Random" }
            on press cp_motion_3_5 { emit ui_sound; emit anim_set(23) }
            zone box cp_motion_4_0 { from: 540, 520; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Fade" }
            on press cp_motion_4_0 { emit ui_sound; emit anim_set(24) }
            zone box cp_motion_4_1 { from: 634, 520; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Spin" }
            on press cp_motion_4_1 { emit ui_sound; emit anim_set(25) }
            zone box cp_motion_4_2 { from: 728, 520; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Unfold" }
            on press cp_motion_4_2 { emit ui_sound; emit anim_set(26) }
            zone box cp_motion_4_3 { from: 540, 550; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Drop" }
            on press cp_motion_4_3 { emit ui_sound; emit anim_set(27) }
            zone box cp_motion_4_4 { from: 634, 550; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Aperture" }
            on press cp_motion_4_4 { emit ui_sound; emit anim_set(28) }
            zone box cp_motion_4_5 { from: 728, 550; size: 88, 24; corner: 12; cursor: pointer; label: "Centre panel Random" }
            on press cp_motion_4_5 { emit ui_sound; emit anim_set(29) }
            text "Random picks a different pose after each close." { at: 266, 612; anchor: left center; size: 13; color: faint; opacity: 78%; family: "Space Grotesk" }
        }

