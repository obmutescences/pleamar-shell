#!/usr/bin/env python3
"""Fetch the city weather the centre panel shows.

Open-Meteo is the primary source because it follows regional models closely;
Nominatim resolves the configured city to coordinates.  wttr.in remains a
fallback for a city that Nominatim cannot resolve.  Results are cached for
ten minutes so opening the panel does not hammer either service.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import quote

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pleamar-shell" / "config.json"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pleamar-shell"
WEATHER_CACHE = CACHE_DIR / "weather.json"
LOCATION_CACHE = CACHE_DIR / "weather-location.json"
USER_AGENT = "pleamar-shell/0.1 (weather)"

DESCRIPTIONS = {
    0: "晴", 1: "大部晴朗", 2: "多云", 3: "阴",
    45: "雾", 48: "雾凇",
    51: "小毛毛雨", 53: "毛毛雨", 55: "强毛毛雨",
    56: "冻毛毛雨", 57: "强冻毛毛雨",
    61: "小雨", 63: "中雨", 65: "大雨",
    66: "冻雨", 67: "强冻雨",
    71: "小雪", 73: "中雪", 75: "大雪", 77: "米雪",
    80: "小阵雨", 81: "阵雨", 82: "强阵雨",
    85: "小阵雪", 86: "强阵雪",
    95: "雷阵雨", 96: "雷阵雨伴冰雹", 99: "强雷暴伴冰雹",
}
ICONS = {
    0: "☀", 1: "☀", 2: "⛅", 3: "☁",
    45: "≋", 48: "≋",
    51: "☂", 53: "☂", 55: "☂", 56: "☂", 57: "☂",
    61: "☂", 63: "☂", 65: "☂", 66: "☂", 67: "☂",
    71: "❄", 73: "❄", 75: "❄", 77: "❄",
    80: "☔", 81: "☔", 82: "☔",
    85: "❄", 86: "❄",
    95: "⚡", 96: "⚡", 99: "⚡",
}


def run_curl(url, timeout=12):
    try:
        proc = subprocess.run(
            ["curl", "-fsSL", "-A", USER_AGENT, "--max-time", str(timeout), url],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout + 2,
        )
        return proc.stdout if proc.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def write_json(path, value):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(value, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass


def configured_city():
    data = read_json(CONFIG) or {}
    return str(data.get("weather_city") or "").strip()


def resolve_city(city):
    if not city:
        return None
    cached = read_json(LOCATION_CACHE)
    if isinstance(cached, dict):
        entry = cached.get(city)
        if entry and time.time() - entry.get("ts", 0) < 30 * 86400:
            return entry
    text = run_curl(
        "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1"
        "&accept-language=" + quote("zh-CN") + "&q=" + quote(city),
        timeout=10,
    )
    if text:
        try:
            rows = json.loads(text)
        except ValueError:
            rows = []
        if rows:
            row = rows[0]
            display = str(row.get("display_name") or city)
            name = display.split(",")[0].strip() or city
            entry = {
                "city": name,
                "display": display,
                "lat": float(row.get("lat", 0)),
                "lon": float(row.get("lon", 0)),
                "ts": time.time(),
            }
            cached = cached if isinstance(cached, dict) else {}
            cached[city] = entry
            write_json(LOCATION_CACHE, cached)
            return entry
    return None


def number(value, digits=0):
    try:
        return str(round(float(value), digits)).replace(".0", "") if digits else str(round(float(value)))
    except (TypeError, ValueError):
        return "--"


def open_meteo(location):
    url = (
        "https://api.open-meteo.com/v1/forecast?latitude=" + str(location["lat"])
        + "&longitude=" + str(location["lon"])
        + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,"
          "precipitation,weather_code,wind_speed_10m,wind_direction_10m"
        + "&hourly=temperature_2m,weather_code"
        + "&daily=weather_code,temperature_2m_max,temperature_2m_min"
        + "&forecast_days=5&timezone=auto"
    )
    text = run_curl(url, timeout=12)
    if not text:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    current = data.get("current") or {}
    hourly = data.get("hourly") or {}
    daily = data.get("daily") or {}
    if not current:
        return None
    code = int(current.get("weather_code") or 0)
    temp = number(current.get("temperature_2m"))
    feels = number(current.get("apparent_temperature"))
    hi = number((daily.get("temperature_2m_max") or [0])[0])
    lo = number((daily.get("temperature_2m_min") or [0])[0])
    now = datetime.now()
    hourly_rows = []
    times = hourly.get("time") or []
    temps = hourly.get("temperature_2m") or []
    codes = hourly.get("weather_code") or []
    for i, stamp in enumerate(times):
        try:
            when = datetime.fromisoformat(stamp)
        except ValueError:
            continue
        if when < now.replace(minute=0, second=0, microsecond=0):
            continue
        hcode = int(codes[i] or 0)
        hourly_rows.append({
            "label": "现在" if not hourly_rows else when.strftime("%H:%M"),
            "temp": number(temps[i]) + "°",
            "icon": ICONS.get(hcode, "·"),
            "night": when.hour < 6 or when.hour >= 19,
        })
        if len(hourly_rows) >= 6:
            break
    daily_rows = []
    days = daily.get("time") or []
    for i, stamp in enumerate(days[:4]):
        dcode = int((daily.get("weather_code") or [0] * len(days))[i] or 0)
        try:
            day = datetime.fromisoformat(stamp).date()
        except ValueError:
            day = None
        daily_rows.append({
            "day": "今天" if i == 0 else (f"周{'一二三四五六日'[day.weekday()]}" if day else ""),
            "icon": ICONS.get(dcode, "·"),
            "hi": number((daily.get("temperature_2m_max") or [0])[i]) + "°",
            "lo": number((daily.get("temperature_2m_min") or [0])[i]) + "°",
        })
    return {
        "configured": True,
        "ready": True,
        "city": location.get("city") or location.get("display") or "",
        "temp": temp,
        "feels": feels,
        "desc": DESCRIPTIONS.get(code, "未知"),
        "icon": ICONS.get(code, "·"),
        "hi": hi,
        "lo": lo,
        "humidity": number(current.get("relative_humidity_2m")) + "%",
        "wind": number(current.get("wind_speed_10m")) + " km/h",
        "updated": now.strftime("%H:%M"),
        "error": "",
        "hourly": hourly_rows,
        "daily": daily_rows,
    }


def wttr(city):
    text = run_curl("https://wttr.in/" + quote(city) + "?format=j1&lang=zh", timeout=12)
    if not text:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    current = (data.get("current_condition") or [{}])[0]
    wcode = int(current.get("weatherCode") or 113)
    # wttr codes are not WMO; only use its text and icon fallbacks.
    desc = current.get("lang_zh") or current.get("weatherDesc") or ""
    if isinstance(desc, list):
        desc = desc[0].get("value", "") if desc else ""
    weather = data.get("weather") or []
    hourly_rows = []
    for h in ((weather[0].get("hourly") or []) if weather else []):
        label = str(h.get("time", "")).zfill(4)
        hourly_rows.append({
            "label": ("现在" if not hourly_rows else label[:2] + ":" + label[2:]),
            "temp": number(h.get("tempC")) + "°",
            "icon": "☂" if wcode >= 176 else "☀",
            "night": int(label[:2] or 0) < 6 or int(label[:2] or 0) >= 19,
        })
        if len(hourly_rows) >= 6:
            break
    daily_rows = []
    for i, d in enumerate(weather[:4]):
        date = d.get("date", "")
        daily_rows.append({
            "day": "今天" if i == 0 else date[-5:],
            "icon": "☂" if int(d.get("hourly", [{}])[0].get("weatherCode", 113)) >= 176 else "☀",
            "hi": number(d.get("maxtempC")) + "°",
            "lo": number(d.get("mintempC")) + "°",
        })
    return {
        "configured": True,
        "ready": True,
        "city": city,
        "temp": number(current.get("temp_C")),
        "feels": number(current.get("FeelsLikeC")),
        "desc": desc or "未知",
        "icon": "☂" if wcode >= 176 else "☀",
        "hi": number((weather[0].get("maxtempC") if weather else current.get("temp_C"))),
        "lo": number((weather[0].get("mintempC") if weather else current.get("temp_C"))),
        "humidity": number(current.get("humidity")) + "%",
        "wind": number(current.get("windspeedKmph")) + " km/h",
        "updated": datetime.now().strftime("%H:%M"),
        "error": "",
        "hourly": hourly_rows,
        "daily": daily_rows,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--city", default="")
    args = parser.parse_args()
    city = args.city.strip() or configured_city()
    if not city:
        print(json.dumps({
            "configured": False, "ready": False, "city": "", "error": "",
            "hourly": [], "daily": [],
        }, ensure_ascii=False, separators=(",", ":")))
        return

    cached = read_json(WEATHER_CACHE)
    if isinstance(cached, dict) and cached.get("city_query") == city:
        if time.time() - cached.get("ts", 0) < 600 and cached.get("ready"):
            cached.pop("city_query", None)
            cached.pop("ts", None)
            print(json.dumps(cached, ensure_ascii=False, separators=(",", ":")))
            return

    location = resolve_city(city)
    result = open_meteo(location) if location else None
    if result is None:
        result = wttr(city)
    if result is None:
        if isinstance(cached, dict) and cached.get("city_query") == city and cached.get("ready"):
            cached.pop("city_query", None)
            cached.pop("ts", None)
            cached["error"] = "天气暂时不可用"
            print(json.dumps(cached, ensure_ascii=False, separators=(",", ":")))
            return
        print(json.dumps({
            "configured": True, "ready": False, "city": city, "error": "天气暂时不可用",
            "hourly": [], "daily": [],
        }, ensure_ascii=False, separators=(",", ":")))
        return
    result["city_query"] = city
    result["ts"] = time.time()
    write_json(WEATHER_CACHE, result)
    result.pop("city_query", None)
    result.pop("ts", None)
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    main()
