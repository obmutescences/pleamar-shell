#!/usr/bin/env python3
"""Fetch the city weather the centre panel shows.

Open-Meteo is the primary source because it follows regional models closely;
Nominatim resolves the configured city to coordinates.  wttr.in remains a
fallback for a city that Nominatim cannot resolve.  Results are cached for
ten minutes so opening the panel does not hammer either service.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import quote

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pleamar-shell" / "config.json"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pleamar-shell"
WEATHER_CACHE = CACHE_DIR / "weather.json"
LOCATION_CACHE = CACHE_DIR / "weather-location.json"
USER_AGENT = "pleamar-shell/0.1 (weather)"
SCHEMA_VERSION = 2

DESCRIPTIONS = {
    0: "晴", 1: "大部晴朗", 2: "多云", 3: "阴",
    45: "雾", 48: "雾凇",
    51: "小毛毛雨", 53: "毛毛雨", 55: "强毛毛雨",
    56: "冻毛毛雨", 57: "强冻毛毛雨",
    61: "小雨", 63: "中雨", 65: "大雨",
    66: "冻雨", 67: "强冻雨",
    71: "小雪", 73: "中雪", 75: "大雪", 77: "米雪",
    80: "小阵雨", 81: "阵雨", 82: "强阵雨",
    85: "小阵雪", 86: "强阵雪",
    95: "雷阵雨", 96: "雷阵雨伴冰雹", 99: "强雷暴伴冰雹",
}
ICONS = {
    0: "☀", 1: "☀", 2: "⛅", 3: "☁",
    45: "≋", 48: "≋",
    51: "☂", 53: "☂", 55: "☂", 56: "☂", 57: "☂",
    61: "☂", 63: "☂", 65: "☂", 66: "☂", 67: "☂",
    71: "❄", 73: "❄", 75: "❄", 77: "❄",
    80: "☔", 81: "☔", 82: "☔",
    85: "❄", 86: "❄",
    95: "⚡", 96: "⚡", 99: "⚡",
}


def wmo_kind(code):
    """Map WMO code to sky shader kind: 0 clear · 1 partly · 2 cloudy · 3 fog · 4 rain · 5 snow · 6 storm."""
    if code == 0:
        return 0
    if code in (1, 2):
        return 1
    if code == 3:
        return 2
    if code in (45, 48):
        return 3
    if (51 <= code <= 67) or (80 <= code <= 82):
        return 4
    if (71 <= code <= 77) or code in (85, 86):
        return 5
    if code >= 95:
        return 6
    return 2


def parse_hm_mins(iso_str, fallback):
    if not iso_str or "T" not in str(iso_str):
        return fallback
    try:
        tpart = str(iso_str).split("T", 1)[1]
        hh, mm = tpart.split(":", 2)[:2]
        return int(hh) * 60 + int(mm)
    except (ValueError, IndexError):
        return fallback


def run_curl(url, timeout=12):
    try:
        proc = subprocess.run(
            ["curl", "-fsSL", "-A", USER_AGENT, "--max-time", str(timeout), url],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout + 2,
        )
        return proc.stdout if proc.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def write_json(path, value):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(value, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass


def configured_city():
    data = read_json(CONFIG) or {}
    return str(data.get("weather_city") or "").strip()


def resolve_city(city):
    if not city:
        return None
    cached = read_json(LOCATION_CACHE)
    if isinstance(cached, dict):
        entry = cached.get(city)
        if entry and time.time() - entry.get("ts", 0) < 30 * 86400:
            return entry
    text = run_curl(
        "https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1"
        "&accept-language=" + quote("zh-CN") + "&q=" + quote(city),
        timeout=10,
    )
    if text:
        try:
            rows = json.loads(text)
        except ValueError:
            rows = []
        if rows:
            row = rows[0]
            display = str(row.get("display_name") or city)
            name = display.split(",")[0].strip() or city
            entry = {
                "city": name,
                "display": display,
                "lat": float(row.get("lat", 0)),
                "lon": float(row.get("lon", 0)),
                "ts": time.time(),
            }
            cached = cached if isinstance(cached, dict) else {}
            cached[city] = entry
            write_json(LOCATION_CACHE, cached)
            return entry
    return None


def number(value, digits=0):
    try:
        return str(round(float(value), digits)).replace(".0", "") if digits else str(round(float(value)))
    except (TypeError, ValueError):
        return "--"


def num_float(value, fallback=0.0):
    try:
        return float(value)
    except (TypeError, ValueError):
        return float(fallback)


def open_meteo(location):
    url = (
        "https://api.open-meteo.com/v1/forecast?latitude=" + str(location["lat"])
        + "&longitude=" + str(location["lon"])
        + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,"
          "precipitation,weather_code,wind_speed_10m,wind_direction_10m"
        + "&hourly=temperature_2m,weather_code"
        + "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset"
        + "&forecast_days=5&timezone=auto"
    )
    text = run_curl(url, timeout=12)
    if not text:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    current = data.get("current") or {}
    hourly = data.get("hourly") or {}
    daily = data.get("daily") or {}
    if not current:
        return None
    code = int(current.get("weather_code") or 0)
    temp = number(current.get("temperature_2m"))
    feels = number(current.get("apparent_temperature"))
    hi = number((daily.get("temperature_2m_max") or [0])[0])
    lo = number((daily.get("temperature_2m_min") or [0])[0])
    now = datetime.now()
    hourly_rows = []
    hourly24 = []
    times = hourly.get("time") or []
    temps = hourly.get("temperature_2m") or []
    codes = hourly.get("weather_code") or []
    for i, stamp in enumerate(times):
        try:
            when = datetime.fromisoformat(stamp)
        except ValueError:
            continue
        if when < now.replace(minute=0, second=0, microsecond=0):
            continue
        hcode = int(codes[i] or 0) if i < len(codes) else 0
        tf = num_float(temps[i] if i < len(temps) else 0, 0.0)
        lbl = "现在" if not hourly24 else when.strftime("%H:%M")
        icon = ICONS.get(hcode, "·")
        hourly24.append({
            "t": round(tf, 1),
            "deg": f"{round(tf)}°",
            "label": lbl,
            "icon": icon,
            "kind": wmo_kind(hcode),
        })
        if len(hourly_rows) < 6:
            hourly_rows.append({
                "label": lbl,
                "temp": f"{round(tf)}°",
                "icon": icon,
                "night": when.hour < 6 or when.hour >= 19,
            })
        if len(hourly24) >= 25:
            break
    while hourly24 and len(hourly24) < 25:
        hourly24.append(dict(hourly24[-1]))
    h_vals = [h["t"] for h in hourly24] if hourly24 else [0.0]
    h_min = min(h_vals)
    h_max = max(h_vals)

    daily_rows = []
    days = daily.get("time") or []
    w_lows, w_highs = [], []
    for i, stamp in enumerate(days[:4]):
        dcode = int((daily.get("weather_code") or [0] * len(days))[i] or 0)
        hi_v = num_float((daily.get("temperature_2m_max") or [0])[i], 0.0)
        lo_v = num_float((daily.get("temperature_2m_min") or [0])[i], 0.0)
        w_highs.append(hi_v)
        w_lows.append(lo_v)
        try:
            day = datetime.fromisoformat(stamp).date()
        except ValueError:
            day = None
        daily_rows.append({
            "day": "今天" if i == 0 else (f"周{'一二三四五六日'[day.weekday()]}" if day else ""),
            "icon": ICONS.get(dcode, "·"),
            "hi": f"{round(hi_v)}°",
            "lo": f"{round(lo_v)}°",
            "hi_n": round(hi_v, 1),
            "lo_n": round(lo_v, 1),
            "kind": wmo_kind(dcode),
            "desc": DESCRIPTIONS.get(dcode, "未知"),
        })
    wind_spd = num_float(current.get("wind_speed_10m"), 5.0)
    wind_deg = num_float(current.get("wind_direction_10m"), 90.0)
    sunrise_m = parse_hm_mins((daily.get("sunrise") or [None])[0], 360)
    sunset_m = parse_hm_mins((daily.get("sunset") or [None])[0], 1140)
    return {
        "schema": SCHEMA_VERSION,
        "configured": True,
        "ready": True,
        "city": location.get("city") or location.get("display") or "",
        "temp": temp,
        "feels": feels,
        "desc": DESCRIPTIONS.get(code, "未知"),
        "icon": ICONS.get(code, "·"),
        "kind": wmo_kind(code),
        "hi": hi,
        "lo": lo,
        "humidity": number(current.get("relative_humidity_2m")) + "%",
        "wind": number(wind_spd) + " km/h",
        "wind_n": round(wind_spd, 1),
        "wind_dir": 1 if (wind_deg % 360.0) < 180.0 else -1,
        "sunrise": sunrise_m,
        "sunset": sunset_m,
        "utc_offset": int(data.get("utc_offset_seconds") or 0),
        "updated": now.strftime("%H:%M"),
        "error": "",
        "hourly": hourly_rows,
        "hourly24": hourly24,
        "h_min": h_min,
        "h_max": h_max,
        "w_min": min(w_lows) if w_lows else 0.0,
        "w_max": max(w_highs) if w_highs else 25.0,
        "daily": daily_rows,
    }


def wttr(city):
    text = run_curl("https://wttr.in/" + quote(city) + "?format=j1&lang=zh", timeout=12)
    if not text:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    current = (data.get("current_condition") or [{}])[0]
    wcode = int(current.get("weatherCode") or 113)
    kind = 4 if wcode >= 176 else (1 if wcode in (116, 119, 122) else 0)
    desc = current.get("lang_zh") or current.get("weatherDesc") or ""
    if isinstance(desc, list):
        desc = desc[0].get("value", "") if desc else ""
    weather = data.get("weather") or []
    hourly_rows = []
    hourly24 = []
    src_hours = []
    for day in weather[:2]:
        for h in (day.get("hourly") or []):
            src_hours.append(h)
    for idx, h in enumerate(src_hours):
        label = str(h.get("time", "")).zfill(4)
        hh_str = label[:2] + ":" + label[2:]
        tf = num_float(h.get("tempC"), 0.0)
        hk = 4 if int(h.get("weatherCode") or 113) >= 176 else 0
        icon = "☂" if hk == 4 else "☀"
        if len(hourly_rows) < 6:
            hourly_rows.append({
                "label": ("现在" if not hourly_rows else hh_str),
                "temp": f"{round(tf)}°",
                "icon": icon,
                "night": int(label[:2] or 0) < 6 or int(label[:2] or 0) >= 19,
            })
        for step in range(3):
            if len(hourly24) >= 25:
                break
            nxt = src_hours[min(idx + 1, len(src_hours) - 1)]
            t_next = num_float(nxt.get("tempC"), tf)
            t_interp = tf + (t_next - tf) * (step / 3.0)
            hr_val = (int(label[:2] or 0) + step) % 24
            hourly24.append({
                "t": round(t_interp, 1),
                "deg": f"{round(t_interp)}°",
                "label": "现在" if not hourly24 else f"{hr_val:02d}:00",
                "icon": icon,
                "kind": hk,
            })
    while hourly24 and len(hourly24) < 25:
        hourly24.append(dict(hourly24[-1]))
    h_vals = [h["t"] for h in hourly24] if hourly24 else [num_float(current.get("temp_C"), 0.0)]

    daily_rows = []
    w_lows, w_highs = [], []
    for i, d in enumerate(weather[:4]):
        date = d.get("date", "")
        dk = 4 if int(d.get("hourly", [{}])[0].get("weatherCode", 113)) >= 176 else 0
        hi_v = num_float(d.get("maxtempC"), 0.0)
        lo_v = num_float(d.get("mintempC"), 0.0)
        w_highs.append(hi_v)
        w_lows.append(lo_v)
        daily_rows.append({
            "day": "今天" if i == 0 else date[-5:],
            "icon": "☂" if dk == 4 else "☀",
            "hi": f"{round(hi_v)}°",
            "lo": f"{round(lo_v)}°",
            "hi_n": round(hi_v, 1),
            "lo_n": round(lo_v, 1),
            "kind": dk,
            "desc": "有雨" if dk == 4 else "晴",
        })
    wind_spd = num_float(current.get("windspeedKmph"), 5.0)
    return {
        "schema": SCHEMA_VERSION,
        "configured": True,
        "ready": True,
        "city": city,
        "temp": number(current.get("temp_C")),
        "feels": number(current.get("FeelsLikeC")),
        "desc": desc or "未知",
        "icon": "☂" if wcode >= 176 else "☀",
        "kind": kind,
        "hi": number((weather[0].get("maxtempC") if weather else current.get("temp_C"))),
        "lo": number((weather[0].get("mintempC") if weather else current.get("temp_C"))),
        "humidity": number(current.get("humidity")) + "%",
        "wind": number(wind_spd) + " km/h",
        "wind_n": round(wind_spd, 1),
        "wind_dir": 1,
        "sunrise": 360,
        "sunset": 1140,
        "utc_offset": 0,
        "updated": datetime.now().strftime("%H:%M"),
        "error": "",
        "hourly": hourly_rows,
        "hourly24": hourly24,
        "h_min": min(h_vals),
        "h_max": max(h_vals),
        "w_min": min(w_lows) if w_lows else 0.0,
        "w_max": max(w_highs) if w_highs else 25.0,
        "daily": daily_rows,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--city", default="")
    args = parser.parse_args()
    city = args.city.strip() or configured_city()
    if not city:
        print(json.dumps({
            "schema": SCHEMA_VERSION,
            "configured": False, "ready": False, "city": "", "error": "",
            "hourly": [], "hourly24": [], "daily": [],
        }, ensure_ascii=False, separators=(",", ":")))
        return

    cached = read_json(WEATHER_CACHE)
    if isinstance(cached, dict) and cached.get("city_query") == city and cached.get("schema") == SCHEMA_VERSION:
        if time.time() - cached.get("ts", 0) < 600 and cached.get("ready"):
            cached.pop("city_query", None)
            cached.pop("ts", None)
            print(json.dumps(cached, ensure_ascii=False, separators=(",", ":")))
            return

    location = resolve_city(city)
    result = open_meteo(location) if location else None
    if result is None:
        result = wttr(city)
    if result is None:
        if isinstance(cached, dict) and cached.get("city_query") == city and cached.get("ready"):
            cached.pop("city_query", None)
            cached.pop("ts", None)
            cached["error"] = "天气暂时不可用"
            print(json.dumps(cached, ensure_ascii=False, separators=(",", ":")))
            return
        print(json.dumps({
            "schema": SCHEMA_VERSION,
            "configured": True, "ready": False, "city": city, "error": "天气暂时不可用",
            "hourly": [], "hourly24": [], "daily": [],
        }, ensure_ascii=False, separators=(",", ":")))
        return
    result["city_query"] = city
    result["ts"] = time.time()
    write_json(WEATHER_CACHE, result)
    result.pop("city_query", None)
    result.pop("ts", None)
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    main()
