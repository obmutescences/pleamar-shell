#!/usr/bin/env bash
# One-surface keyboard helper for the centre panel.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$("$root/bin/pleamar-shell" --path)"
export PLEAMAR_CENTER_PARENT="${PLEAMAR_CENTER_PARENT:-notches}"
exec "$bin" --scene "$root/scenes/centerkeys.plm" --no-hud
