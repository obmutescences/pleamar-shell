#!/usr/bin/env bash
# Keep the ext-session-lock surface alive across sleep and output hotplug.
#
# The shell already watches the lock socket, but it can be stopped or suspended
# with the rest of the session.  This guard is its own user service: it notices
# a wall-clock jump (a resume) or an output-list change, and replaces the lock
# scene while logind still reports the session locked.  A fresh lock client is
# what clears niri's red fallback after a lock face was lost.
set -uo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
lock="$root/bin/pleamar-lock"
last="$(date +%s)"
sig=""
bad=0

while :; do
    sleep 2
    now="$(date +%s)"
    gap=$((now - last))
    last="$now"

    locked=0
    "$lock" locked >/dev/null 2>&1 && locked=1

    # A large monotonic gap means the machine slept.  Even a lock scene whose
    # socket still answers may have lost its compositor faces there.
    if (( gap > 8 )) && (( locked == 1 )); then
        "$lock" recover >/dev/null 2>&1 || true
        sig=""
        continue
    fi

    (( locked == 1 )) || { sig=""; bad=0; continue; }

    if ! "$lock" alive >/dev/null 2>&1; then
        "$lock" recover >/dev/null 2>&1 || true
        sig=""
        continue
    fi

    # `lock.held` is the compositor's confirmation.  A socket that answers
    # while this is false is exactly the red-fallback state.
    if "$lock" held >/dev/null 2>&1; then
        bad=0
    else
        bad=$((bad + 1))
        if (( bad >= 2 )); then
            "$lock" recover >/dev/null 2>&1 || true
            bad=0
            sig=""
        fi
    fi

    # DPMS off/on can make niri re-list the output.  The 0.7.10 lock scene
    # adds a face for a newly arrived output, but a scene that had already lost
    # it cannot: recreating the client is the reliable repair.
    out="$(niri msg -j outputs 2>/dev/null | jq -c 'keys' 2>/dev/null || true)"
    if [[ -n "$out" ]]; then
        if [[ -n "$sig" && "$out" != "$sig" ]]; then
            "$lock" recover >/dev/null 2>&1 || true
        fi
        sig="$out"
    fi
done
