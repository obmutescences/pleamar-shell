#!/usr/bin/env bash
# One-surface keyboard helper for the settings panel.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$("$root/bin/pleamar-shell" --path)"
export PLEAMAR_SETTINGS_PARENT="${PLEAMAR_SETTINGS_PARENT:-island}"
export PLEAMAR_SETTINGS_FIELD="${PLEAMAR_SETTINGS_FIELD:-weather_city}"
exec "$bin" --scene "$root/scenes/settingskeys.plm" --no-hud
