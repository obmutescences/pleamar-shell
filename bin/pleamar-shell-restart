#!/usr/bin/env bash
# Restart the running shell so a font choice from the settings panel applies.
# Only one restart may run, and it never starts a second shell while an old
# one for this scene still exists: that used to leave numbered sockets and a
# pile of pleamar/cava processes after several Apply presses.
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-island}"
font="${2:-}"
[[ -n "$font" ]] && export PLEAMAR_FONT="$font"
bin="$("$root/bin/pleamar-shell" --path)"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock="$runtime/pleamar-shell-restart.lock"

#  One restart at a time.  A second Apply while this one is still working
#  exits instead of starting another shell.
exec 9>"$lock"
flock -n 9 || exit 0

"$bin" --say "$mode" quit >/dev/null 2>&1 || true

#  Wait for every pleamar of this scene to go away, not just the socket.
for _ in $(seq 1 50); do
    pgrep -f -- "pleamar --scene $root/scenes/$mode.plm" >/dev/null || break
    sleep 0.1
done
if pgrep -f -- "pleamar --scene $root/scenes/$mode.plm" >/dev/null; then
    echo "old $mode shell is still running; not starting another" >&2
    exit 1
fi

#  The old process may have left its socket behind; nobody is listening now.
rm -f "$runtime/pleamar/$mode.sock" "$runtime/pleamar/$mode.display" \
      "$runtime/pleamar/$mode-"*.sock "$runtime/pleamar/$mode-"*.display

#  Release the restart lock before exec: the shell inherits open descriptors,
#  so leaving fd 9 open would keep the lock forever and silently block every
#  later font Apply / restart.
exec 9>&-
exec "$root/bin/pleamar-shell" "$mode"
