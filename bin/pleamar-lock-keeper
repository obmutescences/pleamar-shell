#!/usr/bin/env bash
# Supervise the ext-session-lock scene, the way Vitreus's vitreus-keep does.
#
# The lock scene is its own Pleamar process.  If it stops while the session is
# still locked, niri has no locker to draw its lock surface and shows the red
# ext-session-lock fallback.  This keeper starts the scene again and, when
# logind still reports the session locked, tells the fresh scene to lock.
# There is no polling of compositor state beyond whether the scene is running.
# The keeper, pleamar-lock and the shell's watchdog share one flock
# (lock-scene.lock): only one of them can create the scene, so a second locker
# cannot make niri paint its red "no locker" fallback.
set -uo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$("$root/bin/pleamar-shell" --path)"
log="${PLEAMAR_LOCK_KEEPER_LOG:-/tmp/pleamar-lock.log}"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

mkdir -p "$(dirname "$log")" 2>/dev/null || true
running() {
    local pid state
    for pid in $(pgrep -f -- "pleamar --scene .*/lockscreen/lockscreen\.plm" 2>/dev/null || true); do
        state="$(ps -o stat= -p "$pid" 2>/dev/null || true)"
        [[ "$state" == Z* ]] && continue
        return 0
    done
    return 1
}

#  A compositor that has gone can leave its socket behind; do not restart a
#  scene into a dead display after logout.
compositor_alive() {
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || return 1
    case "$WAYLAND_DISPLAY" in
        /*) local socket="$WAYLAND_DISPLAY" ;;
        *)  local socket="$runtime/$WAYLAND_DISPLAY" ;;
    esac
    [[ -S "$socket" ]]
}

locked_hint() {
    local sid out
    sid="${XDG_SESSION_ID:-}"
    if [[ -z "$sid" ]]; then
        sid="$(loginctl list-sessions --no-legend 2>/dev/null | while read -r s uid user rest; do
            [[ "$user" == "$USER" ]] && { echo "$s"; break; }
        done)"
    fi
    [[ -n "$sid" ]] || return 1
    out="$(loginctl show-session "$sid" -p LockedHint --value 2>/dev/null || true)"
    [[ "$out" == "yes" ]]
}

#  DPMS state is the one thing the lock scene cannot poll once its clock has
#  stopped. The keeper is independent of that clock, so it wakes the water when
#  the monitor comes back and stops it when the monitor goes dark.
dpms_on() {
    local f
    for f in /sys/class/drm/card*-*/dpms; do
        [[ "$f" == *Writeback* ]] && continue
        [[ -r "$f" ]] || continue
        [[ "$(cat "$f" 2>/dev/null || true)" == "On" ]] && return 0
    done
    return 1
}

#  The new scene starts warm (`locked = false`).  If the session is still
#  locked, asking it to lock again is what makes niri replace its red fallback
#  with the lock face.
lock_if_needed() {
    locked_hint || return 0
    for _ in $(seq 1 80); do
        if "$bin" --say lockscreen "get locked" >/dev/null 2>&1; then
            #  A keeper restart is a warm start with no pleamar-lock sync.
            #  Push config.json (blur, clock, palette) before locking; without
            #  this the fresh scene kept the previous scene's lock settings and
            #  wallpaper while niri showed its red fallback.
            "$root/bin/pleamar-lock" sync >>"$log" 2>&1 8>&- || true
            #  The socket answers before the first frame; one commit is what
            #  lets niri attach a buffer to the lock surface instead of its
            #  red fallback.
            sleep 0.25
            "$bin" --say lockscreen "fact locked true" >/dev/null 2>&1 || true
            return 0
        fi
        sleep 0.1
    done
    return 1
}

quick=0
last_screen=""
lock_file="$runtime/pleamar/lock-scene.lock"
mkdir -p "$runtime/pleamar" 2>/dev/null || true
while :; do
    compositor_alive || exit 0
    if running; then
        #  The shell or a previous process already owns the scene.  Wait for it
        #  to stop rather than starting a second one.  The short poll keeps the
        #  compositor's red fallback visible for as little time as possible.
        if dpms_on; then screen=true; else screen=false; fi
        if [[ "$screen" != "$last_screen" ]]; then
            "$bin" --say lockscreen "fact screen_on $screen" >/dev/null 2>&1 || true
            last_screen="$screen"
        fi
        sleep 0.5
        continue
    fi

    #  The same single-owner rule as pleamar-lock.  Whoever holds this file
    #  starts the scene; a starter that loses the race re-checks and leaves the
    #  running scene alone instead of adding a second locker.
    exec 8>>"$lock_file"
    if ! flock -w 10 8; then
        sleep 0.5
        continue
    fi
    if running; then
        flock -u 8
        sleep 0.5
        continue
    fi

    started="$(date +%s)"
    echo "keeper   · starting lock scene" >>"$log"
    PLEAMAR_SWAPCHAIN=1 "$root/bin/pleamar-shell" lock >>"$log" 2>&1 8>&- &
    child=$!
    lock_if_needed >>"$log" 2>&1 8>&- &
    flock -u 8
    wait "$child"
    code=$?

    compositor_alive || exit 0
    if (( $(date +%s) - started < 30 )); then
        quick=$((quick + 1))
    else
        quick=0
    fi
    if (( quick >= 5 )); then
        echo "keeper   · lock scene stopped five times within 30 s (last exit $code): giving up" >>"$log"
        exit 1
    fi
    echo "keeper   · lock scene stopped (exit $code): starting it again" >>"$log"
    sleep 0.5
done
