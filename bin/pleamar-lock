#!/usr/bin/env bash
# Lock the running session, starting the lock scene first if it is not up.
#   pleamar-lock ensure   start the scene without locking
#   pleamar-lock lock     start it and lock
#   pleamar-lock test     lock in safe mode (Esc on an empty bar opens it)
#   pleamar-lock sync     push config.json's lock settings into a running scene
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$("$root/bin/pleamar-shell" --path)"
scene="$root/lockscreen/lockscreen.plm"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/pleamar-shell/config.json"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

check="pleamar --scene .*/lockscreen/lockscreen.plm"
running() { pgrep -f -- "$check" >/dev/null 2>&1; }

#  A scene can answer on its socket long after its lock surface stopped coming
#  up (an output was reconfigured under it, or it is from an older build).
#  niri then accepts the lock and paints its own red fallback.  Test lock is a
#  diagnostic, so give it a fresh scene every time instead of reusing that one.
stop() {
    local pids
    pids="$(pgrep -f -- "$check" || true)"
    [[ -n "$pids" ]] || return 0
    kill $pids 2>/dev/null || true
    for _ in $(seq 1 40); do
        pgrep -f -- "$check" >/dev/null 2>&1 || return 0
        sleep 0.05
    done
    kill -9 $pids 2>/dev/null || true
}

ready() {
    for _ in $(seq 1 60); do
        if "$bin" --say lockscreen "get locked" >/dev/null 2>&1; then return 0; fi
        sleep 0.1
    done
    return 1
}

ensure() {
    running && return 0
    #  A crashed lock scene can leave its socket behind.  A new scene would
    #  then take a numbered name, while `say` and `ready` still address
    #  `lockscreen`, so every later command would go to the dead socket.
    rm -f "$runtime/pleamar/lockscreen.sock" "$runtime/pleamar/lockscreen.display"
    setsid -f "$root/bin/pleamar-shell" lock >/tmp/pleamar-lock.log 2>&1
    for _ in $(seq 1 30); do running && break; sleep 0.1; done
    running || return 1
    ready
}

#  Test lock is a diagnostic: a fresh scene costs a fraction of a second and
#  cannot inherit a lock surface that stopped coming up.  Never restart one
#  that is actually locked, or the surface would be gone for real.
fresh() {
    if "$bin" --say lockscreen 'get locked' 2>/dev/null | grep -qx true; then
        return 0
    fi
    stop
    ensure
}

say() { "$bin" --say lockscreen "$1" >/dev/null 2>&1 || true; }

#  Exit 0 only while the lock scene answers.  A crashed scene leaves the
#  compositor locked with no client; the shell's watchdog uses this to put it
#  back up without matching its own command line (as pgrep would).
alive() { "$bin" --say lockscreen "get locked" >/dev/null 2>&1; }

#  Whether logind still considers this session locked.  A crashed locker
#  leaves the compositor locked even though its socket is gone, which is the
#  state the recovery guard must repair rather than unlock.
locked_hint() {
    local sid out
    sid="${XDG_SESSION_ID:-}"
    if [[ -z "$sid" ]]; then
        sid="$(loginctl list-sessions --no-legend 2>/dev/null | while read -r s uid user rest; do
            [[ "$user" == "$USER" ]] && { echo "$s"; break; }
        done)"
    fi
    [[ -n "$sid" ]] || return 1
    out="$(loginctl show-session "$sid" -p LockedHint --value 2>/dev/null || true)"
    [[ "$out" == "yes" ]]
}

held() { "$bin" --say lockscreen 'get lock.held' 2>/dev/null | grep -qx '1'; }

#  niri keeps the session locked when its locker disconnects, and paints its
#  red fallback until another lock client has a face on every output.  A
#  resumed lock scene can answer on its socket while its lock face is gone,
#  so `alive` is not enough: replace the process and wait for the compositor
#  to confirm `lock.held` again.
recover() {
    locked_hint || { ensure; return; }
    #  The shell watchdog and the independent guard can both see the same
    #  broken socket.  Only one of them may replace the locker.
    mkdir -p "$runtime/pleamar"
    exec 9>"$runtime/pleamar/lock-recover.lock"
    if command -v flock >/dev/null 2>&1; then
        flock -n 9 || return 0
    fi
    stop
    rm -f "$runtime/pleamar/lockscreen.sock" "$runtime/pleamar/lockscreen.display"
    ensure || return 1
    sync
    say "fact locked true"
    for _ in $(seq 1 50); do
        held && return 0
        sleep 0.1
    done
    return 1
}

sync() {
    running || return 0
    # The lock scene is started early, but the wallpaper palette can change
    # afterwards.  Push it before every lock so time/faint/panel colours match.
    say "emit palette_sync"
    [[ -r "$cfg" ]] || return 0
    val() { jq -r --arg k "$1" '.[$k] // empty' "$cfg" 2>/dev/null; }
    local blur date mask pal
    blur="$(val lock_blur)"; date="$(val lock_date)"; mask="$(val lock_mask)"; pal="$(val lock_pal)"
    say "fact cfg_blur ${blur:-36}"
    say "fact cfg_12h $(val lock_12h | grep -qx true && echo true || echo false)"
    say "fact cfg_ampm $(val lock_ampm | grep -qx true && echo true || echo false)"
    say "fact cfg_media $(val lock_media | grep -qx true && echo true || echo false)"
    say "fact cfg_secs $(val lock_secs | grep -qx true && echo true || echo false)"
    say "fact show_power $(val lock_power | grep -qx true && echo true || echo false)"
    px="$(val lock_px)"; say "fact clock_px ${px:-200}"
    case "${date:-0}" in
        1) date=standard ;; 2) date=dayFirst ;; 3) date=iso ;; *) date=long ;;
    esac
    case "${mask:-0}" in
        1) mask=msk_dots ;; 2) mask=msk_stars ;; 3) mask=msk_special ;; *) mask=msk_shapes ;;
    esac
    case "${pal:-1}" in
        0) pal=mp_vibrant ;; 2) pal=mp_neon ;; 3) pal=mp_pastel ;; 4) pal=mp_mono ;; *) pal=mp_accent ;;
    esac
    say "text cfg_date $date"
    say "fact mask_style $mask"
    say "fact mask_pal $pal"
}

case "${1:-lock}" in
    ensure) ensure ;;
    sync) sync ;;
    alive) alive ;;
    locked) locked_hint ;;
    held) held ;;
    recover) recover ;;
    lock) ensure; sync; say "fact locked true" ;;
    test) fresh; sync; say "fact safe true"; say "fact locked true" ;;
    *) echo "usage: $0 ensure|lock|test|sync|alive|locked|held|recover" >&2; exit 2 ;;
esac
