#!/usr/bin/env python3
"""Build the centre panel's Chinese calendar view.

The month grid, solar terms and lunar labels come from ccal.  Official days
off and make-up workdays come from the holiday-cn JSON, cached under
~/.cache/pleamar-shell.  Anniversaries live beside config.json in
~/.config/pleamar-shell/anniversaries.json; an iNiR widget file is only a
fallback for a first run.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from datetime import date
from pathlib import Path
import xml.etree.ElementTree as ET

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "pleamar-shell"
ANNIVERSARIES = CONFIG_DIR / "anniversaries.json"
INIR_ANNIVERSARIES = (Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
                      / "inir" / "widgets" / "holiday-countdown" / "anniversaries.json")
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pleamar-shell" / "holidays"
HOLIDAY_URL = "https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json"
WEEKDAYS = ["星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"]
WEEKDAY_SHORT = ["一", "二", "三", "四", "五", "六", "日"]
LUNAR_DAYS = [
    "", "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十",
    "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
    "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十",
]


def local(tag):
    return tag.rsplit("}", 1)[-1]


def read_ccal(year):
    """Return {date: lunar row} and {lunar month/day: Gregorian date} for a year."""
    try:
        proc = subprocess.run(
            ["ccal", "-x", "-g", "-u", str(year)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=8,
        )
    except (OSError, subprocess.SubprocessError):
        return {}, {}
    if proc.returncode != 0 or not proc.stdout.strip():
        return {}, {}
    try:
        root = ET.fromstring(proc.stdout)
    except ET.ParseError:
        return {}, {}
    by_date, by_lunar = {}, {}
    for month_el in root.iter():
        if local(month_el.tag) != "month":
            continue
        try:
            month = int(month_el.get("value", "0"))
        except ValueError:
            continue
        if not month:
            continue
        for day_el in month_el.iter():
            if local(day_el.tag) != "day" or not day_el.get("value"):
                continue
            try:
                day = int(day_el.get("value"))
                lm = int(day_el.get("cmonth", "0"))
                ld = int(day_el.get("cdate", "0"))
            except (TypeError, ValueError):
                continue
            if not day or not lm or not ld:
                continue
            day_name = day_el.get("cdatename", "") or ""
            month_name = day_el.get("cmonthname", "") or ""
            leap = bool(day_el.get("leap", "")) and day_el.get("leap") != "0"
            row = {
                "m": lm,
                "d": ld,
                "month": month_name,
                "day_name": day_name,
                "leap": leap,
                "term": day_name if day_name and day_name != LUNAR_DAYS[ld] else "",
            }
            by_date[(year, month, day)] = row
            if not leap:
                by_lunar.setdefault((lm, ld), date(year, month, day))
    return by_date, by_lunar


def load_holidays(year):
    """Read the cached holiday-cn schedule, refreshing it when possible."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    path = CACHE_DIR / f"{year}.json"
    data = None
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if time.time() - path.stat().st_mtime < 12 * 3600:
                return parse_holidays(data)
        except (OSError, ValueError):
            data = None
    text = None
    try:
        proc = subprocess.run(
            ["curl", "-fsSL", "--max-time", "6", HOLIDAY_URL.format(year=year)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=8,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            text = proc.stdout
    except (OSError, subprocess.SubprocessError):
        text = None
    if text is None:
        try:
            from urllib.request import urlopen
            with urlopen(HOLIDAY_URL.format(year=year), timeout=6) as response:
                text = response.read().decode("utf-8")
        except Exception:
            text = None
    if text:
        try:
            data = json.loads(text)
            path.write_text(text, encoding="utf-8")
        except (OSError, ValueError):
            data = None
    return parse_holidays(data) if data else {}


def parse_holidays(data):
    out = {}
    for item in data.get("days", []) if isinstance(data, dict) else []:
        key = str(item.get("date", ""))
        if key:
            out[key] = {"name": str(item.get("name", "")), "off": item.get("isOffDay") is True}
    return out


def load_anniversaries():
    for path in (ANNIVERSARIES, INIR_ANNIVERSARIES):
        if not path.exists():
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            return data.get("anniversaries", data.get("items", []))
    return []


def anniversary_title(item):
    return str(item.get("title") or item.get("name") or "").strip()


def anniversary_month_day(item):
    if item.get("month") and item.get("day"):
        try:
            return int(item["month"]), int(item["day"])
        except (TypeError, ValueError):
            return None
    raw = str(item.get("date", ""))
    parts = raw.split("-")
    if len(parts) == 3:
        try:
            return int(parts[1]), int(parts[2])
        except ValueError:
            return None
    return None


def anniversary_on(item, year, maps):
    title = anniversary_title(item)
    md = anniversary_month_day(item)
    if not title or not md:
        return None
    month, day = md
    if str(item.get("calendar", "solar")) == "lunar":
        by_lunar = maps.get(year, ({}, {}))[1]
        found = by_lunar.get((month, day))
        if not found and day == 30:
            found = by_lunar.get((month, 29))
        return found
    try:
        return date(year, month, day)
    except ValueError:
        return None


def festival_for(day, lunar):
    if (day.month, day.day) == (1, 1):
        return "元旦"
    if (day.month, day.day) == (5, 1):
        return "劳动节"
    if (day.month, day.day) == (10, 1):
        return "国庆"
    if not lunar:
        return ""
    if lunar["term"] == "清明":
        return "清明"
    if lunar["leap"]:
        return ""
    if (lunar["m"], lunar["d"]) == (1, 1):
        return "春节"
    if (lunar["m"], lunar["d"]) == (5, 5):
        return "端午"
    if (lunar["m"], lunar["d"]) == (8, 15):
        return "中秋"
    return ""


def lunar_label(lunar):
    if not lunar:
        return ""
    if lunar["term"]:
        return lunar["term"]
    if lunar["d"] == 1:
        return lunar["month"]
    return lunar["day_name"]


def build(year, month):
    today = date.today()
    view = date(year, month, 1)
    years = {today.year, view.year - 1, view.year, view.year + 1}
    maps = {y: read_ccal(y) for y in years}
    #  The 42-cell grid borrows days from the neighbouring years as well as
    #  months; merge them so hovering a leading/trailing day still knows its
    #  lunar date.
    view_dates = {}
    for y in (view.year - 1, view.year, view.year + 1):
        view_dates.update(maps.get(y, ({}, {}))[0])
    today_lunar = maps.get(today.year, ({}, {}))[0].get((today.year, today.month, today.day))
    holidays = load_holidays(view.year)
    items = load_anniversaries()

    ann_by_day = {}
    for item in items:
        title = anniversary_title(item)
        when = anniversary_on(item, view.year, maps)
        if title and when and when.year == view.year and when.month == view.month:
            ann_by_day.setdefault(when.day, []).append(title)

    #  The list follows the month on screen, not the month of today.  Dates
    #  already gone stay in the list (marked 已过) so a month that only has
    #  earlier anniversaries is not mistaken for an empty one.
    countdowns = []
    for item in items:
        title = anniversary_title(item)
        when = anniversary_on(item, view.year, maps)
        if not title or not when:
            continue
        if when.year != view.year or when.month != view.month:
            continue
        delta = (when - today).days
        if delta == 0:
            when_text = "今天"
        elif delta > 0:
            when_text = f"还有 {delta} 天"
        else:
            when_text = f"已过 {-delta} 天"
        countdowns.append({
            "title": title,
            "date": f"{when.month}月{when.day}日",
            "when": when_text,
            "days": delta,
        })
    countdowns.sort(key=lambda row: row["days"])

    # Monday-first grid, six rows, including the surrounding month's days.
    first = date(view.year, view.month, 1)
    lead = first.weekday()
    if view.month == 12:
        next_first = date(view.year + 1, 1, 1)
    else:
        next_first = date(view.year, view.month + 1, 1)
    days_in_month = (next_first - first).days
    cells = []
    for index in range(42):
        if index < lead:
            day = date.fromordinal(first.toordinal() - (lead - index))
        elif index < lead + days_in_month:
            day = date.fromordinal(first.toordinal() + index - lead)
        else:
            day = date.fromordinal(next_first.toordinal() + index - lead - days_in_month)
        cur = day.year == view.year and day.month == view.month
        lunar = view_dates.get((day.year, day.month, day.day))
        festival = festival_for(day, lunar)
        holiday = holidays.get(day.isoformat())
        names = ann_by_day.get(day.day, []) if cur else []
        anniv = ""
        if names:
            anniv = names[0] + (f" +{len(names) - 1}" if len(names) > 1 else "")
        lunar_full = ""
        if lunar:
            lunar_full = (("闰" if lunar["leap"] else "") + lunar["month"]
                          + LUNAR_DAYS[lunar["d"]])
        hover = f"{day.month}月{day.day}日 {WEEKDAYS[day.weekday()]}"
        if lunar_full:
            hover += f" · 农历{lunar_full}"
        cells.append({
            "day": day.day,
            "cur": cur,
            "today": day == today,
            "label": festival or lunar_label(lunar),
            "lunar": lunar_label(lunar),
            "hover": hover,
            "term": lunar["term"] if lunar else "",
            "festival": festival,
            "holiday": holiday["name"] if holiday else "",
            "off": bool(holiday and holiday["off"]),
            "work": bool(holiday and not holiday["off"]),
            "anniv": anniv,
            "anniv_count": len(names),
        })

    lunar_today = ""
    if today_lunar:
        lunar_today = ("闰" if today_lunar["leap"] else "") + today_lunar["month"] + LUNAR_DAYS[today_lunar["d"]]
    weekday = WEEKDAYS[today.weekday()]
    header = f"{today.year}年{today.month}月{today.day}日"
    if lunar_today:
        header += f" · 农历{lunar_today}"
    week = first.isocalendar()[1]

    return {
        "header": header,
        "month": {
            "year": view.year,
            "month": view.month,
            "title": f"{view.year}年 {view.month}月",
            "sub": f"第 {week} 周",
        },
        "today": {
            "day": f"{today.day:02d}",
            "month": f"{today.month}月",
            "year": str(today.year),
            "weekday": weekday,
            "week": f"第 {today.isocalendar()[1]} 周",
        },
        "weekdays": WEEKDAY_SHORT,
        "days": cells,
        "countdown_title": ("本月倒计时" if (view.year, view.month) == (today.year, today.month)
                            else f"{view.month}月倒计时"),
        "countdowns": countdowns[:2],
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--year", type=int)
    parser.add_argument("--month", type=int)
    args = parser.parse_args()
    today = date.today()
    year = args.year or today.year
    month = args.month or today.month
    if month < 1 or month > 12:
        parser.error("month must be 1..12")
    json.dump(build(year, month), sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
