#!/usr/bin/env python3
"""Talk to skwd-wall v2's daemon over its Unix socket.

Pleamar keeps the wallpaper picker, settings and palette; skwd-walld owns the
background layer and its GPU transitions.  This helper is the small boundary
between them, so the shell does not need skwd's GUI or its Rust client.

  pleamar-wall-skwd apply PATH [--shader NAME] [--duration MS] [--output NAME]
  pleamar-wall-skwd current [--output NAME]

`current` prints the path of the static wallpaper shown on an output.  It exits
non-zero when the daemon is not running or the current item is not a file, so
callers can leave their state alone.

The socket is $SKWD_WALL_V2_SOCK, or
$XDG_RUNTIME_DIR/skwd-wall-v2/wall.sock.  The protocol is the same newline-
delimited JSON used by skwd-helm: one request per connection, then responses
and events until the matching response arrives.
"""
import json
import os
import re
import socket
import sys
import time

DEFAULT_TIMEOUT = 5.0
MAX_LINE = 8 << 20


def socket_path():
    return os.environ.get("SKWD_WALL_V2_SOCK") or os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "skwd-wall-v2", "wall.sock"
    )


def request(method, params, timeout=DEFAULT_TIMEOUT):
    path = socket_path()
    try:
        stream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        stream.settimeout(timeout)
        stream.connect(path)
    except OSError as exc:
        raise RuntimeError("skwd-walld is not reachable at %s (%s)" % (path, exc))

    request_id = int(time.time() * 1000) & 0x7FFFFFFF
    payload = json.dumps({"id": request_id, "method": method, "params": params},
                         separators=(",", ":")) + "\n"
    try:
        stream.sendall(payload.encode("utf-8"))
        reader = stream.makefile("rb")
        while True:
            line = reader.readline(MAX_LINE)
            if not line:
                raise RuntimeError("skwd-walld closed the connection")
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if message.get("id") != request_id:
                continue
            if message.get("error"):
                error = message["error"]
                if isinstance(error, dict):
                    error = error.get("message") or json.dumps(error)
                raise RuntimeError(str(error))
            result = message.get("result")
            return result if result is not None else {}
    except (OSError, ValueError) as exc:
        raise RuntimeError("skwd request failed: %s" % exc)
    finally:
        try:
            stream.close()
        except OSError:
            pass


def outputs():
    result = request("wall.outputs", {})
    return result.get("outputs") or []


def pick_output(items, wanted):
    if wanted and wanted != "*":
        for item in items:
            if item.get("name") == wanted or item.get("target") == wanted:
                return item
        return None
    for item in items:
        if item.get("connected", True):
            return item
    return items[0] if items else None


def current(wanted):
    items = outputs()
    if wanted and wanted != "*":
        item = pick_output(items, wanted)
        if not item:
            raise RuntimeError("skwd-walld reports no output named %s" % wanted)
        candidates = [item]
    else:
        candidates = [item for item in items if item.get("connected", True)]
    for item in candidates:
        for key in ("path", "current"):
            candidate = item.get(key) or ""
            if candidate and os.path.isfile(candidate):
                return candidate
    raise RuntimeError("the current skwd wallpaper is not a local image")


def apply(path, shader, duration, wanted):
    if not os.path.isfile(path):
        raise RuntimeError("not a wallpaper file: %s" % path)
    if shader and shader != "off":
        if len(shader) > 64 or not re.fullmatch(r"[A-Za-z0-9_-]+", shader):
            raise RuntimeError("invalid transition name: %s" % shader)
        try:
            duration = int(duration)
        except (TypeError, ValueError):
            duration = 650
        duration = max(50, min(10_000, duration))
        transition = True
    else:
        shader = ""
        duration = 0
        transition = False

    params = {
        "type": "static",
        "path": os.path.abspath(path),
        "output": wanted or "*",
        "transition": transition,
    }
    if transition:
        params["transition_shader"] = shader
        params["transition_duration_ms"] = duration
    request("wall.apply", params)


def usage():
    print("usage: pleamar-wall-skwd apply PATH [--shader NAME] [--duration MS] [--output NAME]\n"
          "       pleamar-wall-skwd current [--output NAME]", file=sys.stderr)
    return 2


def main(argv):
    if len(argv) < 2:
        return usage()
    command = argv[1]
    args = argv[2:]
    shader = ""
    duration = 650
    output = "*"
    positional = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("--shader", "--duration", "--output"):
            if i + 1 >= len(args):
                return usage()
            value = args[i + 1]
            if arg == "--shader":
                shader = value
            elif arg == "--duration":
                duration = value
            else:
                output = value
            i += 2
            continue
        positional.append(arg)
        i += 1

    try:
        if command == "apply":
            if len(positional) != 1:
                return usage()
            apply(positional[0], shader, duration, output)
            print(positional[0])
        elif command == "current":
            if positional:
                return usage()
            print(current(output))
        else:
            return usage()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
