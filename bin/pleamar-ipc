#!/usr/bin/env bash
# Open a pleamar-shell panel from a terminal.
#   pleamar-ipc search
#   pleamar-ipc settings [0..9]
#   pleamar-ipc center [toggle|0..6]
#   pleamar-ipc notifications
#   pleamar-ipc lock
# The running scene is discovered; use PLEAMAR_SCENE=frame when both run.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"
scene="${PLEAMAR_SCENE:-}"
action="${1:-}"

if [[ "$action" == "--scene" ]]; then
    scene="${2:-}"
    action="${3:-}"
    shift 2 || true
fi
case "$action" in
    search|settings|center|notifications|lock) ;;
    *)
        echo "usage: $0 search | settings [0..9] | center [toggle|0..6] | notifications | lock" >&2
        exit 2
        ;;
esac

if [[ -z "$scene" ]]; then
    if pgrep -f -- "pleamar --scene .*/scenes/island.plm" >/dev/null; then
        scene=island
    elif pgrep -f -- "pleamar --scene .*/scenes/frame.plm" >/dev/null; then
        scene=frame
    else
        echo "no pleamar-shell scene is running" >&2
        exit 1
    fi
fi

if [[ "$action" == "lock" ]]; then
    exec "$root/bin/pleamar-lock" lock
fi

case "$action" in
    search) command="emit ipc_open_search" ;;
    settings)
        page="${2:-}"
        if [[ -n "$page" ]]; then
            [[ "$page" =~ ^[0-9]$ ]] || { echo "settings page must be 0..9" >&2; exit 2; }
            command="emit ipc_open_settings $page"
        else
            command="emit ipc_open_settings"
        fi
        ;;
    center)
        tab="${2:-}"
        case "$tab" in
            ""|toggle)
                # No tab (or explicit `toggle`): close an open centre, otherwise
                # open it on the last-used tab.
                command="emit center_toggle"
                ;;
            [0-6])
                # An explicit tab always opens/switches, even if the centre is
                # already visible.
                command="emit ipc_open_center $tab"
                ;;
            *)
                echo "center must be toggle or a tab 0..6" >&2
                exit 2
                ;;
        esac
        ;;
    notifications) command="emit ipc_open_notifications" ;;
esac

bin="$("$root/bin/pleamar-shell" --path)"
exec "$bin" --say "$scene" "$command"
