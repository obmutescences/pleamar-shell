#!/usr/bin/env python3
"""Capture and blur the desktop for the window picker's backdrop.

The backdrop is blur-only: an opaque screenshot behind the cards, with no
glass, lens or compositor blur.  Mixing Pleamar's lens with niri's own blur
made the backdrop flicker while the picker animated.

  pleamar-window-backdrop capture
      Capture the focused screen now (before the picker maps) and print the
      raw PNG path.  The clipboard is saved and restored around niri's
      screenshot action, which always writes to the clipboard.

  pleamar-window-backdrop blur RAW WIDTH HEIGHT BLUR
      Blur RAW, cache it, and print the JPEG path.

Both subcommands print nothing when they cannot finish.  Safe without a shell.
"""

from __future__ import annotations

import hashlib
import os
import subprocess
import sys
import time
from pathlib import Path

MIME_ORDER = (
    "text/plain;charset=utf-8",
    "text/plain",
    "UTF8_STRING",
    "text/uri-list",
)


def run(args, timeout=4.0, data=None):
    try:
        return subprocess.run(
            args,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def clipboard_mimes():
    p = run(["wl-paste", "-l"], timeout=1.5)
    if not p or p.returncode != 0:
        return []
    return [line.strip() for line in p.stdout.decode("utf-8", "replace").splitlines() if line.strip()]


def save_clipboard(tmpdir):
    mimes = clipboard_mimes()
    if not mimes:
        return None
    mime = next((m for m in MIME_ORDER if m in mimes), mimes[0])
    path = tmpdir / "clipboard.bin"
    p = run(["wl-paste", "--type", mime], timeout=2.5)
    if not p or p.returncode != 0:
        return None
    path.write_bytes(p.stdout)
    return mime, path


def restore_clipboard(saved):
    if saved is None:
        run(["wl-copy", "--clear"], timeout=1.5)
        return
    mime, path = saved
    if not path.exists():
        return
    with path.open("rb") as fh:
        run(["wl-copy", "--type", mime], timeout=2.5, data=fh.read())


def cache_dir():
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    out = base / "pleamar-shell" / "window-backdrop"
    out.mkdir(parents=True, exist_ok=True)
    return out


def capture():
    cache = cache_dir()
    saved = save_clipboard(cache)
    try:
        #  The screenshot action writes the new image to the clipboard.  If an
        #  older screenshot is still there, wl-paste returns it before niri has
        #  painted the new one, and the picker keeps the previous wallpaper.
        #  Drop it first; save_clipboard has already preserved the real data.
        run(["wl-copy", "--clear"], timeout=1.5)
        action = run(
            [
                "niri",
                "msg",
                "action",
                "screenshot-screen",
                "--write-to-disk",
                "false",
                "--show-pointer",
                "false",
            ],
            timeout=5,
        )
        if not action or action.returncode != 0:
            return 3
        #  niri puts the PNG on the clipboard; reading it is the only way to
        #  get the pixels without relying on its screenshot-path setting.
        #  niri writes the image asynchronously; give it enough time to appear
        #  after the clipboard was cleared.
        for _ in range(40):
            p = run(["wl-paste", "--type", "image/png"], timeout=2.5)
            if p and p.returncode == 0 and p.stdout:
                raw = cache / f"desktop-{int(time.time() * 1000)}.png"
                raw.write_bytes(p.stdout)
                print(raw)
                return 0
            time.sleep(0.05)
        return 3
    finally:
        restore_clipboard(saved)
        #  Keep only the last few captures; the blurred JPEGs are cached.
        raws = sorted(cache.glob("desktop-*.png"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in raws[4:]:
            try:
                old.unlink()
            except OSError:
                pass
        try:
            (cache / "clipboard.bin").unlink()
        except OSError:
            pass


def blur(raw_s: str, width_s: str, height_s: str, blur_s: str):
    raw = Path(raw_s)
    if not raw.is_absolute() or not raw.is_file():
        return 2
    width = max(320, min(7680, int(width_s)))
    height = max(240, min(4320, int(height_s)))
    blur = max(0, min(100, int(blur_s)))
    st = raw.stat()
    key = hashlib.sha1(
        f"{raw}|{st.st_mtime_ns}|{st.st_size}|{width}|{height}|{blur}".encode()
    ).hexdigest()[:20]
    target = cache_dir() / f"backdrop-{key}.jpg"
    if target.is_file() and target.stat().st_size > 0:
        print(target)
        return 0

    #  Blur at half resolution, then scale back up: visually identical for a
    #  backdrop, and about twice as fast as a full-size Gaussian.
    args = ["magick", str(raw), "-resize", "50%"]
    if blur > 0:
        sigma = max(0.3, blur / 100 * 13.0)
        args.extend(["-blur", f"0x{sigma:.2f}"])
    args.extend([
        "-resize",
        f"{width}x{height}^",
        "-gravity",
        "center",
        "-extent",
        f"{width}x{height}",
    ])
    # Keep a JPEG suffix on the temporary file.  ImageMagick chooses the
    # encoder from the output name; a plain `.tmp` suffix makes it reject the
    # write as an unknown format, and the caller then falls back to the sharp
    # PNG.  The final rename is still atomic.
    tmp = target.with_name(f".{target.stem}.{os.getpid()}.tmp.jpg")
    args.extend(["-quality", "88", str(tmp)])
    try:
        proc = subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25)
        if proc.returncode != 0 or not tmp.is_file() or tmp.stat().st_size == 0:
            try:
                tmp.unlink(missing_ok=True)
            except OSError:
                pass
            return 3
        os.replace(tmp, target)
    except (OSError, subprocess.SubprocessError):
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass
        return 3
    print(target)
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        return 2
    command = sys.argv[1]
    try:
        if command == "capture" and len(sys.argv) == 2:
            return capture()
        if command == "blur" and len(sys.argv) == 6:
            return blur(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
    except (OSError, ValueError):
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
