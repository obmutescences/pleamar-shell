language 0.4
//  A 1x1 overlay whose only job is to request frame callbacks.  It draws no
//  shell, bar, panel or water; it is the baseline probe for niri itself.
scene Probe {
    surface {
        size: 1, 1
        anchor: top_left
        level: overlay
        reserve: 0
        rate: 120
    }
    shader probe = file "probe.wgsl"
    shader probe {
        at: 0, 0
        size: 1, 1
        values: 1
        colors: #8ff5df, #58c8ff
    }
}
