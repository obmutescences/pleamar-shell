language 0.4
import "../modules/common/motion.plm"
scene Pleamar {
    permissions {
        run: "cava", "sh"
        services: "clock", "clock.seconds", "battery", "media", "media.*", "audio", "audio.*", "network", "bluetooth", "bluetooth.*", "tray", "tray.*", "say:*", "files", "files.write", "apps", "apps.*", "notifications", "notification_history"
    }
    service clock as now { time: text; date: text }
    service clock.seconds as tick { hour: number; minute: number; second: number }
    service battery as pwr { present: bool; percent: number; charging: bool }
    service media as med { playing: bool; title: text; artist: text; player: text; length: number }
    service audio as aud { volume: number; muted: bool; input: number; input_muted: bool }
    service network as net { online: bool; wifi: bool; name: text; strength: number }

    include "../modules/common/common.plm"
    include "../modules/frame/water.plm"
    include "../modules/frame/glass.plm"
    include "../modules/settings/panel.plm"
    include "../modules/launcher/launcher.plm"
    include "../modules/notifications/notifications.plm"
    include "../modules/center/panel.plm"
    include "../modules/windows/panel.plm"
}
