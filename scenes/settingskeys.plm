language 0.4
//  A one-surface keyboard helper for settings and search text fields. The main
//  scene uses a separate surface to own keyboard focus and relay typed text.
scene SettingsKeys {
    permissions {
        run: "sh"
        services: "say:*"
    }
    fact ready = false
    text buffer = ""
    event key_ping ->
    surface keys {
        size: 8, 8
        anchor: top_left
        level: overlay
        open: true
        keyboard: exclusive
        input buffer {
            at: 0, 0
            width: 8
            size: 6
            opacity: 0
            color: #000000
        }
        zone box hit { from: 0, 0; size: 8, 8; label: "Settings keys" }
    }
    on change ready while ready { focus buffer }
}
