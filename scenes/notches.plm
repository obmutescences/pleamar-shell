language 0.9
import "../modules/common/motion.plm"
import "../modules/common/glass_digits.plm"
scene Pleamar {
    permissions {
        run: "cava", "sh"
        services: "clock", "clock.seconds", "battery", "media", "media.*", "audio", "audio.*", "network", "bluetooth", "bluetooth.*", "tray", "tray.*", "say:*", "files", "files.write", "apps", "apps.*", "notifications", "notification_history", "clipboard", "clipboard.set", "session.*", "env", "sound"
    }
    service clock as now { time: text; date: text }
    service clock.seconds as tick { hour: number; minute: number; second: number }
    service battery as pwr { present: bool; percent: number; charging: bool }
    service media as med { playing: bool; title: text; artist: text; player: text; length: number }
    service audio as aud { volume: number; muted: bool; input: number; input_muted: bool }
    service network as net { online: bool; wifi: bool; name: text; strength: number }

    include "../modules/common/common.plm"
    include "../modules/notifications/notifications.plm"
    include "../modules/notches/frame.plm"

    //  Pace full-screen lens captures: 60ms while a drawer/popup is open,
    //  250ms during music-only border animation (-80% wlr-screencopy load on
    //  both pleamar and the compositor), and ~500ms while quiet.  Pause
    //  captures mid-drawer transition so springs never compete with readbacks.
    lens every 60ms + 190ms * if(panel_open or center_open or launch_open or nt_center or audio_pick_open, 0, if(music_frame_on and music_on, 1, 2.3))
    lens hold while (cp_np > 0.01 and cp_np < 0.99) or (ct_np > 0.01 and ct_np < 0.99) or (la_p > 0.01 and la_p < 0.99) or (nt_np > 0.01 and nt_np < 0.99)
}
