language 0.4
//  A one-surface keyboard helper for the window picker.  The main island/frame
//  scene owns many layer surfaces and does not receive layer keyboard focus,
//  so keys went to the kitty window underneath.  This tiny separate process
//  owns the keyboard and forwards letters, Escape and Return to the parent.
scene WindowKeys {
    permissions {
        run: "sh"
        services: "say:*"
    }
    fact ready = false
    text buffer = ""
    event key_ping ->
    surface keys {
        size: 8, 8
        anchor: top_left
        level: overlay
        open: true
        keyboard: exclusive
        input buffer {
            at: 0, 0
            width: 8
            size: 6
            opacity: 0
            color: #000000
            passive: true
        }
        zone box hit { from: 0, 0; size: 8, 8; label: "Window picker keys" }
    }
    on change ready while ready { focus buffer }
}
